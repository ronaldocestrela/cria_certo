# Configurações de Banco de Dados MSSQL
DB_PORT=1433
MSSQL_SA_PASSWORD=Password123!

# Connection string informations
DB_HOST=database
DATABASE_NAME=criacerto_foundation

# Configurações de Redis Cache
REDIS_PORT=6379

# Configurações de Autenticação JWT
JWT_SECRET=CriaCertoProductionSecureJwtKey2026!32Bytes

# Porta dos Serviços Containerizados
API_PORT=8080
WEB_PORT=8081

# Credenciais do Administrador Mestre do Backoffice (Bootstrap Seed)
BACKOFFICE_MASTER_ADMIN_EMAIL=admin@criacerto.com.br
BACKOFFICE_MASTER_ADMIN_PASSWORD=AdminPassword123!
BACKOFFICE_MASTER_ADMIN_NAME="Administrador Mestre"

# Configurações do Gateway de Pagamentos Stripe
STRIPE_API_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_SUCCESS_URL=http://localhost:8081/settings/subscription?success=true
STRIPE_CANCEL_URL=http://localhost:8081/settings/subscription?canceled=true
STRIPE_RETURN_URL=http://localhost:8081/settings/subscription

