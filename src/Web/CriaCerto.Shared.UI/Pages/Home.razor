                    <span class="material-symbols-outlined">@(_isMobileMenuOpen ? "close" : "menu")</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Mobile Drawer Navigation -->
    <div class="landing-mobile-drawer @(_isMobileMenuOpen ? "open" : "")">
        <a href="#recursos" class="mobile-nav-link" @onclick="CloseMobileMenu">Veja na Prática</a>
        <a href="#diferenciais" class="mobile-nav-link" @onclick="CloseMobileMenu">Antes vs. Depois</a>
        <a href="#modulos" class="mobile-nav-link" @onclick="CloseMobileMenu">Módulos</a>
        <a href="#planos" class="mobile-nav-link" @onclick="CloseMobileMenu">Preços & Simulador</a>
        <a href="#faq" class="mobile-nav-link" @onclick="CloseMobileMenu">Dúvidas Frequentes</a>

        <div class="mobile-drawer-actions">
            <a href="/register" class="cc-btn cc-btn-primary" @onclick="CloseMobileMenu">
                <span>Criar Conta Gratuita (30 Dias)</span>
                <span class="material-symbols-outlined icon-sm">arrow_forward</span>
            </a>
            <a href="/login" class="cc-btn cc-btn-outline" @onclick="CloseMobileMenu">Entrar no Sistema</a>
        </div>
    </div>

    <!-- Hero Banner Section -->
    <section class="landing-hero">
        <div class="hero-bg-overlay"></div>
        <div class="hero-container">
            <div class="hero-content">
                <div class="hero-badge">
                    <span class="material-symbols-outlined text-emerald-400">visibility</span>
                    <span>Pare de perder margem no escuro • 100% Off-line no Curral</span>
                </div>
                <h1 class="hero-title">
                    Quanto dinheiro sua fazenda perde hoje <span class="hero-highlight">sem você perceber?</span>
                </h1>
                <p class="hero-description">
                    Animais refugo comendo ração sem ganhar peso, matrizes falhando na IATF, caderno de curral perdido e lotes barrados por carência sanitária drenam seu lucro em silêncio.
                    Assuma o controle individual do rebanho <strong>mesmo sem sinal de internet no mangueiro</strong>.
                </p>

                <div class="hero-cta-group">
                    <a href="/register" class="cc-btn cc-btn-primary hero-btn-main">
                        <span>Estancar Perdas — 30 Dias Grátis</span>
                        <span class="material-symbols-outlined">rocket_launch</span>
                    </a>
                    <a href="https://wa.me/5575991897068?text=Ol%C3%A1%2C%20quero%20ver%20como%20o%20CriaCerto%20evita%20perdas%20na%20minha%20fazenda" target="_blank" rel="noopener noreferrer" class="cc-btn hero-btn-sec">
                        <span>Falar com Especialista</span>
                        <span class="material-symbols-outlined">chat</span>
                    </a>
                </div>

                <div class="hero-micro-trust font-mono">
                    <span><span class="material-symbols-outlined icon-sm">check_circle</span> Sem cartão de crédito</span>
                    <span><span class="material-symbols-outlined icon-sm">check_circle</span> Até 500 cabeças no teste</span>
                    <span><span class="material-symbols-outlined icon-sm">check_circle</span> Importa seu Excel em 2 min</span>
                </div>

                <div class="hero-metrics-row">
                    <div class="metric-pill">
                        <span class="metric-value">+150k</span>
                        <span class="metric-label">Cabeças Monitoradas</span>
                    </div>
                    <div class="metric-divider"></div>
                    <div class="metric-pill">
                        <span class="metric-value">60%</span>
                        <span class="metric-label">Menos Tempo no Curral</span>
                    </div>
                    <div class="metric-divider"></div>
                    <div class="metric-pill">
                        <span class="metric-value">Zero</span>
                        <span class="metric-label">Multas por Carência</span>
                    </div>
                </div>
            </div>

            <!-- Interactive Hero Monitor Widget -->
            <div class="hero-visual-card">
                <div class="glass-card-header" style="justify-content: space-between; flex-wrap: wrap;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <div class="card-status-dot"></div>
                        <span class="font-mono text-xs text-emerald-300">RAIO-X DO REBANHO (AO VIVO)</span>
                    </div>
                    <div class="hero-widget-tabs">
                        <button type="button" class="hero-tab-btn @(_heroWidgetTab == 0 ? "active" : "")" @onclick="() => _heroWidgetTab = 0">Perdas</button>
                        <button type="button" class="hero-tab-btn @(_heroWidgetTab == 1 ? "active" : "")" @onclick="() => _heroWidgetTab = 1">Curral</button>
                        <button type="button" class="hero-tab-btn @(_heroWidgetTab == 2 ? "active" : "")" @onclick="() => _heroWidgetTab = 2">Abate</button>
                    </div>
                </div>

                @if (_heroWidgetTab == 0)
                {
                    <div class="hero-card-preview">
                        <div class="preview-metric-box">
                            <span class="preview-label">Ralo Invisível Detectado • Lote 04</span>
                            <span class="preview-val">18 Bois Refugo</span>
                            <div class="preview-tag-chip hero-chip-warn">GPD abaixo de 0,38 kg/dia (-R$ 4.320/mês)</div>
                        </div>
                        <div class="preview-mini-chart">
                            <div class="chart-bar" style="height: 38%;" title="Animais Abaixo da Meta"></div>
                            <div class="chart-bar" style="height: 55%;"></div>
                            <div class="chart-bar" style="height: 76%;"></div>
                            <div class="chart-bar active" style="height: 94%;"></div>
                        </div>
                        <div class="preview-alert-box">
                            <span class="material-symbols-outlined text-amber-400">lightbulb</span>
                            <span>Ação sugerida: Apartar lote para descarte ou ajuste de dieta</span>
                        </div>
                    </div>
                }
                else if (_heroWidgetTab == 1)
                {
                    <div class="hero-card-preview">
                        <div class="preview-metric-box">
                            <span class="preview-label">Mangueiro Sede • Modo Off-line Ativo</span>
                            <span class="preview-val">Brinco #4092 • 486 kg</span>
                            <div class="preview-tag-chip">GPD: +1,42 kg/dia • +18 kg em 12 dias</div>
                        </div>
                        <div class="hero-mini-list font-mono">
                            <div class="mini-list-row"><span>#4091 (Nelore)</span><span class="text-emerald-300">502 kg • +1,35/dia</span></div>
                            <div class="mini-list-row"><span>#4092 (Nelore)</span><span class="text-emerald-300">486 kg • +1,42/dia</span></div>
                            <div class="mini-list-row"><span>#4093 (Cruzado)</span><span class="text-amber-300">398 kg • +0,41/dia</span></div>
                        </div>
