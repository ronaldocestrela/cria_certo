                                        <div class="mockup-row">
                                            <span>D0 (Implante)</span><span>10/11</span><span>140 cab.</span><span class="tag-ok">Concluído</span>
                                        </div>
                                        <div class="mockup-row">
                                            <span>D8 (Retirada)</span><span>18/11</span><span>140 cab.</span><span class="tag-ok">Concluído</span>
                                        </div>
                                        <div class="mockup-row">
                                            <span>D10 (IA)</span><span>Hoje</span><span>140 cab.</span><span class="tag-warn">Em Campo</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (_activeShowcaseTab == 2)
                {
