                            <span class="material-symbols-outlined text-emerald-400">cloud_done</span>
                            <span>142 pesagens salvas localmente • Sincroniza ao voltar à sede</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="hero-card-preview">
                        <div class="preview-metric-box">
                            <span class="preview-label">Lote Embarque Frigorífico • 60 Cab.</span>
                            <span class="preview-val">58 Liberados / 2 Travados</span>
                            <div class="preview-tag-chip hero-chip-danger">Bloqueio Automático de Carência Ativo</div>
                        </div>
                        <div class="hero-mini-list font-mono">
                            <div class="mini-list-row"><span>Brinco #2104</span><span class="text-amber-300">Carência até 29/11 (7d)</span></div>
                            <div class="mini-list-row"><span>Brinco #2188</span><span class="text-amber-300">Carência até 03/12 (11d)</span></div>
                        </div>
                        <div class="preview-alert-box">
                            <span class="material-symbols-outlined text-amber-400">verified_user</span>
                            <span>Economia estimada de R$ 18.500 evitando devolução de carga</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Trust & Compatibility Strip -->
    <section class="trust-strip">
        <div class="trust-strip-container font-mono">
            <div class="trust-item">
                <span class="material-symbols-outlined">wifi_off</span>
                <span>PWA Off-line no Curral</span>
            </div>
            <div class="trust-item">
                <span class="material-symbols-outlined">qr_code_scanner</span>
                <span>Balanças & Leitor RFID SISBOV</span>
            </div>
            <div class="trust-item">
                <span class="material-symbols-outlined">table_view</span>
                <span>Importação Excel / CSV</span>
