@using CriaCerto.Modules.Backoffice.Application.Features.AdminUsers.Dtos

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(IsEdit ? "Editar Usuário Administrativo" : "Novo Usuário Administrativo")</h3>
                <button class="close-btn" @onclick="Close">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Nome Completo</label>
                    <input type="text" class="form-control" @bind="Name" placeholder="Ex: Carlos Silva" />
                </div>
                <div class="form-group">
                    <label>E-mail Corporativo</label>
                    <input type="email" class="form-control" @bind="Email" placeholder="exemplo@criacerto.com.br" />
                </div>
                @if (!IsEdit)
                {
                    <div class="form-group">
                        <label>Senha Inicial</label>
                        <input type="password" class="form-control" @bind="Password" placeholder="Mínimo 6 caracteres" />
                    </div>
                }

                <div class="form-group">
                    <label>Papéis Administrativos (Roles)</label>
                    <div class="roles-selection">
                        @foreach (var role in AvailableRoles)
                        {
                            <label class="role-checkbox">
                                <input type="checkbox" checked="@SelectedRoleIds.Contains(role.Id)" @onchange="(e) => ToggleRole(role.Id, e.Value)" />
                                <div>
                                    <span class="role-title">@role.Name</span>
                                    <small class="role-desc">@role.Description</small>
                                </div>
                            </label>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="Close">Cancelar</button>
                <button class="btn btn-primary" @onclick="Save">Salvar Usuário</button>
            </div>
        </div>
    </div>
}

<style>
    .modal-backdrop {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(15, 23, 42, 0.75);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        backdrop-filter: blur(4px);
    }
    .modal-card {
        background: #1e293b;
        color: #f8fafc;
        border-radius: 0.75rem;
        width: 100%;
        max-width: 500px;
        border: 1px solid #334155;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
    }
    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem;
        border-bottom: 1px solid #334155;
    }
    .modal-header h3 { margin: 0; font-size: 1.1rem; font-weight: 700; color: #f1f5f9; }
    .close-btn { background: none; border: none; color: #94a3b8; font-size: 1.2rem; cursor: pointer; }
    .modal-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
    .form-group label { font-size: 0.85rem; font-weight: 600; color: #cbd5e1; }
    .form-control {
        background: #0f172a; border: 1px solid #334155; color: #f8fafc;
        padding: 0.6rem 0.8rem; border-radius: 0.5rem; font-size: 0.9rem;
    }
    .form-control:focus { border-color: #38bdf8; outline: none; }
    .roles-selection { display: flex; flex-direction: column; gap: 0.5rem; max-height: 180px; overflow-y: auto; }
    .role-checkbox {
        display: flex; align-items: flex-start; gap: 0.75rem; background: #0f172a;
        padding: 0.6rem; border-radius: 0.5rem; border: 1px solid #334155; cursor: pointer;
    }
    .role-title { font-size: 0.85rem; font-weight: 700; color: #38bdf8; display: block; }
    .role-desc { font-size: 0.75rem; color: #94a3b8; }
    .modal-footer {
        display: flex; justify-content: flex-end; gap: 0.75rem;
        padding: 1.25rem; border-top: 1px solid #334155;
    }
    .btn { padding: 0.5rem 1rem; border-radius: 0.5rem; font-size: 0.85rem; font-weight: 600; border: none; cursor: pointer; }
    .btn-secondary { background: #334155; color: #f8fafc; }
    .btn-primary { background: #0284c7; color: #ffffff; }
    .btn-primary:hover { background: #0369a1; }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public Guid UserId { get; set; }
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string Email { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<AdminUserSaveModel> OnSave { get; set; }

    private string Password { get; set; } = string.Empty;
    private List<Guid> SelectedRoleIds { get; set; } = new();

    private List<RoleItem> AvailableRoles = new()
    {
        new RoleItem(Guid.Parse("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"), "PlatformOwner", "Acesso total à plataforma"),
        new RoleItem(Guid.Parse("bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"), "SupportN1", "Suporte Leitura"),
        new RoleItem(Guid.Parse("cccccccc-cccc-cccc-cccc-cccccccccccc"), "SupportN2", "Suporte Avançado & Impersonação"),
        new RoleItem(Guid.Parse("dddddddd-dddd-dddd-dddd-dddddddddddd"), "FinanceOps", "Gestão de Planos & Assinaturas"),
        new RoleItem(Guid.Parse("eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee"), "ReadOnlyAuditor", "Auditoria e Compliance")
    };

    private void ToggleRole(Guid roleId, object? checkedValue)
    {
        bool isChecked = checkedValue is bool b && b;
        if (isChecked && !SelectedRoleIds.Contains(roleId))
            SelectedRoleIds.Add(roleId);
        else if (!isChecked)
            SelectedRoleIds.Remove(roleId);
    }

    private async Task Close() => await OnClose.InvokeAsync();

    private async Task Save()
    {
        var model = new AdminUserSaveModel(UserId, Name, Email, Password, SelectedRoleIds);
        await OnSave.InvokeAsync(model);
        await OnClose.InvokeAsync();
    }

    public record RoleItem(Guid Id, string Name, string Description);
    public record AdminUserSaveModel(Guid Id, string Name, string Email, string Password, List<Guid> RoleIds);
}
