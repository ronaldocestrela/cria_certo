@using CriaCerto.Modules.Backoffice.Application.Features.AdminUsers.Dtos

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>🖥️ Sessões Ativas do Usuário</h3>
                <button class="close-btn" @onclick="Close">✕</button>
            </div>
            <div class="modal-body">
                <div class="sessions-header">
                    <span>Sessões encontradas: <strong>@(Sessions?.Count ?? 0)</strong></span>
                    @if (Sessions != null && Sessions.Any())
                    {
                        <button class="btn btn-danger-sm" @onclick="RevokeAll">Revogar Todas as Sessões</button>
                    }
                </div>

                @if (Sessions == null || !Sessions.Any())
                {
                    <div class="empty-sessions">Nenhuma sessão ativa no momento.</div>
                }
                else
                {
                    <div class="sessions-list">
                        @foreach (var session in Sessions)
                        {
                            <div class="session-item">
                                <div class="session-info">
                                    <span class="session-ip">🌐 @session.IpAddress</span>
                                    <span class="session-ua">@session.UserAgent</span>
                                    <small class="session-time">Criada em: @session.CreatedAtUtc.ToLocalTime().ToString("g") | Expira em: @session.ExpiresAtUtc.ToLocalTime().ToString("t")</small>
                                </div>
                                <button class="btn btn-outline-danger" @onclick="() => RevokeOne(session.Id)">Revogar</button>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="Close">Fechar</button>
            </div>
        </div>
    </div>
}

<style>
    .modal-backdrop {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(15, 23, 42, 0.8); display: flex; align-items: center; justify-content: center; z-index: 1000;
        backdrop-filter: blur(4px);
    }
    .modal-card {
        background: #1e293b; color: #f8fafc; border-radius: 0.75rem; width: 100%; max-width: 600px;
        border: 1px solid #334155; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
    }
    .modal-header { display: flex; justify-content: space-between; align-items: center; padding: 1.25rem; border-bottom: 1px solid #334155; }
    .modal-header h3 { margin: 0; font-size: 1rem; font-weight: 700; color: #f1f5f9; }
    .close-btn { background: none; border: none; color: #94a3b8; font-size: 1.2rem; cursor: pointer; }
    .modal-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem; }
    .sessions-header { display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; color: #94a3b8; }
    .sessions-list { display: flex; flex-direction: column; gap: 0.6rem; max-height: 250px; overflow-y: auto; }
    .session-item {
        display: flex; justify-content: space-between; align-items: center; background: #0f172a;
        padding: 0.75rem; border-radius: 0.5rem; border: 1px solid #334155;
    }
    .session-info { display: flex; flex-direction: column; gap: 0.2rem; }
    .session-ip { font-size: 0.85rem; font-weight: 700; color: #38bdf8; }
    .session-ua { font-size: 0.75rem; color: #cbd5e1; }
    .session-time { font-size: 0.7rem; color: #64748b; }
    .empty-sessions { text-align: center; padding: 2rem; color: #64748b; font-size: 0.9rem; }
    .modal-footer { display: flex; justify-content: flex-end; padding: 1rem 1.25rem; border-top: 1px solid #334155; }
    .btn { padding: 0.5rem 1rem; border-radius: 0.5rem; font-size: 0.85rem; font-weight: 600; border: none; cursor: pointer; }
    .btn-secondary { background: #334155; color: #f8fafc; }
    .btn-danger-sm { background: #dc2626; color: #ffffff; padding: 0.3rem 0.6rem; font-size: 0.75rem; border-radius: 0.3rem; border: none; cursor: pointer; }
    .btn-outline-danger { background: transparent; border: 1px solid #ef4444; color: #ef4444; padding: 0.3rem 0.6rem; font-size: 0.75rem; border-radius: 0.3rem; cursor: pointer; }
    .btn-outline-danger:hover { background: #ef4444; color: #ffffff; }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Guid UserId { get; set; }
    [Parameter] public IReadOnlyCollection<AdminSessionDto>? Sessions { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Guid> OnRevokeSession { get; set; }
    [Parameter] public EventCallback<Guid> OnRevokeAllSessions { get; set; }

    private async Task Close() => await OnClose.InvokeAsync();
    private async Task RevokeOne(Guid sessionId) => await OnRevokeSession.InvokeAsync(sessionId);
    private async Task RevokeAll() => await OnRevokeAllSessions.InvokeAsync(UserId);
}
