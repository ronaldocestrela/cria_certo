@using CriaCerto.Modules.Backoffice.Application.Features.Audit.Dtos
@using CriaCerto.Web.Client.Services
@inject IBackofficeApiClient ApiClient

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="header-title-area">
                    <span class="modal-icon">🧹</span>
                    <h3>Política de Retenção e Expurgo por Criticidade</h3>
                </div>
                <button class="btn-close" @onclick="Close" aria-label="Fechar">&times;</button>
            </div>

            <div class="modal-body">
                <div class="policy-alert info">
                    <span class="alert-icon">ℹ️</span>
                    <div class="alert-content">
                        <strong>Governança de Retenção de Logs Forenses</strong>
                        <p>Os prazos mínimos de retenção protegem a integridade de dados fiscais e regulatórios. Registros com severidade <strong>Crítica</strong> nunca são eliminados por expurgo automático (somente arquivados para auditorias).</p>
                    </div>
                </div>

                @if (ErrorMessage is not null)
                {
                    <div class="policy-alert error">
                        <span class="alert-icon">⚠️</span>
                        <div class="alert-content">
                            <strong>Erro na Operação</strong>
                            <p>@ErrorMessage</p>
                        </div>
                    </div>
                }

                @if (ExecutionResult is not null)
                {
                    <div class="execution-result-card @(ExecutionResult.IsDryRun ? "dryrun" : "applied")">
                        <div class="result-header">
                            <span class="result-badge">@(ExecutionResult.IsDryRun ? "Simulação Concluída (Dry Run)" : "Política Aplicada em Produção")</span>
                            <span class="result-time">@ExecutionResult.ExecutedAtUtc.ToString("dd/MM/yyyy HH:mm:ss") UTC</span>
                        </div>
                        <p class="result-summary">@ExecutionResult.Summary</p>
                        <div class="result-stats">
                            <div class="stat-box">
                                <span class="stat-number">@ExecutionResult.TotalEvaluated</span>
                                <span class="stat-label">Avaliados</span>
                            </div>
                            <div class="stat-box">
                                <span class="stat-number">@ExecutionResult.ArchivedCount</span>
                                <span class="stat-label">Arquivados</span>
                            </div>
                            <div class="stat-box">
                                <span class="stat-number">@ExecutionResult.PurgedCount</span>
                                <span class="stat-label">Purgados (Baixos)</span>
                            </div>
                        </div>
                    </div>
                }

                <div class="form-grid">
                    <div class="form-group">
                        <label>Criticidade Baixa (Low) - Dias de Retenção:</label>
                        <input type="number" class="form-control" @bind="LowDays" min="30" max="365" />
                        <span class="field-hint">Logs de leitura ou diagnósticos. Elegíveis para expurgo.</span>
                    </div>

                    <div class="form-group">
                        <label>Criticidade Média (Medium) - Dias de Retenção:</label>
                        <input type="number" class="form-control" @bind="MediumDays" min="90" max="1825" />
                        <span class="field-hint">Criação/edição cadastral. Arquivamento automático.</span>
                    </div>

                    <div class="form-group">
                        <label>Criticidade Alta (High) - Dias de Retenção:</label>
                        <input type="number" class="form-control" @bind="HighDays" min="180" max="3650" />
                        <span class="field-hint">Faturamento e planos. Arquivamento protegido.</span>
                    </div>

                    <div class="form-group">
                        <label>Criticidade Crítica (Critical) - Dias de Retenção:</label>
                        <input type="number" class="form-control" @bind="CriticalDays" min="365" max="3650" />
                        <span class="field-hint">Impersonação, 4-Eyes e acessos. Nunca expurgados.</span>
                    </div>
                </div>

                <div class="dry-run-toggle">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="IsDryRun" />
                        <span><strong>Executar como Simulação (Dry Run)</strong> — Analisa e contabiliza sem alterar ou expurgar nenhum registro.</span>
                    </label>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="Close" disabled="@IsProcessing">Fechar</button>
                <button class="btn @(IsDryRun ? "btn-info" : "btn-danger")" @onclick="ExecutePolicyAsync" disabled="@IsProcessing">
                    @if (IsProcessing)
                    {
                        <span>Processando...</span>
                    }
                    else
                    {
                        <span>@(IsDryRun ? "Simular Retenção (Dry Run)" : "Executar Expurgo e Arquivamento")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnExecuted { get; set; }

    private int LowDays { get; set; } = 90;
    private int MediumDays { get; set; } = 365;
    private int HighDays { get; set; } = 1095;
    private int CriticalDays { get; set; } = 1825;
    private bool IsDryRun { get; set; } = true;
    private bool IsProcessing { get; set; }
    private string? ErrorMessage { get; set; }
    private AuditRetentionExecutionResultDto? ExecutionResult { get; set; }

    private async Task Close()
    {
        ExecutionResult = null;
        ErrorMessage = null;
        await OnClose.InvokeAsync();
    }

    private async Task ExecutePolicyAsync()
    {
        IsProcessing = true;
        ErrorMessage = null;

        try
        {
            var req = new ApplyAuditRetentionRequest(
                IsDryRun,
                CriticalDays,
                HighDays,
                MediumDays,
                LowDays);

            var result = await ApiClient.ApplyAuditRetentionPolicyAsync(req);
            if (result is not null)
            {
                ExecutionResult = result;
                if (!IsDryRun)
                {
                    await OnExecuted.InvokeAsync();
                }
            }
            else
            {
                ErrorMessage = "Não foi possível executar a política de retenção. Verifique suas permissões (necessário PlatformOwner).";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsProcessing = false;
        }
    }
}

<style>
    .policy-alert {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.85rem 1rem;
        border-radius: 8px;
        font-size: 0.85rem;
    }

    .policy-alert.info {
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.3);
        color: #93c5fd;
    }

    .policy-alert.error {
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.4);
        color: #fca5a5;
    }

    .execution-result-card {
        padding: 1rem;
        border-radius: 8px;
        border: 1px solid #334155;
    }

    .execution-result-card.dryrun {
        background: rgba(59, 130, 246, 0.1);
        border-color: #3b82f6;
    }

    .execution-result-card.applied {
        background: rgba(16, 185, 129, 0.1);
        border-color: #10b981;
    }

    .result-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .result-badge {
        font-weight: 600;
        font-size: 0.85rem;
        color: #f8fafc;
    }

    .result-time {
        font-size: 0.75rem;
        color: #94a3b8;
    }

    .result-summary {
        margin: 0 0 0.75rem 0;
        font-size: 0.9rem;
    }

    .result-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
    }

    .stat-box {
        background: #0f172a;
        padding: 0.5rem;
        border-radius: 6px;
        text-align: center;
        display: flex;
        flex-direction: column;
    }

    .stat-number {
        font-size: 1.25rem;
        font-weight: 700;
        color: #f8fafc;
    }

    .stat-label {
        font-size: 0.7rem;
        color: #94a3b8;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    @@media (max-width: 640px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .form-group label {
        font-size: 0.8rem;
        font-weight: 500;
        color: #cbd5e1;
    }

    .form-control {
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 6px;
        padding: 0.5rem 0.75rem;
        color: #f8fafc;
        font-size: 0.9rem;
    }

    .form-control:focus {
        outline: none;
        border-color: #3b82f6;
    }

    .field-hint {
        font-size: 0.7rem;
        color: #64748b;
    }

    .dry-run-toggle {
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 0.85rem 1rem;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        font-size: 0.85rem;
        color: #e2e8f0;
    }

    .btn-info {
        background: #3b82f6;
        color: #fff;
    }

    .btn-info:hover {
        background: #2563eb;
    }

    .btn-danger {
        background: #ef4444;
        color: #fff;
    }

    .btn-danger:hover {
        background: #dc2626;
    }
</style>
