@using CriaCerto.Modules.Backoffice.Application.Security

<nav class="backoffice-nav" aria-label="Menu de Navegação Administrativo">
    <div class="nav-brand">
        <span class="brand-badge">SaaS Admin</span>
        <h2 class="brand-title">CriaCerto Backoffice</h2>
    </div>

    <div class="nav-section">
        <div class="section-header">GERENCIAMENTO PLATAFORMA</div>
        <NavLink class="nav-link" href="backoffice/dashboard" Match="NavLinkMatch.All">
            <span class="nav-icon">📊</span> Dashboard Global
        </NavLink>

        <PermissionGuard Permission="@BackofficePermissions.TenantsRead">
            <NavLink class="nav-link" href="backoffice/tenants">
                <span class="nav-icon">🏢</span> Tenants & Clientes
            </NavLink>
        </PermissionGuard>

        <PermissionGuard Permission="@BackofficePermissions.PlansRead">
            <NavLink class="nav-link" href="backoffice/plans">
                <span class="nav-icon">💳</span> Catálogo de Planos
            </NavLink>
        </PermissionGuard>
    </div>

    <div class="nav-section">
        <div class="section-header">SEGURANÇA & OPERAÇÕES</div>
        <PermissionGuard Permission="@BackofficePermissions.UsersAdminManage">
            <NavLink class="nav-link" href="backoffice/users">
                <span class="nav-icon">👤</span> Usuários Admin (IAM)
            </NavLink>
        </PermissionGuard>

        <PermissionGuard Permission="@BackofficePermissions.SupportDiagnose">
            <NavLink class="nav-link" href="backoffice/support">
                <span class="nav-icon">🛠️</span> Workbench Suporte
            </NavLink>
        </PermissionGuard>

        <PermissionGuard Permission="@BackofficePermissions.ImpersonationStart">
            <NavLink class="nav-link" href="backoffice/impersonation">
                <span class="nav-icon">🔑</span> Impersonação
            </NavLink>
        </PermissionGuard>

        <PermissionGuard Permission="@BackofficePermissions.ApprovalsRequest">
            <NavLink class="nav-link" href="backoffice/approvals">
                <span class="nav-icon">🛡️</span> Aprovações (4-Eyes)
            </NavLink>
        </PermissionGuard>

        <PermissionGuard Permission="@BackofficePermissions.AuditRead">
            <NavLink class="nav-link" href="backoffice/audit">
                <span class="nav-icon">📜</span> Trilha de Auditoria
            </NavLink>
        </PermissionGuard>

        <PermissionGuard Permission="@BackofficePermissions.ObservabilityRead">
            <NavLink class="nav-link" href="backoffice/observability">
                <span class="nav-icon">🛰️</span> Observabilidade & Alertas
            </NavLink>
        </PermissionGuard>

        <PermissionGuard Permission="@BackofficePermissions.ComplianceRead">
            <NavLink class="nav-link" href="backoffice/compliance">
                <span class="nav-icon">⚖️</span> Compliance & LGPD
            </NavLink>
        </PermissionGuard>
    </div>
</nav>

<style>
    .backoffice-nav {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding: 1.5rem 1rem;
        background: #0f172a;
        color: #f8fafc;
        min-height: 100vh;
    }
    .nav-brand {
        padding-bottom: 1rem;
        border-bottom: 1px solid #1e293b;
    }
    .brand-badge {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #ffffff;
        padding: 0.2rem 0.6rem;
        border-radius: 9999px;
        letter-spacing: 0.05em;
    }
    .brand-title {
        font-size: 1.1rem;
        font-weight: 700;
        margin-top: 0.5rem;
        color: #f1f5f9;
    }
    .nav-section {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }
    .section-header {
        font-size: 0.65rem;
        font-weight: 700;
        color: #64748b;
        letter-spacing: 0.08em;
        margin-bottom: 0.2rem;
        padding-left: 0.5rem;
    }
    .nav-link {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.6rem 0.8rem;
        color: #94a3b8;
        text-decoration: none;
        border-radius: 0.5rem;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }
    .nav-link:hover, .nav-link.active {
        background: #1e293b;
        color: #38bdf8;
    }
    .nav-icon {
        font-size: 1rem;
    }
</style>
