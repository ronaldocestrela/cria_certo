@using CriaCerto.Modules.Backoffice.Application.Features.Support.Dtos
@using CriaCerto.Web.Client.Services
@inject IBackofficeApiClient ApiClient

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="modal-header-title">
                    <span class="security-badge">🛡️ Ação Remediativa Segura</span>
                    <h3>@GetActionTitle()</h3>
                </div>
                <button class="close-btn" @onclick="Close" title="Fechar">✕</button>
            </div>

            <div class="modal-body">
                <div class="tenant-summary-card">
                    <div class="tenant-info">
                        <span class="tenant-label">Fazenda / Tenant</span>
                        <strong class="tenant-name">@TenantName</strong>
                        <span class="tenant-meta">ID: <code>@TenantId</code></span>
                    </div>
                    <div class="action-type-pill">
                        <code>@ActionType</code>
                    </div>
                </div>

                <div class="safeguard-alert-box">
                    <div class="safeguard-icon">⚡</div>
                    <div class="safeguard-text">
                        <strong>Impacto Operacional</strong>
                        <p>@GetActionDescription()</p>
                    </div>
                </div>

                <div class="form-group">
                    <label for="rem-ticket-input">Ticket / Chamado de Suporte <span class="required">*</span></label>
                    <input id="rem-ticket-input"
                           type="text"
                           class="form-control"
                           placeholder="Ex: SUP-2041, INC-882"
                           @bind="SupportTicket"
                           @bind:event="oninput"
                           maxlength="30" />
                    <small class="hint-text">Referência do chamado para auditoria forense do suporte.</small>
                </div>

                <div class="form-group">
                    <label for="rem-justification-input">Justificativa Operacional da Remediação <span class="required">*</span></label>
                    <textarea id="rem-justification-input"
                              class="form-control"
                              rows="3"
                              placeholder="Descreva a razão técnica pela qual esta ação de saneamento está sendo executada..."
                              @bind="Justification"
                              @bind:event="oninput"></textarea>
                    <div class="justification-footer">
                        <small class="char-count @(IsJustificationValid ? "text-success" : "text-muted")">
                            @(Justification?.Trim().Length ?? 0) / 10 caracteres mínimos
                        </small>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="error-banner">
                        <span class="error-icon">⚠️</span>
                        <span>@ErrorMessage</span>
                    </div>
                }

                @if (ExecutionSuccessResult is not null)
                {
                    <div class="success-banner">
                        <span class="success-icon">✅</span>
                        <div>
                            <strong>Ação executada com sucesso!</strong>
                            <p>@ExecutionSuccessResult.Message</p>
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer">
                @if (ExecutionSuccessResult is not null)
                {
                    <button type="button" class="btn btn-primary" @onclick="HandleDone">Concluir</button>
                }
                else
                {
                    <button type="button" class="btn btn-secondary" @onclick="Close" disabled="@IsSubmitting">Cancelar</button>
                    <button type="button" class="btn btn-remediate" disabled="@(!CanSubmit || IsSubmitting)" @onclick="HandleExecute">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-small"></span>
                            <span>Executando ação...</span>
                        }
                        else
                        {
                            <span>Executar Remediação</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public Guid TenantId { get; set; }
    [Parameter] public string TenantName { get; set; } = string.Empty;
    [Parameter] public string ActionType { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<RemediationExecutionResultDto> OnRemediationExecuted { get; set; }

    private string SupportTicket { get; set; } = string.Empty;
    private string Justification { get; set; } = string.Empty;
    private bool IsSubmitting { get; set; }
    private string? ErrorMessage { get; set; }
    private RemediationExecutionResultDto? ExecutionSuccessResult { get; set; }

    private bool IsTicketValid => !string.IsNullOrWhiteSpace(SupportTicket) && SupportTicket.Trim().Length >= 3;
    private bool IsJustificationValid => !string.IsNullOrWhiteSpace(Justification) && Justification.Trim().Length >= 10;
    private bool CanSubmit => IsTicketValid && IsJustificationValid;

    protected override void OnParametersSet()
    {
        if (IsOpen && ExecutionSuccessResult is null)
        {
            ErrorMessage = null;
        }
    }

    private string GetActionTitle() => ActionType switch
    {
        nameof(RemediationActionType.RequestClientCacheReset) => "Resetar Cache de Dispositivos Móveis / PWA",
        nameof(RemediationActionType.EvictTenantCache) => "Invalidar Cache em Memória do Tenant",
        nameof(RemediationActionType.ReconcileEntitlements) => "Reconciliar Direitos e Quotas de Módulos",
        nameof(RemediationActionType.RetryFailedQueueItems) => "Reprocessar Mensagens e Filas com Falha",
        nameof(RemediationActionType.ResetTransientLocks) => "Liberar Bloqueios Transitórios e Locks",
        _ => "Ação Remediativa de Suporte"
    };

    private string GetActionDescription() => ActionType switch
    {
        nameof(RemediationActionType.RequestClientCacheReset) =>
            "Envia sinal imediato para os dispositivos móveis e navegadores da fazenda renovarem o estado offline na próxima sincronização.",
        nameof(RemediationActionType.EvictTenantCache) =>
            "Limpa dados cacheados na camada de aplicação (permissões, claims, resolução de tenant) sem indisponibilidade.",
        nameof(RemediationActionType.ReconcileEntitlements) =>
            "Reavalia módulos ativos, recalcula cotas do rebanho e regulariza claims de licença do produtor.",
        nameof(RemediationActionType.RetryFailedQueueItems) =>
            "Agenda reprocessamento seguro de eventos assíncronos que falharam por indisponibilidade transitória.",
        nameof(RemediationActionType.ResetTransientLocks) =>
            "Remove travas de concorrência ou bloqueios de tentativas excedidas mantendo a integridade cadastral.",
        _ => "Executa operação padronizada de saneamento técnico assistido."
    };

    private async Task HandleExecute()
    {
        if (!CanSubmit || IsSubmitting) return;

        IsSubmitting = true;
        ErrorMessage = null;

        try
        {
            var request = new ExecuteRemediationRequest(ActionType, SupportTicket.Trim(), Justification.Trim());
            var result = await ApiClient.ExecuteRemediationAsync(TenantId, request);

            if (result.IsSuccess && result.Result is not null)
            {
                ExecutionSuccessResult = result.Result;
                await OnRemediationExecuted.InvokeAsync(result.Result);
            }
            else
            {
                ErrorMessage = result.ErrorMessage ?? "Falha ao executar ação de remediação.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro inesperado: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task HandleDone()
    {
        ExecutionSuccessResult = null;
        SupportTicket = string.Empty;
        Justification = string.Empty;
        await OnClose.InvokeAsync();
    }

    private async Task Close()
    {
        ExecutionSuccessResult = null;
        ErrorMessage = null;
        await OnClose.InvokeAsync();
    }
}

<style>
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.75);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        animation: fadeIn 0.2s ease-out;
    }

    .modal-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 1rem;
        width: 100%;
        max-width: 580px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        overflow: hidden;
        animation: slideUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 1.25rem 1.5rem;
        background: #0f172a;
        border-bottom: 1px solid #334155;
    }

    .security-badge {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #38bdf8;
        background: rgba(56, 189, 248, 0.12);
        padding: 0.2rem 0.5rem;
        border-radius: 9999px;
        margin-bottom: 0.35rem;
        border: 1px solid rgba(56, 189, 248, 0.25);
    }

    .modal-header-title h3 {
        margin: 0;
        font-size: 1.15rem;
        color: #f1f5f9;
        font-weight: 600;
    }

    .close-btn {
        background: transparent;
        border: none;
        color: #94a3b8;
        font-size: 1.25rem;
        cursor: pointer;
        padding: 0.25rem 0.5rem;
        border-radius: 0.375rem;
        transition: all 0.2s;
    }

    .close-btn:hover {
        background: #334155;
        color: #ffffff;
    }

    .modal-body {
        padding: 1.25rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
        max-height: 70vh;
        overflow-y: auto;
    }

    .tenant-summary-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.85rem 1rem;
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 0.5rem;
    }

    .tenant-info {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .tenant-label {
        font-size: 0.7rem;
        color: #64748b;
        text-transform: uppercase;
        font-weight: 600;
    }

    .tenant-name {
        font-size: 1rem;
        color: #f8fafc;
    }

    .tenant-meta code {
        font-size: 0.75rem;
        color: #94a3b8;
    }

    .action-type-pill code {
        background: rgba(14, 165, 233, 0.15);
        color: #38bdf8;
        padding: 0.3rem 0.6rem;
        border-radius: 0.375rem;
        font-size: 0.75rem;
        font-weight: 600;
        border: 1px solid rgba(56, 189, 248, 0.3);
    }

    .safeguard-alert-box {
        display: flex;
        gap: 0.75rem;
        padding: 0.85rem 1rem;
        background: rgba(56, 189, 248, 0.08);
        border: 1px solid rgba(56, 189, 248, 0.25);
        border-radius: 0.5rem;
        color: #e2e8f0;
    }

    .safeguard-icon {
        font-size: 1.3rem;
        line-height: 1;
    }

    .safeguard-text strong {
        font-size: 0.85rem;
        color: #38bdf8;
        display: block;
        margin-bottom: 0.2rem;
    }

    .safeguard-text p {
        margin: 0;
        font-size: 0.8rem;
        color: #cbd5e1;
        line-height: 1.35;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .form-group label {
        font-size: 0.85rem;
        font-weight: 500;
        color: #cbd5e1;
    }

    .required {
        color: #f87171;
    }

    .form-control {
        width: 100%;
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 0.5rem;
        padding: 0.6rem 0.75rem;
        color: #f8fafc;
        font-size: 0.875rem;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-control:focus {
        outline: none;
        border-color: #38bdf8;
        box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.25);
    }

    .hint-text {
        font-size: 0.75rem;
        color: #64748b;
    }

    .justification-footer {
        display: flex;
        justify-content: flex-end;
    }

    .char-count {
        font-size: 0.75rem;
    }

    .text-success { color: #4ade80 !important; }
    .text-muted { color: #64748b !important; }

    .error-banner {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        background: rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 0.5rem;
        color: #fca5a5;
        font-size: 0.85rem;
    }

    .success-banner {
        display: flex;
        gap: 0.75rem;
        padding: 0.85rem 1rem;
        background: rgba(34, 197, 94, 0.15);
        border: 1px solid rgba(34, 197, 94, 0.3);
        border-radius: 0.5rem;
        color: #86efac;
    }

    .success-banner p {
        margin: 0.25rem 0 0 0;
        font-size: 0.85rem;
        color: #bbf7d0;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        padding: 1rem 1.5rem;
        background: #0f172a;
        border-top: 1px solid #334155;
    }

    .btn {
        padding: 0.6rem 1.2rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-secondary {
        background: #334155;
        color: #cbd5e1;
    }

    .btn-secondary:hover:not(:disabled) {
        background: #475569;
        color: #ffffff;
    }

    .btn-primary {
        background: #0284c7;
        color: #ffffff;
    }

    .btn-primary:hover:not(:disabled) {
        background: #0369a1;
    }

    .btn-remediate {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        color: #ffffff;
    }

    .btn-remediate:hover:not(:disabled) {
        background: linear-gradient(135deg, #0369a1, #1d4ed8);
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.35);
    }

    .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .spinner-small {
        width: 1rem;
        height: 1rem;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes slideUp {
        from { transform: translateY(20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>
