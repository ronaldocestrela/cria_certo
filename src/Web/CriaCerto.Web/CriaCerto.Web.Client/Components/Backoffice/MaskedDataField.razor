@using CriaCerto.Modules.Backoffice.Application.Security
@using CriaCerto.Modules.Backoffice.Application.Features.Compliance.Dtos
@using CriaCerto.Web.Client.Services
@inject IBackofficePermissionService PermissionService
@inject IBackofficeApiClient ApiClient

<div class="masked-field-wrapper @(IsInline ? "inline" : "")">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="field-label">@Label</span>
    }

    <div class="field-value-container">
        @if (isRevealed)
        {
            <span class="value-text revealed @(IsMonospace ? "code-font" : "")">@currentPlainValue</span>
            <span class="revealed-badge" title="Visualização auditada com carimbo de tempo">
                <span class="audit-dot"></span> Revelado (Auditado)
            </span>
            <button type="button" class="btn-toggle-mask" @onclick="HideValue" title="Ocultar novamente">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                </svg>
            </button>
        }
        else
        {
            <span class="value-text masked @(IsMonospace ? "code-font" : "")">@(string.IsNullOrEmpty(Value) ? "-" : Value)</span>

            @if (canUnmask)
            {
                <button type="button" class="btn-unmask" @onclick="OpenRevealModal" title="Revelar dado original (Requer justificativa para auditoria LGPD)">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <span>Revelar</span>
                </button>
            }
            else
            {
                <span class="protected-badge" title="Dado confidencial protegido conforme diretrizes da LGPD (Art. 6º)">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <span>Protegido</span>
                </span>
            }
        }
    </div>
</div>

<RevealPiiModal
    IsOpen="@isModalOpen"
    EntityType="@EntityType"
    EntityId="@EntityId"
    FieldName="@FieldName"
    Label="@(Label ?? FieldName)"
    OnClose="@(() => isModalOpen = false)"
    OnRevealed="@HandleDataRevealed" />

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public string EntityType { get; set; } = "Tenant";
    [Parameter] public Guid EntityId { get; set; }
    [Parameter] public string FieldName { get; set; } = "CNPJ";
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool IsMonospace { get; set; } = true;
    [Parameter] public bool IsInline { get; set; } = true;

    private bool canUnmask = false;
    private bool isRevealed = false;
    private bool isModalOpen = false;
    private string? currentPlainValue;

    protected override async Task OnInitializedAsync()
    {
        canUnmask = await PermissionService.HasPermissionAsync(BackofficePermissions.ComplianceUnmask);
    }

    private void OpenRevealModal()
    {
        isModalOpen = true;
    }

    private void HandleDataRevealed(RevealedDataResultDto result)
    {
        currentPlainValue = result.PlainValue;
        isRevealed = true;
        isModalOpen = false;
        StateHasChanged();
    }

    private void HideValue()
    {
        isRevealed = false;
        currentPlainValue = null;
    }
}

<style>
    .masked-field-wrapper {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .masked-field-wrapper.inline {
        display: inline-flex;
    }

    .field-label {
        font-size: 0.75rem;
        color: #94a3b8;
        font-weight: 500;
    }

    .field-value-container {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .value-text {
        font-size: 0.85rem;
        color: #f1f5f9;
    }

    .value-text.code-font {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        letter-spacing: -0.02em;
    }

    .value-text.masked {
        color: #94a3b8;
    }

    .value-text.revealed {
        color: #38bdf8;
        font-weight: 600;
    }

    .btn-unmask {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        background: rgba(56, 189, 248, 0.1);
        border: 1px solid rgba(56, 189, 248, 0.3);
        color: #38bdf8;
        padding: 0.15rem 0.45rem;
        border-radius: 4px;
        font-size: 0.7rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-unmask:hover {
        background: rgba(56, 189, 248, 0.2);
        border-color: #38bdf8;
    }

    .btn-toggle-mask {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: none;
        color: #94a3b8;
        padding: 0.15rem;
        border-radius: 4px;
        cursor: pointer;
        transition: color 0.2s ease;
    }

    .btn-toggle-mask:hover {
        color: #f8fafc;
    }

    .revealed-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
        font-size: 0.65rem;
        font-weight: 600;
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .audit-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #f59e0b;
        animation: pulse-dot 2s infinite ease-in-out;
    }

    .protected-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.2rem;
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
        font-size: 0.65rem;
        background: rgba(100, 116, 139, 0.15);
        color: #94a3b8;
        border: 1px solid rgba(100, 116, 139, 0.3);
    }

    @@keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
    }
</style>
