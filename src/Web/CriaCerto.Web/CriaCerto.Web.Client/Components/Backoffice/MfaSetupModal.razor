@using CriaCerto.Modules.Backoffice.Application.Features.AdminUsers.Dtos

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>🔒 Ativação de Autenticação Multi-Fator (MFA)</h3>
                <button class="close-btn" @onclick="Close">✕</button>
            </div>
            <div class="modal-body">
                <p class="mfa-instructions">
                    Digitalize o código QR abaixo com seu aplicativo autenticador (Google Authenticator, Microsoft Authenticator) ou insira a chave secreta manualmente.
                </p>

                <div class="mfa-qr-container">
                    <div class="qr-placeholder">
                        <span class="qr-icon">📱</span>
                        <small>URI: @QrCodeUri</small>
                    </div>
                </div>

                <div class="form-group">
                    <label>Chave Secreta Manual</label>
                    <div class="secret-box">
                        <code>@SecretKey</code>
                    </div>
                </div>

                <div class="form-group">
                    <label>Código de Confirmação (6 dígitos)</label>
                    <input type="text" class="form-control code-input" maxlength="6" @bind="VerificationCode" placeholder="000 000" />
                </div>

                @if (RecoveryCodes != null && RecoveryCodes.Any())
                {
                    <div class="form-group">
                        <label>Códigos de Recuperação (Guarde em local seguro)</label>
                        <div class="recovery-codes-grid">
                            @foreach (var recCode in RecoveryCodes)
                            {
                                <span class="code-badge">@recCode</span>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="Close">Cancelar</button>
                <button class="btn btn-success" @onclick="Confirm">Ativar MFA</button>
            </div>
        </div>
    </div>
}

<style>
    .modal-backdrop {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(15, 23, 42, 0.8); display: flex; align-items: center; justify-content: center; z-index: 1000;
        backdrop-filter: blur(4px);
    }
    .modal-card {
        background: #1e293b; color: #f8fafc; border-radius: 0.75rem; width: 100%; max-width: 480px;
        border: 1px solid #334155; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
    }
    .modal-header { display: flex; justify-content: space-between; align-items: center; padding: 1.25rem; border-bottom: 1px solid #334155; }
    .modal-header h3 { margin: 0; font-size: 1rem; font-weight: 700; color: #f1f5f9; }
    .close-btn { background: none; border: none; color: #94a3b8; font-size: 1.2rem; cursor: pointer; }
    .modal-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem; }
    .mfa-instructions { font-size: 0.85rem; color: #94a3b8; margin: 0; line-height: 1.4; }
    .mfa-qr-container { display: flex; justify-content: center; padding: 0.75rem; background: #0f172a; border-radius: 0.5rem; border: 1px solid #334155; }
    .qr-placeholder { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; color: #38bdf8; font-size: 0.75rem; word-break: break-all; text-align: center; }
    .qr-icon { font-size: 2rem; }
    .secret-box { background: #0f172a; padding: 0.6rem; border-radius: 0.5rem; border: 1px dashed #38bdf8; text-align: center; color: #38bdf8; font-weight: 700; }
    .code-input { text-align: center; font-size: 1.2rem; letter-spacing: 0.3em; font-weight: 700; }
    .recovery-codes-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; }
    .code-badge { background: #0f172a; padding: 0.3rem 0.5rem; border-radius: 0.3rem; font-family: monospace; font-size: 0.8rem; color: #fbbf24; text-align: center; }
    .modal-footer { display: flex; justify-content: flex-end; gap: 0.75rem; padding: 1.25rem; border-top: 1px solid #334155; }
    .btn { padding: 0.5rem 1rem; border-radius: 0.5rem; font-size: 0.85rem; font-weight: 600; border: none; cursor: pointer; }
    .btn-secondary { background: #334155; color: #f8fafc; }
    .btn-success { background: #16a34a; color: #ffffff; }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string SecretKey { get; set; } = string.Empty;
    [Parameter] public string QrCodeUri { get; set; } = string.Empty;
    [Parameter] public IReadOnlyCollection<string>? RecoveryCodes { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnConfirm { get; set; }

    private string VerificationCode { get; set; } = string.Empty;

    private async Task Close() => await OnClose.InvokeAsync();

    private async Task Confirm()
    {
        await OnConfirm.InvokeAsync(VerificationCode);
        await OnClose.InvokeAsync();
    }
}
