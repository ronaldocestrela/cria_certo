@using CriaCerto.Modules.Backoffice.Application.Domain.Entities
@using CriaCerto.Modules.Backoffice.Application.Domain.Enums
@using CriaCerto.Modules.Backoffice.Application.Features.Observability.Dtos
@using CriaCerto.Web.Client.Services
@inject IBackofficeApiClient ApiClient
@inject IToastService ToastService

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="header-title-area">
                    <span class="header-badge">Sandbox de Telemetria</span>
                    <h3>Simulação de Alerta Operacional</h3>
                </div>
                <button class="btn-close" @onclick="Close" aria-label="Fechar">&times;</button>
            </div>

            <div class="modal-body">
                <p class="modal-intro">
                    Este assistente permite disparar anomalias sintéticas para validação dos fluxos de observabilidade,
                    testes de resposta operacional e triagem da equipe técnica.
                </p>

                <div class="form-group">
                    <label class="form-label" for="sim-rule">Regra Operacional Modelo</label>
                    <select id="sim-rule" class="form-select" @onchange="OnRuleChanged">
                        <option value="@BackofficeAlertRules.PolicyBruteForce">Violação de Acesso Consecutiva (@BackofficeAlertRules.PolicyBruteForce)</option>
                        <option value="@BackofficeAlertRules.OffHoursCriticalAction">Ação Crítica Fora de Janela (@BackofficeAlertRules.OffHoursCriticalAction)</option>
                        <option value="@BackofficeAlertRules.ImpersonationBurst">Surto de Impersonação (@BackofficeAlertRules.ImpersonationBurst)</option>
                        <option value="@BackofficeAlertRules.ForensicTamperDetected">Violação Forense de Integridade (@BackofficeAlertRules.ForensicTamperDetected)</option>
                        <option value="@BackofficeAlertRules.SimulatedAlert">Alerta Genérico de Teste (@BackofficeAlertRules.SimulatedAlert)</option>
                    </select>
                </div>

                <div class="form-row">
                    <div class="form-group col">
                        <label class="form-label" for="sim-sev">Severidade</label>
                        <select id="sim-sev" class="form-select" @bind="_severity">
                            <option value="@AlertSeverity.Info">Informativo (Info)</option>
                            <option value="@AlertSeverity.Warning">Atenção (Warning)</option>
                            <option value="@AlertSeverity.Critical">Crítico (Critical)</option>
                        </select>
                    </div>

                    <div class="form-group col">
                        <label class="form-label" for="sim-title">Título do Alerta</label>
                        <input id="sim-title" type="text" class="form-input" @bind="_title" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="sim-desc">Descrição Operacional</label>
                    <textarea id="sim-desc" class="form-textarea" rows="2" @bind="_description"></textarea>
                </div>

                <div class="form-group">
                    <label class="form-label" for="sim-ctx">Metadados de Contexto (JSON Sintético)</label>
                    <textarea id="sim-ctx" class="form-textarea code-font" rows="3" @bind="_contextJson"></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn-secondary" @onclick="Close" disabled="@_isProcessing">Cancelar</button>
                <button class="btn-primary" @onclick="HandleSimulate" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <span class="spinner-small"></span>
                        <span>Disparando...</span>
                    }
                    else
                    {
                        <span>⚡ Disparar Alerta Sintético</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(4, 7, 13, 0.85);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
        padding: 1.5rem;
    }

    .modal-content {
        background: #0f172a;
        border: 1px solid #1e293b;
        border-radius: 1rem;
        width: 100%;
        max-width: 650px;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
        animation: modalFadeIn 0.2s ease-out;
    }

    @@keyframes modalFadeIn {
        from { opacity: 0; transform: scale(0.97); }
        to { opacity: 1; transform: scale(1); }
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 1.5rem;
        background: #131d33;
        border-bottom: 1px solid #1e293b;
    }

    .header-title-area {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .header-badge {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #38bdf8;
        letter-spacing: 0.05em;
    }

    .header-title-area h3 {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 700;
        color: #f8fafc;
    }

    .btn-close {
        background: transparent;
        border: none;
        color: #94a3b8;
        font-size: 1.75rem;
        cursor: pointer;
        line-height: 1;
        transition: color 0.15s;
    }

    .btn-close:hover {
        color: #f8fafc;
    }

    .modal-body {
        padding: 1.5rem;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .modal-intro {
        margin: 0 0 0.5rem 0;
        font-size: 0.85rem;
        color: #94a3b8;
        line-height: 1.4;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .form-row {
        display: flex;
        gap: 1rem;
    }

    .form-row .col {
        flex: 1;
    }

    .form-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #cbd5e1;
    }

    .form-input, .form-select, .form-textarea {
        background: #090d16;
        border: 1px solid #334155;
        border-radius: 0.5rem;
        color: #f8fafc;
        padding: 0.55rem 0.75rem;
        font-size: 0.85rem;
        font-family: inherit;
        transition: border-color 0.15s;
    }

    .form-input:focus, .form-select:focus, .form-textarea:focus {
        outline: none;
        border-color: #38bdf8;
    }

    .code-font {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
    }

    .modal-footer {
        padding: 1rem 1.5rem;
        background: #131d33;
        border-top: 1px solid #1e293b;
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
    }

    .btn-secondary {
        background: #1e293b;
        color: #cbd5e1;
        border: 1px solid #334155;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.15s;
    }

    .btn-secondary:hover:not(:disabled) {
        background: #334155;
        color: #f8fafc;
    }

    .btn-primary {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        color: #ffffff;
        border: none;
        padding: 0.5rem 1.1rem;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: opacity 0.15s;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .btn-primary:hover:not(:disabled) {
        opacity: 0.9;
    }

    .btn-primary:disabled, .btn-secondary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .spinner-small {
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnAlertCreated { get; set; }

    private string _ruleCode = BackofficeAlertRules.PolicyBruteForce;
    private AlertSeverity _severity = AlertSeverity.Warning;
    private string _title = BackofficeAlertRules.GetDefaultTitle(BackofficeAlertRules.PolicyBruteForce);
    private string _description = "Simulação sintética de violações consecutivas de permissão no backoffice.";
    private string _contextJson = "{\"target\":\"192.168.1.50\",\"violationsCount\":6,\"simulation\":true}";
    private bool _isProcessing = false;

    protected override void OnInitialized()
    {
        ResetForm();
    }

    private void ResetForm()
    {
        _ruleCode = BackofficeAlertRules.PolicyBruteForce;
        _severity = AlertSeverity.Warning;
        _title = BackofficeAlertRules.GetDefaultTitle(BackofficeAlertRules.PolicyBruteForce);
        _description = "Simulação sintética de violações consecutivas de permissão no backoffice.";
        _contextJson = "{\"target\":\"192.168.1.50\",\"violationsCount\":6,\"simulation\":true}";
    }

    private void OnRuleChanged(ChangeEventArgs e)
    {
        _ruleCode = e.Value?.ToString() ?? BackofficeAlertRules.PolicyBruteForce;
        _severity = BackofficeAlertRules.GetDefaultSeverity(_ruleCode);
        _title = BackofficeAlertRules.GetDefaultTitle(_ruleCode);

        _description = _ruleCode switch
        {
            BackofficeAlertRules.PolicyBruteForce => "Simulação sintética de violações consecutivas de permissão no backoffice.",
            BackofficeAlertRules.OffHoursCriticalAction => "Ação administrativa crítica acionada às 23:45 BRT sem autorização prévia.",
            BackofficeAlertRules.ImpersonationBurst => "Operador iniciou 4 sessões simultâneas de impersonação em menos de 10 minutos.",
            BackofficeAlertRules.ForensicTamperDetected => "Simulação de quebra de hash SHA-256 no bloco #128 da trilha de auditoria.",
            _ => "Alerta sintético disparado para fins de validação do subsistema de observabilidade."
        };

        _contextJson = $"{{\"rule\":\"{_ruleCode}\",\"simulation\":true,\"timestamp\":\"{DateTime.UtcNow:s}\"}}";
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleSimulate()
    {
        if (string.IsNullOrWhiteSpace(_title))
        {
            ToastService.ShowWarning("O título do alerta é obrigatório.");
            return;
        }

        _isProcessing = true;

        try
        {
            var request = new SimulateAlertRequest(
                RuleCode: _ruleCode,
                Severity: _severity,
                Title: _title.Trim(),
                Description: _description.Trim(),
                ContextJson: _contextJson.Trim());

            var alert = await ApiClient.SimulateAlertAsync(request);
            if (alert != null)
            {
                ToastService.ShowSuccess($"Alerta simulado com sucesso: '{alert.Title}'");
                await OnAlertCreated.InvokeAsync();
                await Close();
            }
            else
            {
                ToastService.ShowError("Falha ao disparar o alerta simulado.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Erro na simulação: {ex.Message}");
        }
        finally
        {
            _isProcessing = false;
        }
    }
}
