@using CriaCerto.Modules.Backoffice.Application.Features.Tenants.Dtos
@using CriaCerto.Modules.Backoffice.Application.Security
@using CriaCerto.Web.Client.Services

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal-card modal-wide" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(IsEdit ? "Editar Tenant" : "Novo Tenant")</h3>
                <button class="close-btn" @onclick="Close">✕</button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #fca5a5; padding: 0.75rem 1rem; border-radius: 0.5rem; font-size: 0.85rem; margin-bottom: 0.5rem;">
                        ⚠️ @ErrorMessage
                    </div>
                }
                <div class="form-row">
                    <div class="form-group">
                        <label>Nome da Fazenda *</label>
                        <input type="text" class="form-control" @bind="_name" />
                    </div>
                    <div class="form-group">
                        <label>Razão Social</label>
                        <input type="text" class="form-control" @bind="_legalName" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>CNPJ/CPF *</label>
                        @if (IsEdit)
                        {
                            <input type="text" class="form-control" value="@_cnpj" readonly title="Documento fiscal imutável na edição cadastral básica." style="opacity: 0.75; cursor: not-allowed;" />
                        }
                        else
                        {
                            <input type="text" class="form-control" @bind="_cnpj" />
                        }
                    </div>
                    <div class="form-group">
                        <label>Identificador Externo</label>
                        <input type="text" class="form-control" @bind="_externalIdentifier" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>UF *</label>
                        <input type="text" class="form-control" maxlength="2" @bind="_state" />
                    </div>
                    <div class="form-group">
                        <label>Município *</label>
                        <input type="text" class="form-control" @bind="_city" />
                    </div>
                    <div class="form-group">
                        <label>Inscrição Estadual</label>
                        <input type="text" class="form-control" @bind="_stateRegistration" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Área (ha)</label>
                        <input type="number" class="form-control" @bind="_areaInHectares" />
                    </div>
                    <div class="form-group">
                        <label>Capacidade (cabeças) *</label>
                        <input type="number" class="form-control" @bind="_capacity" />
                    </div>
                    <div class="form-group">
                        <label>Tipo Produtivo</label>
                        <input type="text" class="form-control" @bind="_type" />
                    </div>
                    <div class="form-group">
                        <label>Renovação do Plano</label>
                        <input type="date" class="form-control" value="@_renewalDateString" @onchange="HandleRenewalDateChange" />
                    </div>
                </div>
                @if (!IsEdit)
                {
                    <div class="form-row">
                        <div class="form-group">
                            <label>Plano *</label>
                            <select class="form-control" @bind="_subscribedPlan">
                                <option value="Starter">Starter</option>
                                <option value="Pro">Pro</option>
                                <option value="Enterprise">Enterprise</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>E-mail Owner Produtor (opcional)</label>
                            <input type="email" class="form-control" @bind="_ownerUserEmail" placeholder="produtor@fazenda.com.br" />
                        </div>
                    </div>
                }
                <div class="form-section-title">Owners Operacionais</div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Owner Técnico</label>
                        <input type="text" class="form-control" @bind="_technicalOwnerName" />
                    </div>
                    <div class="form-group">
                        <label>E-mail Técnico</label>
                        <input type="email" class="form-control" @bind="_technicalOwnerEmail" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Owner Comercial</label>
                        <input type="text" class="form-control" @bind="_commercialOwnerName" />
                    </div>
                    <div class="form-group">
                        <label>E-mail Comercial</label>
                        <input type="email" class="form-control" @bind="_commercialOwnerEmail" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="Close">Cancelar</button>
                <button class="btn btn-primary" @onclick="Save">Salvar Tenant</button>
            </div>
        </div>
    </div>
}

<style>
    .modal-backdrop { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.75); display: flex; align-items: center; justify-content: center; z-index: 1000; backdrop-filter: blur(4px); }
    .modal-card { background: #1e293b; color: #f8fafc; border-radius: 0.75rem; width: 100%; max-width: 500px; border: 1px solid #334155; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5); }
    .modal-wide { max-width: 720px; }
    .modal-header { display: flex; justify-content: space-between; align-items: center; padding: 1.25rem; border-bottom: 1px solid #334155; }
    .modal-header h3 { margin: 0; font-size: 1.1rem; font-weight: 700; }
    .close-btn { background: none; border: none; color: #94a3b8; font-size: 1.2rem; cursor: pointer; }
    .modal-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem; max-height: 70vh; overflow-y: auto; }
    .form-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
    .form-group label { font-size: 0.85rem; font-weight: 600; color: #cbd5e1; }
    .form-control { background: #0f172a; border: 1px solid #334155; color: #f8fafc; padding: 0.6rem 0.8rem; border-radius: 0.5rem; font-size: 0.9rem; }
    .form-section-title { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: #38bdf8; margin-top: 0.5rem; }
    .modal-footer { display: flex; justify-content: flex-end; gap: 0.75rem; padding: 1.25rem; border-top: 1px solid #334155; }
    .btn { padding: 0.5rem 1rem; border-radius: 0.5rem; font-size: 0.85rem; font-weight: 600; border: none; cursor: pointer; }
    .btn-secondary { background: #334155; color: #f8fafc; }
    .btn-primary { background: #0284c7; color: #ffffff; }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public Guid TenantId { get; set; }
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string? LegalName { get; set; }
    [Parameter] public string CNPJ { get; set; } = string.Empty;
    [Parameter] public string? ExternalIdentifier { get; set; }
    [Parameter] public string State { get; set; } = string.Empty;
    [Parameter] public string City { get; set; } = string.Empty;
    [Parameter] public string StateRegistration { get; set; } = string.Empty;
    [Parameter] public decimal AreaInHectares { get; set; }
    [Parameter] public int Capacity { get; set; } = 500;
    [Parameter] public string Type { get; set; } = "Pecuária de Corte e Cria";
    [Parameter] public string SubscribedPlan { get; set; } = "Starter";
    [Parameter] public string? TechnicalOwnerName { get; set; }
    [Parameter] public string? TechnicalOwnerEmail { get; set; }
    [Parameter] public string? CommercialOwnerName { get; set; }
    [Parameter] public string? CommercialOwnerEmail { get; set; }
    [Parameter] public DateTime? CurrentPeriodEnd { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<TenantFormSaveModel> OnSave { get; set; }

    private string _name = string.Empty;
    private string? _legalName;
    private string _cnpj = string.Empty;
    private string? _externalIdentifier;
    private string _state = string.Empty;
    private string _city = string.Empty;
    private string _stateRegistration = string.Empty;
    private decimal _areaInHectares;
    private int _capacity = 500;
    private string _type = "Pecuária de Corte e Cria";
    private string _subscribedPlan = "Starter";
    private string? _technicalOwnerName;
    private string? _technicalOwnerEmail;
    private string? _commercialOwnerName;
    private string? _commercialOwnerEmail;
    private string? _ownerUserEmail;
    private DateTime? _currentPeriodEnd;
    private string? _renewalDateString;

    protected override void OnParametersSet()
    {
        _name = Name;
        _legalName = LegalName;
        _cnpj = CNPJ;
        _externalIdentifier = ExternalIdentifier;
        _state = State;
        _city = City;
        _stateRegistration = StateRegistration;
        _areaInHectares = AreaInHectares;
        _capacity = Capacity;
        _type = Type;
        _subscribedPlan = SubscribedPlan;
        _technicalOwnerName = TechnicalOwnerName;
        _technicalOwnerEmail = TechnicalOwnerEmail;
        _commercialOwnerName = CommercialOwnerName;
        _commercialOwnerEmail = CommercialOwnerEmail;
        _currentPeriodEnd = CurrentPeriodEnd;
        _renewalDateString = CurrentPeriodEnd.HasValue
            ? CurrentPeriodEnd.Value.ToLocalTime().ToString("yyyy-MM-dd")
            : null;
    }

    private void HandleRenewalDateChange(ChangeEventArgs e)
    {
        var str = e.Value?.ToString();
        _renewalDateString = str;
        if (!string.IsNullOrWhiteSpace(str) && DateTime.TryParse(str, out var dt))
        {
            var localDateTime = DateTime.SpecifyKind(dt.Date, DateTimeKind.Local);
            _currentPeriodEnd = localDateTime.ToUniversalTime();
        }
        else
        {
            _currentPeriodEnd = null;
        }
    }

    private async Task Close() => await OnClose.InvokeAsync();

    private async Task Save()
    {
        await OnSave.InvokeAsync(new TenantFormSaveModel(
            TenantId, _name, _legalName, _cnpj, _externalIdentifier, _state, _city,
            _stateRegistration, _areaInHectares, _capacity, _type, _subscribedPlan,
            _technicalOwnerName, _technicalOwnerEmail, _commercialOwnerName, _commercialOwnerEmail,
            _ownerUserEmail, _currentPeriodEnd));
    }

    public sealed record TenantFormSaveModel(
        Guid TenantId,
        string Name,
        string? LegalName,
        string CNPJ,
        string? ExternalIdentifier,
        string State,
        string City,
        string StateRegistration,
        decimal AreaInHectares,
        int Capacity,
        string Type,
        string SubscribedPlan,
        string? TechnicalOwnerName,
        string? TechnicalOwnerEmail,
        string? CommercialOwnerName,
        string? CommercialOwnerEmail,
        string? OwnerUserEmail,
        DateTime? CurrentPeriodEnd = null
    );
}
