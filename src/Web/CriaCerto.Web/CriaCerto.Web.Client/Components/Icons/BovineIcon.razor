@* 
    Componente vetorial de alta definição para representação de bovinos (touro / vaca / matriz).
    Projetado para substituir ícones genéricos de animais de estimação (pets) mantendo compatibilidade
    com cores utilitárias (currentColor) e dimensionamento flexível.
*@

<svg xmlns="http://www.w3.org/2000/svg"
     viewBox="0 0 24 24"
     width="@Size"
     height="@Size"
     fill="none"
     stroke="currentColor"
     stroke-width="@StrokeWidth"
     stroke-linecap="round"
     stroke-linejoin="round"
     class="@Class"
     style="@Style"
     aria-hidden="true">
    <!-- Chifres Bovinos curvados para cima -->
    <path d="M7 8C5.2 4.5 3.2 3.2 1.5 3.5c.2 2.5 1.8 5 4.5 5.5" />
    <path d="M17 8c1.8-3.5 3.8-4.8 5.5-4.5-.2 2.5-1.8 5-4.5 5.5" />

    <!-- Orelhas Bovinas caídas/laterais -->
    <path d="M5.5 10.5C3.2 10.2 1.5 11.2 1.5 12.8c1.8 1 3.8.3 4.8-1.1" />
    <path d="M18.5 10.5c2.3-.3 4 .7 4 2.3-1.8 1-3.8.3-4.8-1.1" />

    <!-- Testa e Contorno da Face -->
    <path d="M7 8.5h10" />
    <path d="M6.5 9.5l1.2 5h8.6l1.2-5" />

    <!-- Focinho / Muzzle Largo de Bovino -->
    <path d="M7.5 14.5h9v2.5c0 2.2-1.8 3.8-4.5 3.8s-4.5-1.6-4.5-3.8v-2.5z" />

    <!-- Narinas -->
    <circle cx="10" cy="17.2" r="0.75" fill="currentColor" stroke="none" />
    <circle cx="14" cy="17.2" r="0.75" fill="currentColor" stroke="none" />

    <!-- Olhos -->
    <circle cx="9.5" cy="12" r="0.8" fill="currentColor" stroke="none" />
    <circle cx="14.5" cy="12" r="0.8" fill="currentColor" stroke="none" />
</svg>

@code {
    [Parameter]
    public int Size { get; set; } = 24;

    [Parameter]
    public double StrokeWidth { get; set; } = 1.8;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Style { get; set; }
}
