@inject NavigationManager Navigation

<div class="trial-expired-lockout-container font-headline" style="max-width: 840px; margin: 2rem auto; padding: 0 1rem;">
    <div style="background-color: white; border: 1px solid var(--cc-border); border-radius: 16px; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04); position: relative;">
        
        <!-- Top decorative warning accent bar -->
        <div style="height: 6px; background: linear-gradient(90deg, #c5430f, #e65100, var(--cc-primary));"></div>

        <div style="padding: 3rem 2.5rem; display: flex; flex-direction: column; align-items: center; text-align: center;">
            
            <!-- Icon Badge Stack -->
            <div style="position: relative; margin-bottom: 1.5rem;">
                <div style="width: 88px; height: 88px; border-radius: 50%; background-color: #fff7ed; border: 2px solid #fed7aa; display: flex; align-items: center; justify-content: center;">
                    <span class="material-symbols-outlined text-[44px]" style="color: #ea580c;">timer_off</span>
                </div>
                <div style="position: absolute; bottom: -2px; right: -2px; width: 34px; height: 34px; border-radius: 50%; background-color: #ea580c; border: 2px solid white; display: flex; align-items: center; justify-content: center; color: white;">
                    <span class="material-symbols-outlined text-[18px]">lock</span>
                </div>
            </div>

            <!-- Title & Status Badge -->
            <div style="display: inline-flex; align-items: center; gap: 0.5rem; background-color: #ffedd5; color: #9a3412; padding: 0.4rem 1.25rem; border-radius: 99px; font-size: 13px; font-weight: 700; margin-bottom: 1rem;" class="font-mono">
                <span class="material-symbols-outlined text-[16px]">schedule</span>
                PERÍODO DE TESTES EXPIRADO
            </div>

            <h2 class="font-headline text-[30px] font-bold" style="color: var(--cc-ink); margin: 0 0 0.75rem 0; letter-spacing: -0.02em; line-height: 1.2;">
                Seu teste gratuito de 30 dias terminou
            </h2>

            <p style="color: var(--cc-ink-muted); font-size: 16px; max-width: 620px; margin: 0 0 2rem 0; line-height: 1.6;">
                O período de avaliação da sua fazenda chegou ao fim. Fique tranquilo: 
                <strong>todos os seus dados, manejos, pesagens e rebanho continuam salvos com segurança</strong>. 
                Regularize sua assinatura para desbloquear imediatamente o acesso operacional completo.
            </p>

            <!-- Bento Highlights Cards -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; width: 100%; margin-bottom: 2.5rem;">
                <div style="background-color: var(--cc-canvas); border: 1px solid var(--cc-border); border-radius: 12px; padding: 1.25rem; text-align: left;">
                    <div style="width: 36px; height: 36px; border-radius: 8px; background-color: #ecfdf5; color: #059669; display: flex; align-items: center; justify-content: center; margin-bottom: 0.75rem;">
                        <span class="material-symbols-outlined text-[20px]">shield</span>
                    </div>
                    <h4 class="font-mono text-[13px] font-bold" style="margin: 0 0 0.25rem 0; color: var(--cc-ink); text-transform: uppercase;">Dados Protegidos</h4>
                    <p style="margin: 0; font-size: 12px; color: var(--cc-ink-muted); line-height: 1.4;">Seu histórico genealógico e de pesagens está intacto e pronto para uso.</p>
                </div>

                <div style="background-color: var(--cc-canvas); border: 1px solid var(--cc-border); border-radius: 12px; padding: 1.25rem; text-align: left;">
                    <div style="width: 36px; height: 36px; border-radius: 8px; background-color: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; margin-bottom: 0.75rem;">
                        <span class="material-symbols-outlined text-[20px]">flash_on</span>
                    </div>
                    <h4 class="font-mono text-[13px] font-bold" style="margin: 0 0 0.25rem 0; color: var(--cc-ink); text-transform: uppercase;">Ativação Instantânea</h4>
                    <p style="margin: 0; font-size: 12px; color: var(--cc-ink-muted); line-height: 1.4;">Liberação automática do curral e mangueiro assim que o pagamento for aprovado.</p>
                </div>

                <div style="background-color: var(--cc-canvas); border: 1px solid var(--cc-border); border-radius: 12px; padding: 1.25rem; text-align: left;">
                    <div style="width: 36px; height: 36px; border-radius: 8px; background-color: #f5f3ff; color: #7c3aed; display: flex; align-items: center; justify-content: center; margin-bottom: 0.75rem;">
                        <span class="material-symbols-outlined text-[20px]">payments</span>
                    </div>
                    <h4 class="font-mono text-[13px] font-bold" style="margin: 0 0 0.25rem 0; color: var(--cc-ink); text-transform: uppercase;">Checkout Stripe</h4>
                    <p style="margin: 0; font-size: 12px; color: var(--cc-ink-muted); line-height: 1.4;">Pagamento 100% seguro via cartão de crédito com cancelamento a qualquer momento.</p>
                </div>
            </div>

            <!-- Call to Actions -->
            <div style="display: flex; flex-direction: column; sm-flex-direction: row; gap: 1rem; justify-content: center; width: 100%;">
                <button class="pressed-effect" @onclick="GoToSubscription"
                        style="padding: 0.95rem 2.25rem; background-color: var(--cc-primary); color: white; border: none; border-radius: 10px; font-weight: 700; font-size: 15px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.6rem; box-shadow: 0 4px 12px rgba(0, 102, 51, 0.25);">
                    <span class="material-symbols-outlined text-[22px]">rocket_launch</span>
                    <span>Regularizar Assinatura Agora</span>
                </button>
                <button class="pressed-effect" @onclick="ContactSupport"
                        style="padding: 0.95rem 1.75rem; background: white; border: 1px solid var(--cc-border); color: var(--cc-ink); border-radius: 10px; font-weight: 600; font-size: 14px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                    <span class="material-symbols-outlined text-[20px]">headset_mic</span>
                    <span>Falar com um Consultor</span>
                </button>
            </div>

        </div>

        <!-- Footer Banner Guarantee -->
        <div style="background-color: var(--cc-canvas); border-top: 1px solid var(--cc-border); padding: 1.25rem; display: flex; align-items: center; justify-content: center; gap: 1.5rem; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 12px; color: var(--cc-ink-muted);" class="font-mono">
                <span class="material-symbols-outlined text-[18px]" style="color: var(--cc-primary);">lock</span>
                Criptografia Ponta a Ponta
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 12px; color: var(--cc-ink-muted);" class="font-mono">
                <span class="material-symbols-outlined text-[18px]" style="color: var(--cc-primary);">verified</span>
                Sem Multa de Fidelidade
            </div>
        </div>

    </div>
</div>

@code {
    [Parameter]
    public string? Reason { get; set; }

    private void GoToSubscription()
    {
        Navigation.NavigateTo("/settings/subscription");
    }

    private void ContactSupport()
    {
        Navigation.NavigateTo("/settings/organization");
    }
}
