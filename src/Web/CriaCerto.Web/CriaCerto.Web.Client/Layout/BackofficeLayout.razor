@inherits LayoutComponentBase
@using CriaCerto.Web.Client.Components.Backoffice
@using CriaCerto.Web.Client.Services
@inject NavigationManager Navigation
@inject Auth.CustomAuthStateProvider AuthStateProvider
@inject IBackofficePermissionService PermissionService

@if (_isCheckingAuth)
{
    <div class="auth-loading-screen">
        <div class="auth-spinner"></div>
        <p>Verificando credenciais de acesso ao Backoffice...</p>
    </div>
}
else
{
    <ImpersonationBanner />
    <div class="backoffice-shell">
        <aside class="backoffice-sidebar">
            <BackofficeNavMenu />
        </aside>

        <main class="backoffice-main">
            <header class="backoffice-header">
                <div class="header-left">
                    <span class="header-tag">Módulo Administrativo Global</span>
                    <h1 class="header-title">Governança SaaS & Operações</h1>
                </div>

                <div class="header-right">
                    <div class="admin-profile-badge">
                        <span class="status-indicator"></span>
                        <div class="admin-details">
                            <span class="admin-name">@_adminName</span>
                            <span class="admin-role">@_adminRole</span>
                        </div>
                    </div>
                    <button class="btn-logout" @onclick="HandleLogout" title="Encerrar Sessão Administrativa">
                        <span>🚪 Sair</span>
                    </button>
                </div>
            </header>

            <section class="backoffice-content">
                <CustomErrorBoundary>
                    @Body
                </CustomErrorBoundary>
            </section>
        </main>
    </div>
}

<style>
    .auth-loading-screen {
        min-height: 100vh;
        background-color: #090d16;
        color: #f8fafc;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        font-family: system-ui, sans-serif;
    }

    .auth-spinner {
        width: 32px;
        height: 32px;
        border: 3px solid rgba(56, 189, 248, 0.2);
        border-top-color: #38bdf8;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .backoffice-shell {
        display: grid;
        grid-template-columns: 260px 1fr;
        min-height: 100vh;
        background-color: #090d16;
        color: #f8fafc;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }

    .backoffice-sidebar {
        border-right: 1px solid #1e293b;
        background: #0f172a;
    }

    .backoffice-main {
        display: flex;
        flex-direction: column;
        overflow-y: auto;
    }

    .backoffice-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 2rem;
        background: #0f172a;
        border-bottom: 1px solid #1e293b;
    }

    .header-tag {
        font-size: 0.75rem;
        font-weight: 600;
        color: #38bdf8;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .header-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0.2rem 0 0 0;
        color: #ffffff;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .admin-profile-badge {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.4rem 0.9rem;
        background: #1e293b;
        border-radius: 0.75rem;
        border: 1px solid #334155;
    }

    .admin-details {
        display: flex;
        flex-direction: column;
    }

    .admin-name {
        font-size: 0.85rem;
        font-weight: 700;
        color: #f8fafc;
    }

    .admin-role {
        font-size: 0.7rem;
        color: #38bdf8;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-indicator {
        width: 8px;
        height: 8px;
        background-color: #22c55e;
        border-radius: 50%;
        box-shadow: 0 0 8px #22c55e;
    }

    .btn-logout {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #fca5a5;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 0.45rem 0.85rem;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-logout:hover {
        background: rgba(239, 68, 68, 0.25);
        color: #ffffff;
    }

    .backoffice-content {
        padding: 2rem;
        flex: 1;
    }

    @@media (max-width: 768px) {
        .backoffice-shell {
            grid-template-columns: 1fr;
        }
        .backoffice-sidebar {
            display: none;
        }
    }
</style>

@code {
    private bool _isCheckingAuth = true;
    private string _adminName = "Administrador";
    private string _adminRole = "PlatformOwner";

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthenticationAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await CheckAuthenticationAsync();
    }

    private async Task CheckAuthenticationAsync()
    {
        _isCheckingAuth = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            var currentUri = Navigation.Uri.ToLower();
            if (currentUri.Contains("/backoffice/login"))
            {
                _isCheckingAuth = false;
                return;
            }

            if (user.Identity == null || !user.Identity.IsAuthenticated)
            {
                Navigation.NavigateTo("/backoffice/login");
                return;
            }

            _adminName = user.Identity.Name ?? "Administrador Mestre";
            _adminRole = await PermissionService.GetCurrentUserRoleAsync();
            _isCheckingAuth = false;
        }
        catch
        {
            Navigation.NavigateTo("/backoffice/login");
        }
    }

    private async Task HandleLogout()
    {
        await AuthStateProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/backoffice/login");
    }
}
