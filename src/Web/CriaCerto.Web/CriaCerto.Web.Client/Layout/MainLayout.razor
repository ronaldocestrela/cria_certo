@inherits LayoutComponentBase
@using CriaCerto.Web.Client.Components.Backoffice

<ImpersonationBanner />

<div class="shell-page">
    <aside class="shell-sidebar">
        <NavMenu />
    </aside>

    <main class="shell-main">
        <header class="shell-header">
            <div>
                <p class="shell-kicker">Cria Certo</p>
                <h1 class="shell-title">Gestão Pecuária Inteligente</h1>
            </div>
            <SyncStatusHeader />
        </header>

        <article class="shell-content">
            <CustomErrorBoundary>
                @Body
            </CustomErrorBoundary>
        </article>
    </main>
</div>

<ToastContainer />
<MobileNavMenu />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
