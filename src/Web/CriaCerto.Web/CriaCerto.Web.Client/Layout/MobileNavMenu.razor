@using CriaCerto.Web.Client.Models
@using CriaCerto.Web.Client.Auth
@inject NavigationManager Navigation
@inject CustomAuthStateProvider AuthStateProvider

<nav class="mobile-nav-bar" aria-label="Navegação Móvel Operacional">
    <div class="mobile-nav-scroll">
        @foreach (var item in NavigationCatalog.GetAllItems())
        {
            <NavLink class="mobile-nav-link" href="@item.Href" Match="@(item.MatchExact ? NavLinkMatch.All : NavLinkMatch.Prefix)" title="@item.Title" aria-label="@item.Title">
                @if (!string.IsNullOrWhiteSpace(item.Icon))
                {
                    <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">@item.Icon</span>
                }
            </NavLink>
        }
        <button type="button" class="mobile-nav-link mobile-logout-link" @onclick="HandleLogout" title="Sair da aplicação" aria-label="Sair da aplicação" id="btn-logout-mobile">
            <span class="material-symbols-outlined mobile-nav-icon" aria-hidden="true">logout</span>
        </button>
    </div>
</nav>

@code {
    private async Task HandleLogout()
    {
        await AuthStateProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
