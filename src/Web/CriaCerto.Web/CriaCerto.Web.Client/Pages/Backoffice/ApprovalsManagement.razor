    }
    .item-title {
        font-weight: 600;
        color: #f1f5f9;
    }
    .ticket-tag {
        font-size: 0.75rem;
        background: rgba(99, 102, 241, 0.2);
        color: #a5b4fc;
        padding: 0.15rem 0.4rem;
        border-radius: 0.25rem;
        margin-top: 0.25rem;
        display: inline-block;
        font-family: monospace;
    }
    .code-tag {
        font-family: monospace;
        font-size: 0.85rem;
        color: #38bdf8;
        background: #0f172a;
