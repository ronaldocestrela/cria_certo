        padding: 0.25rem 0.6rem;
        border-radius: 9999px;
        text-transform: uppercase;
    }
    .status-pending { background: #fef3c7; color: #b45309; }
    .status-approved { background: #dbeafe; color: #1d4ed8; }
    .status-executed { background: #d1fae5; color: #065f46; }
    .status-rejected { background: #fee2e2; color: #991b1b; }
    .status-cancelled { background: #f1f5f9; color: #475569; }
    .status-expired { background: #e2e8f0; color: #64748b; }

    .btn-action {
        background: #334155;
        color: #f8fafc;
        border: none;
        padding: 0.4rem 0.8rem;
        border-radius: 0.375rem;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-action:hover {
        background: #475569;
        color: #38bdf8;
    }
    .loading-state, .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 1rem;
        color: #94a3b8;
    }
    .empty-icon { font-size: 3rem; margin-bottom: 0.5rem; }
    .spinner {
        width: 2rem;
        height: 2rem;
        border: 3px solid #334155;
        border-top-color: #38bdf8;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin-bottom: 1rem;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>

@code {
    private string ActiveTab = "pending";
    private ApprovalRequestType? FilterType;
    private ApprovalRequestStatus? FilterStatus;
    private bool IsLoading = true;

    private List<AdminApprovalRequestSummaryDto> Requests = new();
    private PendingApprovalsCountDto? Counts;
    private Guid CurrentAdminUserId = Guid.Empty;

    private bool IsDetailModalOpen = false;
    private AdminApprovalRequestDetailDto? SelectedDetail;
    private bool IsCreateModalOpen = false;

    protected override async Task OnInitializedAsync()
    {
        await ExtractCurrentUserAsync();
        await LoadDataAsync();
    }

    private async Task ExtractCurrentUserAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var subClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? user.FindFirst("sub")?.Value;

        if (Guid.TryParse(subClaim, out var userId))
        {
            CurrentAdminUserId = userId;
        }
    }

    private async Task ChangeTab(string tab)
    {
        ActiveTab = tab;
        FilterStatus = null;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        IsLoading = true;
        try
        {
            Counts = await ApiClient.GetPendingApprovalsCountAsync();

            ApprovalRequestStatus? statusToQuery = ActiveTab switch
            {
                "pending" => ApprovalRequestStatus.Pending,
                "mine" => ApprovalRequestStatus.Pending,
                "history" => FilterStatus,
                _ => null
            };

            Guid? requesterToQuery = ActiveTab == "mine" ? CurrentAdminUserId : null;

            var result = await ApiClient.GetApprovalsAsync(
                status: statusToQuery,
                requestType: FilterType,
                requestedByAdminUserId: requesterToQuery,
                page: 1,
                pageSize: 50);

            if (result is not null)
            {
                Requests = result.Items.ToList();
            }
            else
            {
                Requests = new();
            }
        }
        catch (Exception)
        {
            Requests = new();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OpenDetailAsync(Guid id)
    {
        var detail = await ApiClient.GetApprovalByIdAsync(id);
        if (detail is not null)
        {
            SelectedDetail = detail;
            IsDetailModalOpen = true;
        }
    }

    private bool IsExpired(AdminApprovalRequestSummaryDto item) =>
        item.Status == ApprovalRequestStatus.Pending && DateTime.UtcNow >= item.ExpiresAtUtc;

    private string GetExpirationDisplay(AdminApprovalRequestSummaryDto item)
    {
        if (item.Status != ApprovalRequestStatus.Pending) return "-";
        var remaining = item.ExpiresAtUtc - DateTime.UtcNow;
        if (remaining.TotalSeconds <= 0) return "Expirou";
        if (remaining.TotalHours >= 1) return $"{(int)remaining.TotalHours}h restantes";
        return $"{remaining.Minutes}m restantes";
    }

    private string GetTypeName(ApprovalRequestType type) => type switch
    {
        ApprovalRequestType.PublishPlanVersion => "Plano",
        ApprovalRequestType.MassTenantSuspension => "Suspensão",
        ApprovalRequestType.ExtendedAccessGrant => "Acesso",
        _ => "Ação"
    };

    private string GetBadgeClass(ApprovalRequestType type) => type switch
    {
        ApprovalRequestType.PublishPlanVersion => "badge-plan",
        ApprovalRequestType.MassTenantSuspension => "badge-suspend",
        ApprovalRequestType.ExtendedAccessGrant => "badge-access",
        _ => "badge-custom"
    };

    private string GetStatusName(ApprovalRequestStatus status) => status switch
    {
        ApprovalRequestStatus.Pending => "Pendente",
        ApprovalRequestStatus.Approved => "Aprovado",
        ApprovalRequestStatus.Executed => "Executado",
        ApprovalRequestStatus.Rejected => "Rejeitado",
        ApprovalRequestStatus.Cancelled => "Cancelado",
        ApprovalRequestStatus.Expired => "Expirado",
        _ => status.ToString()
    };
}
