        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding: 1.5rem;
        color: #f8fafc;
        max-width: 1400px;
        margin: 0 auto;
    }
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 1rem;
    }
    .governance-badge {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #38bdf8;
        letter-spacing: 0.05em;
    }
    .page-title {
        font-size: 1.75rem;
        font-weight: 800;
        margin: 0.25rem 0 0.5rem 0;
        color: #f1f5f9;
    }
    .page-subtitle {
        font-size: 0.95rem;
        color: #94a3b8;
        margin: 0;
        max-width: 700px;
    }
    .kpis-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }
    .kpi-card {
        background: #1e293b;
        border-radius: 0.75rem;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        border: 1px solid #334155;
    }
    .kpi-icon {
        font-size: 2rem;
    }
    .kpi-info {
        display: flex;
        flex-direction: column;
    }
    .kpi-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #94a3b8;
        text-transform: uppercase;
    }
    .kpi-value {
        font-size: 1.6rem;
        font-weight: 800;
        color: #f8fafc;
    }
    .card-amber { border-left: 4px solid #f59e0b; }
    .card-cyan { border-left: 4px solid #06b6d4; }
    .card-purple { border-left: 4px solid #a855f7; }
    .card-green { border-left: 4px solid #10b981; }

    .tabs-nav {
        display: flex;
        gap: 0.5rem;
        border-bottom: 1px solid #334155;
        padding-bottom: 0.25rem;
    }
    .tab-btn {
        background: none;
        border: none;
        color: #94a3b8;
        font-size: 0.95rem;
        font-weight: 600;
        padding: 0.6rem 1.25rem;
        cursor: pointer;
        border-radius: 0.5rem 0.5rem 0 0;
        transition: all 0.2s;
    }
    .tab-btn.active {
        color: #38bdf8;
        background: #1e293b;
        border-bottom: 2px solid #38bdf8;
    }
    .filters-bar {
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
        background: #1e293b;
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        border: 1px solid #334155;
    }
    .filter-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: #cbd5e1;
    }
    .form-select {
        background: #0f172a;
        color: #f8fafc;
        border: 1px solid #334155;
        border-radius: 0.375rem;
        padding: 0.35rem 0.6rem;
        font-size: 0.85rem;
    }
    .table-container {
        background: #1e293b;
        border-radius: 0.75rem;
        border: 1px solid #334155;
        overflow-x: auto;
    }
    .data-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }
    .data-table th {
        background: #0f172a;
        padding: 0.85rem 1rem;
        font-size: 0.8rem;
