@page "/backoffice/approvals"
@using CriaCerto.Modules.Backoffice.Application.Domain.Entities
@using CriaCerto.Modules.Backoffice.Application.Features.Approvals.Dtos
@using CriaCerto.Modules.Backoffice.Application.Security
@using CriaCerto.Web.Client.Components.Backoffice
@using CriaCerto.Web.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IBackofficeApiClient ApiClient
@inject IBackofficePermissionService PermissionService
@inject AuthenticationStateProvider AuthStateProvider

<div class="approvals-container">
    <!-- HEADER -->
    <header class="page-header">
        <div class="header-titles">
            <div class="governance-badge">
                <span>🛡️ Governança & Salvaguarda 4-Eyes</span>
            </div>
            <h1 class="page-title">Gestão de Solicitações Administrativas</h1>
            <p class="page-subtitle">
                Fluxo de aprovação dupla para ações de alto impacto (publicação de planos, suspensões massivas e acessos ampliados).
            </p>
        </div>

        <PermissionGuard Permission="@BackofficePermissions.ApprovalsRequest">
            <button class="btn btn-primary" @onclick="() => IsCreateModalOpen = true">
                <span>➕</span> Nova Solicitação
            </button>
        </PermissionGuard>
    </header>

    <!-- KPI CARDS -->
    <section class="kpis-grid">
        <div class="kpi-card card-amber">
            <div class="kpi-icon">⏳</div>
            <div class="kpi-info">
                <span class="kpi-label">Pendentes Globais</span>
                <span class="kpi-value">@(Counts?.TotalPending ?? 0)</span>
            </div>
        </div>

        <div class="kpi-card card-cyan">
            <div class="kpi-icon">👁️‍🗨️</div>
            <div class="kpi-info">
                <span class="kpi-label">Prontas p/ Minha Análise</span>
                <span class="kpi-value">@(Counts?.PendingReviewForMe ?? 0)</span>
            </div>
        </div>

        <div class="kpi-card card-purple">
            <div class="kpi-icon">📝</div>
            <div class="kpi-info">
                <span class="kpi-label">Minhas Aguardando</span>
                <span class="kpi-value">@(Counts?.MyPendingRequests ?? 0)</span>
            </div>
        </div>

        <div class="kpi-card card-green">
            <div class="kpi-icon">⚖️</div>
            <div class="kpi-info">
                <span class="kpi-label">Princípio 4-Eyes</span>
                <span class="kpi-value">100% Ativo</span>
            </div>
        </div>
    </section>

    <!-- TABS -->
    <div class="tabs-nav">
        <button class="tab-btn @(ActiveTab == "pending" ? "active" : "")" @onclick='() => ChangeTab("pending")'>
            Pendentes de Análise (@(Counts?.TotalPending ?? 0))
        </button>
        <button class="tab-btn @(ActiveTab == "mine" ? "active" : "")" @onclick='() => ChangeTab("mine")'>
            Minhas Solicitações (@(Counts?.MyPendingRequests ?? 0))
        </button>
        <button class="tab-btn @(ActiveTab == "history" ? "active" : "")" @onclick='() => ChangeTab("history")'>
            Histórico / Concluídas
        </button>
    </div>

    <!-- FILTER BAR -->
    <div class="filters-bar">
        <div class="filter-group">
            <label>Tipo:</label>
            <select class="form-select" @bind="FilterType" @bind:after="LoadDataAsync">
                <option value="">Todos os Tipos</option>
                <option value="@ApprovalRequestType.PublishPlanVersion">Publicação de Plano</option>
                <option value="@ApprovalRequestType.MassTenantSuspension">Suspensão Massiva</option>
                <option value="@ApprovalRequestType.ExtendedAccessGrant">Acesso Ampliado</option>
                <option value="@ApprovalRequestType.CustomCriticalAction">Ações Críticas</option>
            </select>
        </div>

        @if (ActiveTab == "history")
        {
            <div class="filter-group">
                <label>Status:</label>
                <select class="form-select" @bind="FilterStatus" @bind:after="LoadDataAsync">
                    <option value="">Todos Concluídos</option>
                    <option value="@ApprovalRequestStatus.Executed">Executado</option>
                    <option value="@ApprovalRequestStatus.Approved">Aprovado</option>
                    <option value="@ApprovalRequestStatus.Rejected">Rejeitado</option>
                    <option value="@ApprovalRequestStatus.Cancelled">Cancelado</option>
                    <option value="@ApprovalRequestStatus.Expired">Expirado</option>
                </select>
            </div>
        }

        <button class="btn btn-outline" @onclick="LoadDataAsync" disabled="@IsLoading">
            <span>🔄</span> Atualizar
        </button>
    </div>

    <!-- DATA TABLE -->
    <div class="table-container">
        @if (IsLoading)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Carregando solicitações...</p>
            </div>
        }
        else if (Requests.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon">📭</span>
                <h3>Nenhuma solicitação encontrada</h3>
                <p>Não há itens pendentes ou correspondentes aos filtros selecionados.</p>
            </div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>Título & Justificativa</th>
                        <th>Recurso Alvo</th>
                        <th>Solicitante</th>
                        <th>Status</th>
                        <th>Expiração</th>
                        <th class="text-right">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Requests)
                    {
                        var isMyRequest = item.RequestedByAdminUserId == CurrentAdminUserId;
                        <tr>
                            <td>
                                <span class="badge @GetBadgeClass(item.RequestType)">
                                    @GetTypeName(item.RequestType)
                                </span>
                            </td>
                            <td>
                                <div class="item-title">@item.Title</div>
                                @if (!string.IsNullOrWhiteSpace(item.SupportTicketId))
                                {
                                    <span class="ticket-tag">@item.SupportTicketId</span>
                                }
                            </td>
                            <td>
                                <span class="code-tag">@item.TargetResourceId</span>
                            </td>
                            <td>
                                <div class="requester-email">@item.RequestedByAdminEmail</div>
                                <div class="requester-date">@item.RequestedAtUtc.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td>
                                <span class="status-pill status-@item.Status.ToString().ToLower()">
                                    @GetStatusName(item.Status)
                                </span>
                            </td>
                            <td>
                                <span class="expiration-text @(IsExpired(item) ? "text-danger" : "")">
                                    @GetExpirationDisplay(item)
                                </span>
                            </td>
                            <td class="text-right">
                                <button class="btn-action" @onclick="() => OpenDetailAsync(item.Id)">
                                    @(item.Status == ApprovalRequestStatus.Pending && !isMyRequest ? "Avaliar..." : "Detalhes")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- MODALS -->
<ApprovalDetailModal
    IsOpen="@IsDetailModalOpen"
    RequestDetail="@SelectedDetail"
    CurrentAdminUserId="@CurrentAdminUserId"
    OnClosed="() => IsDetailModalOpen = false"
    OnActionCompleted="LoadDataAsync" />

<CreateApprovalRequestModal
    IsOpen="@IsCreateModalOpen"
    OnClosed="() => IsCreateModalOpen = false"
    OnCreated="LoadDataAsync" />

<style>
