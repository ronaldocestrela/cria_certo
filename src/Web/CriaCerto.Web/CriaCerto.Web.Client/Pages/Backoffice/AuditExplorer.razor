        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .empty-icon {
        font-size: 2.5rem;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

    .data-table th {
        background: #0f172a;
        padding: 0.85rem 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid #1e293b;
    }

    .data-table td {
        padding: 0.9rem 1rem;
        border-bottom: 1px solid #1e293b;
        font-size: 0.875rem;
        vertical-align: middle;
    }

    .data-table tr:hover {
        background: rgba(30, 41, 59, 0.5);
    }

    .row-archived {
        opacity: 0.6;
    }

    .col-date {
        display: flex;
        flex-direction: column;
    }

    .date-primary {
        font-weight: 500;
        color: #f8fafc;
    }

    .date-sub {
        font-size: 0.75rem;
        color: #64748b;
    }

    .actor-email {
        display: block;
        font-weight: 500;
        color: #f8fafc;
    }

    .actor-role {
        display: block;
        font-size: 0.75rem;
        color: #64748b;
    }

    .action-wrap {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .action-name {
        font-weight: 600;
        color: #e2e8f0;
    }

    .category-tag {
        font-size: 0.7rem;
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        background: #1e293b;
        color: #94a3b8;
        display: inline-block;
        width: fit-content;
    }

    .col-target {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .target-res {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.8rem;
        color: #cbd5e1;
    }

    .target-tenant {
        font-size: 0.75rem;
        color: #38bdf8;
    }

    .col-ip code {
        font-size: 0.8rem;
        color: #94a3b8;
    }

    .sev-badge {
        display: inline-block;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .sev-critical { background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4); }
    .sev-high { background: rgba(249, 115, 22, 0.2); color: #fb923c; border: 1px solid rgba(249, 115, 22, 0.4); }
    .sev-medium { background: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.4); }
    .sev-low { background: rgba(100, 116, 139, 0.2); color: #94a3b8; border: 1px solid rgba(100, 116, 139, 0.4); }

    .integrity-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
