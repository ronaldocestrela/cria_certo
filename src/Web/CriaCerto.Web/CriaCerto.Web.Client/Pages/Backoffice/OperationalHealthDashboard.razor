@page "/backoffice/observability"
@layout CriaCerto.Web.Client.Layout.BackofficeLayout
@using CriaCerto.Modules.Backoffice.Application.Domain.Enums
@using CriaCerto.Modules.Backoffice.Application.Features.Observability.Dtos
@using CriaCerto.Modules.Backoffice.Application.Security
@using CriaCerto.Web.Client.Components.Backoffice
@using CriaCerto.Web.Client.Services
@inject IBackofficeApiClient ApiClient
@inject IBackofficePermissionService PermissionService
@inject IToastService ToastService
@inject NavigationManager Navigation
@implements IDisposable

<div class="observability-dashboard">
    <!-- Header com Status Global e Controles -->
    <div class="dashboard-header">
        <div class="header-titles">
            <div class="badge-tag">TELEMETRIA & SAÚDE OPERACIONAL</div>
            <h1 class="page-title">Observabilidade & Central de Alertas</h1>
            <p class="page-subtitle">
                Monitoramento contínuo de anomalias, latência de consultas administrativas e integridade forense da plataforma.
            </p>
        </div>

        <div class="header-actions">
            <!-- Indicador Global de Saúde -->
            @if (_health is not null)
            {
                <div class="health-pill health-@_health.Status.ToString().ToLower()">
                    <span class="pulse-dot"></span>
                    <span class="health-label">@GetHealthStatusLabel(_health.Status)</span>
                </div>
            }

            <button class="btn-refresh" @onclick="RefreshDataAsync" disabled="@_isLoading">
                <span class="@(_isLoading ? "spin-icon" : "")">🔄</span>
                <span>Atualizar</span>
            </button>

            <PermissionGuard Permission="@BackofficePermissions.ObservabilityManage">
                <button class="btn-simulate" @onclick="() => _isSimulateModalOpen = true">
                    <span>⚡ Simular Alerta</span>
                </button>
            </PermissionGuard>
        </div>
    </div>

    <!-- 4 Cards de Métricas Operacionais Chave -->
    <div class="kpi-grid">
        <!-- Card 1: Integridade Forense -->
        <div class="kpi-card">
            <div class="kpi-icon-wrap integrity-wrap">
                <span>🛡️</span>
            </div>
            <div class="kpi-details">
                <span class="kpi-label">Integridade Forense</span>
                <div class="kpi-value-row">
                    @if (_health is not null)
                    {
                        <span class="kpi-status-text @(_health.IsAuditChainValid ? "status-ok" : "status-err")">
                            @(_health.IsAuditChainValid ? "100% Íntegra" : "Violação Detectada")
                        </span>
                    }
                    else
                    {
                        <span class="kpi-value">--</span>
                    }
                </div>
                <NavLink href="backoffice/audit" class="kpi-link">Ver Trilha Forense &rarr;</NavLink>
            </div>
        </div>

        <!-- Card 2: Alertas Críticos Ativos -->
        <div class="kpi-card">
            <div class="kpi-icon-wrap critical-wrap">
                <span>🚨</span>
            </div>
            <div class="kpi-details">
                <span class="kpi-label">Alertas Críticos Ativos</span>
                <div class="kpi-value-row">
                    <span class="kpi-value @((_health?.ActiveCriticalAlerts ?? 0) > 0 ? "val-critical" : "")">
                        @(_health?.ActiveCriticalAlerts ?? 0)
                    </span>
                    <span class="kpi-sub">requerem atenção</span>
                </div>
                <span class="kpi-meta">@(_health?.ActiveWarningAlerts ?? 0) em atenção operacional</span>
            </div>
        </div>

        <!-- Card 3: Falhas de Política (24h) -->
        <div class="kpi-card">
            <div class="kpi-icon-wrap policy-wrap">
                <span>🚫</span>
            </div>
            <div class="kpi-details">
                <span class="kpi-label">Falhas de Permissão (24h)</span>
                <div class="kpi-value-row">
                    <span class="kpi-value @((_health?.PolicyFailuresLast24Hours ?? 0) >= 10 ? "val-warning" : "")">
                        @(_health?.PolicyFailuresLast24Hours ?? 0)
                    </span>
                    <span class="kpi-sub">bloqueios RBAC</span>
                </div>
                <span class="kpi-meta">Tentativas 401/403 monitoradas</span>
            </div>
        </div>

        <!-- Card 4: Sessões de Impersonação Ativas -->
        <div class="kpi-card">
            <div class="kpi-icon-wrap impersonation-wrap">
                <span>🔑</span>
            </div>
            <div class="kpi-details">
                <span class="kpi-label">Sessões Assistidas Ativas</span>
                <div class="kpi-value-row">
                    <span class="kpi-value">@(_health?.ActiveImpersonationsCount ?? 0)</span>
                    <span class="kpi-sub">em monitoramento</span>
                </div>
                <NavLink href="backoffice/impersonation" class="kpi-link">Painel de Impersonação &rarr;</NavLink>
            </div>
        </div>
    </div>

    <!-- Painel Principal de Alertas -->
    <div class="main-alerts-panel">
        <div class="panel-header">
            <div class="panel-title-group">
                <h2>Central de Incidentes & Eventos Ativos</h2>
                <span class="total-badge">@_totalAlerts alerta(s)</span>
            </div>

            <!-- Filtros Rápidos -->
            <div class="filters-row">
                <div class="filter-group">
                    <label class="filter-lbl">Status:</label>
                    <select class="filter-select" @onchange="OnStatusFilterChanged">
                        <option value="">Todos</option>
                        <option value="@AlertStatus.Active">Ativos</option>
                        <option value="@AlertStatus.Acknowledged">Em Triagem</option>
                        <option value="@AlertStatus.Resolved">Resolvidos</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-lbl">Severidade:</label>
                    <select class="filter-select" @onchange="OnSeverityFilterChanged">
                        <option value="">Todas</option>
                        <option value="@AlertSeverity.Critical">Crítico</option>
                        <option value="@AlertSeverity.Warning">Atenção</option>
                        <option value="@AlertSeverity.Info">Informativo</option>
                    </select>
                </div>

                <div class="search-box">
                    <input type="text" class="search-input" placeholder="Buscar por título, regra, tenant ou operador..."
                           @bind="_searchTerm" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />
                </div>
            </div>
        </div>

        <!-- Tabela de Alertas -->
        @if (_isLoading)
        {
            <div class="loading-container">
                <div class="spinner"></div>
                <p>Carregando telemetria e alertas operacionais...</p>
            </div>
        }
        else if (_alerts.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon">✨</span>
                <h3>Nenhum incidente operacional encontrado</h3>
                <p>O ecossistema está operando dentro dos parâmetros de normalidade e conformidade de segurança.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="alerts-table">
                    <thead>
                        <tr>
                            <th>Severidade</th>
                            <th>Incidente & Descrição</th>
                            <th>Ocorrências</th>
                            <th>Primeiro / Último Disparo</th>
                            <th>Alvo Impactado</th>
                            <th>Status</th>
                            <th class="text-right">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var alert in _alerts)
                        {
                            <tr class="alert-row sev-border-@alert.Severity.ToString().ToLower()">
                                <td>
                                    <span class="sev-tag sev-@alert.Severity.ToString().ToLower()">
                                        @GetSeverityLabel(alert.Severity)
                                    </span>
                                </td>
                                <td>
                                    <div class="alert-info-cell">
                                        <span class="alert-title">@alert.Title</span>
                                        <span class="alert-desc">@Truncate(alert.Description, 90)</span>
                                        <span class="alert-rule code-font">@alert.RuleCode</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="occurrences-chip">@alert.OccurrenceCount&times;</span>
                                </td>
                                <td>
                                    <div class="timestamp-cell">
                                        <span class="time-main">@alert.LastTriggeredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                        <span class="time-sub">Início: @alert.FirstTriggeredAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="target-cell">
                                        @if (!string.IsNullOrWhiteSpace(alert.TargetTenantName))
                                        {
                                            <span class="target-name">@alert.TargetTenantName</span>
                                        }
                                        else
                                        {
                                            <span class="target-name">Global / Sistema</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(alert.RelatedAdminEmail))
                                        {
                                            <span class="target-sub">@alert.RelatedAdminEmail</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="status-chip status-@alert.Status.ToString().ToLower()">
                                        @GetStatusLabel(alert.Status)
                                    </span>
                                </td>
                                <td class="text-right">
                                    <button class="btn-inspect" @onclick="() => OpenAlertDetail(alert)">
                                        <span>🔍 Inspecionar</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginação -->
            @if (_totalPages > 1)
            {
                <div class="pagination-bar">
                    <button class="btn-page" disabled="@(_currentPage <= 1)" @onclick="() => ChangePageAsync(_currentPage - 1)">
                        &larr; Anterior
                    </button>
                    <span class="page-info">Página @_currentPage de @_totalPages</span>
                    <button class="btn-page" disabled="@(_currentPage >= _totalPages)" @onclick="() => ChangePageAsync(_currentPage + 1)">
                        Próxima &rarr;
                    </button>
                </div>
            }
        }
    </div>
</div>

<!-- Modais -->
<AlertDetailModal IsOpen="_isDetailModalOpen"
                  Alert="_selectedAlert"
                  OnClose="() => _isDetailModalOpen = false"
                  OnAlertUpdated="RefreshDataAsync" />

<SimulateAlertModal IsOpen="_isSimulateModalOpen"
                    OnClose="() => _isSimulateModalOpen = false"
                    OnAlertCreated="RefreshDataAsync" />

