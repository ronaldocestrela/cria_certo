    }

    .spinner {
        width: 32px;
        height: 32px;
        border: 3px solid rgba(56, 189, 248, 0.2);
        border-top-color: #38bdf8;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    .spin-icon {
        display: inline-block;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private OperationalHealthDto? _health;
    private List<BackofficeAlertDto> _alerts = new();
    private int _totalAlerts = 0;
    private int _currentPage = 1;
    private int _totalPages = 1;
    private const int PageSize = 20;
    private bool _isLoading = true;

    private AlertStatus? _selectedStatus = null;
    private AlertSeverity? _selectedSeverity = null;
    private string _searchTerm = string.Empty;

    private bool _isDetailModalOpen = false;
    private bool _isSimulateModalOpen = false;
    private BackofficeAlertDto? _selectedAlert;

    private PeriodicTimer? _autoRefreshTimer;
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        StartAutoRefresh();
    }

    private void StartAutoRefresh()
    {
        _autoRefreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _ = Task.Run(async () =>
        {
            try
            {
                while (await _autoRefreshTimer.WaitForNextTickAsync(_cts.Token))
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadDataAsync(silent: true);
                        StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task LoadDataAsync(bool silent = false)
    {
        if (!silent) _isLoading = true;

        try
        {
            _health = await ApiClient.GetOperationalHealthAsync();

            var alertsResult = await ApiClient.GetBackofficeAlertsAsync(
                pageNumber: _currentPage,
                pageSize: PageSize,
                status: _selectedStatus,
                severity: _selectedSeverity,
                searchTerm: _searchTerm);

            if (alertsResult != null)
            {
                _alerts = alertsResult.Items.ToList();
                _totalAlerts = alertsResult.TotalCount;
                _totalPages = alertsResult.TotalPages;
            }
        }
        catch (Exception ex)
        {
            if (!silent) ToastService.ShowError($"Erro ao carregar observabilidade: {ex.Message}");
        }
        finally
        {
            if (!silent) _isLoading = false;
        }
    }

    private async Task RefreshDataAsync()
    {
        await LoadDataAsync(silent: false);
    }

    private async Task OnStatusFilterChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        _selectedStatus = string.IsNullOrWhiteSpace(val) ? null : Enum.Parse<AlertStatus>(val);
        _currentPage = 1;
        await LoadDataAsync();
    }

    private async Task OnSeverityFilterChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        _selectedSeverity = string.IsNullOrWhiteSpace(val) ? null : Enum.Parse<AlertSeverity>(val);
        _currentPage = 1;
        await LoadDataAsync();
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await LoadDataAsync();
        }
    }

    private async Task ChangePageAsync(int newPage)
    {
        if (newPage < 1 || newPage > _totalPages) return;
        _currentPage = newPage;
        await LoadDataAsync();
    }

    private void OpenAlertDetail(BackofficeAlertDto alert)
    {
        _selectedAlert = alert;
        _isDetailModalOpen = true;
    }

    private static string GetHealthStatusLabel(OperationalHealthStatus status) => status switch
    {
        OperationalHealthStatus.Healthy => "Operação Normal",
        OperationalHealthStatus.Degraded => "Degradação Parcial",
        OperationalHealthStatus.Critical => "Atenção Crítica",
        _ => status.ToString()
    };

    private static string GetSeverityLabel(AlertSeverity severity) => severity switch
    {
        AlertSeverity.Critical => "Crítico",
        AlertSeverity.Warning => "Atenção",
        AlertSeverity.Info => "Informativo",
        _ => severity.ToString()
    };

    private static string GetStatusLabel(AlertStatus status) => status switch
    {
        AlertStatus.Active => "Ativo",
        AlertStatus.Acknowledged => "Em Triagem",
        AlertStatus.Resolved => "Resolvido",
        _ => status.ToString()
    };

    private static string Truncate(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        return text.Length <= maxLength ? text : text[..maxLength] + "...";
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _autoRefreshTimer?.Dispose();
    }
}
