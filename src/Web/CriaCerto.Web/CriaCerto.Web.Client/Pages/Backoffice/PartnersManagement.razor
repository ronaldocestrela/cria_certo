@code {
    private PagedResult<CommercialPartnerListItemDto>? _pagedPartners;
    private bool _isLoading = true;
    private bool _isSubmitting = false;
    private string _searchTerm = string.Empty;
    private string _selectedStatus = string.Empty;
    private string _selectedCommissionType = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 20;

    // Create Modal state
    private bool _showCreateModal = false;
    private string? _createError;
    private CreatePartnerFormModel _newPartner = new();

    // 4-Eyes Contract Change Modal state
    private bool _showContractChangeModal = false;
    private CommercialPartnerListItemDto? _selectedPartnerForContract;
    private ProposeContractChangeFormModel _contractProposal = new();

    // Details Modal state
    private bool _showDetailsModal = false;
    private CommercialPartnerDto? _partnerDetail;

    // Suspend Modal state
    private bool _showSuspendModal = false;
    private CommercialPartnerListItemDto? _selectedPartnerForSuspend;
    private string _suspendReason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPartnersAsync();
    }

    private async Task LoadPartnersAsync()
    {
        _isLoading = true;
        try
        {
            ParticipantStatus? status = Enum.TryParse<ParticipantStatus>(_selectedStatus, out var s) ? s : null;
            CommissionType? commType = Enum.TryParse<CommissionType>(_selectedCommissionType, out var c) ? c : null;

            _pagedPartners = await ApiClient.GetCommercialPartnersAsync(
                _searchTerm,
                status,
                commType,
                _currentPage,
                _pageSize);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Erro ao carregar parceiros comerciais: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        _currentPage = 1;
        await LoadPartnersAsync();
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFilters();
        }
    }

    private async Task PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            await LoadPartnersAsync();
        }
    }

    private async Task NextPage()
    {
        if (_currentPage * _pageSize < (_pagedPartners?.TotalCount ?? 0))
        {
            _currentPage++;
            await LoadPartnersAsync();
        }
    }

    private void OpenCreateModal()
    {
        _newPartner = new CreatePartnerFormModel();
        _createError = null;
        _showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        _showCreateModal = false;
        _createError = null;
    }

    private async Task HandleFullNameKeyUp()
    {
        if (string.IsNullOrWhiteSpace(_newPartner.PreferredReferralCode) && !string.IsNullOrWhiteSpace(_newPartner.FullName))
        {
            await SuggestCodeAsync();
        }
    }

    private async Task SuggestCodeAsync()
    {
        var seed = !string.IsNullOrWhiteSpace(_newPartner.TradeName) ? _newPartner.TradeName : _newPartner.FullName;
        if (!string.IsNullOrWhiteSpace(seed))
        {
            var res = await ApiClient.SuggestReferralCodeAsync(seed);
            if (res != null)
            {
                _newPartner.PreferredReferralCode = res.SuggestedCode;
            }
        }
    }

    private async Task HandleSubmitCreateAsync()
    {
        _createError = null;
        if (string.IsNullOrWhiteSpace(_newPartner.FullName) ||
            string.IsNullOrWhiteSpace(_newPartner.Email) ||
            string.IsNullOrWhiteSpace(_newPartner.PhoneNumber) ||
            string.IsNullOrWhiteSpace(_newPartner.LegalDocumentNumber) ||
            string.IsNullOrWhiteSpace(_newPartner.PixKey))
        {
            _createError = "Preencha todos os campos obrigatórios (*).";
            return;
        }

        if (_newPartner.CommissionValue <= 0)
        {
            _createError = "O valor da comissão deve ser maior que zero.";
            return;
        }

        _isSubmitting = true;
        try
        {
            var req = new RegisterPartnerRequest(
                _newPartner.FullName,
                _newPartner.TradeName,
                _newPartner.Email,
                _newPartner.PhoneNumber,
                _newPartner.Category,
                _newPartner.City,
                _newPartner.State,
                _newPartner.Notes,
                _newPartner.LegalDocumentNumber,
                _newPartner.PixKeyType,
                _newPartner.PixKey,
                _newPartner.CommissionType,
                _newPartner.CommissionValue,
                _newPartner.MaxRecurringMonths,
                _newPartner.PaymentTermsDays,
                _newPartner.PreferredReferralCode);

            var result = await ApiClient.RegisterCommercialPartnerAsync(req);
            if (result.IsSuccess)
            {
                Toast.ShowSuccess($"Parceiro '{result.Value.FullName}' cadastrado com sucesso!");
                CloseCreateModal();
                await LoadPartnersAsync();
            }
            else
            {
                _createError = result.Error.Message;
            }
        }
        catch (Exception ex)
        {
            _createError = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void OpenContractChangeModal(CommercialPartnerListItemDto partner)
    {
        _selectedPartnerForContract = partner;
        _contractProposal = new ProposeContractChangeFormModel
        {
            CommissionType = partner.CommissionType,
            CommissionValue = partner.CommissionValue,
            MaxRecurringMonths = partner.MaxRecurringMonths,
            PaymentTermsDays = 30,
            PixKey = partner.PixKey,
            PixKeyType = partner.PixKeyType,
            Justification = string.Empty
        };
        _showContractChangeModal = true;
    }

    private void CloseContractChangeModal()
    {
        _showContractChangeModal = false;
        _selectedPartnerForContract = null;
    }

    private async Task HandleSubmitContractProposalAsync()
    {
        if (_selectedPartnerForContract == null) return;

        if (string.IsNullOrWhiteSpace(_contractProposal.Justification) || _contractProposal.Justification.Trim().Length < 10)
        {
            Toast.ShowError("A justificativa administrativa de 4-Olhos deve ter ao menos 10 caracteres.");
            return;
        }

        _isSubmitting = true;
        try
        {
            var req = new ProposeContractChangeRequest(
                _contractProposal.CommissionType,
                _contractProposal.CommissionValue,
                _contractProposal.MaxRecurringMonths,
                _contractProposal.PaymentTermsDays,
                _contractProposal.PixKey,
                _contractProposal.PixKeyType,
                _contractProposal.Justification);

            var ok = await ApiClient.ProposePartnerContractChangeAsync(_selectedPartnerForContract.ParticipantId, req);
            if (ok)
            {
                Toast.ShowSuccess("Solicitação de ajuste de comissão submetida para aprovação (4-Eyes)!");
                CloseContractChangeModal();
            }
            else
            {
                Toast.ShowError("Falha ao submeter proposta de contrato para aprovação.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Erro: {ex.Message}");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task OpenDetailsModal(Guid participantId)
    {
        _partnerDetail = await ApiClient.GetCommercialPartnerByIdAsync(participantId);
        if (_partnerDetail != null)
        {
            _showDetailsModal = true;
        }
        else
        {
            Toast.ShowError("Não foi possível carregar os detalhes do parceiro.");
        }
    }

    private void CloseDetailsModal()
    {
        _showDetailsModal = false;
        _partnerDetail = null;
    }

    private void OpenSuspendModal(CommercialPartnerListItemDto partner)
    {
        _selectedPartnerForSuspend = partner;
        _suspendReason = string.Empty;
        _showSuspendModal = true;
    }

    private void CloseSuspendModal()
    {
        _showSuspendModal = false;
        _selectedPartnerForSuspend = null;
    }

    private async Task HandleConfirmSuspendAsync()
    {
        if (_selectedPartnerForSuspend == null) return;
        if (string.IsNullOrWhiteSpace(_suspendReason) || _suspendReason.Trim().Length < 5)
        {
            Toast.ShowError("Informe uma justificativa válida com ao menos 5 caracteres.");
            return;
        }

        _isSubmitting = true;
        try
        {
            var ok = await ApiClient.SuspendCommercialPartnerAsync(_selectedPartnerForSuspend.ParticipantId, _suspendReason);
            if (ok)
            {
                Toast.ShowSuccess($"Parceiro '{_selectedPartnerForSuspend.FullName}' suspenso com sucesso.");
                CloseSuspendModal();
                await LoadPartnersAsync();
            }
            else
            {
                Toast.ShowError("Falha ao suspender o parceiro.");
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task HandleReactivate(Guid participantId)
    {
        var ok = await ApiClient.ReactivateCommercialPartnerAsync(participantId);
        if (ok)
        {
            Toast.ShowSuccess("Parceiro comercial reativado com sucesso.");
            await LoadPartnersAsync();
        }
        else
        {
            Toast.ShowError("Falha ao reativar parceiro comercial.");
        }
    }

    private async Task CopyReferralLink(string code)
    {
        var link = $"https://app.criacerto.com.br/r/{code}";
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", link);
        Toast.ShowSuccess($"Link copiado: {link}");
    }

    private string FormatCategory(PartnerCategory category) => category switch
    {
        PartnerCategory.ZootechnicianConsultant => "Consultor Zootécnico",
        PartnerCategory.Veterinarian => "Médico Veterinário",
        PartnerCategory.AgriculturalDealer => "Revenda Agropecuária",
        PartnerCategory.BreedAssociation => "Associação de Raça",
        PartnerCategory.InfluencerOther => "Influenciador / Outro",
        _ => category.ToString()
    };

    private string FormatCommission(CommissionType type, decimal value, int? maxMonths) => type switch
    {
        CommissionType.PercentageRecurring => $"{value:N1}% Recorrente {(maxMonths.HasValue ? $"({maxMonths.Value} meses)" : "(Vitalício)")}",
        CommissionType.PercentageFirstMonth => $"{value:N1}% na 1ª Mensalidade",
        CommissionType.FixedPerConversion => $"R$ {value:N2} Fixo / Conversão",
        _ => $"{value}"
    };

    private class CreatePartnerFormModel
    {
        public string FullName { get; set; } = string.Empty;
        public string? TradeName { get; set; }
        public PartnerCategory Category { get; set; } = PartnerCategory.ZootechnicianConsultant;
        public string Email { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public string? City { get; set; }
        public string? State { get; set; }
        public string? Notes { get; set; }
        public string? PreferredReferralCode { get; set; }
        public string LegalDocumentNumber { get; set; } = string.Empty;
        public PixKeyType PixKeyType { get; set; } = PixKeyType.Cnpj;
        public string PixKey { get; set; } = string.Empty;
        public CommissionType CommissionType { get; set; } = CommissionType.PercentageRecurring;
        public decimal CommissionValue { get; set; } = 20.00m;
        public int? MaxRecurringMonths { get; set; } = 12;
        public int PaymentTermsDays { get; set; } = 30;
    }

    private class ProposeContractChangeFormModel
