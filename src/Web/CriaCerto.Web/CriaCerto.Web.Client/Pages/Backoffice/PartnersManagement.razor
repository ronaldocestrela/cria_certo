@page "/backoffice/partners"
@layout Layout.BackofficeLayout
@using CriaCerto.BuildingBlocks.Abstractions.Results
@using CriaCerto.Modules.Backoffice.Application.Security
@using CriaCerto.Modules.Referral.Application.Domain.Enums
@using CriaCerto.Modules.Referral.Application.Features.CommercialPartners.Dtos
@using CriaCerto.Modules.Referral.Application.Features.CommercialPartners.Queries
@using CriaCerto.Web.Client.Components.Backoffice
@using CriaCerto.Web.Client.Services
@inject IBackofficeApiClient ApiClient
@inject IJSRuntime JS
@inject IToastService Toast

<PageTitle>CriaCerto Backoffice - Gestão de Parceiros Comerciais</PageTitle>

<PermissionGuard Permission="@BackofficePermissions.ReferralPartnersRead">
    <Authorized>
        <div class="partners-page">
            <header class="page-header">
                <div>
                    <span class="badge-growth">Programa de Parcerias & Growth</span>
                    <h1 class="page-title">Gestão de Parceiros Comerciais</h1>
                    <p class="page-subtitle">Cadastro de consultores, veterinários e revendas com contratos de comissionamento individualizados e rastreamento de conversão.</p>
                </div>
                <div class="header-actions">
                    <button class="btn btn-secondary" @onclick="LoadPartnersAsync" disabled="@_isLoading">
                        <span>🔄</span> Atualizar
                    </button>
                    <PermissionGuard Permission="@BackofficePermissions.ReferralPartnersManage">
                        <Authorized>
                            <button class="btn btn-primary" @onclick="OpenCreateModal">
                                <span>+</span> Novo Parceiro
                            </button>
                        </Authorized>
                    </PermissionGuard>
                </div>
            </header>

            <!-- KPIs Grid -->
            <div class="kpis-grid">
                <div class="kpi-card">
                    <span class="kpi-label">Total de Parceiros</span>
                    <span class="kpi-value">@(_pagedPartners?.TotalCount ?? 0)</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Parceiros Ativos</span>
                    <span class="kpi-value text-success">@(_pagedPartners?.Items.Count(p => p.Status == ParticipantStatus.Active) ?? 0)</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Parceiros Suspensos</span>
                    <span class="kpi-value text-danger">@(_pagedPartners?.Items.Count(p => p.Status == ParticipantStatus.Suspended) ?? 0)</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Total de Cliques</span>
                    <span class="kpi-value text-info">@(_pagedPartners?.Items.Sum(p => p.ClicksCount).ToString("N0") ?? "0")</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Indicações Vinculadas</span>
                    <span class="kpi-value text-warning">@(_pagedPartners?.Items.Sum(p => p.ActiveReferralsCount).ToString("N0") ?? "0")</span>
                </div>
            </div>

            <!-- Filtros e Busca -->
            <div class="filters-bar">
                <div class="search-box">
                    <span class="search-icon">🔍</span>
                    <input type="text" placeholder="Buscar por nome, documento, e-mail, telefone ou código..."
                           @bind="_searchTerm" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />
                </div>

                <div class="filter-group">
                    <select class="form-select" @bind="_selectedStatus">
                        <option value="">Todos os Status</option>
                        <option value="Active">Ativos</option>
                        <option value="Suspended">Suspensos</option>
                    </select>

                    <select class="form-select" @bind="_selectedCommissionType">
                        <option value="">Todos os Modelos</option>
                        <option value="PercentageRecurring">Percentual Recorrente</option>
                        <option value="PercentageFirstMonth">1ª Mensalidade</option>
                        <option value="FixedPerConversion">Fixo por Conversão</option>
                    </select>

                    <button class="btn btn-secondary" @onclick="ApplyFilters">Filtrar</button>
                </div>
            </div>

            <!-- Tabela Principal -->
            <div class="table-container">
                @if (_isLoading)
                {
                    <div class="loading-state">
                        <div class="spinner"></div>
                        <p>Carregando parceiros comerciais...</p>
                    </div>
                }
                else if (_pagedPartners is null || !_pagedPartners.Items.Any())
                {
                    <div class="empty-state">
                        <span class="empty-icon">🤝</span>
                        <h3>Nenhum parceiro comercial encontrado</h3>
                        <p>Ajuste os filtros de pesquisa ou cadastre um novo consultor/parceiro.</p>
                        <button class="btn btn-primary mt-3" @onclick="OpenCreateModal">+ Cadastrar Parceiro</button>
                    </div>
                }
                else
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Parceiro</th>
                                <th>Categoria</th>
                                <th>Documento / Pix</th>
                                <th>Link / Código</th>
                                <th>Comissão Vigente</th>
                                <th>Desempenho</th>
                                <th>Status</th>
                                <th style="text-align: right;">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var partner in _pagedPartners.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="partner-identity">
                                            <span class="partner-name">@partner.FullName</span>
                                            @if (!string.IsNullOrWhiteSpace(partner.TradeName))
                                            {
                                                <span class="partner-trade">@partner.TradeName</span>
                                            }
                                            <span class="partner-contact">📧 @partner.Email | 📱 @partner.PhoneNumber</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="category-pill">@FormatCategory(partner.Category)</span>
                                    </td>
                                    <td>
                                        <div class="doc-info">
                                            <span>Doc: <MaskedDataField Value="@partner.LegalDocumentNumber" EntityType="Partner" EntityId="@partner.ParticipantId" FieldName="Document" Label="CPF/CNPJ" /></span>
                                            <span class="pix-tag">Pix (@partner.PixKeyType): <MaskedDataField Value="@partner.PixKey" EntityType="Partner" EntityId="@partner.ParticipantId" FieldName="PixKey" Label="Chave Pix" /></span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="code-box">
                                            <code>@partner.ReferralCode</code>
                                            <button class="btn-icon" title="Copiar Link de Indicação" @onclick="() => CopyReferralLink(partner.ReferralCode)">
                                                📋
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="commission-badge">
                                            @FormatCommission(partner.CommissionType, partner.CommissionValue, partner.MaxRecurringMonths)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="metrics-cell">
                                            <span><strong>@partner.ClicksCount</strong> cliques</span>
                                            <span class="text-success"><strong>@partner.ActiveReferralsCount</strong> fazendas</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (partner.Status == ParticipantStatus.Active)
                                        {
                                            <span class="status-badge status-active">Ativo</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-suspended">Suspenso</span>
                                        }
                                    </td>
                                    <td style="text-align: right;">
                                        <div class="action-buttons">
                                            <button class="btn btn-sm btn-outline" title="Ver Histórico e Detalhes" @onclick="() => OpenDetailsModal(partner.ParticipantId)">
                                                👁️
                                            </button>
                                            <PermissionGuard Permission="@BackofficePermissions.ApprovalsRequest">
                                                <Authorized>
                                                    <button class="btn btn-sm btn-outline text-warning" title="Ajustar Comissão (4-Olhos)" @onclick="() => OpenContractChangeModal(partner)">
                                                        ⚖️
                                                    </button>
                                                </Authorized>
                                            </PermissionGuard>
                                            <PermissionGuard Permission="@BackofficePermissions.ReferralPartnersManage">
                                                <Authorized>
                                                    @if (partner.Status == ParticipantStatus.Active)
                                                    {
                                                        <button class="btn btn-sm btn-outline text-danger" title="Suspender Parceiro" @onclick="() => OpenSuspendModal(partner)">
                                                            ⏸️
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-sm btn-outline text-success" title="Reativar Parceiro" @onclick="() => HandleReactivate(partner.ParticipantId)">
                                                            ▶️
                                                        </button>
                                                    }
                                                </Authorized>
                                            </PermissionGuard>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Paginação -->
                    <div class="pagination-footer">
                        <span>Página @_currentPage de @Math.Max(1, (int)Math.Ceiling((double)(_pagedPartners?.TotalCount ?? 0) / _pageSize)) (Total: @(_pagedPartners?.TotalCount ?? 0) parceiros)</span>
                        <div class="pagination-buttons">
                            <button class="btn btn-sm btn-secondary" disabled="@(_currentPage <= 1)" @onclick="PreviousPage">Anterior</button>
                            <button class="btn btn-sm btn-secondary" disabled="@(_currentPage * _pageSize >= (_pagedPartners?.TotalCount ?? 0))" @onclick="NextPage">Próxima</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="access-denied">
            <h2>Acesso Restrito</h2>
            <p>Você não possui a permissão necessária (<code>referral.partners.read</code>) para acessar a Gestão de Parceiros Comerciais.</p>
        </div>
    </NotAuthorized>
</PermissionGuard>

<!-- MODAL: CADASTRAR NOVO PARCEIRO -->
@if (_showCreateModal)
{
    <div class="modal-backdrop">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <span class="badge-growth">Novo Parceiro</span>
                        <h2 class="modal-title">Cadastrar Parceiro Comercial</h2>
                    </div>
                    <button class="btn-close" @onclick="CloseCreateModal">&times;</button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(_createError))
                    {
                        <div class="alert alert-danger">@_createError</div>
                    }

                    <div class="form-section-title">1. Dados Cadastrais e Contato</div>
                    <div class="form-grid">
                        <div class="form-group full-width">
                            <label>Nome Completo ou Razão Social *</label>
                            <input type="text" class="form-control" @bind="_newPartner.FullName" @bind:event="oninput" @onkeyup="HandleFullNameKeyUp" placeholder="Ex: Dr. Roberto Silva ou Agropecuária São José" />
                        </div>
                        <div class="form-group">
                            <label>Nome Fantasia ou Apelido</label>
                            <input type="text" class="form-control" @bind="_newPartner.TradeName" placeholder="Ex: Silva Consultoria" />
                        </div>
                        <div class="form-group">
                            <label>Categoria de Atuação *</label>
                            <select class="form-select" @bind="_newPartner.Category">
                                <option value="@PartnerCategory.ZootechnicianConsultant">Consultor Zootécnico / Agrônomo</option>
                                <option value="@PartnerCategory.Veterinarian">Médico Veterinário</option>
                                <option value="@PartnerCategory.AgriculturalDealer">Revenda Agropecuária / Distribuidor</option>
                                <option value="@PartnerCategory.BreedAssociation">Associação de Raça / Núcleo</option>
                                <option value="@PartnerCategory.InfluencerOther">Influenciador Agro / Outro</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>E-mail de Contato * (Será criado login no Identity)</label>
                            <input type="email" class="form-control" @bind="_newPartner.Email" placeholder="contato@parceiro.com.br" />
                        </div>
                        <div class="form-group">
                            <label>Telefone / WhatsApp *</label>
                            <input type="text" class="form-control" @bind="_newPartner.PhoneNumber" placeholder="+55 67 99988-7766" />
                        </div>
                        <div class="form-group">
                            <label>Cidade</label>
                            <input type="text" class="form-control" @bind="_newPartner.City" placeholder="Campo Grande" />
                        </div>
                        <div class="form-group">
                            <label>UF (Estado)</label>
                            <input type="text" class="form-control" maxlength="2" @bind="_newPartner.State" placeholder="MS" style="text-transform: uppercase;" />
                        </div>
                    </div>

                    <div class="form-section-title mt-4">2. Código de Indicação (Link Rastreável)</div>
                    <div class="form-grid">
                        <div class="form-group full-width">
                            <label>Código Slug * (Ex: <code>criacerto.com/r/SILVA-AGRO</code>)</label>
                            <div class="input-with-button">
                                <input type="text" class="form-control" @bind="_newPartner.PreferredReferralCode" style="text-transform: uppercase;" placeholder="Sugestão automática..." />
                                <button type="button" class="btn btn-secondary" @onclick="SuggestCodeAsync">Gerar Slug</button>
                            </div>
                            <span class="hint-text">Normalizado automaticamente sem acentos ou caracteres especiais.</span>
                        </div>
                    </div>

                    <div class="form-section-title mt-4">3. Dados Fiscais e Chave Pix para Repasses</div>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>CPF ou CNPJ *</label>
                            <input type="text" class="form-control" @bind="_newPartner.LegalDocumentNumber" placeholder="00.000.000/0001-00 ou 000.000.000-00" />
                        </div>
                        <div class="form-group">
                            <label>Tipo de Chave Pix *</label>
                            <select class="form-select" @bind="_newPartner.PixKeyType">
                                <option value="@PixKeyType.Cnpj">CNPJ</option>
                                <option value="@PixKeyType.Cpf">CPF</option>
                                <option value="@PixKeyType.Email">E-mail</option>
                                <option value="@PixKeyType.Phone">Telefone</option>
                                <option value="@PixKeyType.RandomKey">Chave Aleatória (EVP)</option>
                            </select>
                        </div>
                        <div class="form-group full-width">
                            <label>Chave Pix *</label>
                            <input type="text" class="form-control" @bind="_newPartner.PixKey" placeholder="Informe a chave Pix correspondente" />
                        </div>
                    </div>

                    <div class="form-section-title mt-4">4. Regra de Comissão e Vigência Contratual</div>
                    <div class="form-grid">
                        <div class="form-group full-width">
                            <label>Modelo de Comissionamento *</label>
                            <div class="radio-cards">
                                <label class="radio-card @(_newPartner.CommissionType == CommissionType.PercentageRecurring ? "selected" : "")">
                                    <input type="radio" name="commType" checked="@(_newPartner.CommissionType == CommissionType.PercentageRecurring)" @onchange="() => _newPartner.CommissionType = CommissionType.PercentageRecurring" />
                                    <div>
                                        <strong>Percentual Recorrente</strong>
                                        <p>Comissão sobre cada mensalidade paga durante a janela definida.</p>
                                    </div>
                                </label>
                                <label class="radio-card @(_newPartner.CommissionType == CommissionType.PercentageFirstMonth ? "selected" : "")">
                                    <input type="radio" name="commType" checked="@(_newPartner.CommissionType == CommissionType.PercentageFirstMonth)" @onchange="() => _newPartner.CommissionType = CommissionType.PercentageFirstMonth" />
                                    <div>
                                        <strong>1ª Mensalidade Apenas</strong>
                                        <p>Comissão percentual unicamente sobre a primeira fatura convertida.</p>
                                    </div>
                                </label>
                                <label class="radio-card @(_newPartner.CommissionType == CommissionType.FixedPerConversion ? "selected" : "")">
                                    <input type="radio" name="commType" checked="@(_newPartner.CommissionType == CommissionType.FixedPerConversion)" @onchange="() => _newPartner.CommissionType = CommissionType.FixedPerConversion" />
                                    <div>
                                        <strong>Valor Fixo por Conversão</strong>
                                        <p>Bônus fixo em R$ após a confirmação do primeiro pagamento do indicado.</p>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>@(_newPartner.CommissionType == CommissionType.FixedPerConversion ? "Valor Fixo (R$) *" : "Taxa de Comissão (%) *")</label>
                            <input type="number" step="0.01" class="form-control" @bind="_newPartner.CommissionValue" placeholder="@(_newPartner.CommissionType == CommissionType.FixedPerConversion ? "350.00" : "20.00")" />
                        </div>

                        @if (_newPartner.CommissionType == CommissionType.PercentageRecurring)
                        {
                            <div class="form-group">
                                <label>Duração Máxima em Meses (Deixe vazio para vitalício)</label>
                                <input type="number" class="form-control" @bind="_newPartner.MaxRecurringMonths" placeholder="Ex: 12" />
                            </div>
                        }

                        <div class="form-group">
                            <label>Prazo de Carência para Repasse (Dias) *</label>
                            <input type="number" class="form-control" @bind="_newPartner.PaymentTermsDays" placeholder="30" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseCreateModal">Cancelar</button>
                    <button class="btn btn-primary" @onclick="HandleSubmitCreateAsync" disabled="@_isSubmitting">
                        @(_isSubmitting ? "Cadastrando..." : "Confirmar e Cadastrar Parceiro")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL: PROPOR AJUSTE DE COMISSÃO (4-OLHOS) -->
@if (_showContractChangeModal && _selectedPartnerForContract is not null)
{
    <div class="modal-backdrop">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <span class="badge-growth">Governança 4-Olhos</span>
                        <h2 class="modal-title">Ajuste Contratual de Comissão</h2>
                    </div>
                    <button class="btn-close" @onclick="CloseContractChangeModal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="partner-summary-banner">
                        <strong>@_selectedPartnerForContract.FullName</strong>
                        <span>Comissão Vigente: @FormatCommission(_selectedPartnerForContract.CommissionType, _selectedPartnerForContract.CommissionValue, _selectedPartnerForContract.MaxRecurringMonths)</span>
                    </div>

                    <div class="alert alert-info mt-3">
                        🛡️ <strong>Princípio de 4-Olhos (Dual Control):</strong> Esta alteração gera uma solicitação de aprovação administrativa. A nova comissão entrará em vigor imediatamente após a revisão de um segundo operador.
                    </div>

                    <div class="form-group mt-3">
                        <label>Novo Modelo de Comissão *</label>
                        <select class="form-select" @bind="_contractProposal.CommissionType">
                            <option value="@CommissionType.PercentageRecurring">Percentual Recorrente</option>
                            <option value="@CommissionType.PercentageFirstMonth">1ª Mensalidade</option>
                            <option value="@CommissionType.FixedPerConversion">Fixo por Conversão</option>
                        </select>
                    </div>

                    <div class="form-group mt-3">
                        <label>@(_contractProposal.CommissionType == CommissionType.FixedPerConversion ? "Novo Valor Fixo (R$) *" : "Nova Taxa (%) *")</label>
                        <input type="number" step="0.01" class="form-control" @bind="_contractProposal.CommissionValue" />
                    </div>

                    @if (_contractProposal.CommissionType == CommissionType.PercentageRecurring)
                    {
                        <div class="form-group mt-3">
                            <label>Duração Máxima em Meses (Vazio para vitalício)</label>
                            <input type="number" class="form-control" @bind="_contractProposal.MaxRecurringMonths" placeholder="Ex: 12" />
                        </div>
                    }

                    <div class="form-group mt-3">
                        <label>Justificativa Administrativa Obrigatória * (Mínimo 10 caracteres)</label>
                        <textarea class="form-control" rows="3" @bind="_contractProposal.Justification" placeholder="Descreva os motivos da renegociação comercial..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseContractChangeModal">Cancelar</button>
                    <button class="btn btn-primary" @onclick="HandleSubmitContractProposalAsync" disabled="@_isSubmitting">
                        @(_isSubmitting ? "Enviando..." : "Submeter para Aprovação 4-Olhos")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL: DETALHES E HISTÓRICO CONTRATUAL -->
@if (_showDetailsModal && _partnerDetail is not null)
{
    <div class="modal-backdrop">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <span class="badge-growth">Dossiê do Parceiro</span>
                        <h2 class="modal-title">@_partnerDetail.FullName</h2>
                    </div>
                    <button class="btn-close" @onclick="CloseDetailsModal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="details-overview-grid">
                        <div class="overview-item">
                            <span class="overview-label">Código Oficial:</span>
                            <span class="overview-value"><code>@_partnerDetail.ReferralCode</code></span>
                        </div>
                        <div class="overview-item">
                            <span class="overview-label">E-mail:</span>
                            <span class="overview-value">@_partnerDetail.Email</span>
                        </div>
                        <div class="overview-item">
                            <span class="overview-label">Telefone:</span>
                            <span class="overview-value">@_partnerDetail.PhoneNumber</span>
                        </div>
                        <div class="overview-item">
                            <span class="overview-label">Localização:</span>
                            <span class="overview-value">@(_partnerDetail.City ?? "N/A") / @(_partnerDetail.State ?? "N/A")</span>
                        </div>
                        <div class="overview-item">
                            <span class="overview-label">Total de Cliques:</span>
                            <span class="overview-value text-info">@_partnerDetail.ClicksCount</span>
                        </div>
                        <div class="overview-item">
                            <span class="overview-label">Status da Conta:</span>
                            <span class="overview-value">@(_partnerDetail.Status == ParticipantStatus.Active ? "🟢 Ativo" : "🔴 Suspenso")</span>
                        </div>
                    </div>

                    <h4 class="mt-4 mb-2">📜 Histórico de Contratos Comerciais</h4>
                    @if (!_partnerDetail.ContractHistory.Any())
                    {
                        <p class="text-muted">Nenhum contrato arquivado.</p>
                    }
                    else
                    {
                        <table class="data-table mt-2">
                            <thead>
                                <tr>
                                    <th>Vigência</th>
                                    <th>Comissão</th>
                                    <th>Prazo</th>
                                    <th>Chave Pix</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in _partnerDetail.ContractHistory)
                                {
                                    <tr style="@(c.IsActive ? "background: rgba(16, 185, 129, 0.08);" : "")">
                                        <td>@c.ValidFromUtc.ToLocalTime().ToString("dd/MM/yyyy") @(c.ValidToUtc.HasValue ? $"até {c.ValidToUtc.Value.ToLocalTime():dd/MM/yyyy}" : " (Vigente)")</td>
                                        <td>@FormatCommission(c.CommissionType, c.CommissionValue, c.MaxRecurringMonths)</td>
                                        <td>@(c.PaymentTermsDays) dias</td>
                                        <td><code>@c.PixKey</code> (@c.PixKeyType)</td>
                                        <td>
                                            @if (c.IsActive)
                                            {
                                                <span class="status-badge status-active">Vigente</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-closed">Encerrado</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDetailsModal">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL: SUSPENDER PARCEIRO -->
@if (_showSuspendModal && _selectedPartnerForSuspend is not null)
{
    <div class="modal-backdrop">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <span class="badge-danger">Suspensão de Operação</span>
                        <h2 class="modal-title">Suspender Parceiro Comercial</h2>
                    </div>
                    <button class="btn-close" @onclick="CloseSuspendModal">&times;</button>
                </div>
                <div class="modal-body">
                    <p>Tem certeza que deseja suspender <strong>@_selectedPartnerForSuspend.FullName</strong>?</p>
                    <p class="text-muted text-sm">O link de indicação deixará de registrar novos cliques e os repasses serão retidos até a reativação.</p>

                    <div class="form-group mt-3">
                        <label>Justificativa Obrigatória *</label>
                        <textarea class="form-control" rows="3" @bind="_suspendReason" placeholder="Motivo da suspensão..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseSuspendModal">Cancelar</button>
                    <button class="btn btn-danger" @onclick="HandleConfirmSuspendAsync" disabled="@_isSubmitting">
                        @(_isSubmitting ? "Suspendendo..." : "Confirmar Suspensão")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

