@code {
    private const string TabAvailable = "available";
    private const string TabPending = "pending";
    private const string TabHistory = "history";

    private string _currentTab = TabAvailable;
    private bool _isLoading = false;
    private bool _isSubmitting = false;
    private bool _isExporting = false;
    private string _searchTerm = string.Empty;

    private PayoutDashboardKpiDto? _kpis;
    private List<AvailablePartnerPayoutDto> _availablePayouts = new();
    private List<PendingMaturityCommissionDto> _pendingCommissions = new();
    private List<PayoutHistoryDto> _payoutHistory = new();
    private HashSet<Guid> _expandedPartnerIds = new();

    // Modal Payout State
    private bool _isPayoutModalOpen = false;
    private AvailablePartnerPayoutDto? _selectedPartnerForPayout;
    private string _payoutTransactionReference = string.Empty;
    private IBrowserFile? _selectedFile;

    // Modal Cancel State
    private bool _isCancelModalOpen = false;
    private PendingMaturityCommissionDto? _selectedCommissionForCancel;
    private string _cancelReason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    private void SetTab(string tab)
    {
        _currentTab = tab;
    }

    private void ToggleAccordion(Guid partnerId)
    {
        if (_expandedPartnerIds.Contains(partnerId))
            _expandedPartnerIds.Remove(partnerId);
        else
            _expandedPartnerIds.Add(partnerId);
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadCurrentTabDataAsync();
        }
    }

    private async Task LoadAllDataAsync()
    {
        _isLoading = true;
        try
        {
            _kpis = await ApiClient.GetPayoutDashboardKpisAsync();
            var availTask = ApiClient.GetAvailablePartnerPayoutsAsync(_searchTerm);
            var pendTask = ApiClient.GetPendingMaturityCommissionsAsync(_searchTerm);
            var histTask = ApiClient.GetPayoutHistoryAsync(_searchTerm);

            await Task.WhenAll(availTask, pendTask, histTask);

            _availablePayouts = (await availTask)?.ToList() ?? new List<AvailablePartnerPayoutDto>();
            _pendingCommissions = (await pendTask)?.ToList() ?? new List<PendingMaturityCommissionDto>();
            _payoutHistory = (await histTask)?.ToList() ?? new List<PayoutHistoryDto>();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Erro ao carregar dados do painel: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadCurrentTabDataAsync()
    {
        _isLoading = true;
        try
        {
            if (_currentTab == TabAvailable)
            {
                var res = await ApiClient.GetAvailablePartnerPayoutsAsync(_searchTerm);
                _availablePayouts = res?.ToList() ?? new List<AvailablePartnerPayoutDto>();
            }
            else if (_currentTab == TabPending)
            {
                var res = await ApiClient.GetPendingMaturityCommissionsAsync(_searchTerm);
                _pendingCommissions = res?.ToList() ?? new List<PendingMaturityCommissionDto>();
            }
            else if (_currentTab == TabHistory)
            {
                var res = await ApiClient.GetPayoutHistoryAsync(_searchTerm);
                _payoutHistory = res?.ToList() ?? new List<PayoutHistoryDto>();
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Erro ao filtrar: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ExportPixBatchAsync()
    {
        _isExporting = true;
        try
        {
            var result = await ApiClient.ExportPixBatchCsvAsync();
            if (result.IsSuccess)
            {
                await JS.InvokeVoidAsync("downloadFileFromByteArray", result.FileName, "text/csv", result.Content);
                Toast.ShowSuccess("Remessa Pix gerada com sucesso!");
            }
            else
            {
                Toast.ShowError(result.ErrorMessage ?? "Falha ao gerar arquivo de remessa Pix.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Erro ao exportar remessa: {ex.Message}");
        }
        finally
        {
            _isExporting = false;
        }
    }

    private void OpenPayoutModal(AvailablePartnerPayoutDto partner)
    {
        _selectedPartnerForPayout = partner;
        _payoutTransactionReference = string.Empty;
        _selectedFile = null;
        _isPayoutModalOpen = true;
    }

    private void ClosePayoutModal()
    {
        if (_isSubmitting) return;
        _isPayoutModalOpen = false;
        _selectedPartnerForPayout = null;
        _selectedFile = null;
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        if (_selectedFile != null && _selectedFile.Size > 5 * 1024 * 1024)
        {
            Toast.ShowError("O comprovante excede o tamanho máximo de 5 MB.");
            _selectedFile = null;
        }
    }

    private async Task SubmitPayoutAsync()
    {
        if (_selectedPartnerForPayout is null || _selectedFile is null || string.IsNullOrWhiteSpace(_payoutTransactionReference))
        {
            Toast.ShowError("Preencha o código de transação bancária e anexe o comprovante de pagamento.");
            return;
        }

        _isSubmitting = true;
        try
        {
            var ledgerIds = _selectedPartnerForPayout.Commissions.Select(c => c.LedgerId).ToList();
            await using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);

            var result = await ApiClient.RegisterPartnerPayoutBatchAsync(
                _selectedPartnerForPayout.ParticipantId,
                ledgerIds,
                _payoutTransactionReference.Trim(),
                stream,
                _selectedFile.Name,
                _selectedFile.ContentType
            );

            if (result.IsSuccess)
            {
                Toast.ShowSuccess($"Baixa financeira efetuada com sucesso! {result.Value} comissão(ões) liquidada(s).");
                ClosePayoutModal();
                await LoadAllDataAsync();
            }
            else
            {
                Toast.ShowError(result.Error.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Erro ao registrar baixa: {ex.Message}");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void OpenCancelModal(PendingMaturityCommissionDto commission)
    {
        _selectedCommissionForCancel = commission;
        _cancelReason = string.Empty;
        _isCancelModalOpen = true;
    }

    private void CloseCancelModal()
    {
        if (_isSubmitting) return;
        _isCancelModalOpen = false;
        _selectedCommissionForCancel = null;
    }

    private async Task SubmitCancelCommissionAsync()
    {
        if (_selectedCommissionForCancel is null || string.IsNullOrWhiteSpace(_cancelReason) || _cancelReason.Trim().Length < 10)
        {
            Toast.ShowError("A justificativa é obrigatória e deve possuir no mínimo 10 caracteres.");
            return;
        }

        _isSubmitting = true;
        try
        {
            var result = await ApiClient.CancelCommissionLedgerEntryAsync(
                _selectedCommissionForCancel.LedgerId,
                _cancelReason.Trim()
            );

            if (result.IsSuccess)
            {
                Toast.ShowSuccess("Comissão cancelada com sucesso!");
                CloseCancelModal();
                await LoadAllDataAsync();
            }
            else
            {
                Toast.ShowError(result.Error.Message);
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Erro ao cancelar comissão: {ex.Message}");
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
