        _editMonthlyPrice = draftVersion.MonthlyPrice;
        _editAnnualPriceMonthly = draftVersion.AnnualPriceMonthly;
        _editHeadCapacityLimit = draftVersion.HeadCapacityLimit;
        _editMaxUsers = draftVersion.MaxUsers;
        _editMaxProductionUnits = draftVersion.MaxProductionUnits;

        _editSelectedFeatures = _availableFeatureKeys.Keys.ToDictionary(
            k => k,
            k => draftVersion.Features.Any(f => f.FeatureKey == k && f.IsEnabled)
        );

        _showEditDraftModal = true;
    }

    private void ToggleFeature(string key, object? isCheckedObj)
    {
        bool isChecked = isCheckedObj is bool b && b;
        _editSelectedFeatures[key] = isChecked;
    }

    private async Task SubmitUpdateDraftVersion()
    {
        if (_targetEditDraftVersion is null || string.IsNullOrWhiteSpace(_editVersionName)) return;

        var featureInputs = _editSelectedFeatures.Select(kv => new PlanFeatureInputDto(
            kv.Key, _availableFeatureKeys.TryGetValue(kv.Key, out var name) ? name : kv.Key, kv.Value, "ModuleAccess"
        )).ToList();

        var limitInputs = new List<PlanLimitInputDto>
        {
            new("MaxCattleHeads", _editHeadCapacityLimit, "cabeças")
        };

        var command = new UpdateDraftPlanVersionCommand(
            _targetEditDraftVersion.Id, _editVersionName, _editMonthlyPrice, _editAnnualPriceMonthly, _editHeadCapacityLimit,
            _editMaxUsers, _editMaxProductionUnits, featureInputs, limitInputs, Guid.Empty, "", ""
        );

        var result = await ApiClient.UpdateDraftPlanVersionAsync(_targetEditDraftVersion.Id, command);
        if (result != null)
        {
            CloseModals();
            await LoadPlansAsync();
        }
    }

    private void OpenPublishModal(PlanCatalogDto plan, PlanVersionDto draftVersion)
    {
        _targetPublishPlan = plan;
        _targetPublishVersion = draftVersion;
        _approvalNotes = "";
        _publishErrorMessage = null;
        _showPublishModal = true;
    }

    private async Task ConfirmPublishVersion()
    {
        if (_targetPublishVersion is null || string.IsNullOrWhiteSpace(_approvalNotes)) return;

        _publishErrorMessage = null;
        var result = await ApiClient.PublishPlanVersionAsync(_targetPublishVersion.Id, _approvalNotes);
        if (result != null)
        {
            CloseModals();
            await LoadPlansAsync();
        }
        else
        {
            _publishErrorMessage = "Não foi possível publicar a versão do plano.";
        }
    }

    private async Task OpenCompareModal(PlanCatalogDto plan)
    {
        if (plan.Versions.Count < 2) return;

        _targetComparePlan = plan;
        _selectedBaseVersionId = plan.ActiveVersion?.Id ?? plan.Versions.First().Id;
        _selectedTargetVersionId = plan.DraftVersion?.Id ?? plan.Versions.Last().Id;

        if (_selectedBaseVersionId == _selectedTargetVersionId)
        {
            _selectedTargetVersionId = plan.Versions.FirstOrDefault(v => v.Id != _selectedBaseVersionId)?.Id ?? _selectedBaseVersionId;
        }

        _showCompareModal = true;
        await LoadComparisonAsync();
    }

    private async Task OnBaseVersionChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _selectedBaseVersionId = id;
            await LoadComparisonAsync();
        }
    }

    private async Task OnTargetVersionChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _selectedTargetVersionId = id;
            await LoadComparisonAsync();
        }
    }

    private async Task LoadComparisonAsync()
    {
        if (_selectedBaseVersionId == Guid.Empty || _selectedTargetVersionId == Guid.Empty) return;

        _isComparing = true;
        try
        {
            _comparisonDto = await ApiClient.ComparePlanVersionsAsync(_selectedBaseVersionId, _selectedTargetVersionId);
        }
        finally
        {
            _isComparing = false;
        }
    }
}

