@page "/backoffice/plans"
@layout Layout.BackofficeLayout
@using CriaCerto.Modules.Backoffice.Application.Features.Plans.Dtos
@using CriaCerto.Modules.Backoffice.Application.Features.Plans.Commands
@using CriaCerto.Modules.Backoffice.Application.Security
@using CriaCerto.Web.Client.Components.Backoffice
@using CriaCerto.Web.Client.Services
@inject IBackofficeApiClient ApiClient
@attribute [Authorize]

<div class="plans-management-container">
    <header class="page-header">
        <div>
            <span class="badge-category">Gestão Comercial & Catálogo</span>
            <h1 class="page-title">Catálogo de Planos & Matriz Modular</h1>
            <p class="page-subtitle">Gerencie o modelo Self-Service À La Carte por faixas de rebanho e módulos adicionais, além de versões e históricos legados.</p>
        </div>

        <div class="header-actions">
            @if (_activeTab == "modular")
            {
                <PermissionGuard Permission="@BackofficePermissions.PlansWrite">
                    <button class="btn btn-outline" @onclick="OpenCreateTierModal">
                        <span class="icon">🏷️</span> Nova Faixa
                    </button>
                    <button class="btn btn-primary" @onclick="OpenCreateModuleModal">
                        <span class="icon">➕</span> Novo Módulo
                    </button>
                </PermissionGuard>
            }
            else
            {
                <PermissionGuard Permission="@BackofficePermissions.PlansWrite">
                    <button class="btn btn-primary" @onclick="OpenCreatePlanModal">
                        <span class="icon">➕</span> Novo Plano Legado
                    </button>
                </PermissionGuard>
            }
        </div>
    </header>

    <!-- Tab navigation -->
    <div class="tabs-nav">
        <button class="tab-btn @(_activeTab == "modular" ? "active" : "")" @onclick='() => SetTab("modular")'>
            <span class="tab-icon">🎛️</span> Matriz Modular (Faixas x Módulos)
            <span class="tab-badge">Novo</span>
        </button>
        <button class="tab-btn @(_activeTab == "legacy" ? "active" : "")" @onclick='() => SetTab("legacy")'>
            <span class="tab-icon">📦</span> Planos Legados (Histórico & Versões)
        </button>
    </div>

    @if (_activeTab == "modular")
    {
        <!-- MODULAR MATRIX TAB -->
        <div class="modular-catalog-section">
            <div class="kpis-grid">
                <div class="kpi-card">
                    <span class="kpi-label">Faixas de Cabeças</span>
                    <span class="kpi-value">@(_headTiers?.Count(t => t.IsActive) ?? 0)</span>
                    <span class="kpi-sub">Cadastradas e ativas</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Módulos no Catálogo</span>
                    <span class="kpi-value">@(_modules?.Count(m => m.IsActive) ?? 0)</span>
                    <span class="kpi-sub">@(_modules?.Count(m => m.IsCore) ?? 0) Core · @(_modules?.Count(m => !m.IsCore && m.IsActive) ?? 0) Add-ons</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Preços Publicados</span>
                    <span class="kpi-value">@(_modules?.Sum(m => m.ActivePrices.Count) ?? 0)</span>
                    <span class="kpi-sub">Matriz Módulo x Faixa</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Rascunhos Pendentes</span>
                    <span class="kpi-value warning">@(_modules?.Sum(m => m.DraftPrices.Count) ?? 0)</span>
                    <span class="kpi-sub">Aguardando publicação</span>
                </div>
            </div>

            @if (_isLoadingModular)
            {
                <div class="loading-state">
                    <div class="spinner"></div>
                    <p>Carregando matriz de módulos e faixas de cabeças...</p>
                </div>
            }
            else if (_headTiers is null || !_headTiers.Any() || _modules is null || !_modules.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">🎛️</div>
                    <h3>Matriz Modular não inicializada</h3>
                    <p>Cadastre as faixas de cabeças e os módulos do catálogo para estruturar a matriz de preços.</p>
                </div>
            }
            else
            {
                <div class="matrix-card">
                    <div class="matrix-header">
                        <div>
                            <h3 class="matrix-title">Matriz de Preços: Módulos x Faixas de Capacidade</h3>
                            <p class="matrix-subtitle">Os preços publicados são aplicados instantaneamente no checkout e na personalização de assinaturas modulares.</p>
                        </div>
                    </div>

                    <div class="matrix-table-container">
                        <table class="matrix-table">
                            <thead>
                                <tr>
                                    <th class="col-module">Módulo do Sistema</th>
                                    @foreach (var tier in _headTiers.OrderBy(t => t.SortOrder).ThenBy(t => t.MinHeads))
                                    {
                                        <th class="col-tier">
                                            <div class="tier-th-content">
                                                <div class="tier-th-top">
                                                    <span class="tier-code">@tier.TierCode</span>
                                                    <button class="btn-xs btn-ghost" title="Editar Faixa" @onclick="() => OpenEditTierModal(tier)">✏️</button>
                                                </div>
                                                <span class="tier-name">@tier.DisplayName</span>
                                                <span class="tier-range">@tier.MinHeads.ToString("N0") a @tier.MaxHeads.ToString("N0") cab.</span>
                                            </div>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var module in _modules.OrderBy(m => m.SortOrder).ThenBy(m => m.Name))
                                {
                                    <tr class="@(!module.IsActive ? "row-inactive" : "")">
                                        <td class="col-module-cell">
                                            <div class="module-info-box">
                                                <div class="module-title-row">
                                                    <span class="module-icon">@module.Icon</span>
                                                    <span class="module-name">@module.Name</span>
                                                    @if (module.IsCore)
                                                    {
                                                        <span class="core-badge" title="Módulo base incluído compulsoriamente em todas as assinaturas">Core</span>
                                                    }
                                                    <button class="btn-xs btn-ghost" title="Editar Módulo" @onclick="() => OpenEditModuleModal(module)">✏️</button>
                                                </div>
                                                <span class="module-key">@module.ModuleKey</span>
                                                <p class="module-desc">@module.Description</p>
                                            </div>
                                        </td>

                                        @foreach (var tier in _headTiers.OrderBy(t => t.SortOrder).ThenBy(t => t.MinHeads))
                                        {
                                            var activePrice = module.ActivePrices.FirstOrDefault(p => p.HeadTierCatalogId == tier.Id);
                                            var draftPrice = module.DraftPrices.FirstOrDefault(p => p.HeadTierCatalogId == tier.Id);

                                            <td class="col-price-cell">
                                                @if (draftPrice != null)
                                                {
                                                    <div class="price-cell-box draft">
                                                        <div class="cell-status-bar">
                                                            <span class="status-tag draft">✏️ Rascunho v@draftPrice.VersionNumber</span>
                                                        </div>
                                                        <div class="cell-prices">
                                                            <span class="p-monthly">R$ @draftPrice.MonthlyPrice.ToString("N2")<small>/mês</small></span>
                                                            <span class="p-annual">R$ @draftPrice.AnnualPriceMonthly.ToString("N2")<small>/mês anual</small></span>
                                                        </div>
                                                        <div class="cell-actions">
                                                            <PermissionGuard Permission="@BackofficePermissions.PlansWrite">
                                                                <button class="btn btn-xs btn-outline" @onclick="() => OpenEditTierPriceModal(module, tier, draftPrice)">Editar</button>
                                                            </PermissionGuard>
                                                            <PermissionGuard Permission="@BackofficePermissions.PlansPublish">
                                                                <FeatureFlagGuard FlagKey="backoffice.feature.plan_publishing">
                                                                    <ChildContent>
                                                                        <button class="btn btn-xs btn-success" @onclick="() => OpenPublishTierPriceModal(module, tier, draftPrice)">Publicar</button>
                                                                    </ChildContent>
                                                                    <Disabled>
                                                                        <button class="btn btn-xs btn-secondary opacity-50" disabled title="Publicação bloqueada por rollout">🔒</button>
                                                                    </Disabled>
                                                                </FeatureFlagGuard>
                                                            </PermissionGuard>
                                                        </div>
                                                    </div>
                                                }
                                                else if (activePrice != null)
                                                {
                                                    <div class="price-cell-box published">
                                                        <div class="cell-status-bar">
                                                            <span class="status-tag published">● Publicado v@activePrice.VersionNumber</span>
                                                        </div>
                                                        <div class="cell-prices">
                                                            <span class="p-monthly">R$ @activePrice.MonthlyPrice.ToString("N2")<small>/mês</small></span>
                                                            <span class="p-annual">R$ @activePrice.AnnualPriceMonthly.ToString("N2")<small>/mês anual</small></span>
                                                        </div>
                                                        <div class="cell-actions">
                                                            <PermissionGuard Permission="@BackofficePermissions.PlansWrite">
                                                                <button class="btn btn-xs btn-ghost" @onclick="() => OpenCreateTierPriceModal(module, tier, activePrice)">➕ Novo Rascunho</button>
                                                            </PermissionGuard>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="price-cell-box empty">
                                                        <span class="text-subtle">Sem preço</span>
                                                        <PermissionGuard Permission="@BackofficePermissions.PlansWrite">
                                                            <button class="btn btn-xs btn-secondary" @onclick="() => OpenCreateTierPriceModal(module, tier)">+ Definir</button>
                                                        </PermissionGuard>
                                                    </div>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- LEGACY PLANS TAB -->
        <div class="legacy-catalog-section">
            @if (_isLoading)
            {
                <div class="loading-state">
                    <div class="spinner"></div>
                    <p>Carregando catálogo de planos legados...</p>
                </div>
            }
            else if (_plans is null || !_plans.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">💳</div>
                    <h3>Nenhum plano legado encontrado</h3>
                    <p>Os planos cadastrados nesta seção são mantidos apenas para histórico e retrocompatibilidade.</p>
                </div>
            }
            else
            {
                <div class="plans-grid">
                    @foreach (var plan in _plans)
                    {
                        <div class="plan-card @(plan.IsArchived ? "archived" : "")">
                            <div class="plan-card-header">
                                <div class="plan-header-main">
                                    <span class="plan-code">@plan.Code</span>
                                    <span class="plan-category">@plan.Category</span>
                                </div>
                                <h2 class="plan-name">@plan.Name</h2>
                                <p class="plan-description">@plan.Description</p>
                            </div>

                            <div class="plan-card-body">
                                @if (plan.ActiveVersion != null)
                                {
                                    <div class="version-box active-version">
                                        <div class="version-box-header">
                                            <span class="status-badge published">● Versão Ativa (@plan.ActiveVersion.VersionName)</span>
                                            <span class="version-num">v@plan.ActiveVersion.VersionNumber.0</span>
                                        </div>
                                        <div class="price-row">
                                            <span class="price">R$ @plan.ActiveVersion.MonthlyPrice.ToString("N2")/mês</span>
                                            <span class="price-sub">R$ @plan.ActiveVersion.AnnualPriceMonthly.ToString("N2")/mês no anual</span>
                                        </div>
                                        <div class="limits-row">
                                            <span>Capacidade: <strong>@plan.ActiveVersion.HeadCapacityLimit.ToString("N0") cabeças</strong></span>
                                        </div>
                                        <div class="features-summary">
                                            <span class="feature-count">@plan.ActiveVersion.Features.Count(f => f.IsEnabled) módulos inclusos</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="version-box no-active">
                                        <span>Nenhuma versão publicada ativa</span>
                                    </div>
                                }

                                @if (plan.DraftVersion != null)
                                {
                                    <div class="version-box draft-version">
                                        <div class="version-box-header">
                                            <span class="status-badge draft">✏️ Rascunho em Edição (@plan.DraftVersion.VersionName)</span>
                                            <span class="version-num">v@plan.DraftVersion.VersionNumber.0</span>
                                        </div>
                                        <div class="price-row">
                                            <span class="price">R$ @plan.DraftVersion.MonthlyPrice.ToString("N2")/mês</span>
                                        </div>
                                        <div class="draft-actions">
                                            <PermissionGuard Permission="@BackofficePermissions.PlansWrite">
                                                <button class="btn btn-sm btn-outline" @onclick="() => OpenEditDraftModal(plan, plan.DraftVersion)">Editar Rascunho</button>
                                            </PermissionGuard>
                                            <PermissionGuard Permission="@BackofficePermissions.PlansPublish">
                                                <FeatureFlagGuard FlagKey="backoffice.feature.plan_publishing">
                                                    <ChildContent>
                                                        <button class="btn btn-sm btn-success" @onclick="() => OpenPublishModal(plan, plan.DraftVersion)">Publicar Versão</button>
                                                    </ChildContent>
                                                    <Disabled>
                                                        <button class="btn btn-sm btn-secondary opacity-50" disabled title="Publicação suspensa por governança de rollout">
                                                            🔒 Publicação Bloqueada
                                                        </button>
                                                    </Disabled>
                                                </FeatureFlagGuard>
                                            </PermissionGuard>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="plan-card-footer">
                                <div class="versions-history">
                                    <span class="history-label">Histórico de Versões (@plan.Versions.Count)</span>
                                    <div class="version-tags">
                                        @foreach (var v in plan.Versions)
                                        {
                                            <span class="v-tag @v.Status.ToLower()">v@v.VersionNumber (@v.Status)</span>
                                        }
                                    </div>
                                </div>

                                <div class="card-footer-actions">
                                    @if (plan.DraftVersion == null)
                                    {
                                        <PermissionGuard Permission="@BackofficePermissions.PlansWrite">
                                            <button class="btn btn-sm btn-secondary" @onclick="() => CreateNewVersionDraft(plan)">
                                                ➕ Criar Rascunho
                                            </button>
                                        </PermissionGuard>
                                    }

                                    @if (plan.Versions.Count >= 2)
                                    {
                                        <button class="btn btn-sm btn-ghost" @onclick="() => OpenCompareModal(plan)">
                                            🔍 Comparar
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<!-- MODAL: Criar / Editar Faixa de Cabeças -->
@if (_showTierModal)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            <div class="modal-header">
                <h3>@(_isEditingTier ? "Editar Faixa de Cabeças" : "Nova Faixa de Cabeças")</h3>
                <button class="btn-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Código da Faixa (Slug Único)</label>
                    <input class="form-input" @bind="_tierCode" placeholder="ex: TIER_10000" disabled="@_isEditingTier" />
                </div>
                <div class="form-group">
                    <label>Nome de Exibição Comercial</label>
                    <input class="form-input" @bind="_tierDisplayName" placeholder="ex: Até 10.000 cabeças" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Mínimo de Cabeças</label>
                        <input type="number" class="form-input" @bind="_tierMinHeads" step="100" />
                    </div>
                    <div class="form-group">
                        <label>Máximo de Cabeças</label>
                        <input type="number" class="form-input" @bind="_tierMaxHeads" step="100" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Ordem de Exibição</label>
                        <input type="number" class="form-input" @bind="_tierSortOrder" />
                    </div>
                    <div class="form-group" style="display: flex; align-items: center; justify-content: flex-start; margin-top: 1.8rem;">
                        <label style="cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
                            <input type="checkbox" @bind="_tierIsActive" /> Faixa Ativa
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="CloseModals">Cancelar</button>
                <button class="btn btn-primary" @onclick="SubmitTier">Salvar Faixa</button>
            </div>
        </div>
    </div>
}

<!-- MODAL: Criar / Editar Módulo -->
@if (_showModuleModal)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            <div class="modal-header">
                <h3>@(_isEditingModule ? "Editar Módulo do Catálogo" : "Novo Módulo do Catálogo")</h3>
                <button class="btn-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Chave do Módulo (ModuleKey Único)</label>
                    <input class="form-input" @bind="_moduleKey" placeholder="ex: Feedlot, Sanitary, Cows" disabled="@_isEditingModule" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Nome Comercial</label>
                        <input class="form-input" @bind="_moduleName" placeholder="ex: Manejo de Confinamento" />
                    </div>
                    <div class="form-group">
                        <label>Ícone / Emoji</label>
                        <input class="form-input" @bind="_moduleIcon" placeholder="ex: 🌾, 💉, 🐂" />
                    </div>
                </div>
                <div class="form-group">
                    <label>Descrição</label>
                    <textarea class="form-input" rows="2" @bind="_moduleDescription" placeholder="Descrição do escopo do módulo..."></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Ordem de Exibição</label>
                        <input type="number" class="form-input" @bind="_moduleSortOrder" />
                    </div>
                    <div class="form-group" style="margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0.4rem;">
                        <label style="cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
                            <input type="checkbox" @bind="_moduleIsCore" /> Módulo Core (Obrigatório)
                        </label>
                        <label style="cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
                            <input type="checkbox" @bind="_moduleIsActive" /> Módulo Ativo
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="CloseModals">Cancelar</button>
                <button class="btn btn-primary" @onclick="SubmitModule">Salvar Módulo</button>
            </div>
        </div>
    </div>
}

<!-- MODAL: Criar / Editar Rascunho de Preço por Faixa -->
@if (_showTierPriceModal)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            <div class="modal-header">
                <h3>Preço: @_targetPriceModule?.Name × @_targetPriceTier?.DisplayName</h3>
                <button class="btn-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body">
                <p class="text-subtle mb-3">Defina os valores em reais para cobrança mensal e anual. A publicação posterior tornará esta versão imutável.</p>
                <div class="form-row">
                    <div class="form-group">
                        <label>Preço Mensal (R$)</label>
                        <input type="number" step="0.01" class="form-input" @bind="_priceMonthly" />
                    </div>
                    <div class="form-group">
                        <label>Preço Anual Mensalizado (R$)</label>
                        <input type="number" step="0.01" class="form-input" @bind="_priceAnnualMonthly" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Stripe Price ID (Mensal) - Opcional</label>
                        <input class="form-input" @bind="_stripePriceIdMonthly" placeholder="price_1xxxx_monthly" />
                    </div>
                    <div class="form-group">
                        <label>Stripe Price ID (Anual) - Opcional</label>
                        <input class="form-input" @bind="_stripePriceIdAnnual" placeholder="price_1xxxx_annual" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="CloseModals">Cancelar</button>
                <button class="btn btn-primary" @onclick="SubmitTierPriceDraft">Salvar Rascunho</button>
            </div>
        </div>
    </div>
}

<!-- MODAL: Publicar Preço de Módulo por Faixa -->
@if (_showPublishTierPriceModal && _targetPriceToPublish != null)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            <div class="modal-header">
                <h3>Publicar Preço v@_targetPriceToPublish.VersionNumber</h3>
                <button class="btn-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrWhiteSpace(_publishTierPriceErrorMessage))
                {
                    <div class="alert alert-danger mb-3">
                        ⚠️ @_publishTierPriceErrorMessage
                    </div>
                }
                <div class="alert-warning mb-3">
                    ⚠️ <strong>Atenção:</strong> Ao publicar este preço (<strong>R$ @_targetPriceToPublish.MonthlyPrice.ToString("N2")/mês</strong> para <strong>@_targetPriceModule?.Name</strong> na faixa <strong>@_targetPriceTier?.DisplayName</strong>), ele passará a ser <strong>estritamente imutável</strong> para novos checkouts.
                </div>
                <div class="form-group">
                    <label>Justificativa / Notas de Aprovação (Obrigatório)</label>
                    <textarea class="form-input" rows="3" @bind="_approvalTierPriceNotes" placeholder="Descreva o motivo da aprovação ou do reajuste..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="CloseModals">Cancelar</button>
                <button class="btn btn-success" @onclick="ConfirmPublishTierPrice">Confirmar & Publicar</button>
            </div>
        </div>
    </div>
}

<!-- LEGACY MODALS: Create Plan, Edit Draft, Publish Version, Compare -->
@if (_showCreatePlanModal)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            <div class="modal-header">
                <h3>Criar Novo Plano Legado</h3>
                <button class="btn-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Código Slug (Único)</label>
                    <input class="form-input" @bind="_newPlanCode" placeholder="ex: starter, pro, enterprise" />
                </div>
                <div class="form-group">
                    <label>Nome Comercial do Plano</label>
                    <input class="form-input" @bind="_newPlanName" placeholder="ex: Plano Produtor Starter" />
                </div>
                <div class="form-group">
                    <label>Categoria</label>
                    <select class="form-input" @bind="_newPlanCategory">
                        <option value="PeDistributed">Pecuária Distribuída</option>
                        <option value="Confinamento">Confinamento / Engorda</option>
                        <option value="Enterprise">Grupo Enterprise</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Descrição Curta</label>
                    <textarea class="form-input" @bind="_newPlanDescription" rows="2" placeholder="Descrição do escopo do plano..."></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Preço Mensal (R$)</label>
                        <input type="number" class="form-input" @bind="_newPlanPrice" step="0.01" />
                    </div>
                    <div class="form-group">
                        <label>Capacidade (Cabeças)</label>
                        <input type="number" class="form-input" @bind="_newPlanCapacity" step="100" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="CloseModals">Cancelar</button>
                <button class="btn btn-primary" @onclick="SubmitCreatePlan">Criar Plano</button>
            </div>
        </div>
    </div>
}

@if (_showPublishModal && _targetPublishVersion != null)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            <div class="modal-header">
                <h3>Publicar Versão v@_targetPublishVersion.VersionNumber</h3>
                <button class="btn-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrWhiteSpace(_publishErrorMessage))
                {
                    <div class="alert alert-danger mb-3">
                        ⚠️ @_publishErrorMessage
                    </div>
                }
                <div class="alert-warning mb-3">
                    ⚠️ <strong>Atenção:</strong> Ao publicar a versão v@_targetPublishVersion.VersionNumber do plano '<strong>@_targetPublishPlan?.Name</strong>', ela se tornará <strong>estritamente imutável</strong>.
                </div>
                <div class="form-group">
                    <label>Justificativa / Notas de Aprovação (Obrigatório)</label>
                    <textarea class="form-input" @bind="_approvalNotes" rows="3" placeholder="Motivo do lançamento ou reajuste de preço..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="CloseModals">Cancelar</button>
                <button class="btn btn-success" @onclick="ConfirmPublishVersion">Confirmar & Publicar</button>
            </div>
        </div>
    </div>
}

@if (_showEditDraftModal && _targetEditDraftVersion != null)
{
    <div class="modal-backdrop">
        <div class="modal-card modal-lg">
            <div class="modal-header">
                <h3>Editar Rascunho — @_targetEditDraftPlan?.Name (@_targetEditDraftVersion.VersionName)</h3>
                <button class="btn-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Nome da Versão Rascunho</label>
                    <input class="form-input" @bind="_editVersionName" placeholder="ex: v2.0 - Reajuste Anual" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Preço Mensal (R$)</label>
                        <input type="number" step="0.01" class="form-input" @bind="_editMonthlyPrice" />
                    </div>
                    <div class="form-group">
                        <label>Preço Anual Mensalizado (R$)</label>
                        <input type="number" step="0.01" class="form-input" @bind="_editAnnualPriceMonthly" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Capacidade (Cabeças de Gado)</label>
                        <input type="number" step="100" class="form-input" @bind="_editHeadCapacityLimit" />
                    </div>
                    <div class="form-group">
                        <label>Máx. Usuários (Opcional)</label>
                        <input type="number" class="form-input" @bind="_editMaxUsers" />
                    </div>
                </div>

                <div class="form-group">
                    <label>Módulos do Sistema Habilitados Nesta Versão</label>
                    <div class="modules-toggle-grid">
                        @foreach (var feature in _availableFeatureKeys)
                        {
                            var isSelected = _editSelectedFeatures.TryGetValue(feature.Key, out var val) && val;
                            <div class="module-toggle-card @(isSelected ? "selected" : "")" @onclick="() => ToggleFeature(feature.Key, !isSelected)">
                                <input type="checkbox" checked="@isSelected" @onclick:stopPropagation="true" @onchange="(e) => ToggleFeature(feature.Key, e.Value)" />
                                <span>@feature.Value</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="CloseModals">Cancelar</button>
                <button class="btn btn-primary" @onclick="SubmitUpdateDraftVersion">Salvar Rascunho</button>
            </div>
        </div>
    </div>
}

@if (_showCompareModal && _targetComparePlan != null)
{
    <div class="modal-backdrop">
        <div class="modal-card modal-lg">
            <div class="modal-header">
                <h3>Comparativo de Versões — @_targetComparePlan.Name</h3>
                <button class="btn-close" @onclick="CloseModals">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group">
                        <label>Versão Base (Atual/Antiga)</label>
                        <select class="form-input" value="@_selectedBaseVersionId" @onchange="OnBaseVersionChanged">
                            @foreach (var v in _targetComparePlan.Versions)
                            {
                                <option value="@v.Id">v@v.VersionNumber.0 - @v.VersionName (@v.Status)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Versão Alvo (Comparada)</label>
                        <select class="form-input" value="@_selectedTargetVersionId" @onchange="OnTargetVersionChanged">
                            @foreach (var v in _targetComparePlan.Versions)
                            {
                                <option value="@v.Id">v@v.VersionNumber.0 - @v.VersionName (@v.Status)</option>
                            }
                        </select>
                    </div>
                </div>

                @if (_isComparing)
                {
                    <div class="loading-state">
                        <div class="spinner"></div>
                        <p>Calculando comparativo estrutural...</p>
                    </div>
                }
                else if (_comparisonDto != null)
                {
                    <div class="diff-summary-card">
                        <div class="diff-grid">
                            <div class="diff-item">
                                <span class="diff-label">Mensalidade</span>
                                <div class="diff-values">
                                    <span class="val-old">R$ @_comparisonDto.BaseVersion.MonthlyPrice.ToString("N2")</span>
                                    <span class="arrow">➔</span>
                                    <span class="val-new">R$ @_comparisonDto.TargetVersion.MonthlyPrice.ToString("N2")</span>
                                </div>
                            </div>
                            <div class="diff-item">
                                <span class="diff-label">Capacidade (Cabeças)</span>
                                <div class="diff-values">
                                    <span class="val-old">@_comparisonDto.BaseVersion.HeadCapacityLimit</span>
                                    <span class="arrow">➔</span>
                                    <span class="val-new">@_comparisonDto.TargetVersion.HeadCapacityLimit</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="CloseModals">Fechar Comparativo</button>
            </div>
        </div>
    </div>
}

