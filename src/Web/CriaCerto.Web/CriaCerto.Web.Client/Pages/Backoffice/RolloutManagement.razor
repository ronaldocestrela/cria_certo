@page "/backoffice/rollout"
@layout Layout.BackofficeLayout
@using CriaCerto.Web.Client.Models
@using CriaCerto.Web.Client.Services
@using CriaCerto.Web.Client.Components.Backoffice
@inject IFeatureFlagClientService FeatureFlagService
@inject IBackofficePermissionService PermissionService
@inject IToastService ToastService
@inject NavigationManager Navigation

<PageTitle>Rollout por Ondas & Feature Flags | CriaCerto Backoffice</PageTitle>

<PermissionGuard Permission="rollout.read">
    <Authorized>
        <div class="rollout-page">
            <!-- Header -->
            <header class="page-header">
                <div>
                    <span class="badge-rollout">🔀 Governança & Ondas</span>
                    <h1 class="page-title">Rollout por Ondas & Feature Flags</h1>
                    <p class="page-subtitle">
                        Governança dinâmica de funcionalidades críticas, liberação progressiva por anéis (Rings 0, 1 e 2) e circuit breaker com corte emergencial (Kill-Switch).
                    </p>
                </div>
                <div class="header-actions">
                    <button class="btn btn-outline" @onclick="RefreshDataAsync" disabled="@_isLoading">
                        <span class="@(_isLoading ? "spin-icon" : "")">🔄</span>
                        <span>Atualizar</span>
                    </button>
                </div>
            </header>

            <!-- KPI Cards -->
            <div class="kpis-grid">
                <div class="kpi-card">
                    <div class="kpi-info">
                        <span class="kpi-label">Total de Flags</span>
                        <span class="kpi-value text-blue">@_flags.Count</span>
                    </div>
                    <div class="kpi-icon icon-blue">🚩</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-info">
                        <span class="kpi-label">Onda Canary / Early</span>
                        <span class="kpi-value text-cyan">
                            @_flags.Count(f => f.MaxAllowedRing.Contains("Ring0") || f.MaxAllowedRing.Contains("Ring1"))
                        </span>
                    </div>
                    <div class="kpi-icon icon-cyan">🛡️</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-info">
                        <span class="kpi-label">Disponibilidade Geral (GA)</span>
                        <span class="kpi-value text-green">
                            @_flags.Count(f => f.MaxAllowedRing.Contains("Ring2") && !f.KillSwitchActive && f.IsEnabled)
                        </span>
                    </div>
                    <div class="kpi-icon icon-green">✅</div>
                </div>

                <div class="kpi-card @(_flags.Any(f => f.KillSwitchActive) ? "card-alert" : "")">
                    <div class="kpi-info">
                        <span class="kpi-label">Kill-Switch Ativo</span>
                        <span class="kpi-value @(_flags.Any(f => f.KillSwitchActive) ? "text-danger" : "text-muted")">
                            @_flags.Count(f => f.KillSwitchActive)
                        </span>
                    </div>
                    <div class="kpi-icon @(_flags.Any(f => f.KillSwitchActive) ? "icon-red" : "icon-gray")">⚠️</div>
                </div>
            </div>

            <!-- SLO & Observability Strip -->
            <div class="panel-card">
                <div class="panel-header">
                    <h2 class="panel-title">
                        <span>📈</span>
                        <span>Monitoramento de SLO & Guardrails em Tempo Real</span>
                    </h2>
                    <span class="window-badge">Janela Ativa de 24h</span>
                </div>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Funcionalidade</th>
                                <th>Taxa de Erro Atual</th>
                                <th>Latência p95</th>
                                <th>Alertas de Política</th>
                                <th>Status de Estabilidade</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_sloHealthList.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted">Carregando métricas de SLO...</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var slo in _sloHealthList)
                                {
                                    <tr>
                                        <td>
                                            <span class="flag-name">@slo.FlagName</span>
                                            <code class="code-tag">@slo.FlagKey</code>
                                        </td>
                                        <td>
                                            <span class="stat-highlight @(slo.CurrentErrorRatePercent > slo.MaxErrorRateThresholdPercent ? "text-danger" : "text-green")">
                                                @slo.CurrentErrorRatePercent.ToString("F2")%
                                            </span>
                                            <span class="stat-sub"> (SLO &le; @slo.MaxErrorRateThresholdPercent.ToString("F1")%)</span>
                                        </td>
                                        <td>
                                            <span class="stat-highlight @(slo.CurrentLatencyP95Ms > slo.MaxLatencyP95ThresholdMs ? "text-amber" : "")">
                                                @slo.CurrentLatencyP95Ms.ToString("F0") ms
                                            </span>
                                            <span class="stat-sub"> (SLO &le; @slo.MaxLatencyP95ThresholdMs.ToString("F0") ms)</span>
                                        </td>
                                        <td>
                                            @if (slo.PolicyFailuresCount > 0)
                                            {
                                                <span class="badge-alert">@slo.PolicyFailuresCount alerta(s)</span>
                                            }
                                            else
                                            {
                                                <span class="badge-ok">0 violações</span>
                                            }
                                        </td>
                                        <td>
                                            @if (slo.IsHealthy)
                                            {
                                                <span class="status-pill status-ok">
                                                    <span>🛡️</span> Conforme
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-pill status-danger">
                                                    <span>🚨</span> Risco / Corte
                                                </span>
                                            }
                                            <span class="status-summary-text">@slo.StatusSummary</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Feature Flags Table -->
            <div class="panel-card">
                <div class="panel-header flex-header">
                    <h2 class="panel-title">
                        <span>🎛️</span>
                        <span>Catálogo de Feature Flags & Anéis de Implantação</span>
                    </h2>
                    <div class="search-wrap">
                        <input type="text" class="search-input" placeholder="Buscar por chave ou nome..." @bind="_searchTerm" @bind:event="oninput" />
                    </div>
                </div>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Funcionalidade / Chave</th>
                                <th>Categoria</th>
                                <th>Onda Atual (Ring & %)</th>
                                <th>Última Atualização</th>
                                <th class="text-right">Ações de Governança</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_isLoading)
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        <div class="spinner"></div>
                                        <p>Carregando governança de flags...</p>
                                    </td>
                                </tr>
                            }
                            else if (FilteredFlags.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        Nenhuma feature flag localizada com os filtros informados.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var flag in FilteredFlags)
                                {
                                    <tr class="@(flag.KillSwitchActive ? "row-danger" : !flag.IsEnabled ? "row-disabled" : "")">
                                        <td>
                                            @if (flag.KillSwitchActive)
                                            {
                                                <span class="pill pill-danger">KILL-SWITCH</span>
                                            }
                                            else if (flag.IsEnabled)
                                            {
                                                <span class="pill pill-success">ATIVA</span>
                                            }
                                            else
                                            {
                                                <span class="pill pill-secondary">INATIVA</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="flag-name">@flag.Name</span>
                                            <code class="code-tag">@flag.Key</code>
                                            <span class="flag-desc">@flag.Description</span>
                                        </td>
                                        <td>
                                            <span class="category-badge">@flag.Category</span>
                                        </td>
                                        <td>
                                            <RolloutWaveBadge MaxAllowedRing="@flag.MaxAllowedRing" Percentage="@flag.RolloutPercentage" KillSwitchActive="@flag.KillSwitchActive" />
                                            @if (flag.WhitelistedEmails != null && flag.WhitelistedEmails.Count > 0)
                                            {
                                                <span class="whitelist-badge">
                                                    👥 @flag.WhitelistedEmails.Count em whitelist
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <div class="update-date">@(flag.UpdatedAtUtc?.ToString("dd/MM/yyyy HH:mm") ?? flag.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")) UTC</div>
                                            <div class="update-by">por @(flag.UpdatedBy ?? flag.CreatedBy)</div>
                                        </td>
                                        <td class="text-right">
                                            <div class="actions-group">
                                                <button class="btn-action" title="Configurar Onda e Parâmetros" @onclick="() => OpenRolloutModal(flag)">
                                                    ⚙️ Configurar
                                                </button>
                                                <button class="btn-toggle-action @(flag.IsEnabled ? "is-active" : "")" title="Alternar Estado Operacional" @onclick="() => ToggleFlagDirectlyAsync(flag)">
                                                    @(flag.IsEnabled ? "⏸️" : "▶️")
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <FeatureFlagRolloutModal IsOpen="@_isModalOpen" Flag="@_selectedFlag" OnSaved="HandleFlagSaved" OnClosed="() => _isModalOpen = false" />
    </Authorized>
    <NotAuthorized>
        <div class="access-denied-container">
            <h2>Acesso Restrito</h2>
            <p>Seu usuário não possui a permissão administrativa <code>rollout.read</code> necessária para visualizar a governança de rollout.</p>
        </div>
    </NotAuthorized>
</PermissionGuard>

<style>
    .rollout-page {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        color: #f8fafc;
        max-width: 1400px;
    }
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 1rem;
    }
    .badge-rollout {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #38bdf8;
        letter-spacing: 0.05em;
        background: rgba(56, 189, 248, 0.1);
        padding: 0.2rem 0.6rem;
        border-radius: 9999px;
        border: 1px solid rgba(56, 189, 248, 0.2);
    }
    .page-title {
        font-size: 1.75rem;
        font-weight: 800;
        margin: 0.3rem 0 0.5rem 0;
        color: #f1f5f9;
    }
    .page-subtitle {
        font-size: 0.95rem;
        color: #94a3b8;
        margin: 0;
        max-width: 750px;
    }
    .header-actions {
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }
    .btn-outline {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 1rem;
        background: transparent;
        border: 1px solid #334155;
        border-radius: 0.5rem;
        color: #f8fafc;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-outline:hover:not(:disabled) {
        background: #1e293b;
        border-color: #475569;
    }
    .spin-icon {
        display: inline-block;
        animation: spin 1s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    /* KPIs Grid */
    .kpis-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }
    .kpi-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 0.75rem;
        padding: 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .kpi-card.card-alert {
        background: rgba(239, 68, 68, 0.12);
        border-color: #ef4444;
    }
    .kpi-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    .kpi-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #94a3b8;
        letter-spacing: 0.05em;
    }
    .kpi-value {
        font-size: 1.75rem;
        font-weight: 800;
        color: #f8fafc;
    }
    .text-blue { color: #38bdf8; }
    .text-cyan { color: #06b6d4; }
    .text-green { color: #34d399; }
    .text-amber { color: #fbbf24; }
    .text-danger { color: #f87171; }
    .text-muted { color: #64748b; }

    .kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }
    .icon-blue { background: rgba(56, 189, 248, 0.15); }
    .icon-cyan { background: rgba(6, 182, 212, 0.15); }
    .icon-green { background: rgba(52, 211, 153, 0.15); }
    .icon-red { background: rgba(239, 68, 68, 0.2); }
    .icon-gray { background: rgba(148, 163, 184, 0.1); }

    /* Panels & Tables */
    .panel-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 0.75rem;
        overflow: hidden;
    }
    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.25rem;
        background: #0f172a;
        border-bottom: 1px solid #334155;
    }
    .panel-header.flex-header {
        flex-wrap: wrap;
        gap: 0.75rem;
    }
    .panel-title {
        font-size: 1rem;
        font-weight: 700;
        color: #f1f5f9;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .window-badge {
        font-size: 0.75rem;
        font-weight: 600;
        color: #34d399;
        background: rgba(52, 211, 153, 0.1);
        border: 1px solid rgba(52, 211, 153, 0.2);
        padding: 0.2rem 0.6rem;
        border-radius: 9999px;
    }
    .search-wrap {
        min-width: 260px;
    }
    .search-input {
        width: 100%;
        background: #090d16;
        border: 1px solid #334155;
        border-radius: 0.5rem;
        padding: 0.4rem 0.75rem;
        color: #f8fafc;
        font-size: 0.85rem;
    }
    .search-input:focus {
        outline: none;
        border-color: #38bdf8;
    }

    .table-container {
        overflow-x: auto;
    }
    .data-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }
    .data-table th {
        background: #0f172a;
        padding: 0.75rem 1rem;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #94a3b8;
        letter-spacing: 0.05em;
        border-bottom: 1px solid #334155;
    }
    .data-table td {
        padding: 0.85rem 1rem;
        border-bottom: 1px solid #334155;
        font-size: 0.875rem;
        vertical-align: middle;
    }
    .data-table tbody tr:hover {
        background: rgba(255, 255, 255, 0.02);
    }
    .row-danger {
        background: rgba(239, 68, 68, 0.08) !important;
    }
    .row-disabled {
        opacity: 0.6;
    }

    .flag-name {
        display: block;
        font-weight: 700;
        color: #f8fafc;
    }
    .code-tag {
        display: inline-block;
        font-family: monospace;
        font-size: 0.75rem;
        color: #38bdf8;
        background: rgba(56, 189, 248, 0.1);
        padding: 0.15rem 0.4rem;
        border-radius: 0.25rem;
        margin-top: 0.15rem;
    }
    .flag-desc {
        display: block;
        font-size: 0.75rem;
        color: #94a3b8;
        margin-top: 0.2rem;
    }
    .stat-highlight {
        font-weight: 700;
    }
    .stat-sub {
        font-size: 0.75rem;
        color: #94a3b8;
    }
    .category-badge {
        font-size: 0.75rem;
        background: rgba(148, 163, 184, 0.15);
        color: #cbd5e1;
        padding: 0.2rem 0.5rem;
        border-radius: 0.375rem;
    }
    .whitelist-badge {
        display: block;
        font-size: 0.75rem;
        color: #38bdf8;
        margin-top: 0.25rem;
    }
    .update-date {
        font-size: 0.8rem;
        color: #f1f5f9;
    }
    .update-by {
        font-size: 0.75rem;
        color: #94a3b8;
    }
    .badge-alert {
        font-size: 0.75rem;
        font-weight: 600;
        background: rgba(239, 68, 68, 0.15);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.3);
        padding: 0.2rem 0.5rem;
        border-radius: 0.375rem;
    }
    .badge-ok {
        font-size: 0.75rem;
        font-weight: 600;
        background: rgba(52, 211, 153, 0.15);
        color: #6ee7b7;
        border: 1px solid rgba(52, 211, 153, 0.3);
        padding: 0.2rem 0.5rem;
        border-radius: 0.375rem;
    }
    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.2rem 0.5rem;
        border-radius: 9999px;
    }
    .status-pill.status-ok {
        background: rgba(52, 211, 153, 0.15);
        color: #6ee7b7;
        border: 1px solid rgba(52, 211, 153, 0.3);
    }
    .status-pill.status-danger {
        background: rgba(239, 68, 68, 0.15);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }
    .status-summary-text {
        display: block;
        font-size: 0.7rem;
        color: #94a3b8;
        margin-top: 0.2rem;
    }
    .pill {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.2rem 0.55rem;
        border-radius: 9999px;
        letter-spacing: 0.04em;
    }
    .pill-success {
        background: rgba(52, 211, 153, 0.15);
        color: #6ee7b7;
        border: 1px solid rgba(52, 211, 153, 0.3);
    }
    .pill-danger {
        background: #ef4444;
        color: #ffffff;
    }
    .pill-secondary {
        background: rgba(148, 163, 184, 0.15);
        color: #94a3b8;
    }

    .actions-group {
        display: flex;
        justify-content: flex-end;
        gap: 0.4rem;
    }
    .btn-action {
        background: #0f172a;
        border: 1px solid #334155;
        color: #38bdf8;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.35rem 0.7rem;
        border-radius: 0.375rem;
        cursor: pointer;
        transition: all 0.15s;
    }
    .btn-action:hover {
        background: #1e293b;
        border-color: #38bdf8;
    }
    .btn-toggle-action {
        background: #0f172a;
        border: 1px solid #334155;
        color: #f8fafc;
        font-size: 0.85rem;
        padding: 0.35rem 0.6rem;
        border-radius: 0.375rem;
        cursor: pointer;
        transition: all 0.15s;
    }
    .btn-toggle-action:hover {
        background: #1e293b;
    }
    .btn-toggle-action.is-active {
        border-color: #f59e0b;
    }
    .text-right {
        text-align: right;
    }

    .access-denied-container {
        padding: 3rem 2rem;
        text-align: center;
        background: #1e293b;
        border: 1px solid #ef4444;
        border-radius: 0.75rem;
        max-width: 600px;
        margin: 2rem auto;
    }
    .access-denied-container h2 {
        color: #f87171;
        margin-bottom: 0.5rem;
    }
    .access-denied-container p {
        color: #cbd5e1;
    }
</style>

@code {
    private List<FeatureFlagClientDto> _flags = new();
    private List<RolloutSloHealthClientDto> _sloHealthList = new();
    private bool _isLoading = true;
    private string _searchTerm = string.Empty;

    private bool _isModalOpen = false;
    private FeatureFlagClientDto? _selectedFlag;

    protected override async Task OnInitializedAsync()
    {
        await RefreshDataAsync();
    }

    private async Task RefreshDataAsync()
    {
        _isLoading = true;
        try
        {
            _flags = await FeatureFlagService.GetFlagsAsync(forceRefresh: true);
            _sloHealthList = await FeatureFlagService.GetSloHealthAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private List<FeatureFlagClientDto> FilteredFlags =>
        string.IsNullOrWhiteSpace(_searchTerm)
            ? _flags
            : _flags.Where(f =>
                f.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                f.Key.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                f.Category.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
              ).ToList();

    private void OpenRolloutModal(FeatureFlagClientDto flag)
    {
        _selectedFlag = flag;
        _isModalOpen = true;
    }

    private async Task HandleFlagSaved()
    {
        await RefreshDataAsync();
    }

    private async Task ToggleFlagDirectlyAsync(FeatureFlagClientDto flag)
    {
        var targetState = !flag.IsEnabled;
        var reason = targetState
            ? "Reativação operacional solicitada via painel"
            : "Desativação temporária preventiva solicitada via painel";

        var result = await FeatureFlagService.ToggleFlagAsync(flag.Key, targetState, reason);
        if (result is not null)
        {
            ToastService.ShowSuccess($"Feature flag '{flag.Name}' {(targetState ? "ativada" : "desativada")} com sucesso!");
            await RefreshDataAsync();
        }
        else
        {
            ToastService.ShowError("Falha ao alternar estado da flag.");
        }
    }
}
