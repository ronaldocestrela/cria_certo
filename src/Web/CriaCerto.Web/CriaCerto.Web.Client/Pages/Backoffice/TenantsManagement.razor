@page "/backoffice/tenants"
@layout Layout.BackofficeLayout
@using CriaCerto.Modules.Backoffice.Application.Features.Tenants.Dtos
@using CriaCerto.Modules.Backoffice.Application.Security
@using CriaCerto.Web.Client.Components.Backoffice
@using CriaCerto.Web.Client.Pages.Backoffice.Components
@using CriaCerto.Web.Client.Services
@inject IBackofficeApiClient ApiClient
@inject IJSRuntime JS

<PermissionGuard Permission="@BackofficePermissions.TenantsRead">
    <Authorized>
        <div class="tenants-page">
            <header class="page-header">
                <div>
                    <span class="badge-tenant">Tenants & Clientes</span>
                    <h1 class="page-title">Gestão de Clientes e Segmentação Operacional</h1>
                    <p class="page-subtitle">Listas segmentadas, filtros salvos, exportação de recortes e visão 360 com taxonomias operacionais.</p>
                </div>
                <div class="header-actions">
                    <button class="btn btn-secondary" @onclick="ExportCsv">Exportar CSV</button>
                    <PermissionGuard Permission="@BackofficePermissions.TenantsWrite">
                    <Authorized>
                        <button class="btn btn-primary" @onclick="OpenCreateModal">
                            <span class="icon">+</span> Novo Tenant
                        </button>
                    </Authorized>
                </PermissionGuard>
                </div>
            </header>

            <div class="kpis-grid">
                <div class="kpi-card">
                    <span class="kpi-label">Total Filtrado</span>
                    <span class="kpi-value">@(PagedTenants?.TotalCount ?? 0)</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Ativos</span>
                    <span class="kpi-value text-success">@(PagedTenants?.Items.Count(t => t.Status == "Active") ?? 0)</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Suspensos</span>
                    <span class="kpi-value text-warning">@(PagedTenants?.Items.Count(t => t.Status == "Suspended") ?? 0)</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Trial</span>
                    <span class="kpi-value text-info">@(PagedTenants?.Items.Count(t => t.Status == "Trial") ?? 0)</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">Inadimplentes</span>
                    <span class="kpi-value text-danger">@(PagedTenants?.Items.Count(t => t.Status == "PastDue") ?? 0)</span>
                </div>
            </div>

            <div class="filters-bar">
                <div class="search-box">
                    <span class="search-icon">🔍</span>
                    <input type="text" placeholder="Buscar por nome, CNPJ, razão social ou ID externo..." @bind="SearchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
                </div>
                <div class="filters-group">
                    <select class="filter-select" @bind="StatusFilter" @bind:after="LoadData">
                        <option value="">Todos os Status</option>
                        <option value="Active">Active</option>
                        <option value="Suspended">Suspended</option>
                        <option value="Trial">Trial</option>
                        <option value="PastDue">PastDue</option>
                        <option value="Cancelled">Cancelled</option>
                        <option value="Archived">Archived</option>
                    </select>
                    <select class="filter-select" @bind="PlanFilter" @bind:after="LoadData">
                        <option value="">Todos os Planos</option>
                        <option value="Starter">Starter</option>
                        <option value="Pro">Pro</option>
                        <option value="Enterprise">Enterprise</option>
                    </select>
                    <input type="text" class="filter-select" placeholder="UF" maxlength="2" @bind="StateFilter" @bind:after="LoadData" />
                    <select class="filter-select" @bind="SizeSegmentFilter" @bind:after="LoadData">
                        <option value="">Porte</option>
                        <option value="Micro">Micro</option>
                        <option value="Small">Small</option>
                        <option value="Medium">Medium</option>
                        <option value="Large">Large</option>
                    </select>
                    <select class="filter-select" @bind="CommercialRegionFilter" @bind:after="LoadData">
                        <option value="">Região</option>
                        <option value="Norte">Norte</option>
                        <option value="Nordeste">Nordeste</option>
                        <option value="CentroOeste">Centro-Oeste</option>
                        <option value="Sudeste">Sudeste</option>
                        <option value="Sul">Sul</option>
                    </select>
                    <select class="filter-select" @bind="ProductiveProfileFilter" @bind:after="LoadData">
                        <option value="">Perfil</option>
                        <option value="Corte">Corte</option>
                        <option value="Leite">Leite</option>
                        <option value="Misto">Misto</option>
                        <option value="Cria">Cria</option>
                        <option value="Recria">Recria</option>
                        <option value="Engorda">Engorda</option>
                        <option value="Confinamento">Confinamento</option>
                    </select>
                    <select class="filter-select" @bind="ChurnRiskFilter" @bind:after="LoadData">
                        <option value="">Churn</option>
                        <option value="None">None</option>
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                        <option value="Critical">Critical</option>
                    </select>
                    <select class="filter-select tag-filter" multiple @onchange="HandleTagFilterChange">
                        @foreach (var tag in AvailableTags)
                        {
                            <option value="@tag.Id" selected="@SelectedTagIds.Contains(tag.Id)">@tag.Name</option>
                        }
                    </select>
                    <select class="filter-select" @bind="SelectedSavedFilterId" @bind:after="ApplySelectedSavedFilter">
                        <option value="">Filtros salvos</option>
                        @foreach (var filter in SavedFilters)
                        {
                            <option value="@filter.Id">@filter.Name @(filter.IsDefault ? "★" : "")</option>
                        }
                    </select>
                    <button class="btn btn-secondary btn-sm" @onclick="OpenSaveFilterPrompt">Salvar recorte</button>
                    @if (!string.IsNullOrWhiteSpace(SelectedSavedFilterId))
                    {
                        <button class="btn btn-secondary btn-sm" @onclick="DeleteSelectedSavedFilter">Excluir recorte</button>
                    }
                </div>
            </div>

            <div class="content-grid">
                <div class="list-panel">
                    @if (IsLoading)
                    {
                        <div class="loading-state"><div class="spinner"></div><span>Carregando tenants...</span></div>
                    }
                    else if (PagedTenants == null || !PagedTenants.Items.Any())
                    {
                        <div class="empty-state">
                            <span class="empty-icon">🏢</span>
                            <h3>Nenhum tenant encontrado</h3>
                            <p>Tente ajustar os filtros ou cadastre um novo tenant.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-container">
                            <table class="tenants-table">
                                <thead>
                                    <tr>
                                        <th>Tenant</th>
                                        <th>Status</th>
                                        <th>Plano</th>
                                        <th>UF</th>
                                        <th>Porte</th>
                                        <th>Região</th>
                                        <th>Tags</th>
                                        <th>Capacidade</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tenant in PagedTenants.Items)
                                    {
                                        <tr class="@(SelectedTenantId == tenant.Id ? "row-selected" : "")" @onclick="() => SelectTenant(tenant.Id)">
                                            <td>
                                                <div class="tenant-cell">
                                                    <span class="tenant-name">@tenant.Name</span>
                                                    <span class="tenant-meta">@tenant.CNPJ @(tenant.ExternalIdentifier != null ? $"· {tenant.ExternalIdentifier}" : "")</span>
                                                </div>
                                            </td>
                                            <td><span class="status-badge status-@tenant.Status.ToLower()">@tenant.Status</span></td>
                                            <td>@tenant.SubscribedPlan</td>
                                            <td>@tenant.State</td>
                                            <td>@tenant.SizeSegment</td>
                                            <td>@tenant.CommercialRegion</td>
                                            <td>
                                                <div class="tag-chips">
                                                    @foreach (var tag in tenant.Tags.Take(3))
                                                    {
                                                        <span class="tag-chip" style="border-color:@tag.ColorHex;color:@tag.ColorHex">@tag.Name</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>@tenant.Capacity.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="detail-panel">
                    @if (SelectedTenant != null)
                    {
                        <div class="detail-header">
                            <div>
                                <h2>@SelectedTenant.Name</h2>
                                @if (SelectedTenant.IsProtected)
                                {
                                    <span class="protected-badge">Protegido</span>
                                }
                            </div>
                            <div class="detail-actions">
                                <PermissionGuard Permission="@BackofficePermissions.TenantsWrite">
                                    <Authorized>
                                        <button class="btn btn-secondary" @onclick="OpenEditModal">Editar</button>
                                        <button class="btn btn-primary ms-1" @onclick="OpenPlanChangeModal">Alterar Plano</button>
                                    </Authorized>
                                </PermissionGuard>
                                <PermissionGuard Permission="@BackofficePermissions.TenantsSuspend">
                                    <Authorized>
                                        @if (CanSuspend(SelectedTenant))
                                        {
                                            <button class="btn btn-warning" @onclick="() => OpenLifecycleModal(TenantLifecycleModal.LifecycleAction.Suspend)">Suspender</button>
                                        }
                                        @if (CanReactivate(SelectedTenant))
                                        {
                                            <button class="btn btn-primary" @onclick="() => OpenLifecycleModal(TenantLifecycleModal.LifecycleAction.Reactivate)">Reativar</button>
                                        }
                                        @if (CanCancel(SelectedTenant))
                                        {
                                            <button class="btn btn-danger" @onclick="() => OpenLifecycleModal(TenantLifecycleModal.LifecycleAction.Cancel)">Cancelar</button>
                                        }
                                        @if (CanArchive(SelectedTenant))
                                        {
                                            <button class="btn btn-danger" @onclick="() => OpenLifecycleModal(TenantLifecycleModal.LifecycleAction.Archive)">Arquivar</button>
                                        }
                                        @if (!SelectedTenant.IsProtected)
                                        {
                                            <button class="btn btn-secondary" @onclick="() => OpenLifecycleModal(TenantLifecycleModal.LifecycleAction.Protect)">Proteger</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary" @onclick="() => OpenLifecycleModal(TenantLifecycleModal.LifecycleAction.Unprotect)">Desproteger</button>
                                        }
                                    </Authorized>
                                </PermissionGuard>
                            </div>
                        </div>
                        <div class="detail-section">
                            <h3>Dados Cadastrais</h3>
                            <dl class="detail-grid">
                                <dt>Razão Social</dt><dd>@(SelectedTenant.LegalName ?? "—")</dd>
                                <dt>CNPJ/CPF</dt><dd>@SelectedTenant.CNPJ</dd>
                                <dt>ID Externo</dt><dd>@(SelectedTenant.ExternalIdentifier ?? "—")</dd>
                                <dt>Localização</dt><dd>@SelectedTenant.City / @SelectedTenant.State</dd>
                                <dt>IE</dt><dd>@SelectedTenant.StateRegistration</dd>
                                <dt>Área</dt><dd>@SelectedTenant.AreaInHectares.ToString("N2") ha</dd>
                                <dt>Tipo</dt><dd>@SelectedTenant.Type</dd>
                            </dl>
                        </div>
                        <div class="detail-section">
                            <h3>Contrato & Limites</h3>
                            <dl class="detail-grid">
                                <dt>Status</dt><dd><span class="status-badge status-@SelectedTenant.Status.ToLower()">@SelectedTenant.Status</span></dd>
                                @if (!string.IsNullOrWhiteSpace(SelectedTenant.StatusReason))
                                {
                                    <dt>Última Justificativa</dt><dd>@SelectedTenant.StatusReason</dd>
                                }
                                @if (SelectedTenant.StatusChangedAtUtc.HasValue)
                                {
                                    <dt>Status alterado em</dt><dd>@SelectedTenant.StatusChangedAtUtc.Value.ToLocalTime().ToString("g")</dd>
                                }
                                <dt>Plano</dt><dd>@SelectedTenant.SubscribedPlan</dd>
                                <dt>Capacidade</dt><dd>@SelectedTenant.Capacity.ToString("N0") cabeças</dd>
                                <dt>Limite do Plano</dt><dd>@(SelectedTenant.PlanHeadCapacityLimit == int.MaxValue ? "Ilimitado" : SelectedTenant.PlanHeadCapacityLimit.ToString("N0"))</dd>
                                <dt>Acima do Plano</dt><dd class="@(SelectedTenant.IsOverPlanLimit ? "text-warning" : "")">@(SelectedTenant.IsOverPlanLimit ? "Sim" : "Não")</dd>
                            </dl>
                        </div>
                        <div class="detail-section">
                            <h3>Owners Operacionais</h3>
                            <dl class="detail-grid">
                                <dt>Técnico</dt><dd>@(SelectedTenant.TechnicalOwnerName ?? "—") @(SelectedTenant.TechnicalOwnerEmail != null ? $"({SelectedTenant.TechnicalOwnerEmail})" : "")</dd>
                                <dt>Comercial</dt><dd>@(SelectedTenant.CommercialOwnerName ?? "—") @(SelectedTenant.CommercialOwnerEmail != null ? $"({SelectedTenant.CommercialOwnerEmail})" : "")</dd>
                            </dl>
                        </div>
                        <div class="detail-section">
                            <h3>Segmentação Operacional</h3>
                            <dl class="detail-grid">
                                <dt>Porte</dt><dd>@SelectedTenant.SizeSegment</dd>
                                <dt>Região</dt><dd>@SelectedTenant.CommercialRegion</dd>
                                <dt>Perfil Produtivo</dt><dd>@SelectedTenant.ProductiveProfile</dd>
                                <dt>Risco de Churn</dt><dd>@SelectedTenant.ChurnRisk</dd>
                            </dl>
                            <PermissionGuard Permission="@BackofficePermissions.TenantsWrite">
                                <Authorized>
                                    <div class="segmentation-edit">
                                        <select class="filter-select" @bind="EditSizeSegment">
                                            <option value="Micro">Micro</option>
                                            <option value="Small">Small</option>
                                            <option value="Medium">Medium</option>
                                            <option value="Large">Large</option>
                                        </select>
                                        <select class="filter-select" @bind="EditCommercialRegion">
                                            <option value="Norte">Norte</option>
                                            <option value="Nordeste">Nordeste</option>
                                            <option value="CentroOeste">Centro-Oeste</option>
                                            <option value="Sudeste">Sudeste</option>
                                            <option value="Sul">Sul</option>
                                        </select>
                                        <select class="filter-select" @bind="EditProductiveProfile">
                                            <option value="Corte">Corte</option>
                                            <option value="Leite">Leite</option>
                                            <option value="Misto">Misto</option>
                                            <option value="Cria">Cria</option>
                                            <option value="Recria">Recria</option>
                                            <option value="Engorda">Engorda</option>
                                            <option value="Confinamento">Confinamento</option>
                                        </select>
                                        <select class="filter-select" @bind="EditChurnRisk">
                                            <option value="None">None</option>
                                            <option value="Low">Low</option>
                                            <option value="Medium">Medium</option>
                                            <option value="High">High</option>
                                            <option value="Critical">Critical</option>
                                        </select>
                                        <button class="btn btn-secondary btn-sm" @onclick="SaveSegmentation">Atualizar segmentação</button>
                                    </div>
                                </Authorized>
                            </PermissionGuard>
                        </div>
                        <div class="detail-section">
                            <h3>Etiquetas Operacionais</h3>
                            <div class="tag-chips">
                                @if (SelectedTenant.Tags.Any())
                                {
                                    @foreach (var tag in SelectedTenant.Tags)
                                    {
                                        <span class="tag-chip" style="border-color:@tag.ColorHex;color:@tag.ColorHex">@tag.Name</span>
                                    }
                                }
                                else
                                {
                                    <span class="tenant-meta">Nenhuma etiqueta atribuída.</span>
                                }
                            </div>
                            <PermissionGuard Permission="@BackofficePermissions.TenantsWrite">
                                <Authorized>
                                    <div class="segmentation-edit">
                                        <select class="filter-select tag-filter" multiple @onchange="HandleTenantTagSelectionChange">
                                            @foreach (var tag in AvailableTags)
                                            {
                                                <option value="@tag.Id" selected="@EditTagIds.Contains(tag.Id)">@tag.Name</option>
                                            }
                                        </select>
                                        <button class="btn btn-secondary btn-sm" @onclick="SaveTenantTags">Salvar etiquetas</button>
                                        <button class="btn btn-secondary btn-sm" @onclick="() => IsTagModalOpen = true">Nova etiqueta</button>
                                    </div>
                                </Authorized>
                            </PermissionGuard>
                        </div>
                        <div class="detail-section">
                            <h3>Consolidado</h3>
                            <dl class="detail-grid">
                                <dt>Membros do Time</dt><dd>@SelectedTenant.TeamMemberCount</dd>
                                <dt>Unidades Produtivas</dt><dd>@SelectedTenant.ProductionUnitCount</dd>
                                <dt>Criado em</dt><dd>@SelectedTenant.CreatedAtUtc.ToLocalTime().ToString("g")</dd>
                                <dt>Atualizado em</dt><dd>@SelectedTenant.UpdatedAtUtc.ToLocalTime().ToString("g")</dd>
                            </dl>
                        </div>
                    }
                    else
                    {
                        <div class="detail-placeholder">
                            <span class="empty-icon">📋</span>
                            <p>Selecione um tenant na lista para visualizar a visão 360.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <TenantFormModal
            IsOpen="IsModalOpen"
            IsEdit="IsModalEdit"
            TenantId="FormTenantId"
            Name="@FormName"
            LegalName="@FormLegalName"
            CNPJ="@FormCnpj"
            ExternalIdentifier="@FormExternalId"
            State="@FormState"
            City="@FormCity"
            StateRegistration="@FormStateRegistration"
            AreaInHectares="FormArea"
            Capacity="FormCapacity"
            Type="@FormType"
            SubscribedPlan="@FormPlan"
            TechnicalOwnerName="@FormTechOwnerName"
            TechnicalOwnerEmail="@FormTechOwnerEmail"
            CommercialOwnerName="@FormCommOwnerName"
            CommercialOwnerEmail="@FormCommOwnerEmail"
            OnClose="CloseModal"
            OnSave="HandleSave" />

        <TenantLifecycleModal
            IsOpen="IsLifecycleModalOpen"
            Action="LifecycleAction"
            TenantName="@(SelectedTenant?.Name ?? string.Empty)"
            IsProtected="@(SelectedTenant?.IsProtected ?? false)"
            ErrorMessage="@LifecycleErrorMessage"
            OnClose="CloseLifecycleModal"
            OnConfirm="HandleLifecycleConfirm" />

        <OperationalTagModal
            IsOpen="IsTagModalOpen"
            OnClose="CloseTagModal"
            OnCreate="HandleCreateTag" />

        <TenantPlanChangeModal
            IsOpen="IsPlanModalOpen"
            TenantId="@(SelectedTenant?.Id ?? Guid.Empty)"
            TenantName="@(SelectedTenant?.Name ?? string.Empty)"
            OnClosed="() => IsPlanModalOpen = false"
            OnPlanChanged="HandlePlanChanged" />
    </Authorized>
    <NotAuthorized>
        <div class="access-denied-container">
            <h2>Acesso Negado</h2>
            <p>Você não possui a permissão <code>tenants.read</code> para acessar a gestão de tenants.</p>
        </div>
    </NotAuthorized>
</PermissionGuard>

<style>
    .tenants-page { padding: 1.5rem; color: #f8fafc; display: flex; flex-direction: column; gap: 1.5rem; }
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
    .header-actions { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
    .badge-tenant { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; background: #4ade80; color: #0f172a; padding: 0.2rem 0.5rem; border-radius: 9999px; }
    .page-title { font-size: 1.5rem; font-weight: 800; margin: 0.3rem 0; color: #f1f5f9; }
    .page-subtitle { color: #94a3b8; font-size: 0.9rem; margin: 0; }
    .kpis-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; }
    .kpi-card { background: #1e293b; padding: 1rem; border-radius: 0.75rem; border: 1px solid #334155; display: flex; flex-direction: column; gap: 0.4rem; }
    .kpi-label { font-size: 0.75rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; }
    .kpi-value { font-size: 1.5rem; font-weight: 800; }
    .text-success { color: #4ade80; } .text-warning { color: #fbbf24; } .text-info { color: #38bdf8; }
    .filters-bar { display: flex; gap: 1rem; flex-wrap: wrap; background: #1e293b; padding: 0.75rem; border-radius: 0.75rem; border: 1px solid #334155; }
    .search-box { display: flex; align-items: center; gap: 0.5rem; background: #0f172a; padding: 0.5rem 0.75rem; border-radius: 0.5rem; border: 1px solid #334155; flex: 1; min-width: 250px; }
    .search-box input { background: transparent; border: none; color: #f8fafc; width: 100%; outline: none; font-size: 0.85rem; }
    .filters-group { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .filter-select { background: #0f172a; border: 1px solid #334155; color: #f8fafc; padding: 0.5rem 0.75rem; border-radius: 0.5rem; font-size: 0.85rem; outline: none; min-width: 120px; }
    .tag-filter { min-width: 160px; min-height: 72px; }
    .tag-chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .tag-chip { border: 1px solid; border-radius: 9999px; padding: 0.15rem 0.5rem; font-size: 0.7rem; font-weight: 700; background: rgba(15, 23, 42, 0.6); }
    .segmentation-edit { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }
    .btn-sm { padding: 0.35rem 0.65rem; font-size: 0.8rem; }
    .content-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; min-height: 400px; }
    @@media (max-width: 1024px) { .content-grid { grid-template-columns: 1fr; } }
    .list-panel, .detail-panel { background: #1e293b; border-radius: 0.75rem; border: 1px solid #334155; overflow: hidden; }
    .detail-panel { padding: 1.25rem; overflow-y: auto; }
    .table-container { overflow-x: auto; }
    .tenants-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .tenants-table th { background: #0f172a; padding: 0.75rem 1rem; color: #94a3b8; font-weight: 700; border-bottom: 1px solid #334155; }
    .tenants-table td { padding: 0.75rem 1rem; border-bottom: 1px solid #334155; color: #cbd5e1; cursor: pointer; }
    .tenants-table tr:hover td { background: rgba(56, 189, 248, 0.05); }
    .row-selected td { background: rgba(56, 189, 248, 0.1) !important; }
    .tenant-cell { display: flex; flex-direction: column; }
    .tenant-name { font-weight: 700; color: #f8fafc; }
    .tenant-meta { font-size: 0.75rem; color: #94a3b8; }
    .status-badge { padding: 0.2rem 0.5rem; border-radius: 9999px; font-size: 0.7rem; font-weight: 700; }
    .status-active { background: rgba(74, 222, 128, 0.15); color: #4ade80; }
    .status-suspended { background: rgba(251, 191, 36, 0.15); color: #fbbf24; }
    .status-trial { background: rgba(56, 189, 248, 0.15); color: #38bdf8; }
    .status-pastdue { background: rgba(248, 113, 113, 0.15); color: #f87171; }
    .status-cancelled { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
    .status-archived { background: rgba(148, 163, 184, 0.15); color: #94a3b8; }
    .text-danger { color: #f87171; }
    .protected-badge {
        display: inline-block;
        margin-top: 0.35rem;
        padding: 0.15rem 0.5rem;
        border-radius: 9999px;
        font-size: 0.7rem;
        font-weight: 700;
        background: rgba(56, 189, 248, 0.15);
        color: #38bdf8;
    }
    .detail-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: flex-end; }
    .btn-warning { background: #d97706; color: #fff; padding: 0.4rem 0.8rem; border-radius: 0.5rem; border: none; font-weight: 600; cursor: pointer; }
    .btn-danger { background: #dc2626; color: #fff; padding: 0.4rem 0.8rem; border-radius: 0.5rem; border: none; font-weight: 600; cursor: pointer; }
    .detail-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 1rem; }
    .detail-header h2 { margin: 0; font-size: 1.2rem; }
    .detail-section { margin-bottom: 1.25rem; }
    .detail-section h3 { font-size: 0.8rem; text-transform: uppercase; color: #38bdf8; margin: 0 0 0.5rem; }
    .detail-grid { display: grid; grid-template-columns: 140px 1fr; gap: 0.4rem 1rem; font-size: 0.85rem; margin: 0; }
    .detail-grid dt { color: #94a3b8; font-weight: 600; }
    .detail-grid dd { margin: 0; color: #f1f5f9; }
    .detail-placeholder, .loading-state, .empty-state { text-align: center; padding: 3rem; color: #94a3b8; }
    .btn-primary { background: #0284c7; color: #fff; padding: 0.6rem 1rem; border-radius: 0.5rem; border: none; font-weight: 700; cursor: pointer; }
    .btn-secondary { background: #334155; color: #f8fafc; padding: 0.4rem 0.8rem; border-radius: 0.5rem; border: none; font-weight: 600; cursor: pointer; }
    .access-denied-container { text-align: center; padding: 4rem; color: #ef4444; }
</style>

@code {
    private PagedTenantAdminResult? PagedTenants;
    private TenantAdminDetailDto? SelectedTenant;
    private Guid SelectedTenantId;
    private bool IsLoading = true;

    private string SearchTerm = string.Empty;
    private string StatusFilter = string.Empty;
    private string PlanFilter = string.Empty;
    private string StateFilter = string.Empty;
    private string SizeSegmentFilter = string.Empty;
    private string CommercialRegionFilter = string.Empty;
    private string ProductiveProfileFilter = string.Empty;
    private string ChurnRiskFilter = string.Empty;
    private List<Guid> SelectedTagIds = new();
    private List<OperationalTagAdminDto> AvailableTags = new();
    private List<AdminSavedFilterDto> SavedFilters = new();
    private string SelectedSavedFilterId = string.Empty;

    private string EditSizeSegment = "Small";
    private string EditCommercialRegion = "CentroOeste";
    private string EditProductiveProfile = "Corte";
    private string EditChurnRisk = "None";
    private List<Guid> EditTagIds = new();
    private bool IsTagModalOpen;

    private bool IsModalOpen;
    private bool IsModalEdit;
    private Guid FormTenantId;
    private string FormName = string.Empty;
    private string? FormLegalName;
    private string FormCnpj = string.Empty;
    private string? FormExternalId;
    private string FormState = string.Empty;
    private string FormCity = string.Empty;
    private string FormStateRegistration = string.Empty;
    private decimal FormArea;
    private int FormCapacity = 500;
    private string FormType = "Pecuária de Corte e Cria";
    private string FormPlan = "Starter";
    private string? FormTechOwnerName;
    private string? FormTechOwnerEmail;
    private string? FormCommOwnerName;
    private string? FormCommOwnerEmail;

    private bool IsLifecycleModalOpen;
    private TenantLifecycleModal.LifecycleAction LifecycleAction;
    private string? LifecycleErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadTagsAndFilters();
        await LoadData();
    }

    private async Task LoadTagsAndFilters()
    {
        AvailableTags = (await ApiClient.GetOperationalTagsAsync())?.ToList() ?? new List<OperationalTagAdminDto>();
        SavedFilters = (await ApiClient.GetSavedFiltersAsync())?.ToList() ?? new List<AdminSavedFilterDto>();
    }

    private TenantAdminFilterDto BuildCurrentFilter() => new(
        string.IsNullOrWhiteSpace(SearchTerm) ? null : SearchTerm,
        string.IsNullOrWhiteSpace(StatusFilter) ? null : StatusFilter,
        string.IsNullOrWhiteSpace(PlanFilter) ? null : PlanFilter,
        string.IsNullOrWhiteSpace(StateFilter) ? null : StateFilter.ToUpperInvariant(),
        null,
        string.IsNullOrWhiteSpace(SizeSegmentFilter) ? null : SizeSegmentFilter,
        string.IsNullOrWhiteSpace(CommercialRegionFilter) ? null : CommercialRegionFilter,
        string.IsNullOrWhiteSpace(ProductiveProfileFilter) ? null : ProductiveProfileFilter,
        string.IsNullOrWhiteSpace(ChurnRiskFilter) ? null : ChurnRiskFilter,
        SelectedTagIds.Count == 0 ? null : SelectedTagIds);

    private async Task LoadData()
    {
        IsLoading = true;
        var filter = BuildCurrentFilter();
        PagedTenants = await ApiClient.GetTenantsAsync(
            filter.SearchTerm,
            filter.Status,
            filter.SubscribedPlan,
            filter.State,
            filter.OwnerSearch,
            filter.SizeSegment,
            filter.CommercialRegion,
            filter.ProductiveProfile,
            filter.ChurnRisk,
            filter.TagIds);
        IsLoading = false;
    }

    private async Task HandleSearch() => await LoadData();

    private async Task SelectTenant(Guid id)
    {
        SelectedTenantId = id;
        SelectedTenant = await ApiClient.GetTenantByIdAsync(id);
        if (SelectedTenant != null)
        {
            EditSizeSegment = SelectedTenant.SizeSegment;
            EditCommercialRegion = SelectedTenant.CommercialRegion;
            EditProductiveProfile = SelectedTenant.ProductiveProfile;
            EditChurnRisk = SelectedTenant.ChurnRisk;
            EditTagIds = SelectedTenant.Tags.Select(t => t.Id).ToList();
        }
    }

    private async Task HandleTagFilterChange(ChangeEventArgs e)
    {
        SelectedTagIds = ParseSelectedGuids(e);
        await LoadData();
    }

    private async Task HandleTenantTagSelectionChange(ChangeEventArgs e)
    {
        EditTagIds = ParseSelectedGuids(e);
        await Task.CompletedTask;
    }

    private static List<Guid> ParseSelectedGuids(ChangeEventArgs e)
    {
        if (e.Value is not string[] values)
        {
            return new List<Guid>();
        }

        return values
            .Where(v => Guid.TryParse(v, out _))
            .Select(Guid.Parse)
            .ToList();
    }

    private async Task ApplySelectedSavedFilter()
    {
        if (string.IsNullOrWhiteSpace(SelectedSavedFilterId))
        {
            return;
        }

        if (!Guid.TryParse(SelectedSavedFilterId, out var filterId))
        {
            return;
        }

        var saved = SavedFilters.FirstOrDefault(f => f.Id == filterId);
        if (saved == null)
        {
            return;
        }

        SearchTerm = saved.Filter.SearchTerm ?? string.Empty;
        StatusFilter = saved.Filter.Status ?? string.Empty;
        PlanFilter = saved.Filter.SubscribedPlan ?? string.Empty;
        StateFilter = saved.Filter.State ?? string.Empty;
        SizeSegmentFilter = saved.Filter.SizeSegment ?? string.Empty;
        CommercialRegionFilter = saved.Filter.CommercialRegion ?? string.Empty;
        ProductiveProfileFilter = saved.Filter.ProductiveProfile ?? string.Empty;
        ChurnRiskFilter = saved.Filter.ChurnRisk ?? string.Empty;
        SelectedTagIds = saved.Filter.TagIds?.ToList() ?? new List<Guid>();
        await LoadData();
    }

    private async Task OpenSaveFilterPrompt()
    {
        var name = $"Recorte {DateTime.Now:yyyyMMdd-HHmm}";
        var saved = await ApiClient.SaveFilterAsync(new SaveAdminFilterRequest(name, BuildCurrentFilter(), false));
        if (saved != null)
        {
            await LoadTagsAndFilters();
            SelectedSavedFilterId = saved.Id.ToString();
        }
    }

    private async Task DeleteSelectedSavedFilter()
    {
        if (string.IsNullOrWhiteSpace(SelectedSavedFilterId) || !Guid.TryParse(SelectedSavedFilterId, out var filterId))
        {
            return;
        }

        if (await ApiClient.DeleteSavedFilterAsync(filterId))
        {
            SelectedSavedFilterId = string.Empty;
            await LoadTagsAndFilters();
        }
    }

    private async Task ExportCsv()
    {
        var result = await ApiClient.ExportTenantsCsvAsync(BuildCurrentFilter());
        if (result == null || !result.IsSuccess)
        {
            return;
        }

        await JS.InvokeVoidAsync("downloadFileFromByteArray", result.FileName, "text/csv", result.Content);
    }

    private async Task SaveSegmentation()
    {
        if (SelectedTenant == null)
        {
            return;
        }

        var updated = await ApiClient.UpdateTenantSegmentationAsync(
            SelectedTenant.Id,
            new UpdateTenantSegmentationAdminRequest(
                EditSizeSegment,
                EditCommercialRegion,
                EditProductiveProfile,
                EditChurnRisk));

        if (updated != null)
        {
            SelectedTenant = updated;
            await LoadData();
        }
    }

    private async Task SaveTenantTags()
    {
        if (SelectedTenant == null)
        {
            return;
        }

        var updated = await ApiClient.ReplaceTenantTagsAsync(
            SelectedTenant.Id,
            new ReplaceTenantTagsAdminRequest(EditTagIds));

        if (updated != null)
        {
            SelectedTenant = updated;
            await LoadData();
        }
    }

    private async Task HandleCreateTag(CreateOperationalTagAdminRequest request)
    {
        var created = await ApiClient.CreateOperationalTagAsync(request);
        if (created == null)
        {
            return;
        }

        IsTagModalOpen = false;
        await LoadTagsAndFilters();
    }

    private void CloseTagModal() => IsTagModalOpen = false;

    private void OpenCreateModal()
    {
        IsModalEdit = false;
        FormTenantId = Guid.Empty;
        FormName = string.Empty;
        FormLegalName = null;
        FormCnpj = string.Empty;
        FormExternalId = null;
        FormState = string.Empty;
        FormCity = string.Empty;
        FormStateRegistration = string.Empty;
        FormArea = 0;
        FormCapacity = 500;
        FormType = "Pecuária de Corte e Cria";
        FormPlan = "Starter";
        FormTechOwnerName = null;
        FormTechOwnerEmail = null;
        FormCommOwnerName = null;
        FormCommOwnerEmail = null;
        IsModalOpen = true;
    }

    private void OpenEditModal()
    {
        if (SelectedTenant == null) return;
        IsModalEdit = true;
        FormTenantId = SelectedTenant.Id;
        FormName = SelectedTenant.Name;
        FormLegalName = SelectedTenant.LegalName;
        FormCnpj = SelectedTenant.CNPJ;
        FormExternalId = SelectedTenant.ExternalIdentifier;
        FormState = SelectedTenant.State;
        FormCity = SelectedTenant.City;
        FormStateRegistration = SelectedTenant.StateRegistration;
        FormArea = SelectedTenant.AreaInHectares;
        FormCapacity = SelectedTenant.Capacity;
        FormType = SelectedTenant.Type;
        FormPlan = SelectedTenant.SubscribedPlan;
        FormTechOwnerName = SelectedTenant.TechnicalOwnerName;
        FormTechOwnerEmail = SelectedTenant.TechnicalOwnerEmail;
        FormCommOwnerName = SelectedTenant.CommercialOwnerName;
        FormCommOwnerEmail = SelectedTenant.CommercialOwnerEmail;
        IsModalOpen = true;
    }

    private void CloseModal() => IsModalOpen = false;

    private async Task HandleSave(TenantFormModal.TenantFormSaveModel model)
    {
        if (IsModalEdit)
        {
            var request = new UpdateTenantAdminRequest(
                model.Name, model.LegalName, model.CNPJ, model.ExternalIdentifier,
                model.State, model.City, model.StateRegistration, model.AreaInHectares,
                model.Capacity, model.Type,
                model.TechnicalOwnerName, model.TechnicalOwnerEmail,
                model.CommercialOwnerName, model.CommercialOwnerEmail);
            await ApiClient.UpdateTenantAsync(model.TenantId, request);
            await SelectTenant(model.TenantId);
        }
        else
        {
            var request = new CreateTenantAdminRequest(
                model.Name, model.LegalName, model.CNPJ, model.ExternalIdentifier,
                model.State, model.City, model.StateRegistration, model.AreaInHectares,
                model.SubscribedPlan, model.Capacity, model.Type,
                model.TechnicalOwnerName, model.TechnicalOwnerEmail,
                model.CommercialOwnerName, model.CommercialOwnerEmail, model.OwnerUserEmail);
            var created = await ApiClient.CreateTenantAsync(request);
            if (created != null)
            {
                await SelectTenant(created.Id);
            }
        }

        IsModalOpen = false;
        await LoadData();
    }

    private static bool CanSuspend(TenantAdminDetailDto tenant) =>
        !tenant.IsProtected && tenant.Status is "Trial" or "Active" or "PastDue";

    private static bool CanReactivate(TenantAdminDetailDto tenant) =>
        tenant.Status == "Suspended";

    private static bool CanCancel(TenantAdminDetailDto tenant) =>
        !tenant.IsProtected && tenant.Status is "Trial" or "Active" or "PastDue" or "Suspended";

    private static bool CanArchive(TenantAdminDetailDto tenant) =>
        !tenant.IsProtected && tenant.Status == "Cancelled";

    private void OpenLifecycleModal(TenantLifecycleModal.LifecycleAction action)
    {
        if (SelectedTenant == null) return;
        LifecycleAction = action;
        LifecycleErrorMessage = null;
        IsLifecycleModalOpen = true;
    }

    private void CloseLifecycleModal()
    {
        IsLifecycleModalOpen = false;
        LifecycleErrorMessage = null;
    }

    private async Task HandleLifecycleConfirm(string reason)
    {
        if (SelectedTenant == null) return;

        LifecycleActionResult result = LifecycleAction switch
        {
            TenantLifecycleModal.LifecycleAction.Suspend => await ApiClient.SuspendTenantAsync(SelectedTenant.Id, reason),
            TenantLifecycleModal.LifecycleAction.Reactivate => await ApiClient.ReactivateTenantAsync(SelectedTenant.Id, reason),
            TenantLifecycleModal.LifecycleAction.Cancel => await ApiClient.CancelTenantAsync(SelectedTenant.Id, reason),
            TenantLifecycleModal.LifecycleAction.Archive => await ApiClient.ArchiveTenantAsync(SelectedTenant.Id, reason),
            TenantLifecycleModal.LifecycleAction.Protect => await ApiClient.SetTenantProtectionAsync(SelectedTenant.Id, true, reason),
            TenantLifecycleModal.LifecycleAction.Unprotect => await ApiClient.SetTenantProtectionAsync(SelectedTenant.Id, false, reason),
            _ => new LifecycleActionResult { ErrorMessage = "Ação inválida." }
        };

        if (!result.IsSuccess || result.Tenant == null)
        {
            LifecycleErrorMessage = result.ErrorMessage ?? "Falha ao executar ação.";
            return;
        }

        SelectedTenant = result.Tenant;
        IsLifecycleModalOpen = false;
        LifecycleErrorMessage = null;
        await LoadData();
    }

    private bool IsPlanModalOpen;

    private void OpenPlanChangeModal()
    {
        if (SelectedTenant == null) return;
        IsPlanModalOpen = true;
    }

    private async Task HandlePlanChanged(ChangeTenantPlanResponseDto response)
    {
        IsPlanModalOpen = false;
        if (SelectedTenant != null)
        {
            await SelectTenant(SelectedTenant.Id);
        }
    }
}
