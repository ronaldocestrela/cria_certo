@page "/forgot-password"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@layout EmptyLayout
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Cria Certo - Recuperação de Senha</PageTitle>

<div class="min-h-screen flex flex-col items-center justify-center p-4" style="background-color: var(--cc-canvas);">
    <main class="w-full max-w-[480px]">
        
        <div class="bg-white rounded-xl p-8 md:p-10 relative overflow-hidden shadow-sm" style="border: 1px solid var(--cc-border);">
            
            <div class="flex flex-col items-center mb-6 text-center" style="display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: 1.5rem;">
                <span class="material-symbols-outlined text-[56px] mb-2" style="color: var(--cc-primary); font-variation-settings: 'FILL' 1;">lock_reset</span>
                <h2 class="font-headline text-[22px] font-bold" style="color: var(--cc-ink); margin: 0;">Recuperação de Senha</h2>
                <p class="font-mono text-[11px] uppercase tracking-widest text-secondary mt-1" style="color: var(--cc-ink-muted); margin: 0.25rem 0 0 0;">
                    Cria Certo Gestão Pecuária
                </p>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="mb-6 p-4 rounded-lg bg-red-50 text-red-700 text-sm border border-red-200" style="margin-bottom: 1.5rem; padding: 1rem; border-radius: 8px; background-color: #fef2f2; color: #b91c1c; border: 1px solid #fecaca;">
                    @_errorMessage
                </div>
            }

            @if (_currentStep == Step.Success)
            {
                <div class="p-6 rounded-lg bg-green-50 text-green-800 text-center space-y-4" style="padding: 1.5rem; border-radius: 8px; background-color: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; text-align: center;">
                    <span class="material-symbols-outlined text-[48px]" style="color: #16a34a;">check_circle</span>
                    <h3 class="font-bold text-lg" style="margin: 0.5rem 0;">Senha Alterada com Sucesso!</h3>
                    <p class="text-sm" style="font-size: 14px; margin-bottom: 1rem;">Sua nova senha foi registrada. Você já pode fazer login no sistema.</p>
                    <button class="w-full h-[44px] text-white font-bold rounded-lg transition-all" 
                            style="width: 100%; height: 44px; background-color: var(--cc-primary); border: none; border-radius: 8px; cursor: pointer;"
                            @onclick='() => Navigation.NavigateTo("/login")'>
                        Ir para o Login
                    </button>
                </div>
            }
            else if (_currentStep == Step.RequestToken)
            {
                <p class="text-sm text-center mb-6" style="font-size: 14px; color: var(--cc-ink-muted); text-align: center; margin-bottom: 1.5rem;">
                    Informe seu e-mail cadastrado para gerar o código/token de recuperação de senha.
                </p>

                <EditForm Model="@_forgotModel" OnValidSubmit="HandleRequestToken" class="space-y-4">
                    <DataAnnotationsValidator />

                    <div style="margin-bottom: 1.25rem;">
                        <label class="font-mono text-[12px] font-bold block" style="display: block; margin-bottom: 0.35rem; text-transform: uppercase; color: var(--cc-ink-muted);">E-MAIL CADASTRADO *</label>
                        <InputText @bind-Value="_forgotModel.Email" class="w-full h-[46px] px-4 rounded-lg border font-headline" style="width: 100%; height: 46px; padding: 0 1rem; border-radius: 8px; border: 1px solid var(--cc-border); background-color: var(--cc-canvas);" placeholder="usuario@fazenda.com.br" type="email" />
                        <ValidationMessage For="@(() => _forgotModel.Email)" class="text-xs text-red-600 mt-1" />
                    </div>

                    <button class="w-full h-[48px] text-white font-mono text-[14px] rounded-lg uppercase tracking-wider transition-all" 
                            style="width: 100%; height: 48px; background-color: var(--cc-primary); border: none; border-radius: 8px; font-weight: bold; cursor: pointer;"
                            type="submit" disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <span>Gerando Token...</span>
                        }
                        else
                        {
                            <span>Enviar Código de Recuperação</span>
                        }
                    </button>

                    <div class="text-center pt-3" style="text-align: center; margin-top: 1rem;">
                        <a href="/login" class="text-sm font-semibold hover:underline" style="color: var(--cc-primary); font-size: 14px; text-decoration: none;">
                            Voltar para o Login
                        </a>
                    </div>
                </EditForm>
            }
            else if (_currentStep == Step.ResetPassword)
            {
                <p class="text-sm text-center mb-4" style="font-size: 14px; color: var(--cc-ink-muted); text-align: center; margin-bottom: 1rem;">
                    Informe o código de verificação recebido e sua nova senha.
                </p>

                @if (!string.IsNullOrEmpty(_generatedTokenInfo))
                {
                    <div class="mb-4 p-3 rounded-lg bg-blue-50 text-blue-800 text-xs border border-blue-200" style="margin-bottom: 1rem; padding: 0.75rem; border-radius: 8px; background-color: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe;">
                        @_generatedTokenInfo
                    </div>
                }

                <EditForm Model="@_resetModel" OnValidSubmit="HandleResetPassword" class="space-y-4">
                    <DataAnnotationsValidator />

                    <div style="margin-bottom: 1rem;">
                        <label class="font-mono text-[12px] font-bold block" style="display: block; margin-bottom: 0.35rem; text-transform: uppercase; color: var(--cc-ink-muted);">E-MAIL</label>
                        <InputText @bind-Value="_resetModel.Email" class="w-full h-[44px] px-4 rounded-lg border font-headline" style="width: 100%; height: 44px; padding: 0 1rem; border-radius: 8px; border: 1px solid var(--cc-border); background-color: var(--cc-canvas);" placeholder="usuario@fazenda.com.br" type="email" />
                        <ValidationMessage For="@(() => _resetModel.Email)" class="text-xs text-red-600 mt-1" />
                    </div>

                    <div style="margin-bottom: 1rem;">
                        <label class="font-mono text-[12px] font-bold block" style="display: block; margin-bottom: 0.35rem; text-transform: uppercase; color: var(--cc-ink-muted);">CÓDIGO / TOKEN *</label>
                        <InputText @bind-Value="_resetModel.Token" class="w-full h-[44px] px-4 rounded-lg border font-headline" style="width: 100%; height: 44px; padding: 0 1rem; border-radius: 8px; border: 1px solid var(--cc-border); background-color: var(--cc-canvas);" placeholder="Ex: 123456" />
                        <ValidationMessage For="@(() => _resetModel.Token)" class="text-xs text-red-600 mt-1" />
                    </div>

                    <div style="margin-bottom: 1rem;">
                        <label class="font-mono text-[12px] font-bold block" style="display: block; margin-bottom: 0.35rem; text-transform: uppercase; color: var(--cc-ink-muted);">NOVA SENHA *</label>
                        <InputText @bind-Value="_resetModel.NewPassword" class="w-full h-[44px] px-4 rounded-lg border font-headline" style="width: 100%; height: 44px; padding: 0 1rem; border-radius: 8px; border: 1px solid var(--cc-border); background-color: var(--cc-canvas);" placeholder="••••••••" type="password" />
                        <ValidationMessage For="@(() => _resetModel.NewPassword)" class="text-xs text-red-600 mt-1" />
                    </div>

                    <div style="margin-bottom: 1.25rem;">
                        <label class="font-mono text-[12px] font-bold block" style="display: block; margin-bottom: 0.35rem; text-transform: uppercase; color: var(--cc-ink-muted);">CONFIRMAR NOVA SENHA *</label>
                        <InputText @bind-Value="_resetModel.ConfirmNewPassword" class="w-full h-[44px] px-4 rounded-lg border font-headline" style="width: 100%; height: 44px; padding: 0 1rem; border-radius: 8px; border: 1px solid var(--cc-border); background-color: var(--cc-canvas);" placeholder="••••••••" type="password" />
                        <ValidationMessage For="@(() => _resetModel.ConfirmNewPassword)" class="text-xs text-red-600 mt-1" />
                    </div>

                    <button class="w-full h-[48px] text-white font-mono text-[14px] rounded-lg uppercase tracking-wider transition-all" 
                            style="width: 100%; height: 48px; background-color: var(--cc-primary); border: none; border-radius: 8px; font-weight: bold; cursor: pointer;"
                            type="submit" disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <span>Alterando Senha...</span>
                        }
                        else
                        {
                            <span>Redefinir Senha</span>
                        }
                    </button>
                </EditForm>
            }

        </div>
    </main>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? TokenQuery { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? EmailQuery { get; set; }

    private Step _currentStep = Step.RequestToken;
    private ForgotModel _forgotModel = new();
    private ResetModel _resetModel = new();
    private bool _isLoading;
    private string? _errorMessage;
    private string? _generatedTokenInfo;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(TokenQuery) && !string.IsNullOrWhiteSpace(EmailQuery))
        {
            _resetModel.Email = EmailQuery;
            _resetModel.Token = TokenQuery;
            _currentStep = Step.ResetPassword;
        }
    }

    private enum Step
    {
        RequestToken,
        ResetPassword,
        Success
    }

    private class ForgotModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "O e-mail é obrigatório.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Formato de e-mail inválido.")]
        public string Email { get; set; } = string.Empty;
    }

    private class ResetModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "O e-mail é obrigatório.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Formato de e-mail inválido.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "O código/token é obrigatório.")]
        public string Token { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "A nova senha é obrigatória.")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "A senha deve ter no mínimo 8 caracteres.")]
        public string NewPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "A confirmação de senha é obrigatória.")]
        [System.ComponentModel.DataAnnotations.Compare(nameof(NewPassword), ErrorMessage = "As senhas não coincidem.")]
        public string ConfirmNewPassword { get; set; } = string.Empty;
    }

    private record ForgotPasswordResponse(string Token, string Message);

    private async Task HandleRequestToken()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("/api/auth/forgot-password", new { Email = _forgotModel.Email });
            if (response.IsSuccessStatusCode)
            {
                var res = await response.Content.ReadFromJsonAsync<ForgotPasswordResponse>();
                _resetModel.Email = _forgotModel.Email;

                if (res != null && !string.IsNullOrEmpty(res.Token))
                {
                    _resetModel.Token = res.Token;
                    _generatedTokenInfo = $"Código de recuperação gerado para testes: {res.Token}";
                }
                else
                {
                    _generatedTokenInfo = res?.Message;
                }

                _currentStep = Step.ResetPassword;
            }
            else
            {
                _errorMessage = "Erro ao processar solicitação de recuperação de senha.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro de conexão: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleResetPassword()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var payload = new
            {
                Email = _resetModel.Email,
                Token = _resetModel.Token,
                NewPassword = _resetModel.NewPassword
            };

            var response = await Http.PostAsJsonAsync("/api/auth/reset-password", payload);
            if (response.IsSuccessStatusCode)
            {
                _currentStep = Step.Success;
            }
            else
            {
                try
                {
                    var err = await response.Content.ReadFromJsonAsync<CriaCerto.BuildingBlocks.Abstractions.Results.Error>();
                    _errorMessage = err?.Message ?? "Erro ao redefinir senha.";
                }
                catch
                {
                    _errorMessage = "Erro ao redefinir a senha. Verifique o código e tente novamente.";
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro de conexão: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
