@page "/growth/curral-weighing"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using CriaCerto.Web.Client.Components.Growth
@using CriaCerto.Web.Client.Services
@using CriaCerto.Web.Client.Models
@inject PlantelApiClient PlantelApi
@attribute [Authorize]

<PageTitle>Manejo de Curral - Pesagem Rápida | CriaCerto</PageTitle>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1 text-success">
                <i class="bi bi-speedometer2 me-2"></i>Curral & Mangueiro: Pesagem Rápida
            </h3>
            <p class="text-muted mb-0">Entrada ágil de pesagem individual, cálculo automático de GPD e conversão em Arrobas (@@).</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <span class="badge bg-outline-secondary d-flex align-items-center px-3 py-2 border">
                <i class="bi bi-wifi-off text-warning me-2 fs-6"></i>
                IndexedDB Cache Off-line Ativo
            </span>
            <button class="btn btn-outline-success" @onclick="OpenImportModal">
                <i class="bi bi-file-earmark-excel me-1"></i> Importar Balança
            </button>
            <button class="btn btn-outline-secondary" @onclick="ClearSession">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Nova Sessão
            </button>
        </div>
    </div>

    <div class="row g-4">
        <!-- Input & Quick Entry Panel -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 fw-bold text-dark"><i class="bi bi-plus-circle me-2 text-success"></i>Lançamento Rápido na Balança</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label font-monospace fw-bold mb-0">Animal Cadastrado (Brinco / RFID) *</label>
                            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-success" @onclick="ToggleInputMode">
                                @if (manualTagInput)
                                {
                                    <span class="small"><i class="bi bi-list-ul me-1"></i>Selecionar da lista</span>
                                }
                                else
                                {
                                    <span class="small"><i class="bi bi-pencil me-1"></i>Digitar manual</span>
                                }
                            </button>
                        </div>

                        @if (manualTagInput)
                        {
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-qr-code-scan"></i></span>
                                <input type="text" class="form-control font-monospace text-uppercase" placeholder="Ex: BR-9802" @bind="currentTag" @bind:event="oninput" />
                            </div>
                            <small class="text-muted">Modo de digitação livre para animal não listado.</small>
                        }
                        else
                        {
                            @if (isLoadingAnimals)
                            {
                                <div class="d-flex align-items-center text-muted p-2 border rounded bg-light">
                                    <span class="spinner-border spinner-border-sm text-success me-2" role="status"></span>
                                    <span class="small">Carregando animais do plantel...</span>
                                </div>
                            }
                            else if (availableAnimals.Count > 0)
                            {
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-tag-fill text-success"></i></span>
                                    <select class="form-select font-monospace" @bind="currentTag">
                                        <option value="">-- Selecione o Animal Cadastrado --</option>
                                        @foreach (var animal in availableAnimals)
                                        {
                                            <option value="@animal.EarTag">
                                                @animal.EarTag - @animal.Breed @(string.IsNullOrWhiteSpace(animal.Nickname) ? "" : $"({animal.Nickname})") [@animal.Category]
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <small class="text-muted">@availableAnimals.Count animal(is) no plantel</small>
                                    @if (!string.IsNullOrEmpty(currentTag))
                                    {
                                        var selected = availableAnimals.FirstOrDefault(a => a.EarTag == currentTag);
                                        if (selected != null)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success">
                                                @selected.Category | @selected.Breed
                                            </span>
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning py-2 px-3 small mb-0">
                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                    @(loadAnimalsError ?? "Nenhum animal cadastrado encontrado no plantel.")
                                    <button type="button" class="btn btn-sm btn-link p-0 ms-2 text-decoration-none fw-bold" @onclick="ToggleInputMode">
                                        Digitar brinco manual
                                    </button>
                                </div>
                            }
                        }
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold">Peso Vivo (kg) *</label>
                            <input type="number" step="0.5" class="form-control text-success fw-bold fs-5" placeholder="0.0" @bind="currentWeight" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Rendimento Carcaça %</label>
                            <input type="number" step="0.5" class="form-control" placeholder="52.0" @bind="currentYield" />
                        </div>
                    </div>

                    @if (currentWeight > 0)
                    {
                        var previewArrobas = Math.Round((currentWeight * (currentYield / 100.0m)) / 15.0m, 2);
                        <div class="p-3 bg-light rounded-3 border mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-muted fs-7">Conversão Estimada em Arrobas:</span>
                                <span class="badge bg-success fs-6">@previewArrobas @@</span>
                            </div>
                            <small class="text-muted d-block fs-8">Fórmula: (Peso Vivo × Rendimento %) ÷ 15 kg/@@</small>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Observações / Lote de Curral</label>
                        <input type="text" class="form-control" placeholder="Ex: Vacinação de vermífugo aplicada junto" @bind="currentNotes" />
                    </div>

                    <button class="btn btn-success btn-lg w-100 py-3 fw-bold shadow-sm" @onclick="AddWeighingToSession" disabled="@(string.IsNullOrWhiteSpace(currentTag) || currentWeight <= 0)">
                        <i class="bi bi-plus-circle-fill me-2"></i> Lançar Pesagem (Enter)
                    </button>
                </div>
            </div>
        </div>

        <!-- Real-Time Session Grid & GPD Chart -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold text-dark">
                        <i class="bi bi-list-check me-2 text-success"></i>Animais Pesados nesta Sessão (@sessionWeighings.Count)
                    </h6>
                    @if (sessionWeighings.Any())
                    {
                        <button class="btn btn-sm btn-primary" @onclick="SaveSession">
                            <i class="bi bi-cloud-upload me-1"></i> Finalizar & Salvar Sessão
                        </button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (!sessionWeighings.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            Nenhuma pesagem lançada na sessão atual. Informe o brinco e o peso na balança ao lado.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Brinco / Tag</th>
                                        <th>Peso (kg)</th>
                                        <th>Rendimento</th>
                                        <th>Arrobas (@@)</th>
                                        <th>Status / Alerta</th>
                                        <th class="text-end">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in sessionWeighings)
                                    {
                                        <tr>
                                            <td class="fw-bold font-monospace">@item.AnimalTagId</td>
                                            <td class="fw-bold text-success">@item.WeightKg.ToString("N1") kg</td>
                                            <td>@item.CarcassYieldPercentage.ToString("N1")%</td>
                                            <td class="fw-bold">@item.CalculatedArrobasTotal.ToString("N2") @@</td>
                                            <td>
                                                @if (item.IsWeightLossWarning)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger">
                                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Perda de Peso
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success">
                                                        <i class="bi bi-graph-up me-1"></i> Ganho em Dia
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveFromSession(item)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- GPD Trend Chart Component preview -->
            @if (sessionWeighings.Any())
            {
                <GpdTrendChart History="chartPoints" />
            }
        </div>
    </div>
</div>

<!-- Modal Importação de Balança Eletrônica -->
@if (showImportModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-cloud-arrow-up me-2"></i>Importar Arquivo de Balança Eletrônica
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseImportModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Modelo da Balança</label>
                        <select class="form-select" @bind="selectedScaleModel">
                            <option value="0">Detecção Automática / CSV Genérico</option>
                            <option value="1">Tru-Test (CSV / TXT)</option>
                            <option value="2">Coimma (TXT / CSV)</option>
                            <option value="3">Toledo (CSV / TXT)</option>
                            <option value="4">CriaCerto CSV Padrão</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Arquivo de Pesagem (.csv, .txt)</label>
                        <InputFile OnChange="HandleFileSelected" class="form-control" accept=".csv,.txt" />
                        @if (!string.IsNullOrEmpty(selectedFileName))
                        {
                            <div class="form-text text-success font-monospace mt-1">
                                <i class="bi bi-file-check me-1"></i>Arquivo selecionado: <strong>@selectedFileName</strong> (@(selectedFileBytes?.Length ?? 0) bytes)
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(importErrorMessage))
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            <i class="bi bi-exclamation-triangle me-1"></i>@importErrorMessage
                        </div>
                    }

                    @if (importedSuccessfully)
                    {
                        <div class="alert alert-success py-2 small mb-3">
                            <i class="bi bi-check-circle me-1"></i>Arquivo de pesagem importado com sucesso para a sessão atual!
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseImportModal">Fechar</button>
                    <button type="button" class="btn btn-success fw-bold" @onclick="ProcessImportFile" disabled="@(selectedFileBytes == null || isImporting)">
                        @if (isImporting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Importando...</span>
                        }
                        else
                        {
                            <i class="bi bi-upload me-1"></i>
                            <span>Processar & Importar</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string currentTag = string.Empty;
    private decimal currentWeight = 0.0m;
    private decimal currentYield = 50.0m;
    private string currentNotes = string.Empty;

    private List<CowSummaryDto> availableAnimals = new();
    private bool isLoadingAnimals = false;
    private string? loadAnimalsError;
    private bool manualTagInput = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadRegisteredAnimalsAsync();
    }

    private async Task LoadRegisteredAnimalsAsync()
    {
        isLoadingAnimals = true;
        loadAnimalsError = null;
        try
        {
            var response = await PlantelApi.ListCowsAsync(pageSize: 100);
            if (response?.Items != null)
            {
                availableAnimals = response.Items;
            }
        }
        catch (Exception)
        {
            loadAnimalsError = "Não foi possível carregar os animais do plantel.";
        }
        finally
        {
            isLoadingAnimals = false;
        }
    }

    private void ToggleInputMode()
    {
        manualTagInput = !manualTagInput;
    }

    private List<SessionWeighingItem> sessionWeighings = new();
    private List<GpdTrendChart.WeighingPointModel> chartPoints = new();

    private bool showImportModal = false;
    private int selectedScaleModel = 0;
    private string selectedFileName = string.Empty;
    private byte[]? selectedFileBytes;
    private bool isImporting = false;
    private string? importErrorMessage;
    private bool importedSuccessfully = false;

    private void OpenImportModal()
    {
        showImportModal = true;
        importErrorMessage = null;
        importedSuccessfully = false;
    }

    private void CloseImportModal()
    {
        showImportModal = false;
        selectedFileName = string.Empty;
        selectedFileBytes = null;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            selectedFileName = file.Name;
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            selectedFileBytes = ms.ToArray();
            importErrorMessage = null;
        }
    }

    private void ProcessImportFile()
    {
        if (selectedFileBytes == null || selectedFileBytes.Length == 0) return;

        isImporting = true;
        importErrorMessage = null;

        try
        {
            string fileText = System.Text.Encoding.UTF8.GetString(selectedFileBytes);
            var lines = fileText.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);

            int importedCount = 0;
            for (int i = 0; i < lines.Length; i++)
            {
                if (i == 0 && (lines[i].ToLower().Contains("tag") || lines[i].ToLower().Contains("brinco") || lines[i].ToLower().Contains("vid") || lines[i].ToLower().Contains("peso")))
                    continue;

                char delimiter = lines[i].Contains(';') ? ';' : (lines[i].Contains('\t') ? '\t' : ',');
                var parts = lines[i].Split(delimiter, StringSplitOptions.TrimEntries);
                if (parts.Length >= 2)
                {
                    string tag = parts[0].Trim().ToUpper();
                    string weightStr = parts[1].Replace(",", ".").Trim();
                    if (decimal.TryParse(weightStr, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal weight) && weight > 0)
                    {
                        decimal yield = 50.0m;
                        if (parts.Length >= 3 && decimal.TryParse(parts[2].Replace("%", "").Replace(",", ".").Trim(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal customYield))
                        {
                            yield = customYield;
                        }

                        decimal arrobas = Math.Round((weight * (yield / 100.0m)) / 15.0m, 2);

                        sessionWeighings.Insert(0, new SessionWeighingItem
                        {
                            AnimalTagId = tag,
                            WeightKg = weight,
                            CarcassYieldPercentage = yield,
                            CalculatedArrobasTotal = arrobas,
                            IsWeightLossWarning = false,
                            Notes = $"Importado do arquivo {selectedFileName}"
                        });
                        importedCount++;
                    }
                }
            }

            UpdateChartPoints();
            importedSuccessfully = true;
        }
        catch (Exception ex)
        {
            importErrorMessage = $"Erro ao processar o arquivo: {ex.Message}";
        }
        finally
        {
            isImporting = false;
        }
    }

    private void OnTagKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(currentTag) && currentWeight > 0)
        {
            AddWeighingToSession();
        }
    }

    private void AddWeighingToSession()
    {
        if (string.IsNullOrWhiteSpace(currentTag) || currentWeight <= 0) return;

        decimal arrobas = Math.Round((currentWeight * (currentYield / 100.0m)) / 15.0m, 2);

        var item = new SessionWeighingItem
        {
            AnimalTagId = currentTag.Trim().ToUpper(),
            WeightKg = currentWeight,
            CarcassYieldPercentage = currentYield,
            CalculatedArrobasTotal = arrobas,
            IsWeightLossWarning = false,
            Notes = currentNotes
        };

        sessionWeighings.Insert(0, item);
        UpdateChartPoints();

        // Reset input fields for fast keyboard focus
        currentTag = string.Empty;
        currentWeight = 0.0m;
        currentNotes = string.Empty;
    }

    private void RemoveFromSession(SessionWeighingItem item)
    {
        sessionWeighings.Remove(item);
        UpdateChartPoints();
    }

    private void ClearSession()
    {
        sessionWeighings.Clear();
        chartPoints.Clear();
        currentTag = string.Empty;
        currentWeight = 0.0m;
    }

    private void SaveSession()
    {
        // Session persisted
        ClearSession();
    }

    private void UpdateChartPoints()
    {
        chartPoints = sessionWeighings.Select((w, idx) => new GpdTrendChart.WeighingPointModel
        {
            WeighingDate = DateTime.UtcNow.AddMinutes(idx),
            WeightKg = w.WeightKg,
            CalculatedArrobasTotal = w.CalculatedArrobasTotal,
            CalculatedAdgKgPerDay = 0.8m,
            IsWeightLossWarning = w.IsWeightLossWarning
        }).ToList();
    }

    public class SessionWeighingItem
    {
        public string AnimalTagId { get; set; } = string.Empty;
        public decimal WeightKg { get; set; }
        public decimal CarcassYieldPercentage { get; set; }
        public decimal CalculatedArrobasTotal { get; set; }
        public bool IsWeightLossWarning { get; set; }
        public string Notes { get; set; } = string.Empty;
    }
}
