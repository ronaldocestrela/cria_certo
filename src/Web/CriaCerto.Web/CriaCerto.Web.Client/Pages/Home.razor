        </div>
    </div>

    <!-- Hero Banner Section -->
    <section class="landing-hero">
        <div class="hero-bg-overlay"></div>
        <div class="hero-container">
            <div class="hero-content">
                <div class="hero-badge">
                    <span class="material-symbols-outlined text-emerald-400">wifi_off</span>
                    <span>100% Funcional Off-line no Curral & Pasto (PWA)</span>
                </div>
