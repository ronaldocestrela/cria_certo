@code {
    private bool _isAnnual = true;
    private bool _isMobileMenuOpen = false;
    private bool _isLoadingCatalog = true;
    private bool _showFullMatrix = false;
    private int _activeFaqIndex = 0;
    private string _activePreset = "cria";
    private string _selectedTierCode = "TIER_500";
    private HashSet<string> _selectedModuleKeys = new(StringComparer.OrdinalIgnoreCase) { "Cows", "Breeding", "Calving" };
    private ModularSubscriptionCatalogModel _catalog = TenancyApiClient.GetDefaultModularCatalog();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoadingCatalog = true;
            _catalog = await TenancyApiClient.GetModularCatalogAsync();
        }
        catch
        {
            _catalog = TenancyApiClient.GetDefaultModularCatalog();
        }
        finally
        {
            _isLoadingCatalog = false;
        }
    }

    private void SelectTier(string tierCode)
    {
        _selectedTierCode = tierCode;
    }

    private void ToggleModule(string moduleKey)
    {
        if (string.Equals(moduleKey, "Cows", StringComparison.OrdinalIgnoreCase))
        {
            return; // Cows é compulsório / fixo
        }

        if (_selectedModuleKeys.Contains(moduleKey))
        {
            _selectedModuleKeys.Remove(moduleKey);
        }
        else
        {
            _selectedModuleKeys.Add(moduleKey);
        }

        _activePreset = DetectActivePreset();
    }

    private void ApplyPreset(string preset)
    {
        _activePreset = preset;
        _selectedModuleKeys.Clear();
        _selectedModuleKeys.Add("Cows");

        switch (preset)
        {
            case "plantel":
                break;
            case "cria":
                _selectedModuleKeys.Add("Breeding");
                _selectedModuleKeys.Add("Calving");
                break;
            case "engorda":
                _selectedModuleKeys.Add("Growth");
                _selectedModuleKeys.Add("Nutrition");
                _selectedModuleKeys.Add("Sanitary");
                break;
            case "completo":
                foreach (var mod in _catalog.Modules)
                {
                    _selectedModuleKeys.Add(mod.ModuleKey);
                }
                break;
        }
    }

    private string DetectActivePreset()
    {
        var nonCore = _selectedModuleKeys.Where(k => !string.Equals(k, "Cows", StringComparison.OrdinalIgnoreCase)).ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (nonCore.Count == 0) return "plantel";
        if (nonCore.SetEquals(new[] { "Breeding", "Calving" })) return "cria";
        if (nonCore.SetEquals(new[] { "Growth", "Nutrition", "Sanitary" })) return "engorda";
        if (nonCore.Count >= _catalog.Modules.Count - 1) return "completo";

        return string.Empty;
    }

    private bool IsModuleSelected(string moduleKey)
    {
        return string.Equals(moduleKey, "Cows", StringComparison.OrdinalIgnoreCase)
            || _selectedModuleKeys.Contains(moduleKey);
    }

    private HeadTierOptionModel? SelectedTier =>
        _catalog.HeadTiers.FirstOrDefault(t => string.Equals(t.TierCode, _selectedTierCode, StringComparison.OrdinalIgnoreCase))
        ?? _catalog.HeadTiers.FirstOrDefault();

    private int SelectedModuleCount =>
        _catalog.Modules.Count(m => IsModuleSelected(m.ModuleKey));

    private decimal TotalPriceMonthly
    {
        get
        {
            decimal total = 0m;
            foreach (var mod in _catalog.Modules.Where(m => IsModuleSelected(m.ModuleKey)))
            {
                var priceOption = mod.PricesByTier.FirstOrDefault(p => string.Equals(p.TierCode, _selectedTierCode, StringComparison.OrdinalIgnoreCase))
                                  ?? mod.PricesByTier.FirstOrDefault();

                if (priceOption != null)
                {
                    total += _isAnnual ? priceOption.AnnualPriceMonthly : priceOption.MonthlyPrice;
                }
            }
            return total;
        }
    }

    private decimal CostPerHeadPerMonth
    {
        get
        {
            var maxHeads = SelectedTier?.MaxHeads ?? 500;
            var denominator = Math.Max(1, maxHeads);
            return Math.Round(TotalPriceMonthly / denominator, 2);
        }
    }

    private void ToggleMatrixView()
    {
        _showFullMatrix = !_showFullMatrix;
    }

    private void ToggleMobileMenu()
    {
        _isMobileMenuOpen = !_isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        _isMobileMenuOpen = false;
    }

    private void ToggleFaq(int index)
    {
        _activeFaqIndex = _activeFaqIndex == index ? -1 : index;
    }

    private bool IsFaqOpen(int index) => _activeFaqIndex == index;

    private static string FormatPrice(decimal price) =>
        price % 1 == 0 ? price.ToString("N0") : price.ToString("N2");
}
