                        <span class="preview-label">Lote Engorda BR-163</span>
                        <span class="preview-val">420 Cabeças</span>
                        <div class="preview-tag-chip">GPD Média: 1,280 kg/dia</div>
                    </div>
                    <div class="preview-mini-chart">
