@page "/"
@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject NavigationManager Navigation
@inject TenancyApiClient TenancyApiClient

<PageTitle>CriaCerto - Gestão Pecuária Inteligente do Pasto ao Confinamento</PageTitle>

<HeadContent>
    <meta name="description" content="Plataforma SaaS pecuária de alta precisão. Manejo de curral 100% off-line (PWA), pesagens RFID SISBOV, curva de GPD, IATF e trava sanitária de carência." />
    <meta name="keywords" content="gestão pecuária, software pecuário, curral offline, PWA curral, IATF bovino, curva de GPD, balança eletrônica gado, trava de carência sanitária, pecuária de corte, confinamento bovino, SISBOV RFID" />
    <link rel="canonical" href="https://criacerto.com.br/" />
    
    <!-- Open Graph / Redes Sociais -->
    <meta property="og:title" content="CriaCerto - Gestão Pecuária Inteligente do Pasto ao Confinamento" />
    <meta property="og:description" content="Controle individual do rebanho, pesagens com balança eletrônica, GPD, protocolos de IATF, nutrição e trava sanitária de carência — 100% off-line no curral." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://criacerto.com.br/" />
    <meta property="og:site_name" content="CriaCerto Bovino SaaS" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content="https://criacerto.com.br/imgs/CriaCerto.png" />
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="CriaCerto - Gestão Pecuária Inteligente do Pasto ao Confinamento" />
    <meta name="twitter:description" content="Controle individual do rebanho, pesagens com balança eletrônica, GPD, IATF e trava sanitária de carência — 100% off-line no mangueiro." />
    <meta name="twitter:image" content="https://criacerto.com.br/imgs/CriaCerto.png" />

    <!-- Dados Estruturados Schema.org / JSON-LD para Google e Buscadores com IA (GEO) -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@graph": [
        {
          "@@type": "SoftwareApplication",
          "name": "CriaCerto Bovino SaaS",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web, Android, iOS, Windows (PWA Offline)",
          "description": "Plataforma de alta precisão para gestão pecuária do pasto ao confinamento, com operação 100% off-line no curral, pesagens eletrônicas, curva de GPD, IATF e trava sanitária de carência.",
          "url": "https://criacerto.com.br",
          "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "BRL",
            "description": "Teste grátis de 30 dias sem cartão de crédito"
          },
          "featureList": [
            "Manejo de curral 100% off-line",
            "Integração com balança eletrônica e leitor RFID SISBOV",
            "Cálculo automático de GPD (Ganho de Peso Diário)",
            "Protocolos de IATF e diagnóstico gestacional",
            "Trava sanitária de carência para liberação de abate",
            "Gestão de nutrição e cocho em confinamento (TMR)"
          ]
        },
        {
          "@@type": "Organization",
          "name": "CriaCerto",
          "url": "https://criacerto.com.br",
          "logo": "https://criacerto.com.br/imgs/CriaCerto.png"
        },
        {
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "Preciso de internet para lançar dados no curral ou pasto?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Não! O CriaCerto foi concebido com tecnologia PWA Offline-First. Você pode abrir o sistema no celular ou tablet, realizar pesagens, vacinações e manejos no curral completamente sem sinal. Assim que o dispositivo encontrar sinal de Wi-Fi ou 4G, os dados são sincronizados automaticamente com o servidor em nuvem."
              }
            },
            {
              "@@type": "Question",
              "name": "O sistema é compatível com brincos eletrônicos RFID e balanças?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Sim. O módulo de curral possui interface preparada para entrada rápida via bastão leitor de RFID (Bluetooth ou USB), leitura manual de brinco visual/SISBOV e integração ágil com indicadores de pesagem das principais marcas do mercado."
              }
            },
            {
              "@@type": "Question",
              "name": "Como funciona o teste grátis de 30 dias? Preciso cadastrar cartão?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "O período de teste é 100% gratuito e não exige cartão de crédito. Você cria sua conta em menos de 2 minutos, configura os dados da sua fazenda e tem acesso imediato a todas as funcionalidades do plano escolhido por 30 dias."
              }
            },
            {
              "@@type": "Question",
              "name": "Consigo importar meus animais a partir de planilhas Excel?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Com certeza. O CriaCerto conta com assistente de importação em lote via arquivos CSV e planilhas Excel para cadastrar animais, lotes, histórico de peso e matrizes reprodutivas sem necessidade de digitação individual."
              }
            },
            {
              "@@type": "Question",
              "name": "Posso cadastrar vaqueiros e dar permissões personalizadas?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Sim. Você pode cadastrar múltiplos operadores com perfis específicos: o vaqueiro de campo acessa apenas a tela de lançamento de pesagem e trato, enquanto veterinários e gerentes têm acesso à reprodução, sanidade, custos financeiros e relatórios executivos."
              }
            }
          ]
        }
      ]
    }
    </script>
</HeadContent>

<div class="landing-page font-headline">

