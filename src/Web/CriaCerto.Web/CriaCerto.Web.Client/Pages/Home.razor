                                    Cobrança mensal sem fidelidade
                                </div>
                            }
                        </div>

                        <div class="summary-roi-pill font-mono">
                            <span class="material-symbols-outlined icon-sm">calculate</span>
                            <span>Apenas <strong>R$ @FormatPrice(CostPerHeadPerMonth)</strong> por cabeça/mês</span>
                        </div>
                    </div>

                    <div style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; color: #475569;" class="font-mono">
                        Módulos Ativos (@SelectedModuleCount de @_catalog.Modules.Count):
                    </div>

                    <div class="summary-modules-list">
                        @foreach (var mod in _catalog.Modules)
                        {
                            if (IsModuleSelected(mod.ModuleKey))
                            {
                                var priceOption = mod.PricesByTier.FirstOrDefault(p => string.Equals(p.TierCode, _selectedTierCode, StringComparison.OrdinalIgnoreCase))
                                                  ?? mod.PricesByTier.FirstOrDefault();
                                var priceVal = priceOption != null
                                    ? (_isAnnual ? priceOption.AnnualPriceMonthly : priceOption.MonthlyPrice)
                                    : 0m;

                                <div class="summary-mod-item">
                                    <span class="mod-name">
                                        <span class="material-symbols-outlined text-emerald-600 icon-sm">check_circle</span>
                                        <span>@mod.Name</span>
                                    </span>
                                    <span class="mod-price">R$ @FormatPrice(priceVal)</span>
                                </div>
                            }
                        }
                    </div>

                    <a href="/register" class="cc-btn cc-btn-primary plan-cta-btn" style="margin-top: 1.5rem; text-decoration: none;">
                        <span>Iniciar Teste Grátis de 30 Dias</span>
                        <span class="material-symbols-outlined icon-sm">arrow_forward</span>
                    </a>

                    <p class="summary-guarantee-note font-mono">
                        <span class="material-symbols-outlined icon-sm" style="vertical-align: text-bottom; margin-right: 0.2rem; color: #16a34a;">check</span>
                        30 dias grátis para até 500 cabeças • Sem cartão de crédito • Cancele ou altere a qualquer momento
                    </p>
                </div>
            </div>

            <!-- Botão Expansível: Matriz Completa de Preços -->
            <div class="matrix-accordion-toggle">
                <button type="button" class="matrix-toggle-btn font-mono" @onclick="ToggleMatrixView">
                    <span class="material-symbols-outlined">@(_showFullMatrix ? "expand_less" : "table_chart")</span>
                    <span>@(_showFullMatrix ? "Ocultar tabela completa de preços" : "Ver matriz completa de preços por módulo e faixa")</span>
                </button>

                @if (_showFullMatrix)
                {
                    <div class="full-matrix-table-wrap">
                        <table class="full-matrix-table">
                            <thead>
                                <tr>
                                    <th>Módulo</th>
                                    <th>Tipo</th>
                                    @foreach (var tier in _catalog.HeadTiers)
                                    {
                                        <th style="text-align: right;">@tier.DisplayName</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mod in _catalog.Modules)
                                {
                                    <tr>
                                        <td>
                                            <div style="font-weight: 700; color: #0f172a;">@mod.Name</div>
                                            <div style="font-size: 0.75rem; color: #64748b;">@mod.Description</div>
                                        </td>
                                        <td>
                                            @if (mod.IsCore || string.Equals(mod.ModuleKey, "Cows", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="font-mono text-xs" style="background: #f0fdf4; color: #166534; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: 700;">Base</span>
                                            }
                                            else
                                            {
                                                <span class="font-mono text-xs" style="background: #f1f5f9; color: #475569; padding: 0.2rem 0.5rem; border-radius: 4px;">Opcional</span>
                                            }
                                        </td>
                                        @foreach (var tier in _catalog.HeadTiers)
                                        {
                                            var p = mod.PricesByTier.FirstOrDefault(x => string.Equals(x.TierCode, tier.TierCode, StringComparison.OrdinalIgnoreCase));
                                            <td style="text-align: right;" class="font-mono">
                                                @if (p != null)
                                                {
                                                    <span>R$ @FormatPrice(_isAnnual ? p.AnnualPriceMonthly : p.MonthlyPrice)<small style="font-size: 0.7rem; color: #64748b;">/mês</small></span>
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
