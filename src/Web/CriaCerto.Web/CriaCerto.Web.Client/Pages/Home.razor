@page "/"
@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject NavigationManager Navigation
@inject TenancyApiClient TenancyApiClient

<PageTitle>CriaCerto - Gestão Pecuária Inteligente do Pasto ao Confinamento</PageTitle>

<HeadContent>
    <meta name="description" content="Plataforma SaaS pecuária de alta precisão. Manejo de curral 100% off-line (PWA), pesagens RFID SISBOV, curva de GPD, IATF e trava sanitária de carência." />
    <meta property="og:title" content="CriaCerto - Gestão Pecuária Inteligente do Pasto ao Confinamento" />
    <meta property="og:description" content="Controle individual do rebanho, pesagens com balança eletrônica, GPD, protocolos de IATF, nutrição e trava sanitária de carência — tudo na palma da mão, mesmo sem sinal de internet no mangueiro." />
    <meta property="og:type" content="website" />
</HeadContent>

<div class="landing-page font-headline">

    <!-- Commercial Top Navigation Bar -->
    <header class="landing-navbar">
        <div class="landing-nav-container">
            <div class="landing-brand">
                <img src="imgs/CriaCerto.png" alt="CriaCerto Logo" style="height: 42px; width: auto; object-fit: contain; border-radius: 6px;" />
                <div class="brand-text">
                    <span class="brand-title">CriaCerto</span>
                    <span class="brand-subtitle">BOVINO SaaS</span>
                </div>
            </div>

            <nav class="landing-nav-links">
                <a href="#recursos" class="nav-item">Recursos</a>
                <a href="#modulos" class="nav-item">Módulos</a>
                <a href="#diferenciais" class="nav-item">Diferenciais</a>
                <a href="#planos" class="nav-item">Planos & Preços</a>
                <a href="#faq" class="nav-item">Dúvidas</a>
            </nav>

            <div class="landing-nav-actions">
                <a href="/login" class="cc-btn cc-btn-outline nav-btn-login">Entrar</a>
                <a href="/register" class="cc-btn cc-btn-primary nav-btn-register">
                    <span>Experimentar Grátis</span>
                    <span class="material-symbols-outlined icon-sm">arrow_forward</span>
                </a>
                <button class="landing-menu-toggle" @onclick="ToggleMobileMenu" aria-label="Abrir menu de navegação">
                    <span class="material-symbols-outlined">@(_isMobileMenuOpen ? "close" : "menu")</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Mobile Drawer Navigation -->
    <div class="landing-mobile-drawer @(_isMobileMenuOpen ? "open" : "")">
        <a href="#recursos" class="mobile-nav-link" @onclick="CloseMobileMenu">Recursos</a>
        <a href="#modulos" class="mobile-nav-link" @onclick="CloseMobileMenu">Módulos</a>
        <a href="#diferenciais" class="mobile-nav-link" @onclick="CloseMobileMenu">Diferenciais</a>
        <a href="#planos" class="mobile-nav-link" @onclick="CloseMobileMenu">Planos & Preços</a>
        <a href="#faq" class="mobile-nav-link" @onclick="CloseMobileMenu">Dúvidas Frequentes</a>
        
        <div class="mobile-drawer-actions">
            <a href="/register" class="cc-btn cc-btn-primary" @onclick="CloseMobileMenu">
                <span>Criar Conta Gratuita (30 Dias)</span>
                <span class="material-symbols-outlined icon-sm">arrow_forward</span>
            </a>
            <a href="/login" class="cc-btn cc-btn-outline" @onclick="CloseMobileMenu">Entrar no Sistema</a>
        </div>
    </div>

    <!-- Hero Banner Section -->
    <section class="landing-hero">
        <div class="hero-bg-overlay"></div>
        <div class="hero-container">
            <div class="hero-content">
                <div class="hero-badge">
                    <span class="material-symbols-outlined text-emerald-400">wifi_off</span>
                    <span>100% Funcional Off-line no Curral & Pasto (PWA)</span>
                </div>
                <h1 class="hero-title">
                    Gestão Pecuária Inteligente: <br />
                    <span class="hero-highlight">Do Pasto ao Confinamento</span>
                </h1>
                <p class="hero-description">
                    Controle individual do rebanho, pesagens com balança eletrônica, GPD, protocolos de IATF, 
                    suplementação e trava sanitária de carência — tudo na palma da mão, mesmo sem sinal de internet no mangueiro.
                </p>

                <div class="hero-cta-group">
                    <a href="/register" class="cc-btn cc-btn-primary hero-btn-main">
                        <span>Iniciar Teste Grátis de 30 Dias</span>
                        <span class="material-symbols-outlined">rocket_launch</span>
                    </a>
                    <a href="#modulos" class="cc-btn hero-btn-sec">
                        <span>Conhecer Módulos</span>
                        <span class="material-symbols-outlined">expand_more</span>
                    </a>
                </div>

                <div class="hero-metrics-row">
                    <div class="metric-pill">
                        <span class="metric-value">+150k</span>
                        <span class="metric-label">Cabeças Monitoradas</span>
                    </div>
                    <div class="metric-divider"></div>
                    <div class="metric-pill">
                        <span class="metric-value">60%</span>
                        <span class="metric-label">Economia de Tempo no Curral</span>
                    </div>
                    <div class="metric-divider"></div>
                    <div class="metric-pill">
                        <span class="metric-value">100%</span>
                        <span class="metric-label">Segurança Sanitária para Abate</span>
                    </div>
                </div>
            </div>

            <div class="hero-visual-card">
                <div class="glass-card-header">
                    <div class="card-status-dot"></div>
                    <span class="font-mono text-xs text-emerald-300">CURRAL PWA OFFLINE ACTIVE</span>
                </div>
                <div class="hero-card-preview">
                    <div class="preview-metric-box">
                        <span class="preview-label">Lote Engorda BR-163</span>
                        <span class="preview-val">420 Cabeças</span>
                        <div class="preview-tag-chip">GPD Média: 1,280 kg/dia</div>
                    </div>
                    <div class="preview-mini-chart">
                        <div class="chart-bar" style="height: 45%;"></div>
                        <div class="chart-bar" style="height: 60%;"></div>
                        <div class="chart-bar" style="height: 75%;"></div>
                        <div class="chart-bar active" style="height: 90%;"></div>
                    </div>
                    <div class="preview-alert-box">
                        <span class="material-symbols-outlined text-amber-400">verified_user</span>
                        <span>Trava de Carência Medicamentosa Ativa</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Core Features Section (Bento Grid) -->
    <section id="recursos" class="landing-features">
        <div class="features-header text-center">
            <span class="section-tag font-mono">PILARES ZOOTÉCNICOS</span>
            <h2 class="section-title">Tudo o que sua fazenda precisa para maximizar a arroba (@@)</h2>
            <p class="section-subtitle">Tecnologia desenvolvida sob medida para a realidade do produtor de corte, cria, recria e confinamento do Brasil.</p>
        </div>

        <div class="bento-grid">
            <!-- Bento Box 1: PWA Offline -->
            <div class="bento-card bento-wide">
                <div class="bento-icon-box text-emerald-600 bg-emerald-50">
                    <span class="material-symbols-outlined">signal_wifi_off</span>
                </div>
                <div class="bento-body">
                    <span class="bento-badge">PWA Field Technology</span>
                    <h3>Curral & Pasto 100% Off-line</h3>
                    <p>
                        Opere no manejo de curral ou pasto distante sem depender de conexão de celular ou Wi-Fi. 
                        Todas as pesagens, vacinações e manejos reprodutivos são armazenados localmente e sincronizados 
                        automaticamente ao retornar à sede.
                    </p>
                </div>
            </div>

            <!-- Bento Box 2: Reprodução & IATF -->
            <div class="bento-card">
                <div class="bento-icon-box text-rose-600 bg-rose-50 d-flex align-items-center justify-content-center">
                    <BovineIcon Size="28" />
                </div>
                <div class="bento-body">
                    <h3>Matrizes & IATF</h3>
                    <p>
                        Controle completo do rebanho reprodutivo, protocolos de IATF, diagnóstico de gestação 
                        e acompanhamento do Intervalo Entre Partos (IEP).
                    </p>
                </div>
            </div>

            <!-- Bento Box 3: Pesagem & Balança -->
            <div class="bento-card">
                <div class="bento-icon-box text-blue-600 bg-blue-50">
                    <span class="material-symbols-outlined">scale</span>
                </div>
                <div class="bento-body">
                    <h3>Pesagem & Curva de GPD</h3>
                    <p>
                        Entrada rápida por brinco SISBOV / Eletrônico RFID, acompanhamento de Ganho de Peso Diário (kg/dia e @@) 
                        e alertas automáticos para animais com perda de peso.
                    </p>
                </div>
            </div>

            <!-- Bento Box 4: Nutrição & Confinamento -->
            <div class="bento-card">
                <div class="bento-icon-box text-amber-600 bg-amber-50">
                    <span class="material-symbols-outlined">set_meal</span>
                </div>
                <div class="bento-body">
                    <h3>Nutrição & Custo por Arroba</h3>
                    <p>
                        Registro de trato total (TMR) em confinamento, suplementação mineral em pasto, estoque de silos 
                        e indicador em tempo real de custo por @@ produzida.
                    </p>
                </div>
            </div>

            <!-- Bento Box 5: Sanidade & Carência -->
            <div class="bento-card bento-wide">
                <div class="bento-icon-box text-purple-600 bg-purple-50">
                    <span class="material-symbols-outlined">vaccines</span>
                </div>
                <div class="bento-body">
                    <span class="bento-badge">Sanitary Safety</span>
                    <h3>Segurança Sanitária & Trava de Abate</h3>
                    <p>
                        Controle estrito de campanhas vacinais obrigatórias (Febre Aftosa, Brucelose) e trava sanitária 
                        automática impedindo a venda ou loteamento para abate de animais sob carência medicamentosa.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Modules Section -->
    <section id="modulos" class="landing-modules">
        <div class="modules-container">
            <div class="features-header text-center">
                <span class="section-tag font-mono">ARQUITETURA MODULAR</span>
                <h2 class="section-title">Módulos Especializados para cada Etapa do Rebanho</h2>
                <p class="section-subtitle">Ative apenas o que a sua operação necessita, com integração nativa entre módulos.</p>
            </div>

            <div class="modules-grid">
                <div class="module-card">
                    <div class="module-icon-wrap bg-emerald-50 text-emerald-600">
                        <span class="material-symbols-outlined">speed</span>
                    </div>
                    <div class="module-header">
                        <h3>Manejo de Curral & Balança</h3>
                        <p>Leitura por RFID/SISBOV, registro ágil de pesagens, classificação em lotes e exportação para relatórios oficiais.</p>
                    </div>
                    <div class="module-tags">
                        <span class="module-chip">Balança Eletrônica</span>
                        <span class="module-chip">Leitor RFID</span>
                        <span class="module-chip">Curva de GPD</span>
                    </div>
                </div>

                <div class="module-card">
                    <div class="module-icon-wrap bg-rose-50 text-rose-600">
                        <span class="material-symbols-outlined">favorite</span>
                    </div>
                    <div class="module-header">
                        <h3>Reprodução & IATF</h3>
                        <p>Gestão de estações de monta, protocolos D0/D8/D11, controle de doses de sêmen por touro e diagnóstico ultrassonográfico precoce.</p>
                    </div>
                    <div class="module-tags">
                        <span class="module-chip">Protocolos IATF</span>
                        <span class="module-chip">Estoque de Sêmen</span>
                        <span class="module-chip">Taxa de Prenhez</span>
                    </div>
                </div>

                <div class="module-card">
                    <div class="module-icon-wrap bg-blue-50 text-blue-600">
                        <span class="material-symbols-outlined">child_care</span>
                    </div>
                    <div class="module-header">
                        <h3>Partos & Bezerreiro</h3>
                        <p>Acompanhamento de maternidade, avaliação de vigor ao nascer, controle de colostragem e desmame com peso ajustado.</p>
                    </div>
                    <div class="module-tags">
                        <span class="module-chip">Vigor Neonatal</span>
                        <span class="module-chip">Colostragem</span>
                        <span class="module-chip">Mortalidade Pré-desmame</span>
                    </div>
                </div>

                <div class="module-card">
                    <div class="module-icon-wrap bg-amber-50 text-amber-600">
                        <span class="material-symbols-outlined">agriculture</span>
                    </div>
                    <div class="module-header">
                        <h3>Nutrição & Confinamento</h3>
                        <p>Controle de vagão forrageiro, leitura de cocho matinal/vespertina, consumo de matéria seca e inventário de grãos em silos.</p>
                    </div>
                    <div class="module-tags">
                        <span class="module-chip">Leitura de Cocho</span>
                        <span class="module-chip">TMR / Trato</span>
                        <span class="module-chip">Estoque de Silo</span>
                    </div>
                </div>

                <div class="module-card">
                    <div class="module-icon-wrap bg-purple-50 text-purple-600">
                        <span class="material-symbols-outlined">verified</span>
                    </div>
                    <div class="module-header">
                        <h3>Sanidade & Bloqueio de Abate</h3>
                        <p>Calendário de vacinação oficial, controle de lote de vermífugos/antibióticos e bloqueio automático de emissão de GTA para carcaça em carência.</p>
                    </div>
                    <div class="module-tags">
                        <span class="module-chip">Trava de Carência</span>
                        <span class="module-chip">Campanhas Oficiais</span>
                        <span class="module-chip">Emissão GTA</span>
                    </div>
                </div>

                <div class="module-card">
                    <div class="module-icon-wrap bg-teal-50 text-teal-600">
                        <span class="material-symbols-outlined">query_stats</span>
                    </div>
                    <div class="module-header">
                        <h3>Analytics & Zootecnia</h3>
                        <p>Dashboards executivos com evolução zootécnica, custo por @@ engordada, ponto de equilíbrio e projeção de faturamento do lote.</p>
                    </div>
                    <div class="module-tags">
                        <span class="module-chip">Custo por @@</span>
                        <span class="module-chip">Conversão Alimentar</span>
                        <span class="module-chip">DRE Zootécnico</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Strategic Differentials Section -->
    <section id="diferenciais" class="landing-differentials">
        <div class="differentials-container">
            <div class="features-header text-center">
                <span class="section-tag font-mono">POR QUE O CRIACERTO</span>
                <h2 class="section-title">Projetado por quem conhece a poeira e o ritmo do curral</h2>
                <p class="section-subtitle">Diferenciais técnicos e práticos que eliminam pranchetas de papel e retrabalho na fazenda.</p>
            </div>

            <div class="differentials-grid">
                <div class="diff-card">
                    <div class="diff-icon-box">
                        <span class="material-symbols-outlined">signal_wifi_off</span>
                    </div>
                    <div class="diff-content">
                        <h3>PWA Offline-First de Verdade</h3>
                        <p>Nada de telas travadas por falta de sinal 4G. Os dados ficam salvos localmente no navegador do celular ou tablet e sincronizam em segundo plano quando houver conexão.</p>
                    </div>
                </div>

                <div class="diff-card">
                    <div class="diff-icon-box">
                        <span class="material-symbols-outlined">security</span>
                    </div>
                    <div class="diff-content">
                        <h3>Blindagem Sanitária no Embarque</h3>
                        <p>Evite prejuízos milionários e multas de frigoríficos. O sistema bloqueia automaticamente qualquer animal sob período de carência que for adicionado a um lote de venda.</p>
                    </div>
                </div>

                <div class="diff-card">
                    <div class="diff-icon-box">
                        <span class="material-symbols-outlined">trending_up</span>
                    </div>
                    <div class="diff-content">
                        <h3>Foco Real no Lucro por Cabeça</h3>
                        <p>Monitore o ganho médio diário (GPD) individualmente. Descubra rapidamente animais refugos ou de baixa conversão antes que consumam seu lucro em silagem e pasto.</p>
                    </div>
                </div>

                <div class="diff-card">
                    <div class="diff-icon-box">
                        <span class="material-symbols-outlined">hub</span>
                    </div>
                    <div class="diff-content">
                        <h3>Multi-Fazendas & Perfis de Acesso</h3>
                        <p>Controle vários retiros e fazendas em uma única conta. Dê acesso simplificado para os vaqueiros no curral e visão gerencial completa para veterinários e administradores.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Social Proof / Testimonials Section -->
    <section class="landing-testimonials">
        <div class="testimonials-container">
            <div class="features-header text-center">
                <span class="section-tag font-mono">CASES DE SUCESSO</span>
                <h2 class="section-title">O que dizem os pecuaristas que usam o CriaCerto</h2>
                <p class="section-subtitle">Mais de 150.000 animais acompanhados com precisão e segurança zootécnica.</p>
            </div>

            <div class="testimonials-grid">
                <div class="test-card">
                    <div class="test-stars">
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                    </div>
                    <p class="test-quote">
                        "O manejo de pesagem no curral demorava o dia todo e depois tínhamos que passar o caderno a limpo no Excel. Com o CriaCerto no tablet off-line, o lote sai do curral com o relatório de GPD pronto."
                    </p>
                    <div class="test-author">
                        <div class="author-avatar">MS</div>
                        <div class="author-info">
                            <h4>Marcelo Silveira</h4>
                            <span>Fazenda Bela Vista (Sorriso - MT) • 8.500 cabeças</span>
                        </div>
                    </div>
                </div>

                <div class="test-card">
                    <div class="test-stars">
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                    </div>
                    <p class="test-quote">
                        "A trava de carência medicamentosa salvou a nossa fazenda de mandar um lote com resíduo para o frigorífico. Só essa funcionalidade já pagou 10 anos de assinatura do sistema."
                    </p>
                    <div class="test-author">
                        <div class="author-avatar">RC</div>
                        <div class="author-info">
                            <h4>Dra. Renata Campos</h4>
                            <span>Médica Veterinária • Confinamento Rio Verde (GO)</span>
                        </div>
                    </div>
                </div>

                <div class="test-card">
                    <div class="test-stars">
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                    </div>
                    <p class="test-quote">
                        "Na nossa estação de monta com 3.200 matrizes, saber exatamente a taxa de concepção por touro e protocolo de IATF aumentou o nosso desmame em 14% na primeira safra."
                    </p>
                    <div class="test-author">
                        <div class="author-avatar">AF</div>
                        <div class="author-info">
                            <h4>Antônio Ferreira</h4>
                            <span>Agropecuária Três Fronteiras (Uberaba - MG)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Pricing Section -->
    <section id="planos" class="landing-pricing">
        <div class="pricing-header text-center">
            <span class="section-tag font-mono">PLANOS E INVESTIMENTO</span>
            <h2 class="section-title">Escolha o plano ideal para o tamanho da sua fazenda</h2>
            <p class="section-subtitle">Sem surpresas. Escale de acordo com a capacidade do seu rebanho.</p>

            <div class="pricing-toggle-box">
                <button class="toggle-btn @(!_isAnnual ? "active" : "")" @onclick="() => _isAnnual = false">Mensal</button>
                <button class="toggle-btn @(_isAnnual ? "active" : "")" @onclick="() => _isAnnual = true">
                    <span>Anual</span>
                    <span class="discount-badge">20% OFF</span>
                </button>
            </div>
        </div>

        <div class="pricing-grid">
            @if (_isLoadingPlans)
            {
                @for (int i = 0; i < 3; i++)
                {
                    <div class="pricing-skeleton-card">
                        <div class="skeleton-line" style="width: 40%; height: 26px;"></div>
                        <div class="skeleton-line" style="width: 70%; height: 16px;"></div>
                        <div class="skeleton-line" style="width: 50%; height: 42px; margin: 1rem 0;"></div>
                        <div class="skeleton-line" style="width: 90%;"></div>
                        <div class="skeleton-line" style="width: 80%;"></div>
                        <div class="skeleton-line" style="width: 85%;"></div>
                    </div>
                }
            }
            else
            {
                @foreach (var plan in _plans)
                {
                    <div class="pricing-card @(plan.IsPopular ? "popular-card" : "")">
                        @if (plan.IsPopular)
                        {
                            <div class="popular-ribbon">MAIS ESCOLHIDO</div>
                        }

                        <div class="card-plan-header">
                            <h3 class="plan-name">@plan.Name</h3>
                            <p class="plan-desc">@plan.Description</p>
                        </div>

                        <div class="card-plan-price">
                            <span class="currency">R$</span>
                            <span class="price-val">@FormatPrice(_isAnnual ? plan.AnnualPriceMonthly : plan.MonthlyPrice)</span>
                            <span class="period">/mês</span>
                        </div>

                        <div class="capacity-pill font-mono">
                            <span class="material-symbols-outlined icon-sm">groups</span>
                            <span>@(plan.HeadCapacityLimit >= 999999 || plan.HeadCapacityLimit == int.MaxValue ? "Cabeças Ilimitadas" : $"Até {plan.HeadCapacityLimit:N0} cabeças")</span>
                        </div>

                        <ul class="plan-features-list">
                            @if (plan.Features != null && plan.Features.Any(f => f.IsEnabled))
                            {
                                @foreach (var feature in plan.Features.Where(f => f.IsEnabled))
                                {
                                    <li>
                                        <span class="material-symbols-outlined check-icon">check_circle</span>
                                        <span>@feature.Name</span>
                                    </li>
                                }
                            }
                            else
                            {
                                @if (plan.IncludedModules.Contains("CurralOffline") || plan.IncludedModules.Contains("PwaOfflineMode"))
                                {
                                    <li>
                                        <span class="material-symbols-outlined check-icon">check_circle</span>
                                        <span>Acesso PWA Curral 100% Off-line</span>
                                    </li>
                                }
                                @if (plan.IncludedModules.Contains("Breeding"))
                                {
                                    <li>
                                        <span class="material-symbols-outlined check-icon">check_circle</span>
                                        <span>Módulo Reprodução & IATF</span>
                                    </li>
                                }
                                @if (plan.IncludedModules.Contains("Calving"))
                                {
                                    <li>
                                        <span class="material-symbols-outlined check-icon">check_circle</span>
                                        <span>Módulo de Partos & Bezerreiro</span>
                                    </li>
