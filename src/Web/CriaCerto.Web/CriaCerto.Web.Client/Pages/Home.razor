                <div class="test-card">
                    <div class="test-stars">
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                    </div>
                    <p class="test-quote">
                        "A trava de carência medicamentosa salvou a nossa fazenda de mandar um lote com resíduo para o frigorífico. Só essa funcionalidade já pagou 10 anos de assinatura do sistema."
                    </p>
                    <div class="test-author">
                        <div class="author-avatar">RC</div>
                        <div class="author-info">
                            <h4>Dra. Renata Campos</h4>
                            <span>Médica Veterinária • Confinamento Rio Verde (GO)</span>
                        </div>
                    </div>
                </div>

                <div class="test-card">
                    <div class="test-stars">
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                        <span class="material-symbols-outlined">star</span>
                    </div>
                    <p class="test-quote">
                        "Na nossa estação de monta com 3.200 matrizes, saber exatamente a taxa de concepção por touro e protocolo de IATF aumentou o nosso desmame em 14% na primeira safra."
                    </p>
                    <div class="test-author">
                        <div class="author-avatar">AF</div>
                        <div class="author-info">
                            <h4>Antônio Ferreira</h4>
                            <span>Agropecuária Três Fronteiras (Uberaba - MG)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Pricing / Modular Simulator Section -->
    <section id="planos" class="landing-pricing">
        <div class="pricing-header text-center">
            <span class="section-tag font-mono">SIMULADOR & INVESTIMENTO</span>
            <h2 class="section-title">Monte o plano ideal para a sua fazenda</h2>
            <p class="section-subtitle">Sem pacotes engessados. Escolha a faixa do seu rebanho e selecione apenas os módulos que você realmente usa.</p>

            <div class="pricing-toggle-box">
                <button type="button" class="toggle-btn @(!_isAnnual ? "active" : "")" @onclick="() => _isAnnual = false">Mensal</button>
                <button type="button" class="toggle-btn @(_isAnnual ? "active" : "")" @onclick="() => _isAnnual = true">
                    <span>Anual</span>
                    <span class="discount-badge">20% OFF</span>
                </button>
            </div>
        </div>

        <div class="modular-simulator">
            <!-- Barra de Presets Rápidos -->
            <div class="simulator-presets-bar">
                <span class="simulator-presets-label font-mono">
                    <span class="material-symbols-outlined icon-sm" style="vertical-align: middle; margin-right: 0.25rem;">auto_awesome</span>
                    Perfis Rápidos:
                </span>
                <button type="button" class="simulator-preset-chip @(_activePreset == "plantel" ? "active" : "")" @onclick='() => ApplyPreset("plantel")'>
                    Só Plantel & Manejo
                </button>
                <button type="button" class="simulator-preset-chip @(_activePreset == "cria" ? "active" : "")" @onclick='() => ApplyPreset("cria")'>
                    Pecuária de Cria & IATF
                </button>
                <button type="button" class="simulator-preset-chip @(_activePreset == "engorda" ? "active" : "")" @onclick='() => ApplyPreset("engorda")'>
                    Recria & Confinamento
                </button>
                <button type="button" class="simulator-preset-chip @(_activePreset == "completo" ? "active" : "")" @onclick='() => ApplyPreset("completo")'>
                    Fazenda Completa 360°
                </button>
            </div>

            <!-- Etapa 1: Faixas de Cabeças -->
            <div class="simulator-tiers-header">
                <div class="simulator-step-label font-mono">
                    <span class="material-symbols-outlined" style="font-size: 16px;">tag</span>
                    <span>1. Selecione a faixa do seu rebanho</span>
                </div>
                <div class="simulator-tier-grid">
                    @foreach (var tier in _catalog.HeadTiers)
                    {
                        var isSelected = string.Equals(tier.TierCode, _selectedTierCode, StringComparison.OrdinalIgnoreCase);
                        <div class="simulator-tier-card @(isSelected ? "active" : "")" @onclick="() => SelectTier(tier.TierCode)">
                            <span class="material-symbols-outlined" style="font-size: 24px; color: @(isSelected ? "#005323" : "#64748b");">groups</span>
                            <span class="tier-title">@tier.DisplayName</span>
                            <span class="tier-sub font-mono">@(tier.MaxHeads >= 999999 || tier.MaxHeads >= 10000 ? "3.001+ cabeças" : $"Capacidade até {tier.MaxHeads:N0} cab.")</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Etapa 2 e Resumo -->
            <div class="simulator-body">
                <!-- Coluna da Esquerda: Módulos -->
                <div class="simulator-modules-panel">
                    <div class="simulator-step-label font-mono">
                        <span class="material-symbols-outlined" style="font-size: 16px;">view_module</span>
                        <span>2. Escolha os módulos que sua fazenda precisa</span>
                    </div>

                    <!-- Módulo Core Base (Plantel / Cows) -->
                    @{
                        var coreModule = _catalog.Modules.FirstOrDefault(m => m.IsCore || string.Equals(m.ModuleKey, "Cows", StringComparison.OrdinalIgnoreCase));
                        var corePrice = coreModule?.PricesByTier.FirstOrDefault(p => string.Equals(p.TierCode, _selectedTierCode, StringComparison.OrdinalIgnoreCase))
                                        ?? coreModule?.PricesByTier.FirstOrDefault();
                    }
                    @if (coreModule != null && corePrice != null)
                    {
                        <div class="simulator-core-card">
                            <span class="core-badge font-mono">BASE OBRIGATÓRIA</span>
                            <div class="core-header">
                                <div class="core-title-group">
                                    <div class="core-icon-box">
                                        <span class="material-symbols-outlined">pets</span>
                                    </div>
                                    <div>
                                        <h3 class="core-title">@coreModule.Name</h3>
                                        <span class="font-mono text-xs" style="color: #005323; font-weight: 700;">Incluso para todas as fazendas</span>
                                    </div>
                                </div>
                                <div class="core-price font-mono">
                                    R$ @FormatPrice(_isAnnual ? corePrice.AnnualPriceMonthly : corePrice.MonthlyPrice)
                                    <span style="font-size: 0.75rem; color: #64748b; font-weight: 500;">/mês</span>
                                </div>
                            </div>
                            <p class="core-desc">@coreModule.Description</p>
                            <div class="core-features-chips">
                                <span class="core-chip">
                                    <span class="material-symbols-outlined icon-sm">wifi_off</span>
                                    100% Curral Off-line (PWA)
                                </span>
                                <span class="core-chip">
                                    <span class="material-symbols-outlined icon-sm">badge</span>
                                    Brinco & RFID SISBOV
                                </span>
                                <span class="core-chip">
                                    <span class="material-symbols-outlined icon-sm">hub</span>
                                    Lotes & Genealogia
                                </span>
                                <span class="core-chip">
                                    <span class="material-symbols-outlined icon-sm">lock</span>
                                    Módulo Core Travado
                                </span>
                            </div>
                        </div>
                    }

                    <!-- Grid dos Módulos Opcionais -->
                    <div class="simulator-addons-grid">
                        @foreach (var mod in _catalog.Modules.Where(m => !m.IsCore && !string.Equals(m.ModuleKey, "Cows", StringComparison.OrdinalIgnoreCase)))
                        {
                            var isChecked = IsModuleSelected(mod.ModuleKey);
                            var priceOption = mod.PricesByTier.FirstOrDefault(p => string.Equals(p.TierCode, _selectedTierCode, StringComparison.OrdinalIgnoreCase))
                                              ?? mod.PricesByTier.FirstOrDefault();
                            var priceVal = priceOption != null
                                ? (_isAnnual ? priceOption.AnnualPriceMonthly : priceOption.MonthlyPrice)
                                : 0m;

                            <div class="simulator-addon-card @(isChecked ? "selected" : "")" @onclick="() => ToggleModule(mod.ModuleKey)">
                                <div class="addon-card-header">
                                    <div class="addon-icon-title">
                                        <div class="addon-icon-box">
                                            <span class="material-symbols-outlined">@mod.IconName</span>
                                        </div>
                                        <h4 class="addon-title">@mod.Name</h4>
                                    </div>
                                    <div class="addon-checkbox">
                                        @if (isChecked)
                                        {
                                            <span class="material-symbols-outlined" style="font-size: 16px;">check</span>
                                        }
                                    </div>
                                </div>
                                <p class="addon-desc">@mod.Description</p>
                                <div class="addon-price-tag font-mono">
                                    <span style="font-size: 0.75rem; color: #64748b; font-weight: 600;">Adicional na faixa:</span>
                                    <span>+ R$ @FormatPrice(priceVal)<small style="font-size: 0.7rem; color: #64748b;">/mês</small></span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Coluna da Direita: Card de Resumo Flutuante -->
                <div class="simulator-summary-card">
