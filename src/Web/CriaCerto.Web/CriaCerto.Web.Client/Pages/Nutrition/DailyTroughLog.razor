@page "/nutrition/trough-log"
@using CriaCerto.Modules.Nutrition.Application.Contracts
@using CriaCerto.Modules.Nutrition.Application.Domain
@using CriaCerto.Modules.Nutrition.Application.Features.FeedingFeatures
@using CriaCerto.Modules.Growth.Application.Contracts
@using LotDto = CriaCerto.Web.Client.Models.LotDto
@using CriaCerto.Web.Client.Components.Nutrition
@using CriaCerto.Web.Client.Services
@inject NutritionApiClient ApiClient
@inject GrowthApiClient GrowthApiClient
@inject IJSRuntime JSRuntime
@inject Auth.CustomAuthStateProvider AuthStateProvider
@attribute [Authorize]

<PageTitle>Trato Diário & Leitura de Cocho | CriaCerto</PageTitle>

<ModuleGuard Module="Nutrition">
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-success mb-1">
                <i class="bi bi-truck me-2"></i>Trato Diário TMR & Leitura de Cocho
            </h3>
            <p class="text-muted mb-0">Registro rápido para operador de trato em confinamento, escore de cocho (0-3) e controle de Matéria Seca (MS).</p>
        </div>
        <span class="badge bg-outline-secondary d-flex align-items-center px-3 py-2 border">
            <i class="bi bi-wifi-off text-warning me-2 fs-6"></i>
            IndexedDB Cache Off-line Ativo
        </span>
    </div>

    <div class="row g-4">
        <!-- Input Form -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-success text-white py-3">
                    <h6 class="m-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Lançar Batida de Trato / Vagão</h6>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Curral / Lote de Confinamento</label>
                        <select class="form-select form-select-lg" @bind="selectedLotId">
                            <option value="@Guid.Empty">Selecione o Lote / Curral...</option>
                            @foreach (var lot in availableLots)
                            {
                                <option value="@lot.Id">@lot.Name (@lot.HeadCount cabeças)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Formulado de Ração TMR</label>
                        <select class="form-select form-select-lg" @bind="selectedRationId">
                            <option value="@Guid.Empty">Selecione a Dieta TMR...</option>
                            @foreach (var ration in availableRations)
                            {
                                <option value="@ration.Id">@ration.Name (MS @ration.DryMatterPercentage%)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Peso Fornecido na Balança do Vagão (kg MN)</label>
                        <div class="input-group input-group-lg">
                            <input type="number" step="10" class="form-control fw-bold text-success" @bind="offeredAsFedKg" placeholder="0" />
                            <span class="input-group-text">kg Natural</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold d-block mb-2">Escore de Leitura de Cocho (Nota 0 a 3)</label>
                        <div class="btn-group w-100" role="group">
                            <button type="button" class="btn btn-outline-danger py-3 @(selectedTroughScore == TroughScore.Score0_Clean ? "active" : "")" 
                                    @onclick="() => selectedTroughScore = TroughScore.Score0_Clean">
                                <div class="fw-bold">Nota 0</div>
                                <small class="d-block" style="font-size: 0.75rem;">Limpo / Fome</small>
                            </button>
                            <button type="button" class="btn btn-outline-success py-3 @(selectedTroughScore == TroughScore.Score1_ThinLayer ? "active" : "")" 
                                    @onclick="() => selectedTroughScore = TroughScore.Score1_ThinLayer">
                                <div class="fw-bold">Nota 1</div>
                                <small class="d-block" style="font-size: 0.75rem;">Ideal (Lâmina)</small>
                            </button>
                            <button type="button" class="btn btn-outline-warning py-3 @(selectedTroughScore == TroughScore.Score2_Excessive ? "active" : "")" 
                                    @onclick="() => selectedTroughScore = TroughScore.Score2_Excessive">
                                <div class="fw-bold">Nota 2</div>
                                <small class="d-block" style="font-size: 0.75rem;">Sobra Excesso</small>
                            </button>
                            <button type="button" class="btn btn-outline-secondary py-3 @(selectedTroughScore == TroughScore.Score3_Untouched ? "active" : "")" 
                                    @onclick="() => selectedTroughScore = TroughScore.Score3_Untouched">
                                <div class="fw-bold">Nota 3</div>
                                <small class="d-block" style="font-size: 0.75rem;">Intacto</small>
                            </button>
                        </div>
                    </div>

                    <button class="btn btn-success btn-lg w-100 fw-bold shadow-sm" @onclick="SubmitFeedBatch">
                        <i class="bi bi-check-circle-fill me-2"></i> Confirmar Trato
                    </button>
                </div>
            </div>
        </div>

        <!-- Analytics & Widget Section -->
        <div class="col-lg-7">
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <FeedConversionWidget Performance="performanceDto" />
                </div>
                <div class="col-md-6">
                    <CostPerArrobaCard CostInfo="costPerArrobaDto" />
                </div>
            </div>

            <!-- Recent Tmr Logs Card -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 fw-bold text-dark"><i class="bi bi-clock-history me-2 text-success"></i>Tratos Recentes Registrados</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Horário</th>
                                <th>Lote/Curral</th>
                                <th>Kg MN (Natural)</th>
                                <th>Kg MS (Seca)</th>
                                <th>Escore Cocho</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var batch in recentBatches)
                            {
                                <tr>
                                    <td>@batch.FeedingTime.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                    <td><strong class="text-success">@GetLotName(batch.LotId)</strong></td>
                                    <td>@batch.OfferedAsFedKg.ToString("N0") kg</td>
                                    <td>@batch.OfferedDryMatterKg.ToString("N1") kg MS</td>
                                    <td>
                                        <span class="badge @GetTroughBadgeClass(batch.TroughScore)">
                                            @GetTroughText(batch.TroughScore)
                                        </span>
                                    </td>
                                </tr>
                            }
                            @if (!recentBatches.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">Nenhum trato registrado nesta sessão.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
</ModuleGuard>

@code {
    private Guid currentTenantId = Guid.Empty;
    private Guid selectedLotId = Guid.Empty;
    private Guid selectedRationId = Guid.Empty;
    private decimal offeredAsFedKg = 1200m;
    private TroughScore selectedTroughScore = TroughScore.Score1_ThinLayer;

    private List<LotDto> availableLots = new();
    private List<FeedRationDto> availableRations = new();
    private List<DailyFeedBatchDto> recentBatches = new();

    private FeedlotPerformanceDto? performanceDto;
    private CostPerArrobaDto? costPerArrobaDto;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var tenantClaim = user.FindFirst("TenantId")?.Value;
            if (Guid.TryParse(tenantClaim, out var tenantId))
            {
                currentTenantId = tenantId;
            }
        }

        if (currentTenantId != Guid.Empty)
        {
            availableLots = await GrowthApiClient.GetLotsAsync(currentTenantId);
            availableRations = await ApiClient.GetRationsAsync(currentTenantId);

            if (availableLots.Any())
            {
                selectedLotId = availableLots.First().Id;
                await UpdateAnalyticsAsync();
            }

            if (availableRations.Any())
            {
                selectedRationId = availableRations.First().Id;
            }
        }
    }

    private async Task SubmitFeedBatch()
    {
        if (selectedLotId == Guid.Empty || selectedRationId == Guid.Empty || offeredAsFedKg <= 0) return;

        var lot = availableLots.FirstOrDefault(l => l.Id == selectedLotId);
        int headCount = lot?.HeadCount ?? 50;

        var cmd = new RecordFeedlotTmrCommand(
            currentTenantId,
            selectedLotId,
            selectedRationId,
            DateTime.UtcNow,
            offeredAsFedKg,
            selectedTroughScore,
            headCount);

        var result = await ApiClient.RecordTmrBatchAsync(cmd);
        if (result != null)
        {
            recentBatches.Insert(0, result);
            await UpdateAnalyticsAsync();
        }
    }

    private async Task UpdateAnalyticsAsync()
    {
        if (selectedLotId == Guid.Empty) return;
        performanceDto = await ApiClient.GetFeedlotPerformanceAsync(currentTenantId, selectedLotId, totalWeightGainKg: 250m);
        costPerArrobaDto = await ApiClient.GetCostPerArrobaAsync(currentTenantId, selectedLotId, totalWeightGainKg: 250m, carcassYieldPercentage: 54m);
    }

    private string GetLotName(Guid lotId)
    {
        return availableLots.FirstOrDefault(l => l.Id == lotId)?.Name ?? "Curral Confinamento";
    }

    private string GetTroughBadgeClass(TroughScore score) => score switch
    {
        TroughScore.Score0_Clean => "bg-danger",
        TroughScore.Score1_ThinLayer => "bg-success",
        TroughScore.Score2_Excessive => "bg-warning text-dark",
        TroughScore.Score3_Untouched => "bg-secondary",
        _ => "bg-light text-dark"
    };

    private string GetTroughText(TroughScore score) => score switch
    {
        TroughScore.Score0_Clean => "Nota 0 - Limpo",
        TroughScore.Score1_ThinLayer => "Nota 1 - Ideal",
        TroughScore.Score2_Excessive => "Nota 2 - Sobra Excesso",
        TroughScore.Score3_Untouched => "Nota 3 - Intacto",
        _ => "Geral"
    };
}
