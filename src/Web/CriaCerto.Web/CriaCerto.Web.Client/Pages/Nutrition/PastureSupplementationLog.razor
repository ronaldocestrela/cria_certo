@page "/nutrition/pasture-supplementation"
@using CriaCerto.Modules.Nutrition.Application.Contracts
@using CriaCerto.Modules.Nutrition.Application.Features.FeedingFeatures
@using CriaCerto.Modules.Growth.Application.Contracts
@using LotDto = CriaCerto.Web.Client.Models.LotDto
@using PaddockStockingRateDto = CriaCerto.Web.Client.Models.PaddockStockingRateDto
@using CriaCerto.Web.Client.Services
@inject NutritionApiClient ApiClient
@inject GrowthApiClient GrowthApiClient
@inject Auth.CustomAuthStateProvider AuthStateProvider
@attribute [Authorize]

<PageTitle>Suplementação de Pasto | CriaCerto</PageTitle>

<ModuleGuard Module="Nutrition">
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-success mb-1">
                <i class="bi bi-geo-alt me-2"></i>Suplementação Mineral & Proteinado em Pasto
            </h3>
            <p class="text-muted mb-0">Controle de abastecimento de cochos nos piquetes e cálculo de consumo diário em gramas por cabeça (g/cab/dia).</p>
        </div>
        <button class="btn btn-success shadow-sm" @onclick="OpenModal">
            <i class="bi bi-plus-lg me-1"></i> Registrar Suplementação
        </button>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 fw-bold text-dark"><i class="bi bi-list-check me-2 text-success"></i>Histórico de Entregas em Piquetes</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Data</th>
                                <th>Piquete / Pasto</th>
                                <th>Lote de Animais</th>
                                <th>Quantidade (kg)</th>
                                <th>Cabeças</th>
                                <th>Consumo Calculado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var supp in suppList)
                            {
                                <tr>
                                    <td>@supp.DistributionDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><span class="badge bg-light text-dark border">Piquete P-01</span></td>
                                    <td><strong class="text-success">Lote Garrotes Recria</strong></td>
                                    <td>@supp.QuantityKg.ToString("N0") kg</td>
                                    <td>@supp.HeadCount cabeças</td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success fs-6">
                                            @supp.CalculatedIntakeGramsPerHead.ToString("N0") g / cab / dia
                                        </span>
                                    </td>
                                </tr>
                            }
                            @if (!suppList.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-5">
                                        <i class="bi bi-journal-x fs-1 d-block mb-2"></i>
                                        Nenhuma suplementação em pasto registrada.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="modal fade show d-block bg-dark bg-opacity-50" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-geo-alt me-2"></i>Lançar Suplementação em Pasto</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Piquete / Pasto</label>
                        <select class="form-select" @bind="selectedPaddockId">
                            <option value="@Guid.Empty">Selecione o Piquete...</option>
                            @foreach (var p in availablePaddocks)
                            {
                                <option value="@p.Id">@p.Name (@p.AreaHectares ha)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Lote de Animais</label>
                        <select class="form-select" @bind="selectedLotId">
                            <option value="@Guid.Empty">Selecione o Lote...</option>
                            @foreach (var lot in availableLots)
                            {
                                <option value="@lot.Id">@lot.Name (@lot.HeadCount cabeças)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ração / Sal Mineral / Proteinado</label>
                        <select class="form-select" @bind="selectedRationId">
                            <option value="@Guid.Empty">Selecione o Suplemento...</option>
                            @foreach (var r in availableRations)
                            {
                                <option value="@r.Id">@r.Name</option>
                            }
                        </select>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Quantidade Entregue (kg)</label>
                            <input type="number" class="form-control" @bind="quantityKg" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Número de Cabeças</label>
                            <input type="number" class="form-control" @bind="headCount" />
                        </div>
                    </div>
                    @if (headCount > 0 && quantityKg > 0)
                    {
                        <div class="alert alert-success mt-3 mb-0 py-2">
                            Consumo Estimado: <strong>@((quantityKg * 1000m / headCount).ToString("N0")) g / cabeça / dia</strong>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                    <button class="btn btn-success fw-bold" @onclick="SaveSupplementation">Salvar Registro</button>
                </div>
            </div>
        </div>
    </div>
}
</ModuleGuard>

@code {
    private Guid currentTenantId = Guid.Empty;
    private bool showModal = false;

    private Guid selectedPaddockId = Guid.Empty;
    private Guid selectedLotId = Guid.Empty;
    private Guid selectedRationId = Guid.Empty;
    private decimal quantityKg = 60m; // 2 sacos de 30kg
    private int headCount = 100;

    private List<PastureSupplementationDto> suppList = new();
    private List<PaddockStockingRateDto> availablePaddocks = new();
    private List<LotDto> availableLots = new();
    private List<FeedRationDto> availableRations = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var tenantClaim = user.FindFirst("TenantId")?.Value;
            if (Guid.TryParse(tenantClaim, out var tenantId))
            {
                currentTenantId = tenantId;
            }
        }

        if (currentTenantId != Guid.Empty)
        {
            availablePaddocks = await GrowthApiClient.GetPaddocksAsync(currentTenantId);
            availableLots = await GrowthApiClient.GetLotsAsync(currentTenantId);
            availableRations = await ApiClient.GetRationsAsync(currentTenantId);

            if (availablePaddocks.Any()) selectedPaddockId = availablePaddocks.First().Id;
            if (availableLots.Any()) selectedLotId = availableLots.First().Id;
            if (availableRations.Any()) selectedRationId = availableRations.First().Id;
        }
    }

    private void OpenModal() => showModal = true;
    private void CloseModal() => showModal = false;

    private async Task SaveSupplementation()
    {
        if (selectedPaddockId == Guid.Empty || selectedLotId == Guid.Empty || selectedRationId == Guid.Empty || quantityKg <= 0 || headCount <= 0)
            return;

        var cmd = new RecordSupplementationCommand(
            currentTenantId,
            selectedPaddockId,
            selectedLotId,
            selectedRationId,
            DateTime.UtcNow,
            quantityKg,
            headCount);

        var result = await ApiClient.RecordSupplementationAsync(cmd);
        if (result != null)
        {
            suppList.Insert(0, result);
            CloseModal();
        }
    }
}
