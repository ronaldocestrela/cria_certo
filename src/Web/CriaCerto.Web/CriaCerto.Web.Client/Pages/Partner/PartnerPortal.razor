        color: #1e293b;
    }

    .code-badge {
        font-family: monospace;
        font-weight: 700;
        background: #f1f5f9;
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        color: #2563eb;
    }

    .code-ref {
        font-family: monospace;
        font-size: 0.78rem;
        background: #ecfdf5;
        color: #065f46;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
