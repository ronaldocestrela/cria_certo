        font-size: 1.1rem;
        color: #64748b;
        cursor: pointer;
    }

    .modal-body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }

    .modal-desc {
        font-size: 0.88rem;
        color: #64748b;
