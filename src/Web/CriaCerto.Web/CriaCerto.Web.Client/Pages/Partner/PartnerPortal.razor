    }

    .input-text, .input-select {
        padding: 0.65rem 0.85rem;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 0.88rem;
        background: #ffffff;
        color: #0f172a;
    }

    .uppercase { text-transform: uppercase; }

    .filter-actions {
        display: flex;
        gap: 0.5rem;
    }

    /* Modal */
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
