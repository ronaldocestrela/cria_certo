    .status-pill {
        display: inline-block;
        padding: 0.25rem 0.65rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .pill-active, .pill-green { background: #dcfce7; color: #166534; }
    .pill-inactive, .pill-slate { background: #f1f5f9; color: #475569; }
    .pill-amber { background: #fef3c7; color: #92400e; }
    .pill-blue { background: #dbeafe; color: #1e40af; }
    .pill-red { background: #fee2e2; color: #991b1b; }

    /* Filters */
    .statement-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: flex-end;
        background: #f8fafc;
        padding: 1.25rem;
        border-radius: 12px;
        margin-bottom: 1.5rem;
    }

    .filter-item {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        flex: 1;
        min-width: 200px;
    }

    .filter-item label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #475569;
