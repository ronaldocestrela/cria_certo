</style>

@code {
    private bool _isLoading = true;
    private bool _isStatementLoading = false;
    private PartnerPortalDashboardModel? _dashboard;
    private PartnerCommissionStatementModel? _statement;

    // Filtros de Extrato
    private string? _searchFilter;
    private string? _statusFilter;
    private int _statementPage = 1;
    private const int _statementPageSize = 10;

    // Modal Pix
    private bool _isPixModalOpen;
    private bool _isSavingPix;
    private int _selectedPixKeyType = 2; // Email default
    private string _newPixKey = string.Empty;
    private string? _pixErrorMessage;

    // Modal Campanha
    private bool _isCampaignModalOpen;
    private bool _isSavingCampaign;
    private string _newCampaignTitle = string.Empty;
    private string _newCampaignSlug = string.Empty;
    private string? _campaignErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
        await LoadStatementAsync();
    }

    private async Task LoadDashboardAsync()
    {
        _isLoading = true;
        try
        {
            var result = await PartnerApiClient.GetDashboardAsync();
            if (result.IsSuccess)
            {
                _dashboard = result.Value;
                _selectedPixKeyType = _dashboard.PixKeyType;
                _newPixKey = _dashboard.PixKey;
            }
            else
            {
                ToastService.ShowError("Erro ao carregar dados do parceiro: " + result.Error.Message);
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadStatementAsync()
    {
        _isStatementLoading = true;
        try
        {
            int? status = null;
            if (int.TryParse(_statusFilter, out var s)) status = s;

            var result = await PartnerApiClient.GetStatementAsync(
                search: _searchFilter,
                status: status,
                page: _statementPage,
                pageSize: _statementPageSize);

            if (result.IsSuccess)
            {
                _statement = result.Value;
            }
            else
            {
                ToastService.ShowError("Erro ao carregar extrato: " + result.Error.Message);
            }
        }
        finally
        {
            _isStatementLoading = false;
        }
    }

    private async Task ChangePageAsync(int newPage)
    {
        _statementPage = newPage;
        await LoadStatementAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _searchFilter = null;
        _statusFilter = null;
        _statementPage = 1;
        await LoadStatementAsync();
    }

    private string GetReferralUrl(string code)
    {
        var baseUri = Navigation.BaseUri.TrimEnd('/');
        return $"{baseUri}/r/{code}";
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            ToastService.ShowSuccess("Link copiado para a área de transferência!");
        }
        catch
        {
            ToastService.ShowInfo($"Copie o link: {text}");
        }
    }

    private void ShareWhatsApp(string url)
    {
        var message = $"Olá! Sou parceiro do Cria Certo, a principal plataforma de pecuária inteligente. Conheça e teste gratuitamente através do meu link oficial: {url}";
        var encoded = Uri.EscapeDataString(message);
        Navigation.NavigateTo($"https://wa.me/?text={encoded}", forceLoad: true);
    }

    private void OpenPixModal()
    {
        _pixErrorMessage = null;
        if (_dashboard != null)
        {
            _selectedPixKeyType = _dashboard.PixKeyType;
            _newPixKey = _dashboard.PixKey;
        }
        _isPixModalOpen = true;
    }

    private void ClosePixModal()
    {
        _isPixModalOpen = false;
        _pixErrorMessage = null;
    }

    private async Task SavePixKeyAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPixKey))
        {
            _pixErrorMessage = "A chave Pix é obrigatória.";
            return;
        }

        _isSavingPix = true;
        _pixErrorMessage = null;

        try
        {
            var result = await PartnerApiClient.UpdatePixKeyAsync(_selectedPixKeyType, _newPixKey);
            if (result.IsSuccess)
            {
                ToastService.ShowSuccess("Chave Pix atualizada com sucesso!");
                ClosePixModal();
                await LoadDashboardAsync();
            }
            else
            {
                _pixErrorMessage = result.Error.Message;
            }
        }
        finally
        {
            _isSavingPix = false;
        }
    }

    private void OpenCampaignModal()
    {
        _campaignErrorMessage = null;
        _newCampaignTitle = string.Empty;
        _newCampaignSlug = string.Empty;
        _isCampaignModalOpen = true;
    }

    private void CloseCampaignModal()
    {
        _isCampaignModalOpen = false;
        _campaignErrorMessage = null;
    }

    private async Task SaveCampaignAsync()
    {
        if (string.IsNullOrWhiteSpace(_newCampaignTitle))
        {
            _campaignErrorMessage = "O título da campanha é obrigatório.";
            return;
        }

        _isSavingCampaign = true;
        _campaignErrorMessage = null;

        try
        {
            var result = await PartnerApiClient.CreateCampaignAsync(_newCampaignTitle, _newCampaignSlug);
            if (result.IsSuccess)
            {
                ToastService.ShowSuccess($"Campanha criada! Link: /r/{result.Value.Code}");
                CloseCampaignModal();
                await LoadDashboardAsync();
            }
            else
            {
                _campaignErrorMessage = result.Error.Message;
            }
        }
        finally
        {
            _isSavingCampaign = false;
        }
    }

    private string GetCategoryName(int category) => category switch
    {
        0 => "Consultor Agronômico",
        1 => "Médico Veterinário",
        2 => "Revenda Agropecuária",
        3 => "Associação de Produtores",
        _ => "Parceiro Comercial"
    };

    private string GetPixKeyTypeLabel(int type) => type switch
    {
        0 => "CPF",
        1 => "CNPJ",
        2 => "E-mail",
        3 => "Telefone",
        4 => "Chave Aleatória",
        _ => "Pix"
    };

    private string GetPixPlaceholder() => _selectedPixKeyType switch
    {
        0 => "000.000.000-00",
        1 => "00.000.000/0000-00",
        2 => "seu.email@dominio.com.br",
        3 => "+55 (11) 99999-9999",
        4 => "00000000-0000-0000-0000-000000000000",
        _ => "Chave Pix..."
    };

    private string GetCommissionDescription()
    {
        if (_dashboard == null) return "-";
        return _dashboard.CommissionType switch
        {
            0 => $"{_dashboard.CommissionValue:N0}% Recorrente" + (_dashboard.MaxRecurringMonths.HasValue ? $" ({_dashboard.MaxRecurringMonths} meses)" : ""),
            1 => $"{_dashboard.CommissionValue:N0}% 1º Mês",
            2 => $"R$ {_dashboard.CommissionValue:N2} Fixo por Conversão",
            _ => $"{_dashboard.CommissionValue:N0}%"
        };
    }
}
