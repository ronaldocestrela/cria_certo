@page "/register"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@layout EmptyLayout
@inject HttpClient Http
@inject NavigationManager Navigation
@inject CriaCerto.Web.Client.Services.IReferralTrackingService ReferralTracker

<PageTitle>Cria Certo - Criar Conta</PageTitle>

<div class="min-h-screen flex flex-col items-center justify-center p-4" style="background-color: var(--cc-canvas);">
    <main class="w-full max-w-[520px]">
        
        <div class="bg-white rounded-xl p-8 md:p-10 relative overflow-hidden shadow-sm" style="border: 1px solid var(--cc-border);">
            
            <div class="flex flex-col items-center mb-8 text-center" style="display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: 2rem;">
                <img src="imgs/CriaCerto.png" alt="Cria Certo Logo" style="height: 72px; width: auto; object-fit: contain; margin-bottom: 0.75rem; border-radius: 8px;" />
                <h2 class="font-headline text-[24px] font-bold" style="color: var(--cc-ink); margin: 0;">Criar Conta no Cria Certo</h2>
                <p class="font-mono text-[11px] uppercase tracking-widest text-secondary mt-1" style="color: var(--cc-ink-muted); margin: 0.25rem 0 0 0;">
                    Gestão Pecuária Inteligente e de Alta Performance
                </p>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="mb-6 p-4 rounded-lg bg-red-50 text-red-700 text-sm border border-red-200" style="margin-bottom: 1.5rem; padding: 1rem; border-radius: 8px; background-color: #fef2f2; color: #b91c1c; border: 1px solid #fecaca;">
                    @_errorMessage
                </div>
            }

            @if (_registrationSuccess)
            {
                <div class="p-6 rounded-lg bg-green-50 text-green-800 text-center space-y-4" style="padding: 1.5rem; border-radius: 8px; background-color: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; text-align: center;">
                    <span class="material-symbols-outlined text-[48px]" style="color: #16a34a;">check_circle</span>
                    <h3 class="font-bold text-lg" style="margin: 0.5rem 0;">Conta Criada com Sucesso!</h3>
                    <p class="text-sm" style="font-size: 14px; margin-bottom: 0.75rem;">
                        Enviamos um <strong>e-mail com link de confirmação</strong> para <strong>@_createdUserEmail</strong>.
                    </p>
                    <p class="text-xs" style="font-size: 13px; color: #15803d; margin-bottom: 1.25rem;">
                        Você já pode cadastrar as informações da sua fazenda enquanto ativa o acesso pelo link que enviamos.
                    </p>
                    
                    <button class="w-full h-[48px] text-white font-mono text-[14px] uppercase font-bold rounded-lg transition-all" 
                            style="width: 100%; height: 48px; background-color: var(--cc-primary); border: none; border-radius: 8px; cursor: pointer; margin-bottom: 0.75rem;"
                            @onclick="GoToOnboarding">
                        Cadastrar Minha Fazenda Agora &rarr;
                    </button>

                    <button class="w-full text-center text-sm font-semibold hover:underline" 
                            style="width: 100%; border: none; background: transparent; color: var(--cc-primary); font-size: 14px; cursor: pointer;"
                            @onclick='() => Navigation.NavigateTo("/login")'>
                        Ir para o Login
                    </button>
                </div>
            }
            else
            {
                <EditForm Model="@_registerModel" OnValidSubmit="HandleRegister" class="space-y-4">
                    <DataAnnotationsValidator />
                    
                    <div style="margin-bottom: 1rem;">
                        <label class="font-mono text-[12px] font-bold block" style="display: block; margin-bottom: 0.35rem; text-transform: uppercase; color: var(--cc-ink-muted);">NOME COMPLETO *</label>
                        <InputText @bind-Value="_registerModel.FullName" class="w-full h-[46px] px-4 rounded-lg border font-headline" style="width: 100%; height: 46px; padding: 0 1rem; border-radius: 8px; border: 1px solid var(--cc-border); background-color: var(--cc-canvas);" placeholder="Ex: João da Silva" />
                        <ValidationMessage For="@(() => _registerModel.FullName)" class="text-xs text-red-600 mt-1" />
                    </div>

                    <div style="margin-bottom: 1rem;">
                        <label class="font-mono text-[12px] font-bold block" style="display: block; margin-bottom: 0.35rem; text-transform: uppercase; color: var(--cc-ink-muted);">E-MAIL DE ACESSO *</label>
                        <InputText @bind-Value="_registerModel.Email" class="w-full h-[46px] px-4 rounded-lg border font-headline" style="width: 100%; height: 46px; padding: 0 1rem; border-radius: 8px; border: 1px solid var(--cc-border); background-color: var(--cc-canvas);" placeholder="produtor@fazenda.com.br" type="email" />
                        <ValidationMessage For="@(() => _registerModel.Email)" class="text-xs text-red-600 mt-1" />
                    </div>

                    <div style="margin-bottom: 1rem;">
                        <label class="font-mono text-[12px] font-bold block" style="display: block; margin-bottom: 0.35rem; text-transform: uppercase; color: var(--cc-ink-muted);">TELEFONE / WHATSAPP</label>
                        <InputText @bind-Value="_registerModel.PhoneNumber" class="w-full h-[46px] px-4 rounded-lg border font-headline" style="width: 100%; height: 46px; padding: 0 1rem; border-radius: 8px; border: 1px solid var(--cc-border); background-color: var(--cc-canvas);" placeholder="(11) 99999-9999" />
                    </div>

                    <div style="margin-bottom: 1rem;">
                        <label class="font-mono text-[12px] font-bold block" style="display: block; margin-bottom: 0.35rem; text-transform: uppercase; color: var(--cc-ink-muted);">SENHA *</label>
                        <InputText @bind-Value="_registerModel.Password" class="w-full h-[46px] px-4 rounded-lg border font-headline" style="width: 100%; height: 46px; padding: 0 1rem; border-radius: 8px; border: 1px solid var(--cc-border); background-color: var(--cc-canvas);" placeholder="••••••••" type="password" />
                        <ValidationMessage For="@(() => _registerModel.Password)" class="text-xs text-red-600 mt-1" />
                    </div>

                    <div style="margin-bottom: 1.5rem;">
                        <label class="font-mono text-[12px] font-bold block" style="display: block; margin-bottom: 0.35rem; text-transform: uppercase; color: var(--cc-ink-muted);">CONFIRMAR SENHA *</label>
                        <InputText @bind-Value="_registerModel.ConfirmPassword" class="w-full h-[46px] px-4 rounded-lg border font-headline" style="width: 100%; height: 46px; padding: 0 1rem; border-radius: 8px; border: 1px solid var(--cc-border); background-color: var(--cc-canvas);" placeholder="••••••••" type="password" />
                        <ValidationMessage For="@(() => _registerModel.ConfirmPassword)" class="text-xs text-red-600 mt-1" />
                    </div>

                    <div style="margin-bottom: 1.5rem;">
                        <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                            <InputCheckbox @bind-Value="_registerModel.AcceptTermsAndPrivacy" id="acceptTermsCheckbox" 
                                           style="margin-top: 0.25rem; width: 18px; height: 18px; accent-color: var(--cc-primary); cursor: pointer;" />
                            <label for="acceptTermsCheckbox" style="font-size: 13px; color: var(--cc-ink); line-height: 1.5; cursor: pointer;">
                                Li e concordo com os 
                                <a href="/termos-de-uso" target="_blank" rel="noopener noreferrer" style="color: var(--cc-primary); font-weight: 600; text-decoration: underline;">Termos de Uso</a> 
                                (incluindo o <a href="/dpa" target="_blank" rel="noopener noreferrer" style="color: var(--cc-primary); font-weight: 600; text-decoration: underline;">Aditivo DPA</a>) 
                                e a 
                                <a href="/politica-de-privacidade" target="_blank" rel="noopener noreferrer" style="color: var(--cc-primary); font-weight: 600; text-decoration: underline;">Política de Privacidade</a>.
                            </label>
                        </div>
                        <ValidationMessage For="@(() => _registerModel.AcceptTermsAndPrivacy)" class="text-xs text-red-600 mt-1" />
                    </div>

                    <button class="w-full h-[48px] text-white font-mono text-[14px] rounded-lg uppercase tracking-wider transition-all" 
                            style="width: 100%; height: 48px; background-color: var(--cc-primary); border: none; border-radius: 8px; font-weight: bold; cursor: pointer;"
                            type="submit" disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <span>Criando Conta...</span>
                        }
                        else
                        {
                            <span>Cadastrar Grátis</span>
                        }
                    </button>

                    <div class="text-center pt-3" style="text-align: center; margin-top: 1rem;">
                        <a href="/login" class="text-sm font-semibold hover:underline" style="color: var(--cc-primary); font-size: 14px; text-decoration: none;">
                            Já possui uma conta? Faça login
                        </a>
                    </div>
                </EditForm>
            }

        </div>

        <footer class="mt-6 text-center text-xs opacity-75" style="margin-top: 1.5rem; text-align: center; font-size: 12px; color: var(--cc-ink-muted);">
            Plataforma em conformidade com a Lei Geral de Proteção de Dados (LGPD - Lei 13.709/2018).
        </footer>

    </main>
</div>

@code {
    private RegisterModel _registerModel = new();
    private bool _isLoading;
    private bool _registrationSuccess;
    private string? _errorMessage;

    [SupplyParameterFromQuery(Name = "ref")]
    public string? ReferralCodeQuery { get; set; }

    private string? _createdUserId;
    private string? _createdUserEmail;
    private string? _createdUserName;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(ReferralCodeQuery))
        {
            await ReferralTracker.CaptureReferralCodeAsync(ReferralCodeQuery);
        }
    }

    private class RegisterModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "O nome completo é obrigatório.")]
        [System.ComponentModel.DataAnnotations.MinLength(3, ErrorMessage = "O nome deve ter no mínimo 3 caracteres.")]
        public string FullName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "O e-mail é obrigatório.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Formato de e-mail inválido.")]
        public string Email { get; set; } = string.Empty;

        public string? PhoneNumber { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "A senha é obrigatória.")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "A senha deve ter no mínimo 8 caracteres.")]
        public string Password { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "A confirmação de senha é obrigatória.")]
        [System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage = "As senhas não coincidem.")]
        public string ConfirmPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Range(typeof(bool), "true", "true", ErrorMessage = "Você deve concordar com os Termos de Uso e a Política de Privacidade para continuar.")]
        public bool AcceptTermsAndPrivacy { get; set; }
    }

    private record RegisteredUserResponse(Guid Id, string FullName, string Email, string? PhoneNumber);

    private async Task HandleRegister()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var payload = new
            {
                FullName = _registerModel.FullName,
                Email = _registerModel.Email,
                Password = _registerModel.Password,
                PhoneNumber = _registerModel.PhoneNumber,
                AcceptTermsAndPrivacy = _registerModel.AcceptTermsAndPrivacy
            };

            var response = await Http.PostAsJsonAsync("/api/auth/register", payload);
            if (response.IsSuccessStatusCode)
            {
                var userDto = await response.Content.ReadFromJsonAsync<RegisteredUserResponse>();
                _createdUserId = userDto?.Id.ToString();
                _createdUserEmail = userDto?.Email ?? _registerModel.Email;
                _createdUserName = userDto?.FullName ?? _registerModel.FullName;
                _registrationSuccess = true;
            }
            else
            {
                try
                {
                    var err = await response.Content.ReadFromJsonAsync<CriaCerto.BuildingBlocks.Abstractions.Results.Error>();
                    _errorMessage = err?.Message ?? "Erro ao realizar o cadastro.";
                }
                catch
                {
                    _errorMessage = "Não foi possível concluir o cadastro. Verifique os dados e tente novamente.";
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro de conexão: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task GoToOnboarding()
    {
        var refCode = await ReferralTracker.GetReferralCodeAsync();
        var url = $"/onboarding?userId={_createdUserId}&email={Uri.EscapeDataString(_createdUserEmail ?? "")}&name={Uri.EscapeDataString(_createdUserName ?? "")}";
        if (!string.IsNullOrWhiteSpace(refCode))
        {
            url += $"&ref={Uri.EscapeDataString(refCode)}";
        }
        Navigation.NavigateTo(url);
    }
}
