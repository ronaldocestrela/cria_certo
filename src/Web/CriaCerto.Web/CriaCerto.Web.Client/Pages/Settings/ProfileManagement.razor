@code {
    private UserProfileModel? _profile;
    private bool _isLoading = true;
    private bool _isSavingProfile = false;
    private bool _isChangingPassword = false;

    // Profile form state
    private string _editFullName = string.Empty;
    private string? _editPhoneNumber = null;
    private Dictionary<string, string> _profileErrors = new();

    // Password form state
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmNewPassword = string.Empty;
    private bool _showCurrentPassword = false;
    private bool _showNewPassword = false;
    private bool _showConfirmPassword = false;
    private Dictionary<string, string> _passwordErrors = new();

    // Password strength evaluation
    private bool HasMinLength => _newPassword.Length >= 8;
    private bool HasUpper => _newPassword.Any(char.IsUpper);
    private bool HasLower => _newPassword.Any(char.IsLower);
    private bool HasNumber => _newPassword.Any(char.IsDigit);
    private bool HasSymbol => _newPassword.Any(c => !char.IsLetterOrDigit(c));

    protected override async Task OnInitializedAsync()
    {
        await LoadProfileAsync();
    }

    private async Task LoadProfileAsync()
    {
        _isLoading = true;
        try
        {
            _profile = await TenancyClient.GetUserProfileAsync();
            if (_profile != null)
            {
                _editFullName = _profile.FullName;
                _editPhoneNumber = _profile.PhoneNumber;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro ao carregar dados do perfil: " + ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSaveProfileAsync()
    {
        _profileErrors.Clear();

        if (string.IsNullOrWhiteSpace(_editFullName) || _editFullName.Trim().Length < 3)
        {
            _profileErrors["FullName"] = "O nome completo deve conter no mínimo 3 caracteres.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(_editPhoneNumber))
        {
            var digits = new string(_editPhoneNumber.Where(char.IsDigit).ToArray());
            if (digits.Length < 8 || digits.Length > 15)
            {
                _profileErrors["PhoneNumber"] = "Informe um telefone válido (entre 8 e 15 dígitos).";
                return;
            }
        }

        _isSavingProfile = true;
        try
        {
            var request = new UpdateUserProfileRequest(_editFullName.Trim(), _editPhoneNumber?.Trim());
            var (success, updatedProfile, errorMessage) = await TenancyClient.UpdateUserProfileAsync(request);

            if (success && updatedProfile != null)
            {
                _profile = updatedProfile;
                _editFullName = updatedProfile.FullName;
                _editPhoneNumber = updatedProfile.PhoneNumber;
                ToastService.ShowSuccess("Dados cadastrais retificados com sucesso!");
            }
            else
            {
                ToastService.ShowError(errorMessage ?? "Não foi possível atualizar o perfil.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Falha na requisição: " + ex.Message);
        }
        finally
        {
            _isSavingProfile = false;
        }
    }

    private async Task HandleChangePasswordAsync()
    {
        _passwordErrors.Clear();

        if (string.IsNullOrWhiteSpace(_currentPassword))
        {
            _passwordErrors["CurrentPassword"] = "Informe sua senha atual.";
            return;
        }

        if (!HasMinLength || !HasUpper || !HasLower || !HasNumber || !HasSymbol)
        {
            _passwordErrors["NewPassword"] = "A nova senha não atende a todos os critérios de segurança.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_confirmNewPassword) || _newPassword != _confirmNewPassword)
        {
            _passwordErrors["ConfirmNewPassword"] = "A confirmação de senha não confere.";
            return;
        }

        if (_currentPassword == _newPassword)
        {
            _passwordErrors["NewPassword"] = "A nova senha deve ser diferente da senha atual.";
            return;
        }

        _isChangingPassword = true;
        try
        {
            var request = new ChangePasswordRequest(_currentPassword, _newPassword, _confirmNewPassword);
            var (success, errorMessage) = await TenancyClient.ChangePasswordAsync(request);

            if (success)
            {
                _currentPassword = string.Empty;
                _newPassword = string.Empty;
                _confirmNewPassword = string.Empty;
                ToastService.ShowSuccess("Senha alterada com sucesso!");
            }
            else
            {
                ToastService.ShowError(errorMessage ?? "Não foi possível alterar a senha.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Falha na requisição: " + ex.Message);
        }
        finally
        {
            _isChangingPassword = false;
        }
    }

    private int GetStrengthScore()
    {
        if (string.IsNullOrEmpty(_newPassword)) return 0;
        int score = 0;
        if (HasMinLength) score++;
        if (HasUpper && HasLower) score++;
        if (HasNumber) score++;
        if (HasSymbol) score++;
        return score;
    }

    private string GetStrengthClass()
    {
        var score = GetStrengthScore();
        return score switch
        {
            1 => "strength-weak",
            2 => "strength-medium",
            3 or 4 => "strength-strong",
            _ => ""
        };
    }

    private string GetStrengthLabel()
    {
        var score = GetStrengthScore();
        return score switch
        {
            0 => "Não informada",
            1 => "Muito Fraca",
            2 => "Razoável",
            3 => "Boa",
            4 => "Forte",
            _ => "Indefinida"
        };
    }

    private static string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "CC";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private bool _isExportingData = false;

    private async Task HandleExportMyDataAsync()
    {
        if (_isExportingData) return;
        _isExportingData = true;

        try
        {
            var (success, content, fileName, error) = await TenancyClient.ExportUserDataPortabilityAsync();
            if (success && content != null && content.Length > 0)
            {
                await JS.InvokeVoidAsync("downloadFileFromByteArray", fileName, "application/json", content);
                ToastService.ShowSuccess("Dossiê de portabilidade LGPD gerado com sucesso! O download foi iniciado automaticamente no seu navegador.");
            }
            else
            {
                ToastService.ShowError(error ?? "Falha ao gerar o dossiê de portabilidade dos dados pessoais.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro ao processar a exportação: " + ex.Message);
        }
        finally
        {
            _isExportingData = false;
        }
    }
}
