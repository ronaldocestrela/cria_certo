@page "/settings/subscription"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize]
@using CriaCerto.Web.Client.Auth
@using CriaCerto.Web.Client.Components.Settings
@using CriaCerto.Web.Client.Services
@using CriaCerto.BuildingBlocks.Abstractions.Licensing
@using System.Security.Claims
@inject CustomAuthStateProvider AuthStateProvider
@inject TenancyApiClient TenancyApiClient
@inject PlantelApiClient PlantelApiClient
@inject NavigationManager Navigation

<PageTitle>Cria Certo - Assinatura Modular Self-Service</PageTitle>

<div class="subscription-container font-headline" style="max-width: 1280px; margin: 0 auto; padding-bottom: 5rem;">

    <!-- Page Header & Navigation Breadcrumb -->
    <div style="margin-bottom: 2rem;">
        <nav style="display: flex; align-items: center; gap: 0.5rem; color: var(--cc-secondary); font-size: 12px; margin-bottom: 0.5rem;" class="font-mono">
            <span style="text-transform: uppercase; tracking-wider: 0.05em; cursor: pointer;" @onclick="GoToSettings">CONFIGURAÇÕES</span>
            <span class="material-symbols-outlined" style="font-size: 14px;">chevron_right</span>
            <span style="color: var(--cc-primary); text-transform: uppercase; tracking-wider: 0.05em;">ASSINATURA MODULAR</span>
        </nav>
        <h2 class="font-headline text-[32px] font-bold" style="color: var(--cc-ink); margin: 0; line-height: 40px; letter-spacing: -0.02em;">
            Assinatura & Módulos Self-Service
        </h2>
        <p style="color: var(--cc-ink-muted); margin: 0.25rem 0 0 0; font-size: 16px;">
            Configure seu plano sob medida por faixa de cabeças e escolha livremente os módulos que sua fazenda precisa.
        </p>
    </div>

    @if (!_isAdmin)
    {
        <div style="padding: 1rem 1.25rem; border-radius: 8px; margin-bottom: 1.5rem; background-color: #f8fafc; color: var(--cc-ink); border: 1px solid var(--cc-border); display: flex; align-items: center; gap: 0.75rem;">
            <span class="material-symbols-outlined" style="font-size: 22px; color: var(--cc-primary);">admin_panel_settings</span>
            <div style="font-size: 13px;">
                <strong>Modo Somente Leitura (RBAC):</strong> Você está visualizando o catálogo modular e a configuração da fazenda. Apenas administradores possuem permissão para contratar ou alterar módulos e formas de pagamento.
            </div>
        </div>
    }

    @if (_profile != null && _profile.CurrentPeriodEndUtc.HasValue && _profile.CurrentPeriodEndUtc.Value < DateTime.UtcNow)
    {
        <div style="padding: 1.25rem 1.5rem; border-radius: 12px; margin-bottom: 1.5rem; background-color: #fff7ed; color: #9a3412; border: 1px solid #fed7aa; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <span class="material-symbols-outlined" style="font-size: 28px; color: #ea580c;">timer_off</span>
                <div>
                    <strong style="font-size: 14px;">
                        @(string.Equals(_profile.Status, "Trial", StringComparison.OrdinalIgnoreCase)
                            ? "Período de testes (Trial) expirado:"
                            : "Vigência do plano de assinatura expirada:")
                    </strong>
                    <div style="font-size: 13px; color: #7c2d12;">
                        @(string.Equals(_profile.Status, "Trial", StringComparison.OrdinalIgnoreCase)
                            ? "Seu período gratuito terminou. Selecione sua faixa de cabeças e os módulos desejados abaixo para reativar o acesso total aos recursos da plataforma."
                            : "A vigência contratada da fazenda expirou. Selecione sua configuração abaixo para regularizar sua assinatura via Stripe.")
                    </div>
                </div>
            </div>
            <span class="font-mono" style="font-size: 11px; padding: 0.25rem 0.65rem; border-radius: 99px; background: #ea580c; color: white; font-weight: 700;">REGULARIZAÇÃO PENDENTE</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <div style="padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; background-color: @(_isSuccessMessage ? "#dcfce7" : "#fee2e2"); color: @(_isSuccessMessage ? "#166534" : "#991b1b"); font-weight: bold; border: 1px solid @(_isSuccessMessage ? "#86efac" : "#fca5a5");">
            @_message
        </div>
    }

    @if (_profile != null && !string.IsNullOrWhiteSpace(_profile.StripeSubscriptionId))
    {
        <div style="background: white; border: 1px solid var(--cc-border); border-radius: 12px; padding: 1.25rem 1.5rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; box-shadow: var(--cc-shadow);">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <div style="width: 44px; height: 44px; border-radius: 10px; background: #635bff15; color: #635bff; display: flex; align-items: center; justify-content: center;">
                    <span class="material-symbols-outlined" style="font-size: 26px;">credit_card</span>
                </div>
                <div>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-weight: 700; color: var(--cc-ink); font-size: 15px;">Faturamento Ativo Stripe</span>
                        <span class="font-mono" style="font-size: 11px; padding: 0.15rem 0.5rem; border-radius: 99px; background: #dcfce7; color: #166534; font-weight: 700;">CONECTADO</span>
                    </div>
                    <p style="margin: 0.2rem 0 0 0; font-size: 13px; color: var(--cc-ink-muted);">
                        @if (_profile.CurrentPeriodEndUtc.HasValue)
                        {
                            <span>Próxima renovação em <strong>@_profile.CurrentPeriodEndUtc.Value.ToLocalTime().ToString("dd/MM/yyyy")</strong> com rateio automático nas atualizações.</span>
                        }
                        else
                        {
                            <span>Cobrança recorrente ativa via gateway seguro Stripe.</span>
                        }
                    </p>
                </div>
            </div>
            <div>
                @if (_isAdmin)
                {
                    <button class="cc-btn cc-btn-outline font-mono text-xs" @onclick="OpenBillingPortal" disabled="@_isSubmitting"
                            style="border: 1px solid #635bff; color: #635bff; background: white; padding: 0.6rem 1.2rem; border-radius: 8px; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
                        <span class="material-symbols-outlined" style="font-size: 16px;">open_in_new</span>
                        <span>Gerenciar Cobrança & Cartões</span>
                    </button>
                }
            </div>
        </div>
    }

    @if (_isLoading)
    {
        <div style="display: flex; justify-content: center; align-items: center; padding: 4rem 2rem; background-color: white; border-radius: 12px; border: 1px solid var(--cc-border); margin-bottom: 3.5rem;">
            <div class="animate-spin" style="width: 32px; height: 32px; border: 3px solid #e5e7eb; border-top-color: var(--cc-primary); border-radius: 50%;"></div>
            <span style="margin-left: 0.75rem; color: var(--cc-ink-muted);" class="font-mono text-sm font-semibold">
                Carregando catálogo modular e métricas de rebanho...
            </span>
        </div>
    }
    else
    {
        <!-- SEÇÃO 1: Seletor Interativo de Faixa de Cabeças -->
        <HeadTierSelector Tiers="@_catalog.HeadTiers"
                          SelectedTierCode="@_selectedTierCode"
                          CurrentHeadCount="@_activeHerdCount"
                          IsAdmin="@_isAdmin"
                          OnTierSelected="HandleTierSelected" />

        <!-- SEÇÃO 2: Grid de Seleção de Módulos (Self-Service) -->
        <ModuleSelectionGrid Modules="@_catalog.Modules"
                             SelectedTierCode="@_selectedTierCode"
                             IsAnnual="@_isAnnual"
                             SelectedModuleKeys="@_selectedModuleKeys"
                             ActiveTenantModules="@_profile?.SubscribedModules"
                             IsAdmin="@_isAdmin"
                             OnToggleModule="HandleToggleModule" />

        <!-- SEÇÃO 3: Resumo do Carrinho (Sticky Summary Bar) -->
        <ModularCartStickyBar Catalog="@_catalog"
                              SelectedTierCode="@_selectedTierCode"
                              SelectedModuleKeys="@_selectedModuleKeys"
                              IsAnnual="@_isAnnual"
                              ActiveHerdCount="@_activeHerdCount"
                              HasActiveStripeSubscription="@HasActiveStripeSubscription"
                              IsAdmin="@_isAdmin"
                              IsSubmitting="@_isSubmitting"
                              OnAnnualChanged="HandleAnnualChanged"
                              OnPrimaryAction="ExecutePrimaryAction"
                              OnOpenBillingPortal="OpenBillingPortal" />

        <!-- Accordion Comparativo de Funcionalidades dos Módulos -->
        <section style="background-color: white; border: 1px solid var(--cc-border); border-radius: 12px; overflow: hidden; box-shadow: var(--cc-shadow); margin-top: 3rem; margin-bottom: 3rem;">
            <button @onclick="ToggleAccordion"
                    style="width: 100%; background: transparent; border: none; padding: 1.25rem 1.5rem; text-align: left; display: flex; justify-content: space-between; align-items: center; cursor: pointer;">
                <div>
                    <h3 style="margin: 0; font-size: 18px; font-weight: bold; color: var(--cc-ink);">Comparativo Detalhado de Módulos</h3>
                    <p style="margin: 0.2rem 0 0 0; font-size: 13px; color: var(--cc-ink-muted);">Conheça as capacidades específicas e o escopo funcional de cada módulo do catálogo.</p>
                </div>
                <span class="material-symbols-outlined text-outline transition-transform duration-300" 
                      style="transform: rotate(@(_showAccordion ? "180deg" : "0deg"));">
                    expand_more
                </span>
            </button>

            @if (_showAccordion)
            {
                <div style="border-top: 1px solid var(--cc-border); overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
                        <thead>
                            <tr style="background-color: var(--cc-canvas); color: var(--cc-ink-muted);" class="font-mono">
                                <th style="padding: 1rem 1.5rem; font-size: 11px; font-weight: bold; text-transform: uppercase;">Módulo</th>
                                <th style="padding: 1rem 1.5rem; font-size: 11px; font-weight: bold; text-transform: uppercase;">Tipo</th>
                                <th style="padding: 1rem 1.5rem; font-size: 11px; font-weight: bold; text-transform: uppercase;">Recursos Incluídos</th>
                                <th style="padding: 1rem 1.5rem; font-size: 11px; font-weight: bold; text-transform: uppercase; text-align: right;">Preço na Faixa Atual</th>
                            </tr>
                        </thead>
                        <tbody style="color: var(--cc-ink);">
                            @foreach (var mod in _catalog.Modules.OrderBy(m => m.SortOrder))
                            {
                                var price = mod.PricesByTier.FirstOrDefault(p => string.Equals(p.TierCode, _selectedTierCode, StringComparison.OrdinalIgnoreCase))
                                    ?? mod.PricesByTier.FirstOrDefault();
                                var displayPrice = _isAnnual ? price?.AnnualPriceMonthly : price?.MonthlyPrice;

                                <tr style="border-bottom: 1px solid #e2e8f0;">
                                    <td style="padding: 1rem 1.5rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem;">
                                        <span class="material-symbols-outlined" style="color: var(--cc-primary); font-size: 20px;">@mod.Icon</span>
                                        <span>@mod.Name</span>
                                    </td>
                                    <td style="padding: 1rem 1.5rem;">
                                        @if (mod.IsCore)
                                        {
                                            <span class="font-mono" style="font-size: 10px; font-weight: 700; background: #e2e8f0; color: #334155; padding: 0.2rem 0.5rem; border-radius: 4px;">OBRIGATÓRIO</span>
                                        }
                                        else
                                        {
                                            <span class="font-mono" style="font-size: 10px; font-weight: 700; background: #dcfce7; color: #166534; padding: 0.2rem 0.5rem; border-radius: 4px;">OPCIONAL</span>
                                        }
                                    </td>
                                    <td style="padding: 1rem 1.5rem; color: var(--cc-ink-muted); font-size: 13px;">
                                        @mod.Description
                                    </td>
                                    <td style="padding: 1rem 1.5rem; text-align: right; font-weight: 700;" class="font-mono">
                                        R$ @((displayPrice ?? 0m).ToString("N2"))/mês
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    <!-- Modal de Indisponibilidade ou Falha de Faturamento -->
    @if (_showBillingUnavailableModal)
    {
        <div class="modal-overlay" @onclick="CloseBillingModal" style="position: fixed; inset: 0; background: rgba(15, 23, 42, 0.7); display: flex; align-items: center; justify-content: center; z-index: 1050; padding: 1rem;">
            <div class="modal-card" @onclick:stopPropagation="true" style="background: white; border-radius: 16px; width: min(480px, 95vw); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2); overflow: hidden; border: 1px solid var(--cc-border);">
                <div style="background: #fef2f2; padding: 1.25rem 1.5rem; display: flex; align-items: center; gap: 0.75rem; border-bottom: 1px solid #fee2e2;">
                    <div style="width: 40px; height: 40px; border-radius: 10px; background: #fee2e2; color: #dc2626; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <span class="material-symbols-outlined" style="font-size: 24px;">lock_clock</span>
                    </div>
                    <div>
                        <h3 style="margin: 0; font-size: 16px; font-weight: 700; color: #991b1b;">Faturamento Seguro Stripe</h3>
                        <p style="margin: 0.15rem 0 0; font-size: 12px; color: #b91c1c;">Segurança & Conformidade de Pagamento</p>
                    </div>
                </div>
                <div style="padding: 1.5rem; color: var(--cc-ink); font-size: 14px; line-height: 1.5;">
                    <p style="margin: 0 0 1rem 0;">
                        @_billingUnavailableReason
                    </p>
                    <div style="background: #f8fafc; border-left: 4px solid var(--cc-primary); border-radius: 4px; padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 13px; color: var(--cc-ink-muted);">
                        <strong>Aviso de Segurança:</strong> As alterações contratuais e rateios são validados diretamente com o Stripe. Sua configuração atual permanece protegida.
                    </div>
                </div>
                <div style="padding: 1rem 1.5rem; background: #f8fafc; border-top: 1px solid var(--cc-border); display: flex; justify-content: flex-end; gap: 0.75rem;">
                    <button type="button" @onclick="CloseBillingModal" style="background: white; border: 1px solid var(--cc-border); border-radius: 8px; padding: 0.5rem 1.25rem; font-size: 13px; font-weight: 600; cursor: pointer; color: var(--cc-ink);">
                        Fechar
                    </button>
                    @if (HasActiveStripeSubscription)
                    {
                        <button type="button" @onclick="OpenBillingPortalFromModal" style="background: #635bff; border: none; border-radius: 8px; padding: 0.5rem 1.25rem; font-size: 13px; font-weight: 600; color: white; cursor: pointer; display: flex; align-items: center; gap: 0.4rem;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">open_in_new</span>
                            <span>Acessar Portal Stripe</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="ContactSupport" style="background: var(--cc-primary); border: none; border-radius: 8px; padding: 0.5rem 1.25rem; font-size: 13px; font-weight: 600; color: white; cursor: pointer;">
                            Falar com Suporte
                        </button>
                    }
                </div>
            </div>
        </div>
    }

</div>

@code {
    private Guid _tenantId = Guid.Empty;
    private TenantProfileModel? _profile;
    private bool _isAdmin = false;
    private bool _isAnnual = false;
    private bool _showAccordion = false;
    private bool _isSubmitting = false;
    private bool _isLoading = true;
    private string? _message;
    private bool _isSuccessMessage;
    private int _activeHerdCount = 0;
    private string _selectedTierCode = "TIER_500";
    private HashSet<string> _selectedModuleKeys = new(StringComparer.OrdinalIgnoreCase) { "Cows" };
    private ModularSubscriptionCatalogModel _catalog = TenancyApiClient.GetDefaultModularCatalog();
    private bool _showBillingUnavailableModal = false;
    private string _billingUnavailableReason = "O serviço de faturamento seguro no Stripe está temporariamente indisponível.";

    [SupplyParameterFromQuery(Name = "success")]
    public bool? StripeSuccess { get; set; }

    [SupplyParameterFromQuery(Name = "canceled")]
    public bool? StripeCanceled { get; set; }

    [SupplyParameterFromQuery(Name = "addModule")]
    public string? AddModule { get; set; }

    private bool _stripeProcessed = false;

    private bool HasActiveStripeSubscription => _profile != null &&
        !string.IsNullOrWhiteSpace(_profile.StripeSubscriptionId) &&
        (string.Equals(_profile.Status, "Active", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(_profile.Status, "PastDue", StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("login");
            return;
        }

        var roleClaim = user.FindFirst(ClaimTypes.Role)?.Value ?? user.FindFirst("Role")?.Value;
        _isAdmin = user.IsInRole("Admin") || string.Equals(roleClaim, "Admin", StringComparison.OrdinalIgnoreCase);

        var tenantIdClaim = user.FindFirst("TenantId")?.Value;
        if (Guid.TryParse(tenantIdClaim, out var tenantId))
        {
            _tenantId = tenantId;

            // Retorno de checkout com sucesso: renova o token e claims na hora
            if (StripeSuccess == true && !_stripeProcessed)
            {
                _stripeProcessed = true;
                var refreshedToken = await TenancyApiClient.RefreshTokenAsync(_tenantId);
                if (!string.IsNullOrEmpty(refreshedToken))
                {
                    await AuthStateProvider.MarkUserAsAuthenticated(refreshedToken);
                    _message = "Assinatura confirmada com sucesso pelo Stripe! Sua faixa de cabeças e módulos já estão atualizados.";
                    _isSuccessMessage = true;
                }
                else
                {
                    _message = "Pagamento concluído no Stripe! Suas novas cotas e permissões estão sendo sincronizadas.";
                    _isSuccessMessage = true;
                }
            }
            else if (StripeCanceled == true && !_stripeProcessed)
            {
                _stripeProcessed = true;
                _message = "A operação de contratação no Stripe foi cancelada. Seu plano atual permanece inalterado.";
                _isSuccessMessage = false;
            }

            try
            {
                _isLoading = true;

                // 1. Carrega Perfil do Tenant
                _profile = await TenancyApiClient.GetTenantProfileAsync(tenantId);
                if (_profile != null)
                {
                    if (!string.IsNullOrWhiteSpace(_profile.HeadTierCode))
                    {
                        _selectedTierCode = _profile.HeadTierCode;
                    }

                    if (_profile.SubscribedModules is { Count: > 0 })
                    {
                        _selectedModuleKeys = new HashSet<string>(_profile.SubscribedModules, StringComparer.OrdinalIgnoreCase);
                    }
                    else
                    {
                        // Fallback inicial padrão
                        _selectedModuleKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "Cows", "Breeding" };
                    }
                    _selectedModuleKeys.Add("Cows");

                    if (!string.IsNullOrWhiteSpace(AddModule))
                    {
                        var canonical = ModuleGuardUpsellCalculator.ResolveCommercialModuleKey(AddModule);
                        if (!string.IsNullOrWhiteSpace(canonical))
                        {
                            _selectedModuleKeys.Add(canonical);
                            if (string.IsNullOrEmpty(_message))
                            {
                                var readableName = ModuleGuardUpsellCalculator.GetReadableModuleName(canonical);
                                _message = $"Módulo '{readableName}' pré-selecionado no seu carrinho modular.";
                                _isSuccessMessage = true;
                            }
                        }
                    }
                }

                // 2. Carrega Catálogo Modular
                _catalog = await TenancyApiClient.GetModularCatalogAsync();

                // 3. Carrega Rebanho Ativo (máximo entre matrizes do Breeding e unidades de produção)
                int cowsCount = 0;
                try
                {
                    var cowsResponse = await PlantelApiClient.ListCowsAsync(search: null, status: null);
                    if (cowsResponse != null)
                    {
                        cowsCount = cowsResponse.TotalCount;
                    }
                }
                catch
                {
                    // Fallback
                }

                int unitsHeadCount = 0;
                try
                {
                    var units = await TenancyApiClient.GetProductionUnitsAsync(tenantId);
                    if (units != null)
                    {
                        unitsHeadCount = units.Sum(u => u.CurrentHeadCount);
                    }
                }
                catch
                {
                    // Fallback
                }

                _activeHerdCount = Math.Max(cowsCount, unitsHeadCount);

                // Auto-ajusta para faixa compatível se a atual for menor que o rebanho ativo
                var currentSelectedTier = _catalog.HeadTiers.FirstOrDefault(t => string.Equals(t.TierCode, _selectedTierCode, StringComparison.OrdinalIgnoreCase));
                if (currentSelectedTier != null && _activeHerdCount > currentSelectedTier.MaxHeads)
                {
                    var suitableTier = _catalog.HeadTiers.OrderBy(t => t.SortOrder).FirstOrDefault(t => t.MaxHeads >= _activeHerdCount);
                    if (suitableTier != null)
                    {
                        _selectedTierCode = suitableTier.TierCode;
                    }
                }
            }
            finally
            {
                _isLoading = false;
            }
        }
        else
        {
            Navigation.NavigateTo("login");
        }
    }

    private void HandleTierSelected(string tierCode)
    {
        _selectedTierCode = tierCode;
    }

    private void HandleToggleModule(string moduleKey)
    {
        if (string.Equals(moduleKey, "Cows", StringComparison.OrdinalIgnoreCase)) return; // Cows is mandatory

        if (_selectedModuleKeys.Contains(moduleKey))
        {
            _selectedModuleKeys.Remove(moduleKey);
        }
        else
        {
            _selectedModuleKeys.Add(moduleKey);
        }
    }

    private void HandleAnnualChanged(bool isAnnual)
    {
        _isAnnual = isAnnual;
    }

    private void ToggleAccordion()
    {
        _showAccordion = !_showAccordion;
    }

    private async Task ExecutePrimaryAction()
    {
        if (!_isAdmin)
        {
            _message = "Apenas administradores da fazenda possuem permissão para contratar ou alterar planos.";
            _isSuccessMessage = false;
            return;
        }

        if (_isSubmitting || _tenantId == Guid.Empty) return;

        _isSubmitting = true;
        _message = null;

        try
        {
            var modulesList = _selectedModuleKeys.ToList();
            if (!modulesList.Contains("Cows", StringComparer.OrdinalIgnoreCase))
            {
                modulesList.Add("Cows");
            }

            if (HasActiveStripeSubscription)
            {
                // Usuário já possui Stripe ativo -> Atualização direta modular com proration
                var updateRequest = new UpdateModularSubscriptionRequestModel(
                    _tenantId,
                    _selectedTierCode,
                    modulesList,
                    _isAnnual ? "annual" : "monthly",
                    AllowGracePeriod: false);

                var updateResult = await TenancyApiClient.UpdateModularSubscriptionAsync(updateRequest);
                if (updateResult != null)
                {
                    if (!string.IsNullOrWhiteSpace(updateResult.Token))
                    {
                        await AuthStateProvider.MarkUserAsAuthenticated(updateResult.Token);
                    }

                    _profile = updateResult.Profile;
                    _selectedTierCode = updateResult.HeadTierCode;
                    _selectedModuleKeys = new HashSet<string>(updateResult.SubscribedModules, StringComparer.OrdinalIgnoreCase);
                    _selectedModuleKeys.Add("Cows");

                    _message = "Assinatura modular atualizada com sucesso! Seus novos módulos e limites de capacidade já estão ativos.";
                    _isSuccessMessage = true;
                }
            }
            else
            {
                // Nova contratação / Degustação Trial -> Stripe Checkout multi-item
                var checkoutSession = await TenancyApiClient.CreateModularCheckoutAsync(
                    _tenantId,
                    _selectedTierCode,
                    modulesList,
                    _isAnnual ? "annual" : "monthly",
                    Navigation.ToAbsoluteUri("/settings/subscription?success=true").ToString(),
                    Navigation.ToAbsoluteUri("/settings/subscription?canceled=true").ToString());

                if (checkoutSession != null && !string.IsNullOrWhiteSpace(checkoutSession.Url))
                {
                    Navigation.NavigateTo(checkoutSession.Url);
                    return;
                }

                _billingUnavailableReason = "Não foi possível iniciar a sessão de faturamento seguro no Stripe. Nenhuma cobrança foi realizada e sua configuração atual permanece inalterada.";
                _showBillingUnavailableModal = true;
                _message = "O faturamento online está temporariamente indisponível. Entre em contato com o suporte.";
                _isSuccessMessage = false;
            }
        }
        catch (Exception ex)
        {
            _billingUnavailableReason = $"Ocorreu uma falha no processamento da assinatura: {ex.Message}";
            _showBillingUnavailableModal = true;
            _message = $"Erro ao processar assinatura: {ex.Message}";
            _isSuccessMessage = false;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task OpenBillingPortal()
    {
        if (!_isAdmin)
        {
            _message = "Apenas administradores possuem acesso ao portal de faturamento Stripe.";
            _isSuccessMessage = false;
            return;
        }

        if (_tenantId == Guid.Empty) return;

        _isSubmitting = true;
        try
        {
            var portalSession = await TenancyApiClient.CreateSubscriptionPortalAsync(
                _tenantId,
                Navigation.ToAbsoluteUri("/settings/subscription?success=true").ToString());

            if (portalSession != null && !string.IsNullOrWhiteSpace(portalSession.Url))
            {
                Navigation.NavigateTo(portalSession.Url);
            }
            else
            {
                _billingUnavailableReason = "Não foi possível abrir o portal Stripe. Verifique se sua fazenda possui uma assinatura ativa ou contate o suporte.";
                _showBillingUnavailableModal = true;
            }
        }
        catch (Exception ex)
        {
            _billingUnavailableReason = $"Erro ao acessar o portal de faturamento: {ex.Message}";
            _showBillingUnavailableModal = true;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void CloseBillingModal()
    {
        _showBillingUnavailableModal = false;
    }

    private async Task OpenBillingPortalFromModal()
    {
        CloseBillingModal();
        await OpenBillingPortal();
    }

    private void ContactSupport()
    {
        _showBillingUnavailableModal = false;
        Navigation.NavigateTo("settings/organization");
    }

    private void GoToSettings()
    {
        Navigation.NavigateTo("settings/organization");
    }
}
