@page "/settings/subscription"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@attribute [Authorize]
@using CriaCerto.Web.Client.Auth
@using CriaCerto.BuildingBlocks.Abstractions.Licensing
@using System.Security.Claims
@inject CustomAuthStateProvider AuthStateProvider
@inject TenancyApiClient TenancyApiClient
@inject PlantelApiClient PlantelApiClient
@inject NavigationManager Navigation

<PageTitle>Cria Certo - Planos e Assinatura</PageTitle>

<div class="subscription-container font-headline">

    <!-- Page Header & Navigation Breadcrumb -->
    <div style="margin-bottom: 2rem;">
        <nav style="display: flex; align-items: center; gap: 0.5rem; color: var(--cc-secondary); font-size: 12px; margin-bottom: 0.5rem;" class="font-mono">
            <span style="text-transform: uppercase; tracking-wider: 0.05em; cursor: pointer;" @onclick="GoToSettings">CONFIGURAÇÕES</span>
            <span class="material-symbols-outlined" style="font-size: 14px;">chevron_right</span>
            <span style="color: var(--cc-primary); text-transform: uppercase; tracking-wider: 0.05em;">ASSINATURA & PLANOS</span>
        </nav>
        <h2 class="font-headline text-[32px] font-bold" style="color: var(--cc-ink); margin: 0; line-height: 40px; letter-spacing: -0.02em;">
            Assinatura e Planos
        </h2>
        <p style="color: var(--cc-ink-muted); margin: 0.25rem 0 0 0; font-size: 16px;">
            Gerencie o plano da sua granja, acompanhe o uso de cotas e mude de categoria a qualquer momento.
        </p>
    </div>

    @if (!_isAdmin)
    {
        <div style="padding: 1rem 1.25rem; border-radius: 8px; margin-bottom: 1.5rem; background-color: #f8fafc; color: var(--cc-ink); border: 1px solid var(--cc-border); display: flex; align-items: center; gap: 0.75rem;">
            <span class="material-symbols-outlined" style="font-size: 22px; color: var(--cc-primary);">admin_panel_settings</span>
            <div style="font-size: 13px;">
                <strong>Modo Somente Leitura (RBAC):</strong> Você está visualizando o catálogo e as cotas do plano. Apenas administradores da fazenda possuem permissão para contratar planos, solicitar upgrades ou gerenciar formas de pagamento.
            </div>
        </div>
    }

    @if (_profile != null && string.Equals(_profile.Status, "Trial", StringComparison.OrdinalIgnoreCase) && _profile.CurrentPeriodEndUtc.HasValue && _profile.CurrentPeriodEndUtc.Value < DateTime.UtcNow)
    {
        <div style="padding: 1.25rem 1.5rem; border-radius: 12px; margin-bottom: 1.5rem; background-color: #fff7ed; color: #9a3412; border: 1px solid #fed7aa; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <span class="material-symbols-outlined" style="font-size: 28px; color: #ea580c;">timer_off</span>
                <div>
                    <strong style="font-size: 14px;">Período de testes (Trial) expirado:</strong>
                    <div style="font-size: 13px; color: #7c2d12;">Seu período gratuito de 30 dias terminou. Selecione um dos planos abaixo para regularizar via Stripe e reativar o acesso total aos módulos do Cria Certo.</div>
                </div>
            </div>
            <span class="font-mono" style="font-size: 11px; padding: 0.25rem 0.65rem; border-radius: 99px; background: #ea580c; color: white; font-weight: 700;">REGULARIZAÇÃO PENDENTE</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <div style="padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; background-color: @(_isSuccessMessage ? "#dcfce7" : "#fee2e2"); color: @(_isSuccessMessage ? "#166534" : "#991b1b"); font-weight: bold; border: 1px solid @(_isSuccessMessage ? "#86efac" : "#fca5a5");">
            @_message
        </div>
    }

    @if (_profile != null && (!string.IsNullOrEmpty(_profile.StripeCustomerId) || _profile.CurrentPeriodEndUtc.HasValue))
    {
        <div style="background: white; border: 1px solid var(--cc-border); border-radius: 12px; padding: 1.25rem 1.5rem; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; box-shadow: var(--cc-shadow);">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <div style="width: 44px; height: 44px; border-radius: 10px; background: #635bff15; color: #635bff; display: flex; align-items: center; justify-content: center;">
                    <span class="material-symbols-outlined" style="font-size: 26px;">credit_card</span>
                </div>
                <div>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-weight: 700; color: var(--cc-ink); font-size: 15px;">Faturamento Seguro Stripe</span>
                        <span class="font-mono" style="font-size: 11px; padding: 0.15rem 0.5rem; border-radius: 99px; background: #dcfce7; color: #166534; font-weight: 700;">CONECTADO</span>
                    </div>
                    <p style="margin: 0.2rem 0 0 0; font-size: 13px; color: var(--cc-ink-muted);">
                        @if (_profile.CurrentPeriodEndUtc.HasValue)
                        {
                            <span>Próxima renovação em <strong>@_profile.CurrentPeriodEndUtc.Value.ToLocalTime().ToString("dd/MM/yyyy")</strong>.</span>
                        }
                        else
                        {
                            <span>Cobrança recorrente ativa via gateway seguro Stripe.</span>
                        }
                    </p>
                </div>
            </div>
            <div>
                @if (_isAdmin)
                {
                    <button class="cc-btn cc-btn-outline font-mono text-xs" @onclick="OpenBillingPortal" disabled="@_isSubmitting"
                            style="border: 1px solid #635bff; color: #635bff; background: white; padding: 0.6rem 1.2rem; border-radius: 8px; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 0.5rem;">
                        <span class="material-symbols-outlined" style="font-size: 16px;">open_in_new</span>
                        <span>Gerenciar Cobrança & Cartões</span>
                    </button>
                }
                else
                {
                    <div style="display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; border-radius: 8px; background: #f1f5f9; color: var(--cc-ink-muted); font-size: 12px; font-weight: 600;" class="font-mono">
                        <span class="material-symbols-outlined" style="font-size: 16px;">lock</span>
                        <span>Faturamento Restrito a Administradores</span>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Usage Limit Indicators (Stitch Mobile component styling) -->
    <section style="background-color: white; border: 1px solid var(--cc-border); border-radius: 12px; padding: 1.5rem; margin-bottom: 2.5rem; box-shadow: var(--cc-shadow);">
        <h3 class="font-mono text-[12px] font-bold text-secondary" style="margin: 0 0 1rem 0; text-transform: uppercase; tracking-wider: 0.05em;">Uso Atual das Cotas do Plano</h3>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
            
            <!-- Animals quota indicator -->
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <span style="font-size: 14px; font-weight: 600; color: var(--cc-ink);">Animais Cadastrados</span>
                    <span class="font-mono" style="font-size: 14px; font-weight: bold; color: var(--cc-primary);">@_registeredAnimalsCount / @_maxAnimalsAllowed</span>
                </div>
                <div style="width: 100%; bg-color: var(--cc-canvas); background-color: var(--cc-canvas); height: 8px; border-radius: 99px; overflow: hidden; display: flex;">
                    <div style="width: @(_animalsPercentage)%; height: 100%; background-color: @(_animalsPercentage > 90 ? "#ba1a1a" : "var(--cc-primary-container)"); border-radius: 99px;"></div>
                </div>
                @if (_animalsPercentage > 90)
                {
                    <p style="margin: 0.25rem 0 0 0; font-size: 11px; color: #ba1a1a; display: flex; align-items: center; gap: 0.25rem;" class="font-mono">
                        <span class="material-symbols-outlined" style="font-size: 13px;">warning</span> Limite da cota quase atingido!
                    </p>
                }
            </div>

            <!-- Reports quota indicator -->
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <span style="font-size: 14px; font-weight: 600; color: var(--cc-ink);">Relatórios Mensais</span>
                    <span class="font-mono" style="font-size: 14px; font-weight: bold; color: var(--cc-ink);">@_reportsCount / @_maxReportsAllowed</span>
                </div>
                <div style="width: 100%; background-color: var(--cc-canvas); height: 8px; border-radius: 99px; overflow: hidden; display: flex;">
                    <div style="width: @(_reportsPercentage)%; height: 100%; background-color: var(--cc-secondary); border-radius: 99px;"></div>
                </div>
            </div>

        </div>
    </section>

    <!-- Pricing Toggle Switch -->
    <section style="display: flex; flex-direction: column; align-items: center; gap: 0.75rem; margin-bottom: 2.5rem;">
        <div style="background-color: var(--cc-canvas); border: 1px solid var(--cc-border); border-radius: 99px; padding: 0.25rem; display: inline-flex;">
            <button class="font-mono" @onclick="() => SetAnnual(false)"
                    style="border: none; cursor: pointer; padding: 0.5rem 1.5rem; border-radius: 99px; font-size: 13px; font-weight: bold; transition: all 0.2s;
                           background-color: @(!_isAnnual ? "var(--cc-primary)" : "transparent");
                           color: @(!_isAnnual ? "white" : "var(--cc-ink-muted)");">
                Mensal
            </button>
            <button class="font-mono" @onclick="() => SetAnnual(true)"
                    style="border: none; cursor: pointer; padding: 0.5rem 1.5rem; border-radius: 99px; font-size: 13px; font-weight: bold; transition: all 0.2s;
                           background-color: @(_isAnnual ? "var(--cc-primary)" : "transparent");
                           color: @(_isAnnual ? "white" : "var(--cc-ink-muted)");">
                Anual
            </button>
        </div>
        <span style="background-color: #c5430f; color: white; font-size: 10px; font-weight: bold; padding: 0.25rem 0.75rem; border-radius: 99px; display: inline-flex; align-items: center; gap: 0.25rem;" class="font-mono">
            <span class="material-symbols-outlined" style="font-size: 12px; font-variation-settings: 'FILL' 1;">auto_awesome</span>
            ECONOMIZE 15% NO ANUAL
        </span>
    </section>

    @if (_isLoadingPlans)
    {
        <div class="flex items-center justify-center p-12 text-center" style="display: flex; justify-content: center; align-items: center; padding: 3rem; background-color: white; border-radius: 12px; border: 1px solid var(--cc-border); margin-bottom: 3.5rem;">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2" style="width: 32px; height: 32px; border: 3px solid #e5e7eb; border-top-color: var(--cc-primary); border-radius: 50%;"></div>
            <span class="ml-3 font-mono text-sm font-semibold" style="margin-left: 0.75rem; color: var(--cc-ink-muted);">Carregando catálogo de planos atualizados do Backoffice...</span>
        </div>
    }
    else
    {
        <!-- Bento Pricing Cards Matrix (Stitch Desktop Style) -->
        <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; margin-bottom: 3.5rem; align-items: stretch;">
            @foreach (var plan in _availablePlans)
            {
                var isActive = IsActivePlan(plan.PlanId);
                var isProOrPopular = plan.IsPopular;
                var currentPrice = GetPrice(plan);
                var activePlanObj = _availablePlans.FirstOrDefault(p => IsActivePlan(p.PlanId));
                var isUpgrade = activePlanObj != null && plan.MonthlyPrice > activePlanObj.MonthlyPrice;

                <div style="background-color: white; border: @(isActive ? "2px solid var(--cc-primary)" : (isProOrPopular ? "2px solid var(--cc-primary-container)" : "1px solid var(--cc-border)")); border-radius: 12px; padding: 2rem 1.5rem; display: flex; flex-direction: column; position: relative; box-shadow: var(--cc-shadow); transform: @(isProOrPopular && !isActive ? "scale(1.02)" : "none"); z-index: @(isProOrPopular ? "10" : "1");">
                    @if (isActive)
                    {
                        <div style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background-color: var(--cc-primary); color: white; padding: 0.25rem 1rem; border-radius: 99px; font-size: 10px; font-weight: bold; text-transform: uppercase;" class="font-mono">
                            Plano Ativo
                        </div>
                    }
                    else if (isProOrPopular)
                    {
                        <div style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background-color: var(--cc-primary-container); color: white; padding: 0.25rem 1rem; border-radius: 99px; font-size: 10px; font-weight: bold; text-transform: uppercase;" class="font-mono">
                            Mais Popular
                        </div>
                    }

                    <div style="margin-bottom: 1.5rem;">
                        <h3 style="margin: 0 0 0.5rem 0; font-size: 22px; font-weight: bold; color: var(--cc-ink);">@plan.Name</h3>
                        <p style="margin: 0; font-size: 13px; color: var(--cc-ink-muted); line-height: 1.4;">@plan.Description</p>
                    </div>

                    <div style="margin-bottom: 2rem;">
                        @if (currentPrice > 0)
                        {
                            <span style="font-size: 32px; font-weight: bold; color: var(--cc-ink);">R$ @currentPrice.ToString("N2")</span>
                            <span style="font-size: 14px; color: var(--cc-ink-muted);">/mês</span>
                        }
                        else
                        {
                            <span style="font-size: 32px; font-weight: bold; color: var(--cc-ink);">Consultar</span>
                        }
                    </div>

                    <ul style="list-style: none; padding: 0; margin: 0 0 2rem 0; flex: 1; display: flex; flex-direction: column; gap: 0.85rem; font-size: 14px; color: var(--cc-ink);">
                        <li style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600;">
                            <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1; font-size: 18px;">check_circle</span>
                            @if (plan.HeadCapacityLimit > 0 && plan.HeadCapacityLimit < 999999)
                            {
                                <span>Até @plan.HeadCapacityLimit.ToString("N0") Matrizes / Cabeças</span>
                            }
                            else
                            {
                                <span>Matrizes Ilimitadas</span>
                            }
                        </li>
                        @if (plan.Features != null && plan.Features.Any())
                        {
                            @foreach (var feature in plan.Features.Where(f => f.IsEnabled).Take(4))
                            {
                                <li style="display: flex; align-items: center; gap: 0.5rem;">
                                    <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1; font-size: 18px;">check_circle</span>
                                    @feature.Name
                                </li>
                            }
                        }
                        else
                        {
                            @foreach (var module in plan.IncludedModules.Take(4))
                            {
                                <li style="display: flex; align-items: center; gap: 0.5rem;">
                                    <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1; font-size: 18px;">check_circle</span>
                                    Módulo @module
                                </li>
                            }
                        }
                    </ul>

                    @if (isActive)
                    {
                        <button class="cc-btn cc-btn-outline w-full pressed-effect" disabled
                                style="width: 100%; border: 1px solid var(--cc-primary); border-radius: 8px; padding: 0.75rem; font-weight: bold; background: white; color: var(--cc-primary); cursor: default;">
                            Plano Atual
                        </button>
                    }
                    else if (!_isAdmin)
                    {
                        <button class="cc-btn cc-btn-outline w-full" disabled
                                title="Apenas administradores da fazenda podem gerenciar planos"
                                style="width: 100%; border: 1px solid var(--cc-border); border-radius: 8px; padding: 0.75rem; font-weight: bold; background: #f8fafc; color: var(--cc-ink-muted); cursor: not-allowed; display: flex; align-items: center; justify-content: center; gap: 0.4rem;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">lock</span>
                            <span>Apenas Administradores</span>
                        </button>
                    }
                    else if (currentPrice == 0)
                    {
                        <button class="cc-btn cc-btn-outline w-full pressed-effect" @onclick='() => ChangePlan(plan.PlanId)'
                                style="width: 100%; border: 1px solid var(--cc-border); border-radius: 8px; padding: 0.75rem; font-weight: bold; background: white; color: var(--cc-ink-muted); cursor: pointer;">
                            Falar com Consultor
                        </button>
                    }
                    else if (isUpgrade)
                    {
                        <button class="cc-btn cc-btn-primary w-full pressed-effect" @onclick='() => ChangePlan(plan.PlanId)'
                                style="width: 100%; border: none; background-color: var(--cc-primary-container); color: white; border-radius: 8px; padding: 0.75rem; font-weight: bold; cursor: pointer;">
                            @(HasActiveStripeSubscription ? $"Alterar para {plan.Name} (Portal Stripe)" : $"Fazer Upgrade para {plan.Name}")
                        </button>
                    }
                    else
                    {
                        <button class="cc-btn cc-btn-outline w-full pressed-effect" @onclick='() => ChangePlan(plan.PlanId)'
                                style="width: 100%; border: 1px solid var(--cc-primary); border-radius: 8px; padding: 0.75rem; font-weight: bold; background: white; color: var(--cc-primary); cursor: pointer;">
                            @(HasActiveStripeSubscription ? $"Alterar para {plan.Name} (Portal Stripe)" : $"Downgrade para {plan.Name}")
                        </button>
                    }
                </div>
            }
        </section>
    }

    <!-- Accordion Matrix for Comparison (Responsive desktop view table) -->
    <section style="background-color: white; border: 1px solid var(--cc-border); border-radius: 12px; overflow: hidden; box-shadow: var(--cc-shadow); margin-bottom: 3rem;">
        <button @onclick="ToggleAccordion"
                style="width: 100%; background: transparent; border: none; padding: 1.25rem 1.5rem; text-align: left; display: flex; justify-content: space-between; align-items: center; cursor: pointer;">
            <h3 style="margin: 0; font-size: 18px; font-weight: bold; color: var(--cc-ink);">Comparativo de Funcionalidades</h3>
            <span class="material-symbols-outlined text-outline transition-transform duration-300" 
                  style="transform: rotate(@(_showAccordion ? "180deg" : "0deg"));">
                expand_more
            </span>
        </button>

        @if (_showAccordion)
        {
            <div style="border-top: 1px solid var(--cc-border); overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
                    <thead>
                        <tr style="background-color: var(--cc-canvas); color: var(--cc-ink-muted);" class="font-mono">
                            <th style="padding: 1rem 1.5rem; font-size: 11px; font-weight: bold; text-transform: uppercase;">Recurso</th>
                            @foreach (var plan in _availablePlans)
                            {
                                <th style="padding: 1rem 1.5rem; font-size: 11px; font-weight: bold; text-transform: uppercase; text-align: center;">@plan.Name</th>
                            }
                        </tr>
                    </thead>
                    <tbody style="color: var(--cc-ink);">
                        <tr style="border-bottom: 1px solid #e2e8f0;">
                            <td style="padding: 1rem 1.5rem; font-weight: 600;">Limite de Cabeças / Matrizes</td>
                            @foreach (var plan in _availablePlans)
                            {
                                <td style="padding: 1rem 1.5rem; text-align: center;">
                                    @(plan.HeadCapacityLimit > 0 && plan.HeadCapacityLimit < 999999 ? plan.HeadCapacityLimit.ToString("N0") : "Ilimitado")
                                </td>
                            }
                        </tr>
                        <tr style="border-bottom: 1px solid #e2e8f0; background-color: var(--cc-canvas);">
                            <td style="padding: 1rem 1.5rem; font-weight: 600;">Plantel Bovino, Matrizes & Identificação</td>
                            @foreach (var plan in _availablePlans)
                            {
                                var hasFeature = plan.IncludedModules.Any(m => m.Contains("Cows", StringComparison.OrdinalIgnoreCase) || m.Contains("Breeding", StringComparison.OrdinalIgnoreCase))
                                    || (plan.Features?.Any(f => (f.Key.Contains("Cows", StringComparison.OrdinalIgnoreCase) || f.Key.Contains("Breeding", StringComparison.OrdinalIgnoreCase)) && f.IsEnabled) ?? false);
                                <td style="padding: 1rem 1.5rem; text-align: center;">
                                    @if (hasFeature)
                                    {
                                        <span class="material-symbols-outlined" style="color: var(--cc-primary);">check</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined" style="color: #ba1a1a;">close</span>
                                    }
                                </td>
                            }
                        </tr>
                        <tr style="border-bottom: 1px solid #e2e8f0;">
                            <td style="padding: 1rem 1.5rem; font-weight: 600;">Reprodução, IATF & Partos</td>
                            @foreach (var plan in _availablePlans)
                            {
                                var hasFeature = plan.IncludedModules.Any(m => m.Contains("Breeding", StringComparison.OrdinalIgnoreCase) || m.Contains("Calving", StringComparison.OrdinalIgnoreCase))
                                    || (plan.Features?.Any(f => (f.Key.Contains("Breeding", StringComparison.OrdinalIgnoreCase) || f.Key.Contains("Calving", StringComparison.OrdinalIgnoreCase)) && f.IsEnabled) ?? false);
                                <td style="padding: 1rem 1.5rem; text-align: center;">
                                    @if (hasFeature)
                                    {
                                        <span class="material-symbols-outlined" style="color: var(--cc-primary);">check</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined" style="color: #ba1a1a;">close</span>
                                    }
                                </td>
                            }
                        </tr>
                        <tr style="border-bottom: 1px solid #e2e8f0;">
                            <td style="padding: 1rem 1.5rem; font-weight: 600;">Manejo, Crescimento & Pesagens</td>
                            @foreach (var plan in _availablePlans)
                            {
                                var hasFeature = plan.IncludedModules.Any(m => m.Contains("Growth", StringComparison.OrdinalIgnoreCase))
                                    || (plan.Features?.Any(f => f.Key.Contains("Growth", StringComparison.OrdinalIgnoreCase) && f.IsEnabled) ?? false);
                                <td style="padding: 1rem 1.5rem; text-align: center;">
                                    @if (hasFeature)
                                    {
                                        <span class="material-symbols-outlined" style="color: var(--cc-primary);">check</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined" style="color: #ba1a1a;">close</span>
                                    }
                                </td>
                            }
                        </tr>
                        <tr style="border-bottom: 1px solid #e2e8f0; background-color: var(--cc-canvas);">
                            <td style="padding: 1rem 1.5rem; font-weight: 600;">Sanitário & Vacinação Oficial</td>
                            @foreach (var plan in _availablePlans)
                            {
                                var hasFeature = plan.IncludedModules.Any(m => m.Contains("Sanitary", StringComparison.OrdinalIgnoreCase))
                                    || (plan.Features?.Any(f => f.Key.Contains("Sanitary", StringComparison.OrdinalIgnoreCase) && f.IsEnabled) ?? false);
                                <td style="padding: 1rem 1.5rem; text-align: center;">
                                    @if (hasFeature)
                                    {
                                        <span class="material-symbols-outlined" style="color: var(--cc-primary);">check</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined" style="color: #ba1a1a;">close</span>
                                    }
                                </td>
                            }
                        </tr>
                        <tr style="border-bottom: 1px solid #e2e8f0;">
                            <td style="padding: 1rem 1.5rem; font-weight: 600;">Nutrição, Silos & Formulação de Ração</td>
                            @foreach (var plan in _availablePlans)
                            {
                                var hasFeature = plan.IncludedModules.Any(m => m.Contains("Nutrition", StringComparison.OrdinalIgnoreCase))
                                    || (plan.Features?.Any(f => f.Key.Contains("Nutrition", StringComparison.OrdinalIgnoreCase) && f.IsEnabled) ?? false);
                                <td style="padding: 1rem 1.5rem; text-align: center;">
                                    @if (hasFeature)
                                    {
                                        <span class="material-symbols-outlined" style="color: var(--cc-primary);">check</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined" style="color: #ba1a1a;">close</span>
                                    }
                                </td>
                            }
                        </tr>
                        <tr style="border-bottom: 1px solid #e2e8f0; background-color: var(--cc-canvas);">
                            <td style="padding: 1rem 1.5rem; font-weight: 600;">Zootecnia Avançada & Análise de Custo por @@</td>
                            @foreach (var plan in _availablePlans)
                            {
                                var hasFeature = plan.IncludedModules.Any(m => m.Contains("Analytics", StringComparison.OrdinalIgnoreCase))
                                    || (plan.Features?.Any(f => f.Key.Contains("Analytics", StringComparison.OrdinalIgnoreCase) && f.IsEnabled) ?? false);
                                <td style="padding: 1rem 1.5rem; text-align: center;">
                                    @if (hasFeature)
                                    {
                                        <span class="material-symbols-outlined" style="color: var(--cc-primary);">check</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined" style="color: #ba1a1a;">close</span>
                                    }
                                </td>
                            }
                        </tr>
                        <tr style="border-bottom: none;">
                            <td style="padding: 1rem 1.5rem; font-weight: 600;">Modo Offline PWA no Curral</td>
                            @foreach (var plan in _availablePlans)
                            {
                                var hasFeature = (plan.Features?.Any(f => f.Key.Contains("PwaOfflineMode", StringComparison.OrdinalIgnoreCase) && f.IsEnabled) ?? false)
                                    || plan.IncludedModules.Any(m => m.Contains("PwaOfflineMode", StringComparison.OrdinalIgnoreCase));
                                <td style="padding: 1rem 1.5rem; text-align: center;">
                                    @if (hasFeature)
                                    {
                                        <span class="material-symbols-outlined" style="color: var(--cc-primary);">check</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined" style="color: #ba1a1a;">close</span>
                                    }
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (_showBillingUnavailableModal)
    {
        <div class="modal-overlay" @onclick="CloseBillingModal" style="position: fixed; inset: 0; background: rgba(15, 23, 42, 0.7); display: flex; align-items: center; justify-content: center; z-index: 1050; padding: 1rem;">
            <div class="modal-card" @onclick:stopPropagation="true" style="background: white; border-radius: 16px; width: min(480px, 95vw); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.04); overflow: hidden; border: 1px solid var(--cc-border);">
                <div style="background: #fef2f2; padding: 1.25rem 1.5rem; display: flex; align-items: center; gap: 0.75rem; border-bottom: 1px solid #fee2e2;">
                    <div style="width: 40px; height: 40px; border-radius: 10px; background: #fee2e2; color: #dc2626; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <span class="material-symbols-outlined" style="font-size: 24px;">lock_clock</span>
                    </div>
                    <div>
                        <h3 style="margin: 0; font-size: 16px; font-weight: 700; color: #991b1b;">Faturamento Temporariamente Indisponível</h3>
                        <p style="margin: 0.15rem 0 0; font-size: 12px; color: #b91c1c;">Segurança & Conformidade de Pagamento</p>
                    </div>
                </div>
                <div style="padding: 1.5rem; color: var(--cc-ink); font-size: 14px; line-height: 1.5;">
                    <p style="margin: 0 0 1rem 0;">
                        @_billingUnavailableReason
                    </p>
                    <div style="background: #f8fafc; border-left: 4px solid var(--cc-primary); border-radius: 4px; padding: 0.75rem 1rem; margin-bottom: 1rem; font-size: 13px; color: var(--cc-ink-muted);">
                        <strong>Aviso de Segurança:</strong> As alterações de plano na plataforma CriaCerto exigem confirmação pelo Stripe ou autorização expressa documentada pelo Backoffice. Seu plano atual permanece inalterado.
                    </div>
                </div>
                <div style="padding: 1rem 1.5rem; background: #f8fafc; border-top: 1px solid var(--cc-border); display: flex; justify-content: flex-end; gap: 0.75rem;">
                    <button type="button" @onclick="CloseBillingModal" style="background: white; border: 1px solid var(--cc-border); border-radius: 8px; padding: 0.5rem 1.25rem; font-size: 13px; font-weight: 600; cursor: pointer; color: var(--cc-ink);">
                        Fechar
                    </button>
                    @if (HasActiveStripeSubscription)
                    {
                        <button type="button" @onclick="OpenBillingPortalFromModal" style="background: #635bff; border: none; border-radius: 8px; padding: 0.5rem 1.25rem; font-size: 13px; font-weight: 600; color: white; cursor: pointer; display: flex; align-items: center; gap: 0.4rem;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">open_in_new</span>
                            <span>Acessar Portal Stripe</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="ContactSupport" style="background: var(--cc-primary); border: none; border-radius: 8px; padding: 0.5rem 1.25rem; font-size: 13px; font-weight: 600; color: white; cursor: pointer;">
                            Falar com Suporte
                        </button>
                    }
                </div>
            </div>
        </div>
    }

</div>

@code {
    private Guid _tenantId = Guid.Empty;
    private TenantProfileModel? _profile;
    private string _activePlan = "Starter";
    private bool _isAdmin = false;
    private bool _isAnnual = false;
    private bool _showAccordion = true;
    private bool _isSubmitting = false;
    private bool _isLoadingPlans = true;
    private string? _message;
    private bool _isSuccessMessage;
    private List<SubscriptionPlanModel> _availablePlans = new();
    private bool _showBillingUnavailableModal = false;
    private string _billingUnavailableReason = "O serviço de faturamento seguro no Stripe está temporariamente indisponível.";

    [SupplyParameterFromQuery(Name = "success")]
    public bool? StripeSuccess { get; set; }

    [SupplyParameterFromQuery(Name = "canceled")]
    public bool? StripeCanceled { get; set; }

    private bool _stripeProcessed = false;

    private bool HasActiveStripeSubscription => _profile != null &&
        !string.IsNullOrWhiteSpace(_profile.StripeSubscriptionId) &&
        (string.Equals(_profile.Status, "Active", StringComparison.OrdinalIgnoreCase) ||
         string.Equals(_profile.Status, "PastDue", StringComparison.OrdinalIgnoreCase));

    private int _registeredAnimalsCount = 0;
    private int _reportsCount = 0;

    // Usage limits
    private int _maxAnimalsAllowed
    {
        get
        {
            var plan = _availablePlans.FirstOrDefault(p => IsActivePlan(p.PlanId));
            if (plan != null && plan.HeadCapacityLimit > 0)
            {
                return plan.HeadCapacityLimit;
            }
            var normalized = ModuleLicenseChecker.NormalizePlan(_activePlan);
            return normalized.Equals("Starter", StringComparison.OrdinalIgnoreCase) ? 500 : 
                   (normalized.Equals("Pro", StringComparison.OrdinalIgnoreCase) ? 2500 : 99999);
        }
    }
    private int _maxReportsAllowed
    {
        get
        {
            var normalized = ModuleLicenseChecker.NormalizePlan(_activePlan);
            return normalized.Equals("Starter", StringComparison.OrdinalIgnoreCase) ? 10 : 
                   (normalized.Equals("Pro", StringComparison.OrdinalIgnoreCase) ? 50 : 999);
        }
    }
    private int _animalsPercentage => _maxAnimalsAllowed > 0 ? Math.Min(100, (_registeredAnimalsCount * 100) / _maxAnimalsAllowed) : 0;
    private int _reportsPercentage => _maxReportsAllowed > 0 ? Math.Min(100, (_reportsCount * 100) / _maxReportsAllowed) : 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var roleClaim = user.FindFirst(ClaimTypes.Role)?.Value 
                         ?? user.FindFirst("Role")?.Value;
            _isAdmin = user.IsInRole("Admin") || string.Equals(roleClaim, "Admin", StringComparison.OrdinalIgnoreCase);

            var planClaim = user.FindFirst("SubscribedPlan")?.Value;
            if (!string.IsNullOrEmpty(planClaim))
            {
                _activePlan = ModuleLicenseChecker.NormalizePlan(planClaim);
            }

            var tenantIdClaim = user.FindFirst("TenantId")?.Value;
            if (Guid.TryParse(tenantIdClaim, out var tenantId))
            {
                _tenantId = tenantId;

                // Renovação de Claims e JWT no Retorno do Stripe (Fase 2.3)
                if (StripeSuccess == true && !_stripeProcessed)
                {
                    _stripeProcessed = true;
                    var refreshedToken = await TenancyApiClient.RefreshTokenAsync(_tenantId);
                    if (!string.IsNullOrEmpty(refreshedToken))
                    {
                        await AuthStateProvider.MarkUserAsAuthenticated(refreshedToken);
                        _message = "Assinatura confirmada com sucesso pelo Stripe! Seu plano e permissões de acesso foram atualizados.";
                        _isSuccessMessage = true;
                    }
                    else
                    {
                        _message = "Pagamento concluído no Stripe! Suas novas cotas e permissões estão sendo sincronizadas.";
                        _isSuccessMessage = true;
                    }
                }
                else if (StripeCanceled == true && !_stripeProcessed)
                {
                    _stripeProcessed = true;
                    _message = "A operação de assinatura no Stripe foi cancelada. Seu plano atual permanece inalterado.";
                    _isSuccessMessage = false;
                }

                _profile = await TenancyApiClient.GetTenantProfileAsync(tenantId);
                if (_profile != null && !string.IsNullOrEmpty(_profile.SubscribedPlan))
                {
                    _activePlan = ModuleLicenseChecker.NormalizePlan(_profile.SubscribedPlan);
                }
            }

            try
            {
                _isLoadingPlans = true;
                _availablePlans = await TenancyApiClient.GetSubscriptionPlansAsync();
            }
            catch
            {
                _availablePlans = TenancyApiClient.GetFallbackPlans();
            }
            finally
            {
                _isLoadingPlans = false;
            }

            try
            {
                var cowsResponse = await PlantelApiClient.ListCowsAsync(search: null, status: null);
                if (cowsResponse != null)
                {
                    _registeredAnimalsCount = cowsResponse.TotalCount;
                }
            }
            catch
            {
                // Fallback for offline or client preview
            }
        }
        else
        {
            Navigation.NavigateTo("login");
        }
    }

    private void SetAnnual(bool value)
    {
        _isAnnual = value;
    }

    private void ToggleAccordion()
    {
        _showAccordion = !_showAccordion;
    }

    private bool IsActivePlan(string planId)
    {
        return string.Equals(
            ModuleLicenseChecker.NormalizePlan(_activePlan),
            ModuleLicenseChecker.NormalizePlan(planId),
            StringComparison.OrdinalIgnoreCase);
    }

    private decimal GetPrice(SubscriptionPlanModel plan)
    {
        return _isAnnual ? plan.AnnualPriceMonthly : plan.MonthlyPrice;
    }

    private decimal GetPrice(string planName)
    {
        var plan = _availablePlans.FirstOrDefault(p => string.Equals(p.PlanId, planName, StringComparison.OrdinalIgnoreCase));
        if (plan != null)
        {
            return _isAnnual ? plan.AnnualPriceMonthly : plan.MonthlyPrice;
        }
        return 0;
    }

    private async Task ChangePlan(string planName)
    {
        if (!_isAdmin)
        {
            _message = "Apenas administradores da fazenda possuem permissão para alterar o plano de assinatura.";
            _isSuccessMessage = false;
            return;
        }

        if (_isSubmitting || IsActivePlan(planName) || _tenantId == Guid.Empty)
            return;

        // Prevenção de assinaturas concorrentes / cobrança dupla no Stripe
        if (HasActiveStripeSubscription)
        {
            await OpenBillingPortal();
            return;
        }

        _isSubmitting = true;
        _message = null;

        try
        {
            // Tenta criar checkout seguro com o Stripe
            var checkoutSession = await TenancyApiClient.CreateSubscriptionCheckoutAsync(
                _tenantId,
                planName,
                _isAnnual ? "annual" : "monthly",
                Navigation.ToAbsoluteUri("/settings/subscription?success=true").ToString(),
                Navigation.ToAbsoluteUri("/settings/subscription?canceled=true").ToString());

            if (checkoutSession != null && !string.IsNullOrWhiteSpace(checkoutSession.Url))
            {
                Navigation.NavigateTo(checkoutSession.Url);
                return;
            }

            // Eliminação do bypass gratuito: notifica indisponibilidade e bloqueia concessão sem pagamento
            _billingUnavailableReason = "Não foi possível iniciar a sessão de faturamento seguro no Stripe para este plano. O serviço pode estar temporariamente indisponível ou em manutenção. Nenhuma cobrança foi efetuada e seu plano atual permanece inalterado.";
            _showBillingUnavailableModal = true;
            _message = "O faturamento online para este plano está temporariamente indisponível. Entre em contato com o suporte para regularizar sua assinatura.";
            _isSuccessMessage = false;
        }
        catch (Exception ex)
        {
            if (HasActiveStripeSubscription || ex.Message.Contains("assinatura ativa no Stripe", StringComparison.OrdinalIgnoreCase))
            {
                _billingUnavailableReason = "Sua fazenda já possui uma assinatura ativa gerenciada com segurança pelo Stripe. Para prevenir cobranças duplicadas e calcular o rateio proporcional automaticamente, a alteração de plano deve ser realizada através do Portal do Stripe.";
            }
            else
            {
                _billingUnavailableReason = $"Ocorreu uma falha na integração de pagamentos: {ex.Message}. A alteração direta de planos sem confirmação financeira foi bloqueada.";
            }
            _showBillingUnavailableModal = true;
            _message = $"Erro ao conectar ao faturamento seguro: {ex.Message}";
            _isSuccessMessage = false;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task OpenBillingPortal()
    {
        if (!_isAdmin)
        {
            _message = "Apenas administradores da fazenda possuem permissão para acessar o portal de faturamento Stripe.";
            _isSuccessMessage = false;
            return;
        }

        if (_tenantId == Guid.Empty) return;

        _isSubmitting = true;
        try
        {
            var portalSession = await TenancyApiClient.CreateSubscriptionPortalAsync(
                _tenantId,
                Navigation.ToAbsoluteUri("/settings/subscription?success=true").ToString());

            if (portalSession != null && !string.IsNullOrWhiteSpace(portalSession.Url))
            {
                Navigation.NavigateTo(portalSession.Url);
            }
            else
            {
                _billingUnavailableReason = "Não foi possível abrir o portal de autoatendimento Stripe. Verifique se sua fazenda possui uma assinatura ativa ou contate o suporte.";
                _showBillingUnavailableModal = true;
                _message = "Portal de autoatendimento Stripe indisponível no momento.";
                _isSuccessMessage = false;
            }
        }
        catch (Exception ex)
        {
            _billingUnavailableReason = $"Erro ao acessar o portal de faturamento: {ex.Message}";
            _showBillingUnavailableModal = true;
            _message = $"Erro ao abrir portal de cobrança: {ex.Message}";
            _isSuccessMessage = false;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void CloseBillingModal()
    {
        _showBillingUnavailableModal = false;
    }

    private async Task OpenBillingPortalFromModal()
    {
        CloseBillingModal();
        await OpenBillingPortal();
    }

    private void ContactSupport()
    {
        _showBillingUnavailableModal = false;
        Navigation.NavigateTo("settings/organization");
    }

    private void GoToSettings()
    {
        Navigation.NavigateTo("settings/organization");
    }
}
